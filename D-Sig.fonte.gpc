// Salva 3 SPVARs de uma instância — chamado apenas no SHARE 1s
// Grava um SPVAR SO se o valor for diferente do que ja esta la.
// A EEPROM do Cronus e "rated for 1000's of" ciclos, segundo a documentacao — e nao ha
// contador nenhum avisando quantos ja foram. Uma leitura para evitar uma gravacao e
// sempre um bom negocio: leitura nao desgasta, e o tempo de uma gravacao evitada e
// maior que o de uma leitura feita.
// O ganho real esta na regeracao de script pelo app: trocar um MOD e gerar de novo
// regravava as 21 instancias, 63 SPVARs. Agora regrava so o que mudou.
function Grava_Spv(qual, valor) {
    if(get_pvar(qual, -2147483648, 2147483647, 0) == valor) return;
    set_pvar(qual, valor);
}

function Save_Instance(num) {
    if(num ==  1) { Grava_Spv(SPVAR_1, DS_A_01); Grava_Spv(SPVAR_2, DS_B_01); Grava_Spv(SPVAR_3, DS_C_01); }
    if(num ==  2) { Grava_Spv(SPVAR_4, DS_A_02); Grava_Spv(SPVAR_5, DS_B_02); Grava_Spv(SPVAR_6, DS_C_02); }
    if(num ==  3) { Grava_Spv(SPVAR_7, DS_A_03); Grava_Spv(SPVAR_8, DS_B_03); Grava_Spv(SPVAR_9, DS_C_03); }
    if(num ==  4) { Grava_Spv(SPVAR_10, DS_A_04); Grava_Spv(SPVAR_11, DS_B_04); Grava_Spv(SPVAR_12, DS_C_04); }
    if(num ==  5) { Grava_Spv(SPVAR_13, DS_A_05); Grava_Spv(SPVAR_14, DS_B_05); Grava_Spv(SPVAR_15, DS_C_05); }
    if(num ==  6) { Grava_Spv(SPVAR_16, DS_A_06); Grava_Spv(SPVAR_17, DS_B_06); Grava_Spv(SPVAR_18, DS_C_06); }
    if(num ==  7) { Grava_Spv(SPVAR_19, DS_A_07); Grava_Spv(SPVAR_20, DS_B_07); Grava_Spv(SPVAR_21, DS_C_07); }
    if(num ==  8) { Grava_Spv(SPVAR_22, DS_A_08); Grava_Spv(SPVAR_23, DS_B_08); Grava_Spv(SPVAR_24, DS_C_08); }
    if(num ==  9) { Grava_Spv(SPVAR_25, DS_A_09); Grava_Spv(SPVAR_26, DS_B_09); Grava_Spv(SPVAR_27, DS_C_09); }
    if(num == 10) { Grava_Spv(SPVAR_28, DS_A_10); Grava_Spv(SPVAR_29, DS_B_10); Grava_Spv(SPVAR_30, DS_C_10); }
    if(num == 11) { Grava_Spv(SPVAR_31, DS_A_11); Grava_Spv(SPVAR_32, DS_B_11); Grava_Spv(SPVAR_33, DS_C_11); }
    if(num == 12) { Grava_Spv(SPVAR_34, DS_A_12); Grava_Spv(SPVAR_35, DS_B_12); Grava_Spv(SPVAR_36, DS_C_12); }
    if(num == 13) { Grava_Spv(SPVAR_37, DS_A_13); Grava_Spv(SPVAR_38, DS_B_13); Grava_Spv(SPVAR_39, DS_C_13); }
    if(num == 14) { Grava_Spv(SPVAR_40, DS_A_14); Grava_Spv(SPVAR_41, DS_B_14); Grava_Spv(SPVAR_42, DS_C_14); }
    if(num == 15) { Grava_Spv(SPVAR_43, DS_A_15); Grava_Spv(SPVAR_44, DS_B_15); Grava_Spv(SPVAR_45, DS_C_15); }
    if(num == 16) { Grava_Spv(SPVAR_46, DS_A_16); Grava_Spv(SPVAR_47, DS_B_16); Grava_Spv(SPVAR_48, DS_C_16); }
    if(num == 17) { Grava_Spv(SPVAR_49, DS_A_17); Grava_Spv(SPVAR_50, DS_B_17); Grava_Spv(SPVAR_51, DS_C_17); }
    if(num == 18) { Grava_Spv(SPVAR_52, DS_A_18); Grava_Spv(SPVAR_53, DS_B_18); Grava_Spv(SPVAR_54, DS_C_18); }
    if(num == 19) { Grava_Spv(SPVAR_55, DS_A_19); Grava_Spv(SPVAR_56, DS_B_19); Grava_Spv(SPVAR_57, DS_C_19); }
    if(num == 20) { Grava_Spv(SPVAR_58, DS_A_20); Grava_Spv(SPVAR_59, DS_B_20); Grava_Spv(SPVAR_60, DS_C_20); }
    if(num == 21) { Grava_Spv(SPVAR_61, DS_A_21); Grava_Spv(SPVAR_62, DS_B_21); Grava_Spv(SPVAR_63, DS_C_21); }
    // As tres gravacoes passam pelo Grava_Spv, que le antes e so escreve se mudou.
    // Nada global a gravar aqui: a SPVAR_64 e escrita SO por Marcar_Selo, que e quem
    // conhece a reparticao dela (bit 0 = migracao de layout, bits 1-31 = selo do app).
    // D-Sig: o comentario antigo dizia "o SPVAR_64 ficou livre" — verdade na v3zb, falso
    // desde a v5b. Ficava a duas telas de distancia do Load_All, que dizia o contrario.
    // v3z7: gravou -> deixa de estar sujo e passa a constar como salvo. Vale tambem para
    // as chamadas vindas do Compact_Pos/Zerar_Posicao na delecao, e ali esta correto: o
    // slot foi mesmo persistido naquele instante.
    Cfg_Ram   = Cfg_Ram   & (~(1 << (num - 1)));
    Cfg_Salvo = Cfg_Salvo |  (1 << (num - 1));
}
// =============================================================
// SEÇÃO 16 — DESENHO DO OLED
// =============================================================
function Update_OLED() {
    cls_oled(0);
    OLED_Timer = OLED_TIMEOUT;
    rect_oled(0, 0, 128, 64, 0, 1);
    // CORRIGIDO: pré-carrega os dados da tela ANTES de desenhar, sempre que Wz_Entrando
    // está true — não importa se quem chamou Update_OLED() já rodou o Load correspondente
    // ou não. Sem isso, uma transição que chama Update_OLED() na mesma passada que muda
    // MenuDin desenha com dado da instância/tela ANTERIOR, porque o Load só rodaria na
    // passada seguinte (quando o main{} confere Wz_Entrando daquela tela). Sintoma
    // reportado: ao criar/configurar várias instâncias em sequência, a tela nova parecia
    // "replicar" a anterior até UP/DOWN ou L1/R1 forçar outro redesenho — o dado já
    // estava certo por baixo, só a tela atrasava um quadro. Chamar o Load de novo aqui é
    // redundante com o do main{}, mas inofensivo (só relê o mesmo valor já correto).
    if(Wz_Entrando) {
        if(MenuDin == 100) Load_Wz_Fonte(WzSlot);
        if(MenuDin == 101) Load_Wz_Cond(WzSlot);
        if(MenuDin == 102) Load_Wz_Gatilho(WzSlot);
        if(MenuDin == 104) Load_Wz_Tipo(WzSlot);
        if(MenuDin == 105) Load_Wz_Tipo(WzSlot);
        if(MenuDin == 106) Load_Wz_Mod(Wz_Mod_Tipo);
        // v3z7 DESAJUSTES DE NAVEGACAO — mesma raiz do bug de dado ja corrigido acima,
        // agora pelo lado da ROLAGEM. Wz_ScrTop e UMA global compartilhada pelas quatro
        // telas de lista (101 condicionais, 102 gatilhos, 105 destino, 106 MODs). Cada uma
        // zera essa variavel no proprio bloco if(Wz_Entrando) do main{} — que so roda no
        // quadro SEGUINTE. Como a transicao chama Update_OLED() na MESMA passada, a tela
        // nova era desenhada UMA VEZ com o Wz_ScrTop da tela ANTERIOR.
        // Sintoma 1 (INV duplicado nas CONDICOES): Print_Cond_Row termina em fallthrough —
        // qualquer indice que nao seja 0/1/2/"3 com eixo" cai no INV. Vindo do DESTINO
        // (18 itens), Wz_ScrTop podia estar em 4; as duas linhas caiam no fallthrough e
        // desenhavam INV em cima de INV, sem cursor (Wz_SubCursor ja fora zerado).
        // Sintoma 2 (GATILHOS em branco): Print_Gatilho_Lista_Row so trata 0-5. Com
        // Wz_ScrTop acima de 5, NADA era desenhado — nem o cursor. No primeiro UP o clamp
        // do main{} reancorava, dando a impressao de que o FINAL_AFTER virara o ultimo item.
        // Ancorar aqui resolve os dois de uma vez, e tambem as telas 105/106 (onde o
        // desalinhamento era menos visivel porque as listas sao longas).
        // 101/105/106 entram sempre com Wz_SubCursor=0, entao o topo e 0.
        // 102 e a excecao: o cursor dela (Wz_Gatilho_Lista_Cur) PERSISTE entre entradas,
        // entao o topo tem de ser reancorado nele, nao zerado — senao o cursor sairia da
        // janela de 2 linhas ao reentrar com a lista rolada.
        if(MenuDin == 101 || MenuDin == 105 || MenuDin == 106) Wz_ScrTop = 0;
        if(MenuDin == 102) {
            Wz_ScrTop = 0;
            if(Wz_Gatilho_Lista_Cur > 1) Wz_ScrTop = Wz_Gatilho_Lista_Cur - 1;
        }
    }
    //----------------------------------------------------------
    // NÍVEL 1 — Lista de instâncias
    //----------------------------------------------------------
    if(MenuDin == 1) {
        // Cabeçalho
        print(5, 2, 0, 1, DS_TITULO[0]);
        rect_oled(0, 11, 128, 1, 0, 1);
        // Linha 0 — instância ou [+]
        if(MenuCursor == ScrollTop) rect_oled(0, ROW0_Y - 2, 128, 18, 0, 1);
        Print_Inst_Row(ScrollTop, ITEM_X, ROW0_Y);
        // Linha 1 — instância ou [+]
        if(MenuCursor == ScrollTop + 1) rect_oled(0, ROW1_Y - 2, 128, 18, 0, 1);
        Print_Inst_Row(ScrollTop + 1, ITEM_X, ROW1_Y);
        // Indicadores de scroll
        if(ScrollTop > 0) print(120, 2, 0, 1, SCR_UP[0]);
        if(ScrollTop + VISIBLE_ROWS <= Total_Inst) print(120, FOOTER_Y, 0, 1, SCR_DN[0]);
        print(5, FOOTER_Y, 0, 1, NAV_LISTA[0]);
        return;
    }
    //----------------------------------------------------------
    // FONTES ÚNICA v3 (MenuDin=100)
    //----------------------------------------------------------
    if(MenuDin == 100) {
        print(5, 2, 0, 1, WZ_FONTES[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        if(Wz_SubCursor == 0) print(2, 17, 0, 1, SCR_SEL[0]);
        Print_Fonte_Label(10, 17, Wz_Fonte_Tipo);
        // v7m: a linha ganhou rotulo. Antes aparecia so "ATIVO"/"PASSIVO", solto, e era
        // facil confundir com o nome da fonte da linha de cima. Agora fica alinhada com a
        // linha do DELAY: rotulo em x=10, valor em x=70.
        if(Wz_SubCursor == 1) print(2, 26, 0, 1, SCR_SEL[0]);
        print(10, 27, 0, 1, F1_MODO_LBL[0]);
        if(Wz_Fonte_Passivo) print(70, 27, 0, 1, F1_PASSIV[0]);
        else                 print(70, 27, 0, 1, F1_ATIVO[0]);
        // v5: o DELAY vive na tela do ALFA porque e sobre QUANDO a resposta comeca —
        // mas vale para qualquer caminho de acionamento, nao so o da fonte.
        if(Wz_SubCursor == 2) print(2, 39, 0, 1, SCR_SEL[0]);
        print(10, 39, 0, 1, DLY_LBL[0]);
        if(Wz_Delay == 0) print(70, 39, 0, 1, DLY_0[0]);
        if(Wz_Delay == 1) print(70, 39, 0, 1, DLY_1[0]);
        if(Wz_Delay == 2) print(70, 39, 0, 1, DLY_2[0]);
        if(Wz_Delay == 3) print(70, 39, 0, 1, DLY_3[0]);
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // CONDICIONAIS DA FONTE v3 (MenuDin=101) — campos variam por categoria
    //----------------------------------------------------------
    if(MenuDin == 101) {
        print(5, 2, 0, 1, WZ_COND[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        Work_C = Get_Fonte_Categoria(Wz_Fonte_Tipo);
        if(Work_C == CAT_TOUCH) {
            // só MULT, sem rolagem (mesmo layout do antigo F1X só-MULT)
            rect_oled(0, 18, 128, 20, 0, 1);
            print(3, 22, 1, 1, F1_MULT_LBL[0]);
            Print_Mult_Label(78, 22, Wz_Cond_Mult);
            print(3, 44, 0, 1, F1_SOMENTE[0]);
        } else {
            Print_Cond_Row(Wz_ScrTop,     ROW0_Y, Work_C);
            Print_Cond_Row(Wz_ScrTop + 1, ROW1_Y, Work_C);
            Work_D = 3; if(Work_C == CAT_GATILHO) Work_D = 2;   // v3ze
            if(Wz_ScrTop > 0) print(120, 14, 0, 1, SCR_UP[0]);   // v3zj: era 13, colava na linha do cabecalho
            if(Wz_ScrTop + 2 <= Work_D) print(120, FOOTER_Y, 0, 1, SCR_DN[0]);
        }
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // GATILHO+BTN_FN v3 — LISTA (MenuDin=102)
    //----------------------------------------------------------
    if(MenuDin == 102) {
        print(5, 2, 0, 1, GTL_LBL[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        Print_Gatilho_Lista_Row(Wz_ScrTop,     ROW0_Y);
        Print_Gatilho_Lista_Row(Wz_ScrTop + 1, ROW1_Y);
        if(Wz_ScrTop > 0) print(120, 14, 0, 1, SCR_UP[0]);   // v3zj: era 13, colava na linha do cabecalho
        if(Wz_ScrTop + 2 <= 4) print(120, FOOTER_Y, 0, 1, SCR_DN[0]);   // v6c
        print(5, FOOTER_Y, 0, 1, NAV_FN[0]);
        return;
    }
    //----------------------------------------------------------
    // GATILHO+BTN_FN v3 — CONFIG DO TIPO (MenuDin=103) — sem rolagem, máx 3 campos
    //----------------------------------------------------------
    if(MenuDin == 103) {
        Work_C = Wz_Gatilho_Lista_Cur;
        if(Work_C == 0) print(5, 2, 0, 1, GTL_DUPLO[0]);
        if(Work_C == 1) print(5, 2, 0, 1, FN_FINAL[0]);
        if(Work_C == 2) print(5, 2, 0, 1, GTL_HPHOLD[0]);
        if(Work_C == 3) print(5, 2, 0, 1, FN_FINAFT[0]);
        if(Work_C == 4) print(5, 2, 0, 1, FN_BLOQ[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        // v7: linhas em 13/26/39/52 (eram 13/27/41). O ALT/FIN levou o HOLD a quatro
        // linhas, e a quarta so cabe sem o rodape.
        // v3zk: linhas em 13/27/41 (eram 13/32/46). Com o FOOTER_Y descido para 52, a
        // terceira linha ia ate ~56 e aparecia cortada pela metade — foi o que o Daniel
        // viu na tela do HOLD, unico tipo que usa as tres. Vao de 14px entre elas: aperta
        // um pouco em relacao aos 19px de antes, mas cabe inteiro acima do rodape.
        // v3z8: o HOLD agora tem 4 campos (botao/tempo/MODO/RELIG) e a tela so cabe 3
        // linhas. Janela deslizante derivada do proprio cursor — sem variavel de estado
        // nova: com o cursor ate 2 mostra os campos 0-2; no campo 3 desliza para 1-3.
        // Print_Hold_Campo faz o desenho de um campo numa altura; os demais tipos de
        // gatilho seguem com o layout fixo de antes, intocados.
        if(Wz_SubCursor == 0) print(2, 13, 0, 1, SCR_SEL[0]);
        if(Work_C == 0) Print_Gatilho_Btn(15, 13, Wz_Gatilho_Duplo_Btn);
        if(Work_C == 1) Print_Gatilho_Btn(15, 13, Wz_Gatilho_Final_Btn);
        if(Work_C == 2) Print_Gatilho_Btn(15, 13, Wz_Gatilho_Hphold_Btn);
        if(Work_C == 3) Print_Gatilho_Btn(15, 13, Wz_Gatilho_FA_Btn);
        if(Work_C == 4) Print_Gatilho_Btn(15, 13, Wz_Blok);
        // Linha 1: tempo (HOLD/FINAL_AFTER) ou RELIG (FINALIZA/2CLK) — cadeia else-if única
        if(Work_C == 2) {
            if(Wz_SubCursor == 1) print(2, 26, 0, 1, SCR_SEL[0]);
            print(10, 26, 0, 1, GTL_TMP_LBL[0]);
            Print_Hphold_Tempo(68, 26, Wz_Gatilho_Hphold_Tempo);
        } else if(Work_C == 3) {
            if(Wz_SubCursor == 1) print(2, 26, 0, 1, SCR_SEL[0]);
            print(10, 26, 0, 1, FT_LBL[0]);
            Print_After_Val(68, 26, Wz_Gatilho_FA_Tempo);
        }
        // Linha 2: RELIG (FINAL_AFTER e HOLD) — cadeia else-if única
        // CORRIGIDO: Print_Hphold_Tempo (chamada na Linha 1 acima) usa Work_C como rascunho
        // interno pros dígitos decimais — suja o Work_C que guardava Wz_Gatilho_Lista_Cur.
        // Por isso a Linha 2 inteira (cursor incluso) sumia especificamente pra HOLD: a
        // checagem "if(Work_C==3)" falhava porque Work_C já não valia mais 3 nesse ponto.
        // Reatribuir aqui garante o valor fresco, independente do que rodou antes.
        // v3zb: linha 3 agora e o MODO do HOLD (era o RELIG). Reatribuir Work_C aqui
        // continua obrigatorio: Print_Hphold_Tempo, chamada na linha acima, usa Work_C
        // como rascunho dos digitos decimais.
        Work_C = Wz_Gatilho_Lista_Cur;
        // v7j CORRIGIDO (bug B15). Work_D e calculado no bloco de NAVEGACAO, nunca aqui.
        // O desenho usava o lixo que sobrou de outra funcao, entao "Wz_SubCursor == Work_D"
        // comparava com um valor qualquer: o cursor do ALT/FIN aparecia junto com o do
        // botao e sumia quando devia aparecer. Recalcular aqui e obrigatorio, pelo mesmo
        // motivo que Work_C ja era reatribuido logo acima.
        if(Work_C == 2)      Work_D = 3;   // HOLD:  botao + tempo + APOS/ATE + ALT/FIN
        else if(Work_C == 3) Work_D = 2;   // AFTER: botao + tempo + ALT/FIN
        else if(Work_C == 4) Work_D = 0;   // BLOK:  so botao
        else                 Work_D = 1;   // 2CLK / TOGGLE: botao + ALT/FIN
        // linha do ALT/FIN — sempre a ULTIMA de cada gatilho que liga/desliga.
        if(Work_C != 4) {
            // v7: com o ALT/FIN a tela do HOLD passou a ter QUATRO linhas. Em 13/27/41
            // a quarta cairia em 55 e seria cortada pelo rodape (52), o mesmo problema
            // que ja tivemos. As linhas foram para 13/26/39/52 e esta tela deixou de
            // desenhar o rodape — como a de destino, que tambem tem quatro.
            Work_E = 26;
            if(Work_C == 2) Work_E = 52;
            else if(Work_C == 3) Work_E = 39;
            if(Wz_SubCursor == Work_D) print(2, Work_E, 0, 1, SCR_SEL[0]);
            print(10, Work_E, 0, 1, GTL_MODO_L[0]);
            // v7i: em x=75 o FINALIZA (8 chars) terminava em 131 e o "A" saia da tela.
            // Todos os valores desta tela foram para x=68, para ficarem alinhados entre si.
            if((Wz_Fin >> Gatilho_Idx(Work_C)) & 1) print(68, Work_E, 0, 1, GTL_FIN[0]);
            else                                    print(68, Work_E, 0, 1, GTL_ALT[0]);
        }
        if(Work_C == 2) {
            // v7i: rotulo e valor estavam em y=41 e o cursor em y=39 — a linha do
            // APOS/ATE ficava deslocada das outras (13/26/39/52) e o cursor parecia
            // apontar para o lugar errado. Tudo alinhado em 39.
            if(Wz_SubCursor == 2) print(2, 39, 0, 1, SCR_SEL[0]);
            print(10, 39, 0, 1, HOLD_MD_L[0]);
            if(Wz_Gatilho_Hold_Modo) print(68, 39, 0, 1, HOLD_MD_ATE[0]);
            else                     print(68, 39, 0, 1, HOLD_MD_AP[0]);
        }
        // v7: sem rodape — com quatro linhas nao ha espaco, e as instrucoes sao as
        // mesmas de todas as outras telas.
        return;
    }
    //----------------------------------------------------------
    // TIPO v3 (MenuDin=104, Seção 5)
    //----------------------------------------------------------
    if(MenuDin == 104) {
        print(5, 2, 0, 1, DST_TIPO_L[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        rect_oled(0, 18, 128, 20, 0, 1);
        if(Wz_Tipo == DST_TIPO_DIRECT) print(30, 22, 1, 1, DST_DIRECT[0]);
        if(Wz_Tipo == DST_TIPO_ESTATC) print(30, 22, 1, 1, DST_ESTATC[0]);
        if(Wz_Tipo == DST_TIPO_TURBO)  print(35, 22, 1, 1, DST_TURBO[0]);
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // DESTINO v3 (MenuDin=105, Seção 5) — lista rolável, adapta por Wz_Tipo
    //----------------------------------------------------------
    if(MenuDin == 105) {
        print(5, 2, 0, 1, LBL_DEST[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        if(Wz_Tipo == DST_TIPO_TURBO) {
            Print_Turbo_Dst_Row(Wz_ScrTop,     ROW0_Y);
            Print_Turbo_Dst_Row(Wz_ScrTop + 1, ROW1_Y);
            if(Wz_ScrTop > 0)  print(120, 14, 0, 1, SCR_UP[0]);   // v3zj: era 13, colava na linha do cabecalho
            if(Wz_ScrTop + 2 <= 10) print(120, FOOTER_Y, 0, 1, SCR_DN[0]);
        } else {
            // v3zr: quatro linhas fixas, sem rolagem. Fonte 0 e rotulo curto (D1..D4)
            // para o nome do destino nao encostar no valor — TRIANGLE e o mais longo.
            // v3zt: quatro linhas em 14/26/38/50. A ultima vai ate ~60, o que so cabe
            // porque esta tela NAO desenha o rodape — e a unica com 4 linhas, e as
            // instrucoes (LT/RT X_OK O_SAI) sao as mesmas de todas as outras telas.
            Print_Dst4_Row(0, 14);
            Print_Dst4_Row(1, 26);
            Print_Dst4_Row(2, 38);
            Print_Dst4_Row(3, 50);
            return;
        }
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // MODs v3 (MenuDin=106, Seção 6/7/8) — título muda por Wz_Mod_Tipo
    //----------------------------------------------------------
    if(MenuDin == 106) {
        if(Wz_Mod_Tipo == 0) print(5, 2, 0, 1, MOD_EXCL_L[0]);
        if(Wz_Mod_Tipo == 1) print(5, 2, 0, 1, MOD_ASSOC_L[0]);
        if(Wz_Mod_Tipo == 2) print(5, 2, 0, 1, MOD_BLOQ_L[0]);
        Print_Inst_Label(WzSlot, 78, 2);   // v3zn: era 85, unico fora do alinhamento geral
        rect_oled(0, 11, 128, 1, 0, 1);
        if(Total_Inst <= 1) {
            print(18, 22, 0, 1, MOD_SEM_L[0]);   // v3zn: deslocado a direita p/ centrar melhor
        } else {
            Print_Mod_Row_v3(Wz_ScrTop,     ROW0_Y);
            Print_Mod_Row_v3(Wz_ScrTop + 1, ROW1_Y);
            if(Wz_ScrTop > 0) print(120, 14, 0, 1, SCR_UP[0]);   // v3zj: era 13, colava na linha do cabecalho
            if(Wz_ScrTop + 2 <= Total_Inst - 2) print(120, FOOTER_Y, 0, 1, SCR_DN[0]);
        }
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // HIMDs v3 (MenuDin=107, Seção 6/7/8) — lista MOD_EXCL/ASSOC/BLOQ, "*" se configurado
    //----------------------------------------------------------
    if(MenuDin == 107) {
        print(5, 2, 0, 1, HIMDS_L[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        // v3zn: eram 15/30/45. A terceira linha (MOD_BLOQ) ia ate ~55 e era cortada pelo
        // rodape, que desceu para 52 na v3zj. Vao reduzido de 15 para 13px.
        Print_Himds_Lista_Row(0, 14);
        Print_Himds_Lista_Row(1, 27);
        Print_Himds_Lista_Row(2, 40);
        print(5, FOOTER_Y, 0, 1, NAV_FN[0]);
        return;
    }
    //----------------------------------------------------------
    // PERFIL_HAB (MenuDin=36)
    //----------------------------------------------------------
    if(MenuDin == 36) {
        print(5, 2, 0, 1, WZ_PERFIS[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        if(Wz_SubCursor <= 1) {
            if(Wz_SubCursor == 0) rect_oled(0, PERF_ROW0_Y - 2, 128, 18, 0, 1);
            print(10, PERF_ROW0_Y - 3, 1, 1, LBL_S1[0]);
            if(Wz_S1) print(60, PERF_ROW0_Y - 3, 1, 1, VAL_ON[0]);
            else      print(60, PERF_ROW0_Y - 3, 1, 1, VAL_OFF[0]);
            if(Wz_SubCursor == 1) rect_oled(0, PERF_ROW1_Y - 2, 128, 18, 0, 1);
            print(10, PERF_ROW1_Y - 3, 1, 1, LBL_S2[0]);
            if(Wz_S2) print(60, PERF_ROW1_Y - 3, 1, 1, VAL_ON[0]);
            else      print(60, PERF_ROW1_Y - 3, 1, 1, VAL_OFF[0]);
            print(120, FOOTER_Y, 0, 1, SCR_DN[0]);
        } else {
            if(Wz_SubCursor == 2) rect_oled(0, PERF_ROW0_Y - 2, 128, 18, 0, 1);
            print(10, PERF_ROW0_Y - 3, 1, 1, LBL_S3[0]);
            if(Wz_S3) print(60, PERF_ROW0_Y - 3, 1, 1, VAL_ON[0]);
            else      print(60, PERF_ROW0_Y - 3, 1, 1, VAL_OFF[0]);
            if(Wz_SubCursor == 3) rect_oled(0, PERF_ROW1_Y - 2, 128, 18, 0, 1);
            print(10, PERF_ROW1_Y - 3, 1, 1, LBL_S4[0]);
            if(Wz_S4) print(60, PERF_ROW1_Y - 3, 1, 1, VAL_ON[0]);
            else      print(60, PERF_ROW1_Y - 3, 1, 1, VAL_OFF[0]);
            print(120, 2, 0, 1, SCR_UP[0]);
        }
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // CONFIRMAÇÃO DE DELEÇÃO (MenuDin=38)
    //----------------------------------------------------------
    if(MenuDin == MENUDIN_DEL_CONF) {
        print(5, 2, 0, 1, DEL_CONF[0]);
        Print_Inst_Label(Del_Slot, 70, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        // Indicador EEP ou RAM
        if(Del_Slot <= MAX_INST_EEP) print(5, 18, 0, 1, DS_EEP[0]);
        else                         print(5, 18, 0, 1, DS_RAM[0]);
        print(5, 35, 1, 1, DEL_SIM[0]);
        print(5, FOOTER_Y, 0, 1, DEL_AVISO[0]);
        return;
    }
    //----------------------------------------------------------
    // CONFIRMAR (MenuDin=37)
    //----------------------------------------------------------
    if(MenuDin == 37) {
        print(5, 2, 0, 1, WZ_CONFIRM[0]);
        Print_Inst_Label(WzSlot, 78, 2);
        rect_oled(0, 11, 128, 1, 0, 1);
        if(WzSlot <= MAX_INST_EEP) {
            print(5, 20, 0, 1, WZ_SAVE[0]);
            print(5, 32, 0, 1, DS_EEP[0]);
        } else {
            print(5, 20, 0, 1, DS_RAM[0]);
        }
        print(5, FOOTER_Y, 0, 1, NAV_WZ[0]);
        return;
    }
    //----------------------------------------------------------
    // Estado normal (MenuDin=0)
    //----------------------------------------------------------
    // O menu de status era uma tela de uma linha so. Agora ela diz tambem QUAL build
    // esta rodando neste aparelho — a informacao que faltava no dia em que a duvida era
    // se o app do notebook havia atualizado antes de gerar os scripts.
    if(MenuLevel > 0) {
        print(5, 10, 1, 1, MENU_TITLE[0]);
        print(5, 36, 0, 1, DS_VERSAO[0]);
        return;
    }
    if(CurrentMode == 0) {
        print(20,  5, 0, 1, GAME_NAME_1[0]);
        print(20, 20, 0, 1, GAME_NAME_2[0]);
        print(20, 35, 0, 1, GAME_NAME_3[0]);
        print(20, 50, 0, 1, GAME_NAME_4[0]);
    }
    if(CurrentMode == 1) print(12, 25, 1, 1, MODE_S1[0]);
    if(CurrentMode == 2) print(12, 25, 1, 1, MODE_S2[0]);
    if(CurrentMode == 3) print(12, 25, 1, 1, MODE_S3[0]);
    if(CurrentMode == 4) print(12, 25, 1, 1, MODE_S4[0]);
}
// Imprime uma linha da lista de instâncias
// idx = índice 0-based. Se idx == Total_Inst e Total_Inst < MAX_INST → mostra [+]
function Print_Inst_Row(idx, x, y) {
    if(idx == Total_Inst && Total_Inst < MAX_INST) {
        print(x, y, 1, 1, DS_NOVO[0]);
        return;
    }
    if(idx >= Total_Inst) return; // linha vazia
    // v3z7: label + indicador de ESTADO (era faixa de slot, que nao dizia nada util).
    // Prioridade R sobre E: uma instancia salva e depois alterada precisa avisar que ha
    // mudanca pendente — essa e a informacao acionavel. Default nao imprime nada: a
    // ausencia ja comunica "intocada", e um terceiro simbolo so poluiria a linha.
    Print_Inst_Label(idx + 1, x, y);
    // v3zv: prioridade R > M > E. O R vem primeiro porque alteracao pendente e a
    // informacao acionavel; o M antes do E porque "gravado sem voce pedir" merece ser
    // distinguido de "salvo por voce".
    if((Cfg_Ram >> idx) & 1)         print(100, y, 0, 1, IND_RAM[0]);
    else if((Cfg_Mov >> idx) & 1)    print(100, y, 0, 1, IND_MOV[0]);
    else if((Cfg_Salvo >> idx) & 1)  print(100, y, 0, 1, IND_EEP[0]);
}
// Imprime label da instância pelo número 1-based
