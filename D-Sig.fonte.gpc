// =============================================================
// SEÇÃO 16B — AUXILIARES DO DESENHO
// =============================================================
// Imprime uma linha de modificador do EIXO_X (idx 0-4) com rolagem
// 0=MULT 1=THRESH_IN 2=THRESH_OUT 3=DIR 4=INV
// Linha de condicional da FONTE ÚNICA v3 (idx 0-4, campos variam por categoria).
// categoria: CAT_EIXO mostra DIR no idx 3 e INV no idx 4; CAT_GATILHO pula DIR, INV no idx 3.
function Print_Cond_Row(idx, y, categoria) {
    if(idx == 0) {
        if(idx == Wz_SubCursor) rect_oled(0, y - 2, 128, 18, 0, 1);
        print(3, y, 1, 1, F1_MULT_LBL[0]);
        Print_Mult_Label(82, y, Wz_Cond_Mult);
        return;
    }
    if(idx == 1) {
        if(idx == Wz_SubCursor) rect_oled(0, y - 2, 128, 18, 0, 1);
        print(3, y, 1, 1, F1_TIN_LBL[0]);
        Print_Thresh_Val(95, y, Wz_Cond_ThrIn);
        return;
    }
    if(idx == 2) {
        if(idx == Wz_SubCursor) rect_oled(0, y - 2, 128, 18, 0, 1);
        print(3, y, 1, 1, F1_TOUT_LBL[0]);
        if(Wz_Cond_ThrOut == 0) print(95, y, 1, 1, TAIL_OFF[0]);
        else                    Print_Thresh_Val(95, y, Wz_Cond_ThrOut);
        return;
    }
    // v3ze: o DIR virou o ULTIMO campo e ganhou return proprio. Com isso a funcao deixa
    // de terminar em fallthrough — era ele que, com um indice fora de faixa, desenhava o
    // INV duas vezes (o bug da v3z7). Agora indice invalido simplesmente nao desenha nada.
    if(idx == 3 && categoria == CAT_EIXO) {
        if(idx == Wz_SubCursor) rect_oled(0, y - 2, 128, 18, 0, 1);
        print(3, y, 1, 1, F1_DIR_LBL[0]);
        if(Wz_Cond_Dir == 0) print(89, y, 1, 1, F1_DIR_NEG[0]);
        if(Wz_Cond_Dir == 1) print(89, y, 1, 1, F1_DIR_ABS[0]);
        if(Wz_Cond_Dir == 2) print(89, y, 1, 1, F1_DIR_POS[0]);
    }
}
// Imprime uma linha de modificador do EIXO_Y (idx 0-4) com rolagem
// Imprime tempo do gatilho HPHOLD (índice 0-10 → 1.5-2.5s)
// Lista de instâncias de um MOD: 2 linhas ao redor do cursor.
// Cada linha: [X]/[ ] + INTRS_NN + (ATIVO/PASSIVO se marcada)
// sel = máscara de seleção, modo = máscara de modo
// Uma linha da lista de MOD. foco=1 mostra ">". inst=0 → nada.
// Imprime TAIL_TIME (0=OFF, 1-25 → 0.1-2.5s passo 0.1)
// Imprime décimos de segundo no formato "N.Ns" (idx 1-25 → 0.1-2.5)
// Reaproveitado por TAIL e outros tempos em décimos
// Imprime número da página (0→"1/2" 1→"2/2")
// Imprime uma linha de botão (página pg, linha 0 ou 1)
// row 0 mostra botão (pg*8 + Wz_SubCursor se foco) — usa rolagem de 2
// Aqui mostramos 2 botões por vez: idx_base = Wz_SubCursor ancorado
// Simplificação: mostra botões Wz_SubCursor e Wz_SubCursor+1 da página
// Uma linha de botão na lista rolável (gatilho e BTN_FN).
// idx = índice do item (0-15 botões, 16=NATIVO). maxidx = último índice válido.
// Foco (">" ) quando idx == Wz_SubCursor. Sem destaque.
// Nome do destino por índice (0-14): L1 L2 L3 R1 R2 R3 CROSS CIRCLE SQUARE TRIANGLE TOUCH LX LY RX RY
function Print_Dst_Label(x, y, idx) {
    if(idx ==  0) print(x, y, 0, 1, DST_L1[0]);
    if(idx ==  1) print(x, y, 0, 1, DST_L2[0]);
    if(idx ==  2) print(x, y, 0, 1, DST_L3[0]);
    if(idx ==  3) print(x, y, 0, 1, DST_R1[0]);
    if(idx ==  4) print(x, y, 0, 1, DST_R2[0]);
    if(idx ==  5) print(x, y, 0, 1, DST_R3[0]);
    if(idx ==  6) print(x, y, 0, 1, DST_CRS[0]);
    if(idx ==  7) print(x, y, 0, 1, DST_CIR[0]);
    if(idx ==  8) print(x, y, 0, 1, DST_SQU[0]);
    if(idx ==  9) print(x, y, 0, 1, DST_TRI[0]);
    if(idx == 10) print(x, y, 0, 1, DST_LX_S[0]);
    if(idx == 11) print(x, y, 0, 1, DST_LY_S[0]);
    if(idx == 12) print(x, y, 0, 1, DST_RX_S[0]);
    if(idx == 13) print(x, y, 0, 1, DST_RY_S[0]);
    if(idx == 14) print(x, y, 0, 1, BTN_UP[0]);
    if(idx == 15) print(x, y, 0, 1, BTN_DN[0]);
    if(idx == 16) print(x, y, 0, 1, BTN_LT[0]);
    if(idx == 17) print(x, y, 0, 1, BTN_RT[0]);
}
// Linha da lista de destinos (rolável). idx 0-14. Foco por ">". mask = destino atual
// Linha da lista do TURBO (tela 17): idx 0=PERM 1=LAT 2=MODO 3-16=destinos (bit idx-3)
// Valor do CICLOS: 0=ATIVO (enquanto ativo), 1-10 = número de oscilações
function Print_Cic_Val(x, y, idx) {
    if(idx == 0)  print(x, y, 0, 1, CIC_ATV[0]);
    if(idx == 1)  print(x, y, 0, 1, CIC_1[0]);
    if(idx == 2)  print(x, y, 0, 1, CIC_2[0]);
    if(idx == 3)  print(x, y, 0, 1, CIC_3[0]);
    if(idx == 4)  print(x, y, 0, 1, CIC_4[0]);
    if(idx == 5)  print(x, y, 0, 1, CIC_5[0]);
    if(idx == 6)  print(x, y, 0, 1, CIC_6[0]);
