// v7m: RESTO DA ESPERA do combo. O timer do TrbSt tem 11 bits (ate 2047ms), e ate a v7l a
// espera maior que isso era simplesmente CORTADA — tres passos vazios de 1s davam 2,047s em
// vez de 3s (o Daniel pegou no C11c). Agora o que passa de 2047 fica guardado aqui e o timer
// e recarregado em fatias, sem sair da fase. E RAM, nao gasta bit de EEPROM.
int Esx_01=0; int Esx_02=0; int Esx_03=0; int Esx_04=0; int Esx_05=0; int Esx_06=0; int Esx_07=0; int Esx_08=0; int Esx_09=0; int Esx_10=0; int Esx_11=0;
