    if(num==21) DS_C_21 = val;
}
// =============================================================
// SEÇÃO 15B — CAMPOS DA CONFIGURACAO: GETTERS E SETTERS
// Operam diretamente sobre Get/Set_Spvar_A e _B (persistente).
// Substituem F1X_*/F1Y_*/F2_* — remoção do antigo ocorre quando a
// execução (V3-c+) parar de depender dele.
// =============================================================
// [v3za REMOVIDAS: Get_Fonte_Relig / Set_Fonte_Relig — RELIG da fonte deu lugar ao INIC]
function Get_Fonte_Tipo(num) {
    if(num == Spv_N) { return (Spv_A >> SHIFT_FONTE_TIPO) & 0x1F; }   // v7l: MOD em execucao
    return (Get_Spvar_A(num) >> SHIFT_FONTE_TIPO) & 0x1F;
}
function Set_Fonte_Tipo(num, v) {
    Work_A = Get_Spvar_A(num) & (~(0x1F << SHIFT_FONTE_TIPO));
    Work_A = Work_A | ((v & 0x1F) << SHIFT_FONTE_TIPO);
    Set_Spvar_A(num, Work_A);
}
function Get_Fonte_Passivo(num) {
    if(num == Spv_N) { return (Spv_A >> SHIFT_FONTE_PASSIVO) & 1; }   // v7l: MOD em execucao
    return (Get_Spvar_A(num) >> SHIFT_FONTE_PASSIVO) & 1;
}
function Set_Fonte_Passivo(num, v) {
    Work_A = Get_Spvar_A(num) & (~(1 << SHIFT_FONTE_PASSIVO));
    if(v) Work_A = Work_A | (1 << SHIFT_FONTE_PASSIVO);
    Set_Spvar_A(num, Work_A);
}
// Categoria da fonte (determina quais condicionais mostrar/aplicar) — tipo é o
// valor FONTE_*, não o número da instância.
function Get_Fonte_Categoria(tipo) {
    if(tipo == FONTE_FINGER_X || tipo == FONTE_FINGER_Y) return CAT_TOUCH;
    if(tipo == FONTE_LX || tipo == FONTE_LY || tipo == FONTE_RX || tipo == FONTE_RY) return CAT_EIXO;
    if(tipo == FONTE_L2 || tipo == FONTE_R2) return CAT_GATILHO;
    // FONTE_NENHUMA cai aqui junto com os botões: sem condicionais, R1 pula direto pro
    // GATILHO. Coerente — sem fonte não há valor a condicionar.
    return CAT_BOTAO;
}
// --- Condicionais (SPVAR_B) ---
// v3z8: MULT, DIR e INV vivem empacotados em 7 bits — pack = (MULT*3 + DIR)*2 + INV.
// Cada getter extrai so o seu campo; cada setter le o pack, troca o campo e regrava.
// Divisao inteira e o suficiente, sem tabela: DIR e o resto por 3 e INV o resto por 2.
// v3z9 CORRIGIDO: estes getters usavam Work_B. Executar_Turbo_Fonte guarda o ESTADO da
// maquina do TURBO em Work_B e o passa a Trb_Valor_Eixo — mas entre uma coisa e outra
// chama Trb_Aplicar_Cond, que chama Get_Cond_Mult/Inv. O estado do TURBO era destruido
// no meio do caminho e o destino de EIXO recebia lixo (ficava presO num valor em vez de
// oscilar). O destino DIGITAL escapava porque e escrito ANTES da corrupcao, e a fonte de
// BOTAO tambem, porque Trb_Aplicar_Cond retorna cedo em CAT_BOTAO sem chegar nos getters
// — que e precisamente a assimetria observada no teste. Agora usam Cond_Tmp, dedicada.
function Get_Cond_Mult(num) {
    if(num == Spv_N) { Cond_Tmp = (Spv_B >> SHIFT_COND_PACK) & 0x3F; return Cond_Tmp / 3; }   // v7l: MOD em execucao
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_PACK) & 0x3F;
    return Cond_Tmp / 3;
}
function Set_Cond_Mult(num, v) {
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_PACK) & 0x3F;
    Cond_Tmp = (v & 0x1F) * 3 + (Cond_Tmp - ((Cond_Tmp / 3) * 3));
    Work_A = Get_Spvar_B(num) & (~(0x3F << SHIFT_COND_PACK));
    Set_Spvar_B(num, Work_A | ((Cond_Tmp & 0x3F) << SHIFT_COND_PACK));
}
// v3zb: os dois thresholds vivem em 9 bits — pack = THR_IN * 20 + THR_OUT.
// Cond_Tmp e a mesma variavel dedicada do pack MULT/DIR/INV, e nao colide: os getters
// terminam antes de qualquer outro uso dela.
function Get_Cond_ThrIn(num) {
    if(num == Spv_N) { Cond_Tmp = (Spv_B >> SHIFT_COND_THR) & 0x1FF; return Cond_Tmp / 20; }   // v7l: MOD em execucao
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_THR) & 0x1FF;
    return Cond_Tmp / 20;
}
function Set_Cond_ThrIn(num, v) {
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_THR) & 0x1FF;
    Cond_Tmp = (v & 0x1F) * 20 + (Cond_Tmp - ((Cond_Tmp / 20) * 20));
    Work_A = Get_Spvar_B(num) & (~(0x1FF << SHIFT_COND_THR));
    Set_Spvar_B(num, Work_A | ((Cond_Tmp & 0x1FF) << SHIFT_COND_THR));
}
function Get_Cond_ThrOut(num) {
    if(num == Spv_N) { Cond_Tmp = (Spv_B >> SHIFT_COND_THR) & 0x1FF; return Cond_Tmp - ((Cond_Tmp / 20) * 20); }   // v7l: MOD em execucao
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_THR) & 0x1FF;
    return Cond_Tmp - ((Cond_Tmp / 20) * 20);
}
function Set_Cond_ThrOut(num, v) {
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_THR) & 0x1FF;
    Cond_Tmp = ((Cond_Tmp / 20) * 20) + (v & 0x1F);
    Work_A = Get_Spvar_B(num) & (~(0x1FF << SHIFT_COND_THR));
    Set_Spvar_B(num, Work_A | ((Cond_Tmp & 0x1FF) << SHIFT_COND_THR));
}
function Get_Cond_Dir(num) {
    if(num == Spv_N) { Cond_Tmp = (Spv_B >> SHIFT_COND_PACK) & 0x3F; return Cond_Tmp - ((Cond_Tmp / 3) * 3); }   // v7l: MOD em execucao
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_PACK) & 0x3F;
    return Cond_Tmp - ((Cond_Tmp / 3) * 3);
}
function Set_Cond_Dir(num, v) {
    Cond_Tmp = (Get_Spvar_B(num) >> SHIFT_COND_PACK) & 0x3F;
    Cond_Tmp = ((Cond_Tmp / 3) * 3) + (v & 0x3);
    Work_A = Get_Spvar_B(num) & (~(0x3F << SHIFT_COND_PACK));
    Set_Spvar_B(num, Work_A | ((Cond_Tmp & 0x3F) << SHIFT_COND_PACK));
}
// v3z8: MODO do BTN_HOLD — 0=APOS (valida quando o tempo e ULTRAPASSADO, comportamento
// classico), 1=ATE (valida quando o botao e SOLTO ANTES do tempo — o toque curto).
// Os dois sao mutuamente excludentes por construcao: segurou demais, o ATE ja perdeu a
// janela; soltou cedo, o APOS nunca chegou ao tempo. Por isso dois MODs no MESMO botao,
// um de cada modo, nunca disparam juntos — e e assim que um botao vira dois comandos.
function Get_Hold_Modo(num) {
    if(num == Spv_N) { return (Spv_B >> BIT_HOLD_MODO) & 1; }   // v7l: MOD em execucao
 return (Get_Spvar_B(num) >> BIT_HOLD_MODO) & 1; 
}
function Set_Hold_Modo(num, v) {
    Work_A = Get_Spvar_B(num) & (~(1 << BIT_HOLD_MODO));
    if(v) Work_A = Work_A | (1 << BIT_HOLD_MODO);
    Set_Spvar_B(num, Work_A);
}
// ===== V3-g (dados): TURBO — bits reservados desde V3-e (SPVAR_B 30-31, SPVAR_C 20-31) =====
// ===== v3ze: TURBO/COMBO — o TIPO TURBO passou a interpretar o campo DESTINO como uma
// SEQUENCIA DE ATE 4 PASSOS, cada um com um destino unico e uma duracao propria.
// DIRECT e ESTATC continuam lendo o mesmo campo como MASCARA de 18 destinos — quem muda
// a leitura e o DST_TIPO. Foi isso que liberou os 18 bits necessarios.
//   destinos: pack de 4 x 19 valores (0=nenhum, 1-18) = 130321 -> 17 bits, no campo DST
//   tempos:   pack de 4 x 8 valores = 4096 -> 12 bits, distribuidos em 3 pedacos
// O PERM global deixou de existir: cada passo carrega o seu tempo. LAT continua (silencio
// ENTRE passos) e CICLOS continua (agora conta SEQUENCIAS completas, nao pulsos).
function Get_Turbo_Lat(num) { if(num == Spv_N) { return (Spv_C >> 18) & 0xF; } return (Get_Spvar_C(num) >> 18) & 0xF; }   // v3zr: 4 bits
function Set_Turbo_Lat(num, v) {
    Work_A = Get_Spvar_C(num) & (~(0xF << 18));
    Set_Spvar_C(num, Work_A | ((v & 0xF) << 18));
}
function Get_Turbo_Ciclos(num) { if(num == Spv_N) { return (Spv_C >> 22) & 0x7; } return (Get_Spvar_C(num) >> 22) & 0x7; }   // v3zr: 3 bits
function Set_Turbo_Ciclos(num, v) {
    Work_A = Get_Spvar_C(num) & (~(0x7 << 22));
    Set_Spvar_C(num, Work_A | ((v & 0x7) << 22));
}
// v3ze: os 4 DESTINOS do combo vivem empacotados nos 17 bits baixos do campo DST.
// pack = ((((d4 * 19) + d3) * 19 + d2) * 19) + d1   com d = 0 (nenhum) ou 1-18.
// v3zr: monta a MASCARA equivalente aos 4 destinos. Existe para que Escrever_Destino,
// Estatc_Escrever_Dst e todo o resto do pipeline continuem recebendo o que ja sabem
// tratar — a mudanca de formato fica contida aqui, sem tocar na execucao.
// Um unpack so, em vez de quatro chamadas a Get_Combo_Dst.
function Dst_Mask(num) {
    Cmb_Tmp = (Get_Spvar_A(num) >> SHIFT_F1_DST) & 0x1FFFF;
    Cmb_D1 = Cmb_Tmp - ((Cmb_Tmp / 19) * 19);
    Cmb_D2 = (Cmb_Tmp / 19) - ((Cmb_Tmp / 361) * 19);
    Cmb_D3 = (Cmb_Tmp / 361) - ((Cmb_Tmp / 6859) * 19);
    Cmb_D4 = Cmb_Tmp / 6859;
    Cmb_N = 0;
    if(Cmb_D1) Cmb_N = Cmb_N | (1 << (Cmb_D1 - 1));
    if(Cmb_D2) Cmb_N = Cmb_N | (1 << (Cmb_D2 - 1));
    if(Cmb_D3) Cmb_N = Cmb_N | (1 << (Cmb_D3 - 1));
    if(Cmb_D4) Cmb_N = Cmb_N | (1 << (Cmb_D4 - 1));
    return Cmb_N;
}
function Get_Combo_Dst(num, passo) {
    Cmb_Tmp = (Get_Spvar_A(num) >> SHIFT_F1_DST) & 0x1FFFF;
    if(passo == 2) Cmb_Tmp = Cmb_Tmp / 19;
    if(passo == 3) Cmb_Tmp = Cmb_Tmp / 361;
    if(passo == 4) return Cmb_Tmp / 6859;
    return Cmb_Tmp - ((Cmb_Tmp / 19) * 19);
}
function Set_Combo_Dst(num, passo, v) {
    Cmb_Tmp = (Get_Spvar_A(num) >> SHIFT_F1_DST) & 0x1FFFF;
    Cmb_D1 = Cmb_Tmp - ((Cmb_Tmp / 19) * 19);
    Cmb_D2 = (Cmb_Tmp / 19) - ((Cmb_Tmp / 361) * 19);
    Cmb_D3 = (Cmb_Tmp / 361) - ((Cmb_Tmp / 6859) * 19);
    Cmb_D4 = Cmb_Tmp / 6859;
    if(passo == 1) Cmb_D1 = v;
    if(passo == 2) Cmb_D2 = v;
    if(passo == 3) Cmb_D3 = v;
    if(passo == 4) Cmb_D4 = v;
    Cmb_Tmp = ((((Cmb_D4 * 19) + Cmb_D3) * 19 + Cmb_D2) * 19) + Cmb_D1;
    Work_A = Get_Spvar_A(num) & (~(0x1FFFF << SHIFT_F1_DST));
    Set_Spvar_A(num, Work_A | ((Cmb_Tmp & 0x1FFFF) << SHIFT_F1_DST));
}
// v3ze: os 4 TEMPOS ficam num pack de 12 bits (8^4 = 4096) que nao cabe inteiro em lugar
// nenhum — vive repartido em tres pedacos. Encapsulado aqui para que o resto do script
// nunca precise saber disso:
//   bits 0-6  -> SPVAR_C 25-31        bits 7-9 -> SPVAR_B 29-31
//   bits 10-11-> SPVAR_A 30-31  (o bit 30 e o 18o do campo DST, livre so no TURBO)
function Get_Combo_TmpPack(num) {
    Cmb_Tmp = (Get_Spvar_C(num) >> 25) & 0x7F;
    Cmb_Tmp = Cmb_Tmp | (((Get_Spvar_B(num) >> 29) & 0x7) << 7);
    Cmb_Tmp = Cmb_Tmp | (((Get_Spvar_A(num) >> 30) & 0x3) << 10);
    return Cmb_Tmp;
}
function Set_Combo_TmpPack(num, v) {
    Work_A = Get_Spvar_C(num) & (~(0x7F << 25));
    Set_Spvar_C(num, Work_A | ((v & 0x7F) << 25));
    Work_A = Get_Spvar_B(num) & (~(0x7 << 29));
    Set_Spvar_B(num, Work_A | (((v >> 7) & 0x7) << 29));
    Work_A = Get_Spvar_A(num) & (~(0x3 << 30));
    Set_Spvar_A(num, Work_A | (((v >> 10) & 0x3) << 30));
}
function Get_Combo_Tmp(num, passo) {
    Cmb_Tmp = Get_Combo_TmpPack(num);
    if(passo == 2) Cmb_Tmp = Cmb_Tmp / 8;
    if(passo == 3) Cmb_Tmp = Cmb_Tmp / 64;
    if(passo == 4) return Cmb_Tmp / 512;
    return Cmb_Tmp - ((Cmb_Tmp / 8) * 8);
}
function Set_Combo_Tmp(num, passo, v) {
    Cmb_Tmp = Get_Combo_TmpPack(num);
    Cmb_D1 = Cmb_Tmp - ((Cmb_Tmp / 8) * 8);
    Cmb_D2 = (Cmb_Tmp / 8) - ((Cmb_Tmp / 64) * 8);
    Cmb_D3 = (Cmb_Tmp / 64) - ((Cmb_Tmp / 512) * 8);
    Cmb_D4 = Cmb_Tmp / 512;
    if(passo == 1) Cmb_D1 = v;
    if(passo == 2) Cmb_D2 = v;
    if(passo == 3) Cmb_D3 = v;
    if(passo == 4) Cmb_D4 = v;
    Set_Combo_TmpPack(num, ((((Cmb_D4 * 8) + Cmb_D3) * 8 + Cmb_D2) * 8) + Cmb_D1);
}
// v3ze: proximo passo COM destino, a partir de "de" (1-4). Devolve 0 se nao houver outro —
// e o sinal de que a sequencia terminou e o ciclo deve ser contabilizado.
// v6 ESPERA POR ACUMULO (proposta do Daniel). Os passos VAZIOS antes do primeiro
// configurado deixam de ser simplesmente pulados: os tempos deles SOMAM e viram uma
// espera antes da sequencia comecar.
//   P1 vazio(250ms) + P2 CROSS            -> espera 250ms, aciona CROSS
//   P1 vazio(500) + P2 vazio(1000) + P3   -> espera 1500ms, aciona P3
// Custo zero: cada passo ja carrega o seu tempo no pack de 12 bits, mesmo sem destino.
// O tempo estava la, sem uso — agora tem significado.
// Alcance ate 2,5s, com a granularidade da tabela dos passos — bem mais fino que o
// campo DELAY, que tem quatro valores fixos. Os dois convivem: o DELAY atrasa a
// RESPOSTA INTEIRA (vale para os tres tipos); a espera atrasa DENTRO da sequencia.
// v7i CORRIGIDO — COLISAO DE VARIAVEL. O laco usava Cmb_Tmp como contador, e
// Get_Combo_Tmp usa a MESMA variavel como rascunho do unpack: a cada chamada o contador
// era sobrescrito pelo pack de tempos. O laco passava a iterar sobre lixo, somando os
// tempos errados — o Daniel cronometrou 1s virando quase 2s.
// Contador e acumulador agora sao dedicados (Esp_I, Esp_N) e nenhuma funcao chamada
// aqui dentro os toca. Cmb_N tambem saiu: Combo_Prox_Passo o usa.
function Combo_Espera(num, ate) {
    Esp_N = 0;
    Esp_I = 1;
    while(Esp_I < ate) {
        Esp_N = Esp_N + Trb_Tempo_Ms(Get_Combo_Tmp(num, Esp_I));
        Esp_I = Esp_I + 1;
    }
    return Esp_N;   // v7m: sem corte — Trb_Prog_Espera fatia o que passa de 2047ms
}
function Combo_Prox_Passo(num, de) {
    Cmb_N = de;
    while(Cmb_N < 4) {
        Cmb_N = Cmb_N + 1;
        if(Get_Combo_Dst(num, Cmb_N)) return Cmb_N;
    }
    return 0;
}
// v7j: soma os tempos dos passos VAZIOS entre 'de' (exclusive) e o proximo configurado.
// Ate aqui esses passos eram simplesmente pulados e o tempo deles ficava sem uso — a
// proposta do Daniel foi transforma-lo em LATENCIA ADICIONAL naquele ponto da sequencia.
//   P1 CIRCLE | P2 vazio(250ms) | P3 TRIANGLE  ->  CIRCLE, pausa de LAT+250, TRIANGLE
// Com a latencia global em "---", o tempo do passo vazio vira a UNICA pausa ali — e
// cada intervalo da sequencia passa a poder ter a sua.
// Custo: nenhum bit. O tempo ja estava gravado; so ganhou significado.
// Contador dedicado: Get_Combo_Tmp usa Cmb_Tmp por dentro (foi a colisao da v7i).
// v7k CORRIGIDO: so conta vazio que tenha um passo configurado DEPOIS dele. Na v7j os
// vazios do FIM da sequencia tambem entravam na soma — um turbo de um passo so ganhava
// a pausa de P2+P3+P4 (tempos que nem aparecem na tela) a cada volta. O app ja tratava
// os do fim como sem efeito; agora o script bate com ele.
function Combo_Lat_Extra(num, de) {
    Esp_N = 0;
    Esp_I = de;
    while(Esp_I < 4) {
        Esp_I = Esp_I + 1;
        if(Get_Combo_Dst(num, Esp_I)) return Esp_N;
        Esp_N = Esp_N + Trb_Tempo_Ms(Get_Combo_Tmp(num, Esp_I));
    }
    return 0;   // nenhum passo configurado adiante: vazios do fim nao geram pausa
}
function Get_Turbo_Modo(num) { if(num == Spv_N) { return (Spv_B >> 27) & 0x3; } return (Get_Spvar_B(num) >> 27) & 0x3; }   // v3ze
function Set_Turbo_Modo(num, v) {
    Work_A = Get_Spvar_B(num) & (~(0x3 << 27));
    Set_Spvar_B(num, Work_A | ((v & 0x3) << 27));
}
// --- Load/Commit do wizard (FONTE ÚNICA v3) ---
function Load_Wz_Fonte(num) {
    Wz_Fonte_Tipo    = Get_Fonte_Tipo(num);
    Wz_Fonte_Passivo = Get_Fonte_Passivo(num);
    Wz_Delay         = Get_Delay(num);
}
function Commit_Wz_Fonte(num) {
    Set_Fonte_Tipo(num,    Wz_Fonte_Tipo);
    Set_Fonte_Passivo(num, Wz_Fonte_Passivo);
    Set_Delay(num,         Wz_Delay);
}
function Load_Wz_Cond(num) {
    Wz_Cond_Mult   = Get_Cond_Mult(num);
    Wz_Cond_ThrIn  = Get_Cond_ThrIn(num);
    Wz_Cond_ThrOut = Get_Cond_ThrOut(num);
    Wz_Cond_Dir    = Get_Cond_Dir(num);
}
function Commit_Wz_Cond(num) {
    Set_Cond_Mult(num,   Wz_Cond_Mult);
    Set_Cond_ThrIn(num,  Wz_Cond_ThrIn);
    Set_Cond_ThrOut(num, Wz_Cond_ThrOut);
    Set_Cond_Dir(num,    Wz_Cond_Dir);
}
// --- Load/Commit do wizard (TIPO+DESTINO v3, Seção 5) ---
// v3zg: O ZERAMENTO ACONTECE NO COMMIT, comparando com o tipo GRAVADO — nunca durante
// a navegacao. Na v3zf ele estava no LEFT/RIGHT da lista de tipos, e isso era pior do que
// o problema original: a lista cicla DIRECT -> ESTATC -> TURBO -> DIRECT, entao ir de
// ESTATC para DIRECT PASSA pelo TURBO e a mascara morria no caminho.
// Comparar com o gravado cobre todos os caminhos de saida da tela (X, R1 e L1/CIRCLE
// chamam o commit) e ignora a passagem: so zera quem realmente MUDOU de leitura.
// Idempotente: na segunda chamada o gravado ja e o novo tipo e nada mais e zerado.
// v3zh: TRADUCAO mascara -> passos. Os quatro primeiros destinos marcados viram P1..P4.
// Usada so quando o espelho esta vazio, ou seja, na PRIMEIRA vez que a instancia entra
// no TURBO: em vez de comecar zerada, ela ja chega com o que estava marcado.
// Perde nas pontas de proposito — havendo mais de quatro marcados, os excedentes ficam
// de fora, porque o TURBO nao tem onde guarda-los.
// v3zh: TRADUCAO passos -> mascara. Cada passo com destino acende o bit correspondente.
function Load_Wz_Tipo(num) {
    Wz_Tipo     = Get_F1_Tipo(num);
    // v3ze: no TURBO o mesmo campo e lido como sequencia de passos, nao como mascara.
    Wz_Cmb_D1 = Get_Combo_Dst(num, 1); Wz_Cmb_T1 = Get_Combo_Tmp(num, 1);
    Wz_Cmb_D2 = Get_Combo_Dst(num, 2); Wz_Cmb_T2 = Get_Combo_Tmp(num, 2);
    Wz_Cmb_D3 = Get_Combo_Dst(num, 3); Wz_Cmb_T3 = Get_Combo_Tmp(num, 3);
    Wz_Cmb_D4 = Get_Combo_Dst(num, 4); Wz_Cmb_T4 = Get_Combo_Tmp(num, 4);
    Wz_Turbo_Lat   = Get_Turbo_Lat(num);
    Wz_Turbo_Modo  = Get_Turbo_Modo(num);
    Wz_Turbo_Ciclos= Get_Turbo_Ciclos(num);
}
function Commit_Wz_Tipo(num) {
    Set_F1_Tipo(num, Wz_Tipo);
    // v3ze: TURBO grava a sequencia; DIRECT/ESTATC gravam a mascara. Sao leituras
    // diferentes do MESMO campo — por isso a gravacao tambem precisa ser exclusiva.
    // v3zr: os 4 destinos valem para TODOS os tipos. Os tempos so importam ao TURBO,
    // mas gravar sempre e inofensivo e evita um ramo a mais.
    Set_Combo_Dst(num, 1, Wz_Cmb_D1); Set_Combo_Tmp(num, 1, Wz_Cmb_T1);
    Set_Combo_Dst(num, 2, Wz_Cmb_D2); Set_Combo_Tmp(num, 2, Wz_Cmb_T2);
    Set_Combo_Dst(num, 3, Wz_Cmb_D3); Set_Combo_Tmp(num, 3, Wz_Cmb_T3);
    Set_Combo_Dst(num, 4, Wz_Cmb_D4); Set_Combo_Tmp(num, 4, Wz_Cmb_T4);
    Set_Turbo_Lat(num,    Wz_Turbo_Lat);
    Set_Turbo_Modo(num,   Wz_Turbo_Modo);
    Set_Turbo_Ciclos(num, Wz_Turbo_Ciclos);
}
// --- Load/Commit do wizard (MODs v3, Seção 6/7/8 — tela compartilhada por Wz_Mod_Tipo) ---
function Load_Wz_Mod(tipo) {
    if(tipo == 0) Wz_Mod_Sel = Get_F1_Excl(WzSlot);
    else if(tipo == 1) Wz_Mod_Sel = Get_F1_Assoc(WzSlot);
    else Wz_Mod_Sel = Get_F1_Bloq(WzSlot);
}
function Commit_Wz_Mod(tipo) {
    if(tipo == 0) Set_F1_Excl(WzSlot, Wz_Mod_Sel);
    else if(tipo == 1) Set_F1_Assoc(WzSlot, Wz_Mod_Sel);
    else Set_F1_Bloq(WzSlot, Wz_Mod_Sel);
}
// Mapeia linha da lista (0-19) pra número real de instância, pulando a própria WzSlot —
// bit da máscara usa o número REAL da instância (Work_C - 1), não a posição da linha, pra
// bater com a reindexação que Ajust_Ref_Slot já faz na deleção.
function Mod_Row_To_Inst(row_idx) {
    Work_N = row_idx + 1;
    if(Work_N >= WzSlot) Work_N = Work_N + 1;
    return Work_N;
}
// --- Load/Commit do wizard (GATILHO+BTN_FN v3) ---
function Load_Wz_Gatilho(num) {
    Wz_Blok = Get_Blok(num);   // v7i: carregados aqui, junto com o resto do GAMA
    Wz_Fin  = Get_Fin(num);
    Wz_Gatilho_Hphold_Btn   = Get_Gatilho_Hphold_Btn(num);
    Wz_Gatilho_Hphold_Tempo = Get_Gatilho_Hphold_Tempo(num);
    Wz_Gatilho_Hold_Modo    = Get_Hold_Modo(num);
    Wz_Gatilho_Duplo_Btn    = Get_Gatilho_Duplo_Btn(num);
    Wz_Gatilho_Final_Btn    = Get_Gatilho_Final_Btn(num);
    Wz_Gatilho_FA_Btn       = Get_Gatilho_FinalAfter_Btn(num);
    Wz_Gatilho_FA_Tempo     = Get_FA_Tempo(num);
}
function Commit_Wz_Gatilho(num) {
    // v7i CORRIGIDO: o BLOK e o modo FINALIZA sao editados NESTA tela (GAMA), mas
    // estavam sendo gravados em Commit_Wz_Fonte, o commit da tela ALFA — que nunca roda
    // ao sair do GAMA. Resultado: a pessoa configurava, confirmava com X, e voltava
    // zerado. Foram seis testes falhando (B6 a B12) pela mesma causa.
    Set_Blok(num,                 Wz_Blok);
    Set_Fin(num,                  Wz_Fin);
    Set_Gatilho_Hphold_Btn(num,   Wz_Gatilho_Hphold_Btn);
    Set_Gatilho_Hphold_Tempo(num, Wz_Gatilho_Hphold_Tempo);
    Set_Hold_Modo(num,            Wz_Gatilho_Hold_Modo);
    Set_Gatilho_Duplo_Btn(num,    Wz_Gatilho_Duplo_Btn);
    Set_Gatilho_Final_Btn(num,    Wz_Gatilho_Final_Btn);
    Set_Gatilho_FinalAfter_Btn(num, Wz_Gatilho_FA_Btn);
    Set_FA_Tempo(num,             Wz_Gatilho_FA_Tempo);
}
