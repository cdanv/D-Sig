    if(idx ==  3) print(x, y, 1, 1, M_04[0]);
    if(idx ==  4) print(x, y, 1, 1, M_05[0]);
    if(idx ==  5) print(x, y, 1, 1, M_06[0]);
    if(idx ==  6) print(x, y, 1, 1, M_07[0]);
    if(idx ==  7) print(x, y, 1, 1, M_08[0]);
    if(idx ==  8) print(x, y, 1, 1, M_09[0]);
    if(idx ==  9) print(x, y, 1, 1, M_10[0]);
    if(idx == 10) print(x, y, 1, 1, M_11[0]);
    if(idx == 11) print(x, y, 1, 1, M_12[0]);
    if(idx == 12) print(x, y, 1, 1, M_13[0]);
    if(idx == 13) print(x, y, 1, 1, M_14[0]);
    if(idx == 14) print(x, y, 1, 1, M_15[0]);
    if(idx == 15) print(x, y, 1, 1, M_16[0]);
    if(idx == 16) print(x, y, 1, 1, M_17[0]);
    if(idx == 17) print(x, y, 1, 1, M_18[0]);
    if(idx == 18) print(x, y, 1, 1, M_19[0]);
}
// SEÇÃO 17 — AUXILIARES GERAIS
// =============================================================
// v3z: REST na troca de perfil. O gate de perfil do Run_Instance_v3 impede a instância de
// RODAR, mas não apaga o que ela já tinha: Inst_Ativa, a trava do ESTATC e o TrbSt ficam
// congelados. Ao voltar ao perfil, ela retomava de onde parou — destino já no alto, sem
// nenhum toque do usuário. Agora todo estado de execução volta ao ponto de partida (INIC).
// Config do usuário NÃO é tocada: Inicializar_Estado só mexe em estado volátil (a nota do
// bug 1 lá dentro documenta por que Set_GT_Relig/Set_FA_Cfg foram retirados de lá).
// As duas máscaras de anti-loop vão para "já disparado" em vez de zero — diferença crucial
// em relação ao boot: a troca de perfil é feita com L1+L3 / R1+R3, ou seja, COM um botão
// de ombro pressionado. Zerando o anti-loop, uma instância com BTN_HOLD ou TOGGLE nesse
// mesmo botão dispararia sozinha no instante da entrada, porque o ptime dele já está alto.
// Marcando como travado, o gatilho exige SOLTAR o botão antes de valer — que é o correto.
function Reset_Perfil() {
    Inicializar_Estado();
    Hp_Travado = 0x1FFFFF;   // 21 bits — no modo ATE isto significa "janela ja perdida"
    Hp_Press   = 0;          // v3z8: ninguem "estava pressionado" na entrada do perfil
    Fz_Travado = 0x1FFFFF;
    Ent_Trava  = 0x1FFFFF;   // v3z1: nenhuma instancia opera ate passar por repouso
    // As saidas com duracao param junto: nada de um toque ou de um pisca do dominio
    // velho chegando no dominio novo.
    Tap_T     = 0;
    Vib_T     = 0;
    Fb_T      = 0;
    Fb_Pulsos = 0;
    // Zerar o contador do pisca NAO desliga o que ele ja tinha ligado. Sem as duas linhas
    // abaixo, um reset no meio de um pulso deixaria a vibracao e a cor de pe para sempre
    // — e o unico motivo de isso nao acontecer sempre e que o Switch_Mode dispara um
    // pisca novo logo em seguida. Depender dessa ordem e depender de sorte, e o
    // Menu_Din_Saida chama este reset SEM disparar pisca nenhum.
    Fb_Aceso  = FALSE;
    Fb_Aplicar();
}

// Liga, troca ou desliga o dominio. Pedir o dominio que JA esta ligado desliga: e o que
// garante um dominio por vez sem uma tecla de "sair".
// Reset_Perfil vem antes do feedback porque o estado tem de estar limpo na mesma volta em
// que o dominio muda.
function Switch_Mode(m) {
    Cfg_Sujo = TRUE;   // v7l: o dominio muda quem esta ativo
    if(CurrentMode == m) CurrentMode = 0;
    else                 CurrentMode = m;
    Reset_Menus();
    Reset_Perfil();   // v3z: zera o estado de execução ao entrar E ao sair de um perfil
    Tela_Trocando();
    if(CurrentMode > 0) Fb_Disparar(FB_VERDE,     RUMBLE_A, 1, FB_ACESO_LONGO);
    else                Fb_Disparar(FB_VERMELHO,  RUMBLE_B, 2, FB_ACESO_CURTO);
    update_leds();
}

// Tudo o que os menus guardam de "estou no meio de alguma coisa" volta ao zero. Era o
// corpo do combo RestFun, que rodava 500ms DEPOIS do comando; agora e sincrono, no
// instante da troca — e por isso os MODs do dominio novo nao pegam meio segundo de menu
// aberto pela frente.
// O que NAO entra aqui: Dom_Disparado, que protege contra a repeticao do proprio comando
// que acabou de chamar esta troca. Zerar aquele bit faria o dominio trocar de novo na
// volta seguinte, com o analogico ainda pressionado.
function Reset_Menus() {
    MenuLevel       = 0;
    MenuDin         = 0;
    MenuCursor      = 0;
    ScrollTop       = 0;
    Dc_Touch        = 0;
    Flag_Share_Save = FALSE;
    Wz_Entrando     = FALSE;
    Sq_Timer        = 0;
    Tri_Timer       = 0;
    Del_Slot        = 0;
}
// A cor diz em que dominio voce esta sem abrir a tela. Intensidade fraca de proposito:
// visivel no escuro, sem competir com o jogo. Tabela de cores na SECAO 19.
// AUDITORIA: os quatro "1" eram numeros crus, e LED_FRACO estava definido na SECAO 2 sem
// nenhum uso — o mesmo caso do TIME_CIRCLE_CLOSE. Dois lugares com o mesmo valor e
// ninguem garantindo que continuariam iguais; mudar a intensidade exigia achar as quatro
// linhas em vez de uma.
function update_leds() {
    if(CurrentMode == 0) colorled(0, 0, 0, 0);
    if(CurrentMode == 1) colorled(LED_FRACO, 0, 0, 0);
    if(CurrentMode == 2) colorled(0, LED_FRACO, 0, 0);
    if(CurrentMode == 3) colorled(0, 0, LED_FRACO, 0);
    if(CurrentMode == 4) colorled(0, 0, 0, LED_FRACO);
}
// O Zen trata a barra de luz como quatro canais, nao como cor. Este embrulho existe para
// o resto do script pedir uma COR em uma linha.
function colorled(a, b, c, d) {
    set_led(LED_1, a); set_led(LED_2, b);
    set_led(LED_3, c); set_led(LED_4, d);
}
// =============================================================
// SEÇÃO 18 — SAIDAS COM DURACAO
// =============================================================
// Aqui mora tudo o que "dura um tempo": o toque no touchpad, o pisca de confirmacao de
// dominio, a vibracao que confirma a gravacao na EEPROM e o redesenho da tela na troca de
// dominio. Antes eram CINCO COMBOS; agora sao quatro contadores e um punhado de funcoes
// curtas, e o script nao tem combo nenhum.
//
// O molde e sempre o mesmo, e vale para qualquer saida temporizada:
//   Disparar()  armazena o tempo e aplica o primeiro instante
//   Manter()    perde o tempo da volta e, quando chega a zero, faz a virada
// Chamadas de Saidas_Manter, no FIM do main: o que se escreve aqui nao pode ser
// sobrescrito por um MOD na mesma volta.
//
// POR QUE TROCAR COMBO POR CONTADOR — as quatro razoes, todas aprendidas neste projeto:
//   1. REARMAR. combo_run num combo que ja corre NAO reinicia nada: a segunda chamada e
//      silenciosamente ignorada. Com contador, rearmar e uma atribuicao. Foi essa
//      diferenca que escondeu por versoes o pisca da tela na troca de dominio: o
//      RestFun era pedido a cada volta em que o par ficava segurado, e so nao se via
//      porque o combo em curso ignorava os pedidos.
//   2. ESTADO VISIVEL. "Esta piscando?" e uma pergunta que se responde em qualquer ponto
//      do script (Fb_T > 0). De um combo nao se pergunta nada.
//   3. RESET. Reset_Perfil zera as quatro saidas de uma vez; combo nao se zera — exigiria
//      um combo_stop por combo, e o esquecido e sempre o que da o bug.
//   4. VARIAVEIS. O Zen reserva variaveis dedicadas aos combos. Os cinco daqui custavam
//      12 delas; agora custam zero.
//
// O QUE UM COMBO FAZ E UM CONTADOR NAO: o passo de um combo fica APLICADO enquanto dura,
// e por isso ganha de quem escreveu antes na mesma volta. Uma funcao chamada uma vez so
// escreve uma vez. A resposta esta em duas decisoes: Fb_Aplicar e chamada TODA VOLTA
// enquanto o pisca corre (nao so na virada de fase), e Saidas_Manter e o ULTIMO bloco do
// main. Juntas, elas dao ao contador a mesma "ultima palavra" que o combo tinha.
//
// Combo continua sendo a ferramenta certa para UMA coisa: sequencia longa de passos que
// se quer ler como roteiro (uma macro de 10 botoes, por exemplo). Nao e o caso de nenhuma
// das cinco que estavam aqui.
function Saidas_Manter() {
    Tap_Manter();
    Vib_Manter();
    Fb_Manter();      // por ultimo: o pisca do dominio tem a palavra final no rumble
}

// --- TOQUE NO TOUCHPAD (era o combo cTouchTap) ---
// SHARE abre a tela de captura do console. O utilitario anula o SHARE e pede um toque no
// touchpad, que e o gesto que o jogo espera. TIME_TOQUE e o suficiente para o jogo
// reconhecer.
function Tap_Disparar() {
    Tap_T = TIME_TOQUE;
}
function Tap_Manter() {
    if(Tap_T <= 0) return;
    Tap_T = Tap_T - get_rtime();
    set_val(PS5_TOUCH, 100);
}

// --- VIBRACAO DA GRAVACAO (era o combo VIBRATE_SAVE) ---
// Confirma que o SHARE segurado gravou o MOD na EEPROM. Vibra e nao mexe no LED: ela
// acontece com o MenuDin aberto, onde o LED esta a servico do menu.
// Nao passa pelo Fb_* por um motivo: o Fb_* termina redesenhando a tela, e aqui a tela
// acabou de ser redesenhada pelo proprio menu. Sao oito linhas, e oito linhas honestas
// valem mais que um parametro a mais numa funcao que faz duas coisas.
function Vib_Disparar() {
    Vib_T = FB_SALVOU;
    set_rumble(RUMBLE_A, FB_RUMBLE_FORCA);
}
function Vib_Manter() {
    if(Vib_T <= 0) return;
    Vib_T = Vib_T - get_rtime();
    if(Vib_T <= 0) {
        reset_rumble();
        return;
    }
    set_rumble(RUMBLE_A, FB_RUMBLE_FORCA);
}

// --- PISCA DE CONFIRMACAO DE DOMINIO (eram cFlashON e cFlashOFF) ---
// Um pulso verde longo = dominio LIGADO. Dois pulsos vermelhos curtos = DESLIGADO.
// A diferenca esta no NUMERO de pulsos, nao so na cor: a barra de luz fica fora do campo
// de visao durante o jogo, a vibracao nao.
// Os dois combos viraram UMA maquina com parametros, porque a diferenca entre eles era so
// cor, motor, numero de pulsos e duracao. Uma funcao para disparar, uma para aplicar a
// fase, uma para virar a fase.
function Fb_Disparar(cor, rumble, pulsos, ms_aceso) {
    Vib_T      = 0;        // o pisca do dominio cancela a vibracao de gravacao: os dois
                           // usam o mesmo motor, e deixar os dois de pe seria sorteio
    Fb_Cor     = cor;
    Fb_Rumble  = rumble;
    Fb_Pulsos  = pulsos;
    Fb_MsAceso = ms_aceso;
    Fb_Aceso   = TRUE;
    Fb_T       = ms_aceso;
    Fb_Aplicar();
}

// O que a fase atual faz no hardware. Chamada toda volta enquanto o pisca corre — ver a
// nota do cabecalho desta secao sobre por que isso importa.
// Com FB_SEM_COR o LED nao e tocado em fase nenhuma: quem usa essa cor esta pedindo
// vibracao e nada mais.
function Fb_Aplicar() {
    if(Fb_Aceso) {
        set_rumble(Fb_Rumble, FB_RUMBLE_FORCA);
        if(Fb_Cor == FB_VERDE)         colorled(0, 0, LED_NORMAL, 0);
        else if(Fb_Cor == FB_VERMELHO) colorled(0, LED_NORMAL, 0, 0);
        return;
    }
    reset_rumble();
    if(Fb_Cor != FB_SEM_COR) colorled(0, 0, 0, 0);
}

function Fb_Manter() {
    if(Fb_T <= 0) return;
    Fb_T = Fb_T - get_rtime();
    if(Fb_T <= 0) Fb_Virar();
    Fb_Aplicar();
}

// A virada de fase: aceso -> apagado -> (proximo pulso) -> ... -> fim.
// No fim, redesenha a tela: e o que os dois combos faziam no seu ultimo passo. A fase
// termina em "apagado", entao o Fb_Aplicar que vem depois desliga a vibracao e o LED — e
// na volta seguinte o update_leds devolve a cor do dominio.
function Fb_Virar() {
    if(Fb_Aceso) {
        Fb_Aceso = FALSE;
        Fb_T     = FB_APAGADO;
        return;
    }
    Fb_Pulsos = Fb_Pulsos - 1;
    if(Fb_Pulsos > 0) {
        Fb_Aceso = TRUE;
        Fb_T     = Fb_MsAceso;
        return;
    }
    Fb_T = 0;
    Update_OLED();
}

// --- REDESENHO NA TROCA DE DOMINIO (era a espera do combo RestFun) ---
// Apaga agora e agenda um redesenho para TIME_TROCA_LIMPA depois.
// Traduzir o combo para contador mostrou o que ele fazia de verdade: a tela NAO ficava
// apagada meio segundo. Ela apagava, e na volta seguinte o proprio Tela_Manter
// redesenhava, porque o dominio havia mudado. O wait(500) do RestFun so atrasava um
// segundo desenho, por cima do que ja estava certo. O comportamento visivel foi mantido
// igual. Querendo a tela realmente apagada durante a troca, e uma linha: Tela_Manter
// passa a sair cedo enquanto Tela_Agenda_T > 0.
//
// ONDE ESTAVA O GATILHO, E POR QUE ELE MUDOU DE LUGAR. No v7o o RestFun era pedido pelos
// LEITORES de comando — em toda volta em que o par L1+L3 (ou R1+R3) estivesse segurado, e
// tambem no PRIMEIRO clique de um duplo que talvez nunca se completasse. Com combo isso
// passava despercebido, porque combo_run num combo em curso e ignorado; com contador, cada
// volta reapagaria a tela. Pior: ao vencer o prazo, a volta seguinte pedia tudo de novo, e
// a tela PISCAVA a cada meio segundo enquanto os botoes ficassem segurados — no v7o
// tambem, porque o combo terminado era religado do mesmo jeito.
// O conserto certo nao era proteger a chamada repetida: era mover o gatilho. Apagar a tela
// pertence ao INSTANTE da troca, e quem sabe que a troca aconteceu e o Switch_Mode.
// CONSEQUENCIAS VISIVEIS, todas desejadas:
//   1. um clique solto no L3 (sem completar o duplo) nao apaga mais a tela;
//   2. segurar o par nao pisca mais a tela;
//   3. tocar L1+L3 sem trocar de dominio nao fecha mais os menus — trocar de dominio
//      fecha, e para sair do MenuDin ja existem R1+OPTIONS e o CIRCLE segurado.
function Tela_Trocando() {
    cls_oled(0);
    Tela_Agenda_T = TIME_TROCA_LIMPA;
}
function Tela_Redesenho() {
    if(Tela_Agenda_T <= 0) return;
    Tela_Agenda_T = Tela_Agenda_T - get_rtime();
    if(Tela_Agenda_T <= 0) Update_OLED();
}

// =============================================================
// SEÇÃO 19 — REFERENCIAS
// =============================================================
// LED — colorled(a, b, c, d): LED_1=a, LED_2=b, LED_3=c, LED_4=d
// Intensidade: 0 apagado, 1 fraco (LED_FRACO), 2 normal (LED_NORMAL), 3 forte
//
//   colorled(0,0,0,0)  apagado            colorled(1,0,0,0)  azul fraco
//   colorled(0,1,0,0)  vermelho fraco     colorled(0,0,1,0)  verde fraco
//   colorled(0,0,0,1)  rosa fraco         colorled(1,0,1,0)  ciano fraco
//   colorled(0,1,1,0)  amarelo fraco      colorled(1,1,1,0)  branco fraco
//   Trocando o 1 por 3 em qualquer linha, a mesma cor sai brilhante.
//   Os dominios: D1 azul, D2 vermelho, D3 verde, D4 rosa (ver update_leds).
//
// OLED — print(x, y, tamanho, fundo, texto[0])
//   tamanho 0: ate 18 letras por linha, 10px de altura
//   tamanho 1: ate 11 letras por linha, 17px de altura
//   tamanho 2: ate  8 letras por linha, 23px de altura
//   fundo 0: fundo branco, letra preta   fundo 1: fundo preto, letra branca
//   coordenadas: x de 0 a 127, y de 0 a 63
//   a fonte nao tem acento: escreva "Dominio", nao "Dominio" com til
//
// rect_oled(x, y, largura, altura, preenchido, cor)
//   preenchido 0 = so a borda, 1 = solido.
//
// SAIDA COM DURACAO — o molde que substitui o combo (SECAO 18)
//   armar:     T = MS;
//   manter:    if(T <= 0) return;  T = T - get_rtime();  <o efeito>
//   virar:     quando T chega a zero, troca de fase ou encerra
//   rearmar:   T = MS;   (um combo, nesse caso, simplesmente continuaria)
//   parar:     T = 0;    (um combo exigiria combo_stop)
//
// MASCARA DE BITS — o array que o GPC nao tem
//   ligar o MOD N:       M = M |  (1 << (N - 1));
//   desligar o MOD N:    M = M & (~(1 << (N - 1)));
//   perguntar pelo N:    (M >> (N - 1)) & 1
//   zerar todos:         M = 0;
//   Um int guarda 32 itens, e os 21 MODs cabem folgados. 0x1FFFFF = os 21 ligados.
//
// LEITURA E ESCRITA — os tres verbos, e a diferenca entre eles importa
//   get_ival(btn)   o que o CONTROLE mandou nesta volta. E o que um MOD deve ler.
//   get_val(btn)    o que o SCRIPT ja escreveu nesta volta. Quem le get_val passa a
//                   depender da ordem das chamadas no main.
//   set_val(btn, v) o que o CONSOLE vai receber. Quem escreve por ultimo vence — e por
//                   isso a SECAO 18 e o ultimo bloco do main.
