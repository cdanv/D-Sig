    if(n==11) DS_F1_ASSOC_11=v; if(n==12) DS_F1_ASSOC_12=v;
    if(n==13) DS_F1_ASSOC_13=v; if(n==14) DS_F1_ASSOC_14=v;
    if(n==15) DS_F1_ASSOC_15=v; if(n==16) DS_F1_ASSOC_16=v;
    if(n==17) DS_F1_ASSOC_17=v;
    if(n==18) DS_F1_ASSOC_18=v;
    if(n==19) DS_F1_ASSOC_19=v;
    if(n==20) DS_F1_ASSOC_20=v;
