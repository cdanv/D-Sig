}
// v5: o DELAY vale para o INSTANTE EM QUE A RESPOSTA IA COMECAR — nao para o ALFA nem
// para o GAMA em separado. Foi o MOD_03 do FIFA que fechou essa decisao: ele nao tem
// ALFA nem GAMA, sobe pelo ZETA ASSOC, e amarrar o delay a qualquer um dos dois o
// deixaria de fora. Amarrar a RESPOSTA e a mesma regra que ja governa os ZETA.
// Devolve 1 quando a resposta pode subir; 0 enquanto o atraso corre.
// O timer zera quando o MOD para de responder, entao a proxima subida recomeca limpo.
function Delay_Passou(num) {
    if(Get_Delay(num) == 0) return 1;   // v5a: OFF — responde na hora, sem armar timer
    // v7i CORRIGIDO: o timer so era rearmado quando a INSTANCIA desligava. Mas um MOD
    // com ALFA nao desliga ao sair da zona — fica ativo, apenas sem responder. O timer
    // ficava zerado e o delay valia so na primeira subida, nunca mais.
    // Agora, havendo ALFA, sair da zona rearma: a resposta ia parar, entao a proxima
    // subida recomeca a contagem, que e o que o campo promete.
    if(Get_Fonte_Tipo(num) != FONTE_NENHUMA) {
        if(!Zona_Ativa_Fonte(num)) { Delay_Zerar(num); return 0; }
    }
    if(!((Dly_Arm >> (num - 1)) & 1)) {
        Set_Dly(num, Delay_Ms(Get_Delay(num)));
        Dly_Arm = Dly_Arm | (1 << (num - 1));
    }
    Work_N = Get_Dly(num);
    if(Work_N <= 0) return 1;
    Work_N = Work_N - get_rtime();
    if(Work_N < 0) Work_N = 0;
    Set_Dly(num, Work_N);
    return Work_N <= 0;
}
function Delay_Zerar(num) {
    Dly_Arm = Dly_Arm & (~(1 << (num - 1)));
    Set_Dly(num, 0);
}
function Ent_Livre(num) {
    if(Get_Blok(num) && Ler_Btn_Fisico(Get_Blok(num) - 1)) return 0;
    if(Get_Gatilho_Duplo_Btn(num)      && Ler_Btn_Fisico(Get_Gatilho_Duplo_Btn(num) - 1))      return 0;
    if(Get_Gatilho_Final_Btn(num)      && Ler_Btn_Fisico(Get_Gatilho_Final_Btn(num) - 1))      return 0;
    if(Get_Gatilho_Hphold_Btn(num)     && Ler_Btn_Fisico(Get_Gatilho_Hphold_Btn(num) - 1))     return 0;
    if(Get_Gatilho_FinalAfter_Btn(num) && Ler_Btn_Fisico(Get_Gatilho_FinalAfter_Btn(num) - 1)) return 0;
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) return 1;
    if(Zona_Ativa_Fonte(num)) return 0;
    return 1;
}
function Suprime_Gatilhos(num) {
    Work_N = Get_Blok(num);                  if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Duplo_Btn(num);      if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Final_Btn(num);      if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Hphold_Btn(num);     if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_FinalAfter_Btn(num); if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
}
function Gatilho_Btn_Val(num) {
    Work_N = Get_Gatilho_Duplo_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_Hphold_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_Final_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_FinalAfter_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    return 100;
}
function Trb_Aplicar_Cond(num, v) {
    // v3t: sem fonte ("---") não há condicionais — a tela 101 nem é exibida. Aplicar MULT
    // aqui fazia o destino subir com o valor do multiplicador em vez de 100%, ignorando o
    // gatilho, que é quem manda nesse caso.
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) return v;
    // v3u: mesmo gate que Cond_Aplicar_Fonte já tinha pro DIRECT — fonte de BOTÃO é remap
    // puro, sem MULT/INV. Faltava aqui, e por isso um MULT configurado com eixo/L2 ficava
    // guardado no SPVAR_B e "vazava" pro TURBO depois de trocar a fonte pra um botão.
    if(Get_Fonte_Categoria(Get_Fonte_Tipo(num)) == CAT_BOTAO) return v;
    Pipe_Val = (v * (Get_Cond_Mult(num) + 1)) / 10;     // v3za
    if(Pipe_Val > 100)  Pipe_Val = 100;
    if(Pipe_Val < -100) Pipe_Val = -100;
    return Pipe_Val;
}
// ===== V3-f/g/h: Run_Instance unificado — substitui a antiga (X/Y/F2 triplicados) por
// uma fonte só. Ainda NÃO conectada ao Run_Pipeline — troca acontece depois de validar. =====
function Run_Instance_v3(num) {
    Spv_N = -1;                                        // v7l: carrega o cache deste MOD
    Spv_A = Get_Spvar_A(num); Spv_B = Get_Spvar_B(num); Spv_C = Get_Spvar_C(num);
    Spv_N = num;
    Work_A = Spv_A;
    if(!(Work_A & 1)) return;                         // SLOT_USED = 0 → não existe
    // CORRIGIDO: CurrentMode==0 ("nenhum perfil ativo") checava o bit 0 (SLOT_USED, sempre 1)
    // por acidente, ligando toda instância independente de S1-S4. Agora nenhum perfil ativo
    // = nada roda, coerente com S1-S4 todos desmarcados = instância desligada em qualquer
    // CurrentMode. FONTE_ON removido (redundante com S1-S4 todos OFF — mesmo efeito).
    if(CurrentMode == 0) return;
    if(!((Work_A >> CurrentMode) & 1)) return;         // perfil atual não marcado
    // v3z1: GATE DE ENTRADA DE PERFIL. O Reset_Perfil da v3z armou o anti-loop dos GATILHOS,
    // mas a FONTE ficou desprotegida — e a troca de perfil é feita com L1+L3 / R1+R3, ou
    // seja, com um botão de ombro SEGURADO. Com L1 como fonte, a fonte já entrava na zona
    // ativa no primeiro quadro do novo perfil: o ESTATC (que é chave) travava o destino na
    // hora, e o FINAL_AFTER armava sozinho. Mesmo fenômeno do anti-loop, pela porta da fonte.
    // Agora a instância só volta a operar depois de TUDO passar por repouso — fonte fora da
    // zona e nenhum botão de gatilho pressionado. Enquanto travada, ela ainda suprime (senão
    // o botão de gatilho/fonte PASSIVO vazaria pro jogo), mas não detecta nem responde.
    if((Ent_Trava >> (num - 1)) & 1) {
        if(Get_Fonte_Passivo(num)) { Suprime_Gatilhos(num); Suprime_Fonte(num); }
        if(Ent_Livre(num)) Ent_Trava = Ent_Trava & (~(1 << (num - 1)));
        return;
    }
    // Gatilhos e finalizadores (podem alternar/desligar o estado)
    Gatilho_HPHOLD_v3(num);
    Gatilho_DUPLO_v3(num);
    BTN_FN_Finaliza_v3(num);
    BTN_FN_FinalAfter_v3(num);
    // v3zk: a supressao dos gatilhos passou a depender do PASSIVO (ver Suprime_Gatilhos).
    // Continua vindo DEPOIS da deteccao — que usa get_ival e nao e afetada por set_val —
    // e antes de qualquer return, para valer com a instancia ligada ou desligada.
    if(Get_Fonte_Passivo(num)) Suprime_Gatilhos(num);
    // Religar pela fonte (por transição; internamente só religa se suprimida)
    Religa_Fonte(num);
    // Supressão PASSIVO — independente do estado das respostas, roda sempre que ON+PASSIVO
    if(Get_Fonte_Passivo(num)) Suprime_Fonte(num);
    // Só executa respostas se a instância estiver ativa
    if(!Inst_Esta_Ativa(num)) return;
    if((Bloq_Mask  >> (num - 1)) & 1) {
        // v3w: bloquear DESMONTA a resposta, não só a suspende. Sem isto, uma instância
        // bloqueada CONGELA seu estado (TrbSt no meio da rajada, ESTATC travado) e continua
        // parecendo "engajada" pro critério de destino — reintroduzindo o falso positivo que
        // toda esta mudança veio corrigir. É também o que dá coerência à remoção em cascata
        // do Computar_Bloq_Instancia_v3.
        // v3zm CORRIGIDO (achado do Daniel em B6.1): bloquear SUSPENDE, nao desmonta.
        // Antes eu zerava aqui a trava do ESTATC e a maquina do TURBO. Para o ESTATC isso
        // era destrutivo: a trava so e recriada quando a fonte ENTRA na zona, entao com o
        // botao ja solto ela nunca voltava — o bloqueio se comportava como finalizacao,
        // contra a definicao de BLOQ (continuo e reversivel).
        // O motivo original de desmontar era impedir que a bloqueada continuasse parecendo
        // engajada e voltasse a bloquear terceiros; isso agora e resolvido no lugar certo,
        // dentro de Bloq_Resp_Ativa_v3, que desconta quem esta em Bloq_Mask.
        // O TURBO passa a CONGELAR e retomar de onde parou — o timer nao decrementa porque
        // este return vem antes da maquina, e e o que "bloquear" deve significar.
        return;
    }
    if((Excl_Veto  >> (num - 1)) & 1) return;    // MOD_EXCL
    if((Assoc_Mask >> (num - 1)) & 1) { Delay_Zerar(num); return; }   // v7i: rearma o DELAY    // MOD_ASSOC
    if(BTN_FN_Bloqueia_v3(num)) return;   // v6c: BLOK segurado suspende a resposta
    if((Resp_Off_Fonte >> (num - 1)) & 1) return; // suprimida (desligada)
    // v5: DELAY — ultimo gate antes de responder. Fica aqui de proposito: neste ponto
    // ja passou por perfil, gate de entrada, gatilhos, ZETA e supressao, entao "chegou
    // aqui" significa exatamente "a resposta ia subir agora". E o instante certo para
    // comecar a contar, seja quem for que destravou.
    if(!Delay_Passou(num)) return;
    // v3s CORRIGIDO: o gate anterior (return em FONTE_NENHUMA) bloqueava a escrita no
    // destino ANTES de qualquer tipo rodar — por isso o gatilho ligava a instância mas
    // nada acontecia. Agora, sem fonte, o GATILHO é o "player": chegou aqui = instância
    // ativa e sem veto, então o destino sobe. DIRECT e ESTATC se comportam igual (não há
    // valor analógico a rotear, então é 100% enquanto ativo); o TURBO oscila normalmente
    // (o gate de zona dele foi tratado dentro de Executar_Turbo_Fonte).
    // v3zj CORRIGIDO (achado do Daniel no teste B4.5): a limitacao vale so para o ESTATC.
    // O DIRECT sem fonte passa por Escrever_Destino, que trata os 18 destinos — eixos
    // inclusive —, entao o eixo E escrito, espelhando o botao do gatilho. Ja o ESTATC usa
    // Estatc_Escrever_Dst, que ignora os eixos de proposito: travar um eixo em 100% sem um
    // valor de origem seria um empurrao fixo, nao um roteamento.
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) {
        if(Get_F1_Tipo(num) == DST_TIPO_TURBO) { Executar_Turbo_Fonte(num); return; }
        // v3t: DIRECT sem fonte = PREDISPOSIÇÃO, não trava. O gatilho ARMA a instância; a
        // partir daí o destino espelha o botão do gatilho em tempo real (aperta L1 -> destino
        // sobe; solta -> destino cai), até o gatilho desarmar. Antes se comportava igual ao
        // ESTATC (travava em 100%), que é o comportamento certo só pro ESTATC.
        if(Get_F1_Tipo(num) == DST_TIPO_DIRECT) {
            Work_D = Gatilho_Btn_Val(num);
            // v7i: orfao adotado herda a INTENSIDADE do alvo, em vez de 100% fixo.
            if(Orfao_Adotado(num)) {
                Est_Tmp = Valor_Alvo_Assoc(num);
                if(Est_Tmp != -1) Work_D = Est_Tmp;
            }
            // v3zp AUTOENCERRAMENTO (proposta do Daniel apos o teste do Mad Max).
            // DIRECT sem fonte espelha o botao do gatilho, entao o destino ja cai ao
            // soltar — mas o ESTADO ficava ligado, e como sem fonte o gatilho ALTERNA, o
            // toque seguinte DESLIGAVA em vez de repetir. Um comando momentaneo (rolar,
            // esquivar) exigia dois toques para cada uso.
            // Encerrar aqui resolve sem custar bit nenhum: e regra derivada, nao campo.
            // Gatilho_Btn_Val devolve 100 quando NENHUM gatilho esta configurado, entao
            // uma instancia sem gatilho nunca cai neste ramo — segue de pe como antes.
            // LIMITACAO: com HOLD no modo ATE o disparo acontece na SOLTURA, com o botao
            // ja em zero — o MOD ligaria e encerraria no mesmo quadro. Mas essa combinacao
            // ja era inutil antes (o destino espelharia um botao solto), entao nada se perde.
            if(Work_D) {
                Escrever_Destino(Dst_Mask(num), Work_D);
            } else {
                Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                Aplicar_RespOff_Inst(num);
            }
            return;
        }
        Estatc_Escrever_Dst(Dst_Mask(num));
        return;
    }
    if(Get_F1_Tipo(num) == DST_TIPO_DIRECT) {
        // CORRIGIDO (bug 3): o DIRECT lia a fonte e aplicava só MULT/INV via
        // Cond_Aplicar_Fonte — nunca consultava Zona_Ativa_Fonte, que é quem aplica
        // THR_IN/THR_OUT/DIR. Resultado: esses três eram totalmente ignorados no DIRECT.
        // Agora, fora da zona ativa o destino recebe 0 (repouso) em vez do valor cru.
        if(Zona_Ativa_Fonte(num)) {
            Work_D = Ler_Fonte(num);
            Escrever_Destino(Dst_Mask(num), Cond_Aplicar_Fonte(num, Work_D));
        }
        // v3z4: FORA DA ZONA O MOD FICA EM SILENCIO — antes ele afirmava zero aqui.
        // Motivo (apontado pelo Daniel): o THR_IN JA E o campo neutro declarado pelo
        // usuario. "Abaixo do THR_IN" nao significa "o MOD esta mandando zero", significa
        // "o MOD nao esta falando". Como Acc_Um marcava Acc_Eixo_Tocado a cada zero
        // escrito, o Aplicar_Acc sobrescrevia o eixo de destino TODO quadro — e o
        // analogico fisico daquele eixo morria. Sintoma: fonte LX com destino RX/RY
        // tirava o R do jogo por completo. So acontecia eixo->eixo; botao/gatilho nao
        // passam pelo acumulador de eixo. Agora, calado o MOD, o eixo cru vive.
        // O zero de PROPOSITO continua sendo afirmado onde ele faz parte da resposta:
        // a latencia do TURBO segue escrevendo 0 via Trb_Valor_Eixo. Para destino
        // DIGITAL nada muda — Aplicar_Acc ja ignorava acumulador zerado.
        // Fonte PASSIVO com destino no PROPRIO eixo continua suprimida por Suprime_Fonte.
    }
    if(Get_F1_Tipo(num) == DST_TIPO_ESTATC) Executar_Estatc_Fonte(num);
    if(Get_F1_Tipo(num) == DST_TIPO_TURBO)  Executar_Turbo_Fonte(num);
}
// A instância está ativa agora? (SEMPRE_ATIVO sem gatilho = sempre; senão consulta Inst_Ativa)
// v3zy: o MOD tem algum gatilho que possa LIGA-LO? O BLOK fica de fora de proposito —
// ele so suspende enquanto segurado, nunca liga.
// v7a CORRIGIDO: um gatilho marcado como FINALIZA nao LIGA nada, entao nao pode contar
// como "gatilho de estado". Contava, e isso abria um buraco que so apareceu quando o
// Daniel montou o MOD_03 do futebol: sem ALFA, com o unico GAMA em FINALIZA e um ZETA
// ASSOC configurado, o MOD ficava INERTE — o gatilho nao ligava (por ser FINALIZA) e o
// ASSOC nao o adotava (porque o gatilho, mesmo inutil para ligar, contava aqui).
// Descontando os FINALIZA, o MOD volta a ser adotado pelo ASSOC e sobe com o alvo,
// que era exatamente a intencao da configuracao.
// Os indices batem com Gatilho_Alterna_G: 0=2CLK 1=TOGGLE 2=HOLD 3=AFTER.
function Tem_Gatilho_Estado(num) {
    // v7l: com as mascaras em dia, a resposta ja esta pronta. Cfg_Sujo cobre o menu aberto.
    if(!Cfg_Sujo) return (Msk_GatEst >> (num - 1)) & 1;
    if(Get_Gatilho_Duplo_Btn(num)      && !((Get_Fin(num) >> 0) & 1)) return 1;
    if(Get_Gatilho_Final_Btn(num)      && !((Get_Fin(num) >> 1) & 1)) return 1;
    if(Get_Gatilho_Hphold_Btn(num)     && !((Get_Fin(num) >> 2) & 1)) return 1;
    if(Get_Gatilho_FinalAfter_Btn(num) && !((Get_Fin(num) >> 3) & 1)) return 1;
    return 0;
}
function Inst_Esta_Ativa(num) {
    // v7l: mesma regra, lida das mascaras (com ALFA e sem GAMA de estado = sempre ativo)
    if(!Cfg_Sujo) {
        if((Msk_Livre >> (num - 1)) & 1) return 1;
        return (Inst_Ativa >> (num - 1)) & 1;
    }
    // v3t CORRIGIDO: com fonte "---" o atalho "sempre ativo" não pode valer. Sem fonte E
    // sem gatilho de estado (ex.: só BLOK configurado), nada gatava a instância e o destino
    // subia sozinho, ignorando o INIC. Agora, sem fonte, o estado vem SEMPRE de Inst_Ativa
    // (que é justamente o que o INIC inicializa e os gatilhos alternam).
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) {
        // v3zy MOD ORFAO ADOTADO PELO ASSOC (proposta do Daniel).
        // Sem ALFA e sem GAMA que ligue, este MOD era 100% inerte: nascia desligado e nada
        // o acordava — o ASSOC so BARRA, nunca liga. Agora, tendo ASSOC configurado, ele
        // e considerado ativo e o proprio ASSOC decide: responde enquanto o alvo responder.
        // Na pratica isso da um DELTA EXTRA a um MOD existente. Um MOD tem um tipo so;
        // querendo um TURBO num botao e um STATIC noutro pelo mesmo acionamento, o segundo
        // MOD pega carona no primeiro, sem gastar botao nem gatilho.
        // Custo zero: e regra derivada, e a combinacao que ela usa nao fazia nada antes.
        // v7b: o orfao adotado agora RESPEITA o desligamento. Antes devolvia 1
        // incondicionalmente, e um GAMA em FINALIZA nao conseguia derruba-lo — o
        // Daniel viu isso no MOD_03 do futebol, onde o toque no TOUCH nao cortava a
        // corrida. Quem liga o orfao passou a ser a BORDA do ASSOC (ver Adotar_Orfaos):
        // quando um alvo sobe, a instancia liga; depois disso, ela obedece ao proprio
        // estado, como qualquer outra.
        return (Inst_Ativa >> (num - 1)) & 1;
    }
    // v3: checa os getters novos (Seção 4, botão único). Os antigos (Get_F1_GBTN etc.)
    // nunca mais são escritos desde que as telas antigas saíram — sempre voltariam 0,
    // fazendo toda instância parecer SEMPRE_ATIVO por engano.
    if(!Tem_Gatilho_Estado(num)) return 1;
    return (Inst_Ativa >> (num - 1)) & 1;
}
// Get/Set do estado FINAL_AFTER por instância (1-16): janela (ms) restante; 0 = não contando
function Get_Fa(num) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return Fa_01;
                if(num == 2) return Fa_02;
                if(num == 3) return Fa_03;
            } else {
                if(num == 4) return Fa_04;
                if(num == 5) return Fa_05;
                if(num == 6) return Fa_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return Fa_07;
                if(num == 8) return Fa_08;
                if(num == 9) return Fa_09;
            } else {
                if(num == 10) return Fa_10;
                if(num == 11) return Fa_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return Fa_12;
                if(num == 13) return Fa_13;
                if(num == 14) return Fa_14;
            } else {
                if(num == 15) return Fa_15;
                if(num == 16) return Fa_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return Fa_17;
                if(num == 18) return Fa_18;
                if(num == 19) return Fa_19;
            } else {
                if(num == 20) return Fa_20;
                if(num == 21) return Fa_21;
            }
        }
    }
    return 0;
}
function Set_Fa(num, v) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) Fa_01=v;
                if(num == 2) Fa_02=v;
                if(num == 3) Fa_03=v;
            } else {
                if(num == 4) Fa_04=v;
                if(num == 5) Fa_05=v;
                if(num == 6) Fa_06=v;
            }
        } else {
            if(num <= 9) {
                if(num == 7) Fa_07=v;
                if(num == 8) Fa_08=v;
                if(num == 9) Fa_09=v;
            } else {
                if(num == 10) Fa_10=v;
                if(num == 11) Fa_11=v;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) Fa_12=v;
                if(num == 13) Fa_13=v;
                if(num == 14) Fa_14=v;
            } else {
                if(num == 15) Fa_15=v;
                if(num == 16) Fa_16=v;
            }
        } else {
            if(num <= 19) {
                if(num == 17) Fa_17=v;
                if(num == 18) Fa_18=v;
                if(num == 19) Fa_19=v;
            } else {
                if(num == 20) Fa_20=v;
                if(num == 21) Fa_21=v;
            }
        }
    }
}
// FINALIZA (FBTN2): pressionar desliga; com RELIG=SIM, alterna (toggle). Anti-loop via Fz_Travado.
// FINAL_AFTER (FBTN3): ao SOLTAR o botão, conta FTMP; ao fim, desliga. Reapertar cancela.
// Estado empacotado em Fa: bit 0 = armado (botão foi pressionado); bits 1+ = janela (ms) restante.
// Religar pela fonte: se a instância está desligada e um eixo ATIVO sobe (passa THR_IN), religa.
// Fonte PASSIVO não religa. Vale para instâncias com finalizador/gatilho.
// Inicializa o estado lig/desl de todas as instâncias a partir do INIC
function Inicializar_Estado() {
    Inst_Ativa = 0;
    // D-Sig: UM laco, nao dois. Antes, o primeiro montava Inst_Ativa e zerava a janela do
    // 2CLK, e um segundo, identico, zerava o resto. Podem ser um so porque o unico
    // cruzamento possivel foi conferido: Aplicar_RespOff_Inst pergunta a Inst_Esta_Ativa,
    // e ela le somente o bit da propria instancia — o bit que a primeira linha desta
    // iteracao acabou de escrever. Nenhuma linha daqui olha o estado de outro MOD, e por
    // isso a ordem entre MODs nao importa.
    Work_N = 1;
    while(Work_N <= 21) {
        // v3zc NASCIMENTO DERIVADO: com fonte nasce LIGADA, sem fonte nasce DESLIGADA.
        // "Ligada" nao significa destino no alto — com fonte, quem decide se o destino
        // sobe e sempre a zona ativa. Nascer ligada so evita um quadro de latencia na
        // primeira subida. Sem fonte, o gatilho e quem arma, entao nascer desligada e o
        // unico estado seguro (senao o destino subiria sozinho no boot e na troca de perfil).
        if(Get_Fonte_Tipo(Work_N) != FONTE_NENHUMA) Inst_Ativa = Inst_Ativa | (1 << (Work_N - 1));
        Set_Dc(Work_N, 0);
        Set_Fa(Work_N, 0); Set_TrbSt_X(Work_N, 0);
        // v3z3 CORRIGIDO: a trava do ESTATC agora é zerada AQUI, incondicionalmente, ao
        // lado do TrbSt. Antes ela só era limpa dentro de Aplicar_RespOff_Inst, e SÓ no
        // ramo "instância inativa" — mas uma instância SEM gatilho de estado é sempre
        // considerada ativa (Inst_Esta_Ativa devolve 1 direto), então ela passava pelo ramo
        // "ativo" e a trava SOBREVIVIA à troca de perfil. Resultado: o destino do ESTATC
        // voltava no alto assim que a instância recomeçava a rodar — que, com o gate de
        // entrada da v3z1, é exatamente o instante em que o L1 é SOLTO. Daí o sintoma
        // "aciona na saída de L1" dos testes 01/02/08/16/17/18/19/20/21. O TURBO passou em
        // todos justamente porque o Set_TrbSt_X acima já era incondicional.
        Set_Estatc_Travado(Work_N, 0);
        Set_Estatc_Teto(Work_N, 0);   // v3za
        Set_Estatc_Neg(Work_N, 0);    // v3zw
        Delay_Zerar(Work_N);          // v5
        // CORRIGIDO (bug 1): Set_GT_Relig e Set_FA_Cfg saíram daqui. Esta função é chamada
        // em DOIS lugares: no boot (onde resetar é correto) e ao DELETAR uma instância (pra
        // reconstruir Inst_Ativa). No segundo caso, resetar apagava a configuração do
        // usuário — RELIG e tempo do FINAL_AFTER de TODAS as instâncias voltavam ao default.
        // Os defaults dessas duas já são garantidos pela declaração das variáveis (valor
        // inicial no boot) e por Zero_F1_Behavior (instância nova / posição reusada).
        // NOTA: Hold_Relig também não entra aqui — é persistente (SPVAR_64) e
        // Inicializar_Estado roda DEPOIS de Load_All, então resetá-lo apagaria o que
        // acabou de vir da EEPROM.
        Aplicar_RespOff_Inst(Work_N);
        Work_N++;
    }
    // As mascaras abaixo nao tem nada por MOD: uma atribuicao zera as 21 de uma vez. Vem
    // DEPOIS do laco porque Aplicar_RespOff_Inst escreve em Resp_Off_X/Y/F2/Fonte e em
    // Excl_Veto — zerar antes seria desfazer o que o laco acabou de decidir. Hp_Travado e
    // Fz_Travado sao reescritas pelo Reset_Perfil logo em seguida, e no boot ficam em zero.
    Hp_Travado = 0;
    Hp_Press = 0;      // v3z8
    Fz_Travado = 0;
    Bloq_Mask = 0;
    Excl_RespAnt = 0;
    Src_Acima_Fonte = 0;   // v3: fonte única
    Assoc_Mask = 0;
}
// BLOQUEIA: 1 se algum botão marcado (FBTN) está pressionado → instância suspensa neste ciclo.
// Momentâneo: não altera o estado lig/desl; só suspende a ação enquanto segurado.
// Trata só os 16 botões físicos (sem NATIVO).
// Executa uma instância (Subfase 3A: FONTE_1, EIXO_X, TIPO DIRECT)
// ATIVO:   eixo cru passa nativo (não tocamos); destinos recebem valor condicionado.
// PASSIVO: eixo cru é suprimido, EXCETO se o próprio eixo estiver marcado em DESTINO.
// Escreve 100% nos destinos DIGITAIS marcados (ESTATC trava só botões; ignora eixos 10-13)
function Estatc_Escrever_Dst(mask) {
    if((mask >> 0)  & 1) Acc_Um(0,  100);
    if((mask >> 1)  & 1) Acc_Um(1,  100);
    if((mask >> 2)  & 1) Acc_Um(2,  100);
    if((mask >> 3)  & 1) Acc_Um(3,  100);
    if((mask >> 4)  & 1) Acc_Um(4,  100);
    if((mask >> 5)  & 1) Acc_Um(5,  100);
    if((mask >> 6)  & 1) Acc_Um(6,  100);
    if((mask >> 7)  & 1) Acc_Um(7,  100);
    if((mask >> 8)  & 1) Acc_Um(8,  100);
    if((mask >> 9)  & 1) Acc_Um(9,  100);
    // v3zw: sem fonte nao ha lado para onde empurrar, entao o eixo trava no positivo.
    if((mask >> 10) & 1) Acc_Um(10, 100);
    if((mask >> 11) & 1) Acc_Um(11, 100);
    if((mask >> 12) & 1) Acc_Um(12, 100);
    if((mask >> 13) & 1) Acc_Um(13, 100);
    // eixos ja tratados acima; os D-pads (14-17) sao digitais e entram.
    if((mask >> 14) & 1) Acc_Um(14, 100);
    if((mask >> 15) & 1) Acc_Um(15, 100);
    if((mask >> 16) & 1) Acc_Um(16, 100);
    if((mask >> 17) & 1) Acc_Um(17, 100);
}
// Igual à Estatc_Escrever_Dst, mas com o valor parametrizável — usada pelo TURBO pra
// aplicar MULT/INV no destino em botão (bug 5), em vez do 100 fixo.
function Estatc_Escrever_Dst_Val(mask, v, sinal) {
    if((mask >> 0)  & 1) Acc_Um(0,  v);
    if((mask >> 1)  & 1) Acc_Um(1,  v);
    if((mask >> 2)  & 1) Acc_Um(2,  v);
    if((mask >> 3)  & 1) Acc_Um(3,  v);
    if((mask >> 4)  & 1) Acc_Um(4,  v);
    if((mask >> 5)  & 1) Acc_Um(5,  v);
    if((mask >> 6)  & 1) Acc_Um(6,  v);
    if((mask >> 7)  & 1) Acc_Um(7,  v);
    if((mask >> 8)  & 1) Acc_Um(8,  v);
    if((mask >> 9)  & 1) Acc_Um(9,  v);
    // v3zw: os EIXOS (10-13) entram no STATIC. Antes eram ignorados porque travar um eixo
    // "sem valor de origem seria um empurrao fixo" — o que vale para fonte AUSENTE, mas nao
    // para fonte de eixo com MULT, onde e roteamento legitimo. O sinal vem por parametro.
    if((mask >> 10) & 1) Acc_Um(10, sinal);
    if((mask >> 11) & 1) Acc_Um(11, sinal);
    if((mask >> 12) & 1) Acc_Um(12, sinal);
    if((mask >> 13) & 1) Acc_Um(13, sinal);
    if((mask >> 14) & 1) Acc_Um(14, v);
    if((mask >> 15) & 1) Acc_Um(15, v);
    if((mask >> 16) & 1) Acc_Um(16, v);
    if((mask >> 17) & 1) Acc_Um(17, v);
}
// ===== EXECUÇÃO DO TURBO (3I-c: botões) =====
function Get_Esx(n) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) return Esx_01;
                if(n == 2) return Esx_02;
                if(n == 3) return Esx_03;
            } else {
                if(n == 4) return Esx_04;
                if(n == 5) return Esx_05;
                if(n == 6) return Esx_06;
            }
        } else {
            if(n <= 9) {
                if(n == 7) return Esx_07;
                if(n == 8) return Esx_08;
                if(n == 9) return Esx_09;
            } else {
                if(n == 10) return Esx_10;
                if(n == 11) return Esx_11;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) return Esx_12;
                if(n == 13) return Esx_13;
                if(n == 14) return Esx_14;
            } else {
                if(n == 15) return Esx_15;
                if(n == 16) return Esx_16;
            }
        } else {
            if(n <= 19) {
                if(n == 17) return Esx_17;
                if(n == 18) return Esx_18;
                if(n == 19) return Esx_19;
            } else {
                if(n == 20) return Esx_20;
                if(n == 21) return Esx_21;
            }
        }
    }
    return 0;
}
function Set_Esx(n, v) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) Esx_01 = v;
                if(n == 2) Esx_02 = v;
                if(n == 3) Esx_03 = v;
            } else {
                if(n == 4) Esx_04 = v;
                if(n == 5) Esx_05 = v;
                if(n == 6) Esx_06 = v;
            }
        } else {
            if(n <= 9) {
                if(n == 7) Esx_07 = v;
                if(n == 8) Esx_08 = v;
                if(n == 9) Esx_09 = v;
            } else {
                if(n == 10) Esx_10 = v;
                if(n == 11) Esx_11 = v;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) Esx_12 = v;
                if(n == 13) Esx_13 = v;
                if(n == 14) Esx_14 = v;
            } else {
                if(n == 15) Esx_15 = v;
                if(n == 16) Esx_16 = v;
            }
        } else {
            if(n <= 19) {
                if(n == 17) Esx_17 = v;
                if(n == 18) Esx_18 = v;
                if(n == 19) Esx_19 = v;
            } else {
                if(n == 20) Esx_20 = v;
                if(n == 21) Esx_21 = v;
            }
        }
    }
}
// v7m: programa uma espera de qualquer tamanho. Devolve o que cabe nos 11 bits do timer
// e guarda o resto em Esx, que a maquina consome em fatias antes de mudar de fase.
function Trb_Prog_Espera(num, ms) {
    if(ms > 2047) { Set_Esx(num, ms - 2047); return 2047; }
    Set_Esx(num, 0);
    return ms;
}
function Get_TrbSt_X(n) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) return DS_TrbSt_X_01;
                if(n == 2) return DS_TrbSt_X_02;
                if(n == 3) return DS_TrbSt_X_03;
            } else {
                if(n == 4) return DS_TrbSt_X_04;
                if(n == 5) return DS_TrbSt_X_05;
                if(n == 6) return DS_TrbSt_X_06;
            }
        } else {
            if(n <= 9) {
                if(n == 7) return DS_TrbSt_X_07;
                if(n == 8) return DS_TrbSt_X_08;
                if(n == 9) return DS_TrbSt_X_09;
            } else {
                if(n == 10) return DS_TrbSt_X_10;
                if(n == 11) return DS_TrbSt_X_11;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) return DS_TrbSt_X_12;
                if(n == 13) return DS_TrbSt_X_13;
                if(n == 14) return DS_TrbSt_X_14;
            } else {
                if(n == 15) return DS_TrbSt_X_15;
                if(n == 16) return DS_TrbSt_X_16;
            }
        } else {
            if(n <= 19) {
                if(n == 17) return DS_TrbSt_X_17;
                if(n == 18) return DS_TrbSt_X_18;
                if(n == 19) return DS_TrbSt_X_19;
            } else {
                if(n == 20) return DS_TrbSt_X_20;
                if(n == 21) return DS_TrbSt_X_21;
            }
        }
    }
    return 0;
}
function Set_TrbSt_X(n, v) {
    if(v == 0 || v == 65536) Set_Esx(n, 0);   // v7m: rearme/terminado zera o resto da espera
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) DS_TrbSt_X_01=v;
                if(n == 2) DS_TrbSt_X_02=v;
                if(n == 3) DS_TrbSt_X_03=v;
            } else {
                if(n == 4) DS_TrbSt_X_04=v;
                if(n == 5) DS_TrbSt_X_05=v;
                if(n == 6) DS_TrbSt_X_06=v;
            }
        } else {
            if(n <= 9) {
                if(n == 7) DS_TrbSt_X_07=v;
                if(n == 8) DS_TrbSt_X_08=v;
                if(n == 9) DS_TrbSt_X_09=v;
            } else {
                if(n == 10) DS_TrbSt_X_10=v;
                if(n == 11) DS_TrbSt_X_11=v;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) DS_TrbSt_X_12=v;
                if(n == 13) DS_TrbSt_X_13=v;
                if(n == 14) DS_TrbSt_X_14=v;
            } else {
                if(n == 15) DS_TrbSt_X_15=v;
                if(n == 16) DS_TrbSt_X_16=v;
            }
        } else {
            if(n <= 19) {
                if(n == 17) DS_TrbSt_X_17=v;
                if(n == 18) DS_TrbSt_X_18=v;
                if(n == 19) DS_TrbSt_X_19=v;
            } else {
                if(n == 20) DS_TrbSt_X_20=v;
                if(n == 21) DS_TrbSt_X_21=v;
            }
        }
    }
}
// Tempo do TURBO em ms (idx 0-9)
// v3zc: 8 valores (3 bits) em vez de 16. A faixa RAPIDA (50-150ms) fica quase
// intacta — e onde o turbo vive. A perda concentra-se acima de 250ms, onde o passo
// ja era grosso. Com o COMBO carregando tempo proprio por passo, o PERM/LAT passou
// a ser so o ritmo BASE, e ritmo base nao precisa de 16 niveis.
// v3zr: tabela dos PASSOS — entram 30 e 70ms, saem 60 e 80 (que estavam colados demais
// para fazer diferenca). Continua com 8 valores: nao ha bit para ampliar, mas a escolha
// dos valores e de graca.
function Trb_Tempo_Ms(idx) {
    if(idx == 0) return 30;
    if(idx == 1) return 50;
    if(idx == 2) return 70;
    if(idx == 3) return 100;
    if(idx == 4) return 150;
    if(idx == 5) return 250;
    if(idx == 6) return 500;
    return 1000;
}
// v3zr: tabela da LATENCIA — agora 16 valores (4 bits), comecando em 10ms. O bit veio do
// CICLOS, que caiu de 11 para 8 valores. Motivo: com CICLO 1, a sequencia so autofinaliza
// DEPOIS da latencia, entao 50ms era um atraso somado a cada disparo — foi o que o Daniel
// sentiu no MOD_07 do Mad Max. Com 10ms isso praticamente desaparece.
// v6: o indice 0 virou OFF (sem latencia) — os passos alternam direto, um emendando no
// outro. O 1000ms saiu para abrir a vaga: latencia de 1s e rara, e a ESPERA por passos
// vazios (abaixo) cobre pausas longas com muito mais alcance.
function Trb_Lat_Ms(idx) {
    if(idx ==  0) return 0;
    if(idx ==  1) return 10;
    if(idx ==  2) return 20;
    if(idx ==  3) return 30;
    if(idx ==  4) return 40;
    if(idx ==  5) return 50;
    if(idx ==  6) return 60;
    if(idx ==  7) return 80;
    if(idx ==  8) return 100;
    if(idx ==  9) return 120;
    if(idx == 10) return 150;
    if(idx == 11) return 200;
    if(idx == 12) return 250;
    if(idx == 13) return 350;
    if(idx == 14) return 500;
    return 750;
}
// Máquina de oscilação do TURBO — EIXO_X (1 ciclo = PERM ligado + LAT desligado)
// CICLOS=0 (ATIVO): oscila enquanto a fonte está na zona; CICLOS=1-10: N oscilações por
// acionamento, rearma quando a fonte sai e entra de novo na zona. Fase ON escreve os
// destinos DIGITAIS (0-9) a 100% — eixos ficam para a 3I-d.
// Valor do TURBO nos EIXOS conforme o MODO e o estado da máquina (pack de estado completo).
// POS/NEG: oscila polo(fixo)↔repouso(0) — só escreve no polo quando fase=ligado.
// ABS: NUNCA repousa em 0 enquanto ativo — alterna direto entre +100 (fase ligada) e -100
// (fase desligada), independente do sinal da fonte (crucial p/ fontes de botão, que só
// leem positivo: o ABS ainda assim tem que cobrir negativo e positivo). Exceção: quando os
// CICLOS terminam (pack "terminado" — timer=0 e fase=desligado), sempre repousa em 0 de
// verdade, mesmo em ABS — senão o eixo ficaria preso em -100 até a próxima entrada na zona.
function Trb_Valor_Eixo(mod, pack, raw) {
    Work_N = pack & 0x7FF;               // timer restante da fase
    if(Work_N == 0 && !((pack >> 11) & 1)) return 0;   // terminado: repouso real (todos os modos)
    if(mod == TRB_MOD_ABSF) {
        // ABSF (resgate do comportamento antigo): polo segue o sinal ATUAL da fonte,
        // repousa em 0 na fase desligada — igual POS/NEG na estrutura, mas polaridade dinâmica.
        if(!((pack >> 11) & 1)) return 0;
        if(raw < 0) return -100;
        return 100;
    }
    if((pack >> 11) & 1) {
        // fase LIGADA
        if(mod == TRB_MOD_NEG) return -100;
        return 100;                       // POS e ABS ligam em +100
    }
    // fase DESLIGADA
    if(mod == TRB_MOD_ABS) return -100;   // ABS não repousa: vai para o polo oposto
    return 0;                             // POS/NEG: repouso normal
}
// Máquina de oscilação do TURBO — EIXO_Y (espelho do X)
// ===== MOD_BLOQ (execução) — CORRIGIDO =====
// "a atual" (m, quem CONFIGURA a relação) é SEMPRE quem sofre o efeito — nunca a selecionada.
// Get_F1_Bloq(m) = quem m marcou; Get_F1_BLOQ_M(m) = modo por bit marcado (0=ATV 1=PASS):
//   PASS: m fica bloqueada ENQUANTO as RESPOSTAS do alvo estiverem de pé (contínuo, sem memória;
//         libera no instante em que as respostas do alvo terminam).
//   ATV : m fica bloqueada a partir do instante em que a FONTE do alvo sobe (borda), e continua
//         bloqueada até as RESPOSTAS do alvo terminarem — mesmo que a fonte já tenha descido
//         antes disso. Por isso precisava de uma trava, diferente do PASS (lógica removida).
// "Respostas de pé" = respondendo de verdade agora (habilitada E fonte na zona ativa, sem veto).
// "Fonte subiu" = fonte entrou na zona ativa agora e não estava no quadro anterior.
// Calculado 1x por quadro, ANTES do loop de instâncias, com o estado como estava ao final do
// quadro anterior (evita depender da ordem de processamento dentro do mesmo quadro).
function Mask_Tem_Bit_Comum(a, b) {
    // v7l: as mascaras tem 21 bits (0-20), nunca chegam ao bit de sinal — o E bit a bit
    // responde de uma vez o que 21 testes respondiam um a um. O historico abaixo continua
    // valendo: a versao antiga chegou a parar no bit 15.
    // v3x — BUG RAIZ DOS MODs: esta função parava no bit 15, resquício de quando o sistema
    // tinha 16 instâncias. Com 21, as instâncias 17-21 (bits 16-20) eram INVISÍVEIS pra
    // toda a lógica de MOD. Como o Daniel testou justamente com MOD_20 (bit 19) e MOD_21
    // (bit 20), os três MODs pareciam mortos ao mesmo tempo — mas por vias diferentes:
    //   BLOQ  -> nunca achava bit comum -> nunca bloqueava (parecia inerte)
    //   EXCL  -> idem, nunca disparava  (parecia inerte)
    //   ASSOC -> testa a AUSÊNCIA de bit comum, então "não achou" virava "nenhum vinculado
    //            de pé" -> bloqueava SEMPRE. Era o único que dava sinal de vida, e por isso
    //            mesmo foi o que denunciou a causa: a assimetria só faz sentido com o
    //            Bloq_Snap_Resp permanentemente vazio aos olhos desta função.
    if(a & b) return 1;
    return 0;
}
// A fonte da instância i está na zona ativa agora, em pelo menos um eixo (independente de
// veto/RELIG — é o sinal bruto da fonte, para detectar a borda de subida do ATV).
// As respostas da instância i estão de pé agora: habilitada E ao menos um eixo ativo na zona
// e não vetado (respondendo de verdade, não só "habilitada a responder").
// Calcula se "m" (quem configurou) fica bloqueada neste quadro, dado o que m marcou.
// Snapshot de fonte/respostas de todas as instâncias + aplica a regra — chamadas explícitas
// (sem while aninhado), no mesmo espírito do Run_Instance(1..16) já usado no loop principal.
// ===== MOD_EXCL (execução) =====
// "a atual" (m, quem CONFIGURA) é SEMPRE quem sofre o encerramento — nunca a selecionada.
// Diferente do MOD_BLOQ: é disparo ÚNICO na borda de subida, não contínuo. Uma vez encerrada,
// m só volta pelas PRÓPRIAS condições internas (gatilho/RELIG dela) — nunca porque o alvo
// "acabou" (não existe reativação automática aqui, ao contrário do BLOQ).
//   PASS: quando as RESPOSTAS do alvo SOBEM (borda) -> m é encerrada.
//   ATV : quando a FONTE do alvo SOBE (borda) -> m é encerrada.
// Reaproveitava os snapshots de fonte/resposta já calculados no MOD_BLOQ (mesmo quadro, mesmo
// significado) — só a borda das RESPOSTAS é nova aqui (o BLOQ nunca precisou da borda, só do
// nível contínuo). Chamado logo depois de Computar_Mods_Bloq, na mesma função de quadro.
// Aplica a regra às 16 instâncias — chamadas explícitas (sem while aninhado). Deve rodar DEPOIS
// de Computar_Mods_Bloq (mesmo quadro), para que os snapshots de fonte/resposta
// já estejam frescos, e ANTES de atualizar Excl_RespAnt para o próximo quadro.
// ===== MOD_ASSOC (execução) =====
// "a atual" (m, quem CONFIGURA) sempre sofre o efeito — igual BLOQ/EXCL. Diferença: em vez de
// BLOQUEAR enquanto o alvo está de pé, o ASSOC só PERMITE m responder ENQUANTO pelo menos um
// vinculado estiver de pé — "m se torna subordinada a subir associada" ao(s) alvo(s). Mesma
// mecânica do MOD_BLOQ (PASS contínuo, ATV com trava grudenta), sentido do veto invertido.
// Múltiplos alvos: OR — m é permitida se QUALQUER vinculado estiver de pé.
// Aplica a regra às 16 instâncias — chamadas explícitas (sem while aninhado). Roda por último no
// pipeline de MODs (depois de BLOQ e EXCL), e era quem atualizava o snapshot de fonte para o próximo
// quadro — precisa ser o ÚLTIMO consumidor da borda da fonte deste quadro antes dela ser renovada.
// ===== V3-i: MOD_EXCL/ASSOC/BLOQ — versão v3, SEM modo ATV/PASS (decisão 3.3/3.8).
// Critério único: RESPOSTA do vinculado. Dados (DS_F1_EXCL/ASSOC/BLOQ) já eram RAM desde
// antes — só a lógica de cálculo muda aqui. Nomes _v3 novos porque Run_Pipeline antigo
// (agora trocado) ainda referenciava as versões antigas com _M; mantidas intocadas.
// Verifica se a instância i está "ligada" pelo sistema de perfis (S1-S4 + CurrentMode) —
// substitui o antigo FONTE_ON (removido por ser redundante: S1-S4 todos OFF já desliga
// por completo, e agora CurrentMode==0 também desliga tudo, sem a brecha antiga).
// v3ze: "esta instancia tem destino configurado?" — precisa ser uma pergunta propria
// porque o campo DST tem leituras diferentes por tipo. No TURBO ele guarda o pack de
// passos MAIS um bit do pack de tempos (o 18o bit): ler o campo cru daria "tem destino"
// para uma instancia sem passo nenhum, so porque um tempo estava configurado. Os MODs
// dependem disso para decidir quem participa de relacao — um falso positivo aqui faria
// o ASSOC prender terceiros a uma instancia que nunca responde.
function Tem_Destino(i) {
    // v3zr: uniforme para todos os tipos — os quatro destinos vivem no mesmo formato.
    if(Get_Combo_Dst(i, 1)) return 1;
    if(Get_Combo_Dst(i, 2)) return 1;
    if(Get_Combo_Dst(i, 3)) return 1;
    if(Get_Combo_Dst(i, 4)) return 1;
    return 0;
}
function Inst_Perfil_Ativo(i) {
    if(CurrentMode == 0) return 0;
    return (Get_Spvar_A(i) >> CurrentMode) & 1;
}
// v3w — CRITÉRIO DE ENGAJAMENTO POR DESTINO (substitui o critério de FONTE).
// Motivo: a fonte mentia nos dois sentidos. Falso NEGATIVO: ESTATC travado com o botão já
// solto — fonte fora da zona, mas o destino continua no alto. Falso POSITIVO: TURBO com os
// ciclos esgotados — fonte na zona, destino em repouso. O destino diz a verdade nos dois.
// "Engajada" NÃO é "acumulador != 0": o TURBO escreve zero na latência dezenas de vezes por
// segundo, e isso faria o bloqueio piscar. É "a resposta está de pé", por tipo:
//   DIRECT  -> fonte na zona (ou instância ligada, se "---")
//   ESTATC  -> travado OU na zona
//   TURBO   -> máquina rodando (ciclos não esgotados), incluindo as fases de latência
// Sem dependência circular: Estatc_Travado e TrbSt são estados PERSISTENTES em RAM, escritos
// dentro do Run_Instance. Como esta função roda ANTES das 21 instâncias, ela lê naturalmente
// o valor do quadro ANTERIOR — o snapshot que eu precisaria construir já existe de graça.
function Bloq_Resp_Ativa_v3(i) {
    if(!Inst_Esta_Ativa(i)) return 0;
    if(!Inst_Perfil_Ativo(i)) return 0;
    if((Resp_Off_Fonte >> (i - 1)) & 1) return 0;
    // v3zm: quem esta BLOQUEADO nao esta de pe — nao bloqueia nem sustenta terceiros.
    // Le o Bloq_Mask do quadro ANTERIOR de proposito: o snapshot roda antes do calculo do
    // bloqueio deste quadro, e e essa defasagem que permite ao ESTATC manter a trava
    // (correcao acima) sem reintroduzir o falso positivo que motivou o desmonte.
    if((Bloq_Mask >> (i - 1)) & 1) return 0;
    // v3zq: dois casos que IMPEDIAM a resposta no Run_Instance mas nao eram descontados
    // aqui — instancias que nao produziam nada e ainda assim bloqueavam e sustentavam
    // terceiros. Sao os "comandos altos invisiveis" que o Daniel apontou: corrompem a
    // relacao de MOD justamente porque nao ha nada na tela nem no jogo denunciando.
    //   BLOK segurado  -> a resposta esta suspensa AGORA, entao nao esta de pe.
    //   gate de entrada -> nos primeiros quadros apos trocar de perfil ou fechar o
    //                      MenuDin a instancia esta travada e nao detecta nem responde;
    //                      contar como de pe ali podia disparar um EXCL espurio no
    //                      exato instante da troca.
    if((Ent_Trava >> (i - 1)) & 1) return 0;
    if(BTN_FN_Bloqueia_v3(i)) return 0;   // v6c: suspenso nao esta de pe
    if(!Tem_Destino(i)) return 0;   // v3ze: sem destino nao participa de relacao nenhuma
    // v7l: enquanto o DELAY corre, a resposta AINDA NAO SUBIU — e relacao e de RESPOSTA para
    // RESPOSTA. Antes o MOD contava como de pe no instante em que ligava, e numa cadeia de
    // orfaos o segundo subia junto com o primeiro, ignorando o DELAY dele (achado do Daniel
    // no F10). Agora cada elo espera o anterior subir de fato: os DELAYs da cadeia SOMAM.
    if(Get_Delay(i)) {
        if(!((Dly_Arm >> (i - 1)) & 1)) return 0;
        if(Get_Dly(i) > 0) return 0;
    }
    Work_B = Get_F1_Tipo(i);
    if(Work_B == DST_TIPO_TURBO) {
        Work_E = Get_TrbSt_X(i);
        // v3y CORRIGIDO: antes, TrbSt=0 ("nunca iniciou") devolvia 1 — eu tratei como
        // "vai iniciar neste quadro". Errado: TrbSt=0 é o estado de repouso da MAIORIA do
        // tempo (fonte fora da zona, instância recém-ligada, máquina rearmada). Resultado:
        // toda instância TURBO parecia ETERNAMENTE engajada. Como o ASSOC pergunta pela
        // AUSÊNCIA, ele nunca bloqueava nada — testes 10 e 11 do relatório. Agora, quando
        // a máquina não iniciou, a pergunta certa é a mesma do DIRECT: a fonte está na
        // zona? Se estiver, o TURBO de fato arranca neste quadro; se não, está parado.
        if((Work_E >> 16) & 1) {
            // pack "terminado" = timer zerado E fase desligada (igual Trb_Valor_Eixo)
            if((Work_E & 0x7FF) == 0 && !((Work_E >> 11) & 1)) return 0;
            return 1;                          // rodando (inclui a fase de latência)
        }
        // não iniciou: cai no teste de zona lá embaixo
    }
    if(Work_B == DST_TIPO_ESTATC) {
        if(Estatc_Travado(i)) return 1;
    }
    if(Get_Fonte_Tipo(i) == FONTE_NENHUMA) return 1;
    return Zona_Ativa_Fonte(i);
}
// v3w: m bloqueada enquanto um vinculado tiver resposta de pé — agora com desempate para o
// bloqueio MÚTUO (A bloqueia B e B bloqueia A), que antes travava os dois ou oscilava.
//   Regra 1 — alvo INCUMBENTE (engajado também no quadro anterior) bloqueia sempre.
//             É o "quem subiu primeiro mantém o bloqueio": critério funcional, não hierárquico.
//   Regra 2 — alvo NOVO (engajou agora) só bloqueia se m também for nova. Uma incumbente não
//             é derrubada por quem acabou de chegar — bloqueio não é finalizador.
//   Empate real (as duas engajam no MESMO quadro): resolvido pela remoção em cascata abaixo.
// A REMOÇÃO EM CASCATA não é truque de desempate: como bloquear DESMONTA a resposta (decisão
// do Daniel), uma instância recém-bloqueada deixou de responder de fato — tirá-la de
// Bloq_Snap_Resp só mantém o conjunto coerente. O efeito colateral é que, no empate, a
// primeira avaliada (número menor) cai e a outra sobrevive. Determinístico e estável.
// Bônus: EXCL e ASSOC, que consomem Bloq_Snap_Resp depois, passam a enxergar corretamente
// que a bloqueada não está de pé.
function Computar_Bloq_Instancia_v3(m) {
    Work_A = Get_F1_Bloq(m);
    if(!Work_A) return;
    if(Mask_Tem_Bit_Comum(Work_A, Bloq_Snap_Resp & Excl_RespAnt)) {
        Bloq_Mask = Bloq_Mask | (1 << (m - 1));
        Bloq_Snap_Resp = Bloq_Snap_Resp & (~(1 << (m - 1)));
        return;
    }
    // m é incumbente? (engajada agora E no quadro anterior) -> alvo novo não a derruba
    if(((Excl_RespAnt >> (m - 1)) & 1) && ((Bloq_Snap_Resp >> (m - 1)) & 1)) return;
    if(Mask_Tem_Bit_Comum(Work_A, Bloq_Snap_Resp)) {
        Bloq_Mask = Bloq_Mask | (1 << (m - 1));
        Bloq_Snap_Resp = Bloq_Snap_Resp & (~(1 << (m - 1)));
    }
}
// m encerrada quando a RESPOSTA de QUALQUER vinculado sobe (borda) — disparo único.
function Computar_Excl_Instancia_v3(m) {
    Work_A = Get_F1_Excl(m);
    if(!Work_A) return;
    if(Mask_Tem_Bit_Comum(Work_A, Bloq_Snap_Resp & (~Excl_RespAnt))) {
        Excl_Veto = Excl_Veto | (1 << (m - 1));
        Inst_Ativa = Inst_Ativa & (~(1 << (m - 1)));
        // v3y CORRIGIDO (teste 12): faltava marcar a resposta como suprimida. Religa_Fonte
        // exige o bit de Resp_Off_Fonte pra religar ("só religa o que está suprimido"), e
        // como o EXCL nunca o setava, a instância excluída ficava morta pra sempre — a
        // fonte subia de novo e nada acontecia. É o mesmo desgaste de RELIG que já nos
        // custou caro antes, agora pela porta do MOD_EXCL.
        Resp_Off_Fonte = Resp_Off_Fonte | (1 << (m - 1));
        // v3zn (achado do Daniel em B6.10): o EXCL ENCERRA — a resposta e DESMONTADA, nao
        // suspensa. Antes o estado sobrevivia, e uma instancia excluida no meio de uma
        // rajada retomava de onde parou ao voltar, igual ao bloqueio. Isso apagava a
        // distincao entre os dois: o BLOQ suspende e retoma, o EXCL encerra e a volta e um
        // comeco novo. Zerar aqui e o que separa "pausar" de "terminar".
        Set_TrbSt_X(m, 0);
        Set_Estatc_Travado(m, 0);
        Bloq_Snap_Resp = Bloq_Snap_Resp & (~(1 << (m - 1)));   // excluída não está de pé
    }
}
// m só é permitida ENQUANTO pelo menos 1 vinculado APTO estiver de pé — inverso do BLOQ.
// v3y: dois ajustes.
//  (a) alvos inaptos (sem destino / fora do perfil) são descartados. Se sobrar nenhum, não
//      há vínculo a respeitar e m responde livre — antes ela morria pra sempre (teste 15).
//  (b) quando m é barrada, ela SAI do snapshot, pelo mesmo motivo do BLOQ: barrada = não
//      está respondendo, então não pode bloquear/excluir terceiros. Era o teste 17 — o
//      MOD_21 estava suspenso pelo ASSOC e ainda assim derrubava o TURBO do MOD_03.
function Computar_Assoc_Instancia_v3(m) {
    Work_A = Get_F1_Assoc(m) & Mod_Apto;
    if(!Work_A) return;
    if(!Mask_Tem_Bit_Comum(Work_A, Bloq_Snap_Resp)) {
        Assoc_Mask = Assoc_Mask | (1 << (m - 1));
        Bloq_Snap_Resp = Bloq_Snap_Resp & (~(1 << (m - 1)));
    }
}
// v3y: uma instância só PARTICIPA de relação de MOD se puder responder de verdade — tem
// destino marcado E perfil ativo. Sem isso, o ASSOC condenava a instância dependente à
// morte permanente (teste 15: alvo sem destino = nunca "de pé" = ASSOC bloqueia pra sempre).
// Para BLOQ/EXCL a inaptidão já era inofensiva (nunca dispara); é só o ASSOC, que pergunta
// pela AUSÊNCIA, que precisa ignorar alvos inaptos em vez de tratá-los como "parados".
function Snap_Um_v3(i) {
    if(Bloq_Resp_Ativa_v3(i)) Bloq_Snap_Resp = Bloq_Snap_Resp | (1 << (i - 1));
}
function Computar_Snapshot_v3() {
    Bloq_Snap_Resp = 0;
    Mod_Apto = Msk_Apto_Est;   // v7l: estatico (dominio + destino)
    // Bloq_Resp_Ativa_v3 devolve 0 fora do dominio; so os do dominio sao consultados
    if(Msk_Perf & 1) Snap_Um_v3(1);
    if(Msk_Perf & 2) Snap_Um_v3(2);
    if(Msk_Perf & 4) Snap_Um_v3(3);
    if(Msk_Perf & 8) Snap_Um_v3(4);
    if(Msk_Perf & 16) Snap_Um_v3(5);
    if(Msk_Perf & 32) Snap_Um_v3(6);
    if(Msk_Perf & 64) Snap_Um_v3(7);
    if(Msk_Perf & 128) Snap_Um_v3(8);
    if(Msk_Perf & 256) Snap_Um_v3(9);
    if(Msk_Perf & 512) Snap_Um_v3(10);
    if(Msk_Perf & 1024) Snap_Um_v3(11);
    if(Msk_Perf & 2048) Snap_Um_v3(12);
    if(Msk_Perf & 4096) Snap_Um_v3(13);
    if(Msk_Perf & 8192) Snap_Um_v3(14);
    if(Msk_Perf & 16384) Snap_Um_v3(15);
    if(Msk_Perf & 32768) Snap_Um_v3(16);
    if(Msk_Perf & 65536) Snap_Um_v3(17);
    if(Msk_Perf & 131072) Snap_Um_v3(18);
    if(Msk_Perf & 262144) Snap_Um_v3(19);
    if(Msk_Perf & 524288) Snap_Um_v3(20);
    if(Msk_Perf & 1048576) Snap_Um_v3(21);
}
// v3zm CADEIA DE BLOQUEIO (achado do Daniel em B6.9). As instancias sao avaliadas de 1 a
// 21, e numa cadeia "03 bloqueia 02, 02 bloqueia 01" isso dava o resultado errado:
//   o 01 era avaliado PRIMEIRO, via o 02 ainda no snapshot, e era bloqueado;
//   so depois o 02 era bloqueado pelo 03 e saia do snapshot — tarde demais.
// Resultado: subir o 03 nao liberava o 01, embora devesse.
// A correcao e repetir a passada. Cada passada propaga um elo, entao TRES cobrem cadeias
// de ate quatro instancias — o suficiente na pratica, e barato: a avaliacao por instancia
// e so um Get_F1_Bloq mais uma comparacao de mascaras.
// Idempotente: uma instancia ja marcada em Bloq_Mask nao muda de estado ao ser reavaliada,
// entao passadas extras num cenario simples nao alteram nada.
function Computar_Bloq_Passada() {
    if(Msk_Bloq & 1) Computar_Bloq_Instancia_v3(1);
    if(Msk_Bloq & 2) Computar_Bloq_Instancia_v3(2);
    if(Msk_Bloq & 4) Computar_Bloq_Instancia_v3(3);
    if(Msk_Bloq & 8) Computar_Bloq_Instancia_v3(4);
    if(Msk_Bloq & 16) Computar_Bloq_Instancia_v3(5);
    if(Msk_Bloq & 32) Computar_Bloq_Instancia_v3(6);
    if(Msk_Bloq & 64) Computar_Bloq_Instancia_v3(7);
    if(Msk_Bloq & 128) Computar_Bloq_Instancia_v3(8);
    if(Msk_Bloq & 256) Computar_Bloq_Instancia_v3(9);
    if(Msk_Bloq & 512) Computar_Bloq_Instancia_v3(10);
    if(Msk_Bloq & 1024) Computar_Bloq_Instancia_v3(11);
    if(Msk_Bloq & 2048) Computar_Bloq_Instancia_v3(12);
    if(Msk_Bloq & 4096) Computar_Bloq_Instancia_v3(13);
    if(Msk_Bloq & 8192) Computar_Bloq_Instancia_v3(14);
    if(Msk_Bloq & 16384) Computar_Bloq_Instancia_v3(15);
    if(Msk_Bloq & 32768) Computar_Bloq_Instancia_v3(16);
    if(Msk_Bloq & 65536) Computar_Bloq_Instancia_v3(17);
    if(Msk_Bloq & 131072) Computar_Bloq_Instancia_v3(18);
    if(Msk_Bloq & 262144) Computar_Bloq_Instancia_v3(19);
    if(Msk_Bloq & 524288) Computar_Bloq_Instancia_v3(20);
    if(Msk_Bloq & 1048576) Computar_Bloq_Instancia_v3(21);
}
function Computar_Mods_Bloq_v3() {
    // v3zm: TRES passadas, restaurando o snapshot entre elas. Zerar so a mascara nao
    // bastava — uma instancia marcada nunca desmarcava dentro do quadro, e a cadeia
    // continuava errada. Restaurando o snapshot original e descontando APENAS quem
    // continua bloqueado, cada passada corrige o excesso da anterior.
    //   3 elos (01<-02, 02<-03): 1 passada da [1,2] bloqueados (errado);
    //                            2 passadas dao [2], que e o esperado — subir o 03
    //                            libera o 01, porque o 02 deixou de responder.
    // A terceira cobre cadeias de quatro. E barato: cada passada e um Get_F1_Bloq mais
    // uma comparacao de mascaras por instancia, sem tocar em fonte nem em destino.
    Snap_Orig = Bloq_Snap_Resp;
    Bloq_Mask = 0;
    if(!Msk_Bloq) return;     // v7l: nenhum MOD com BLOQ
    Computar_Bloq_Passada();
    // v7l: ninguem bloqueado na primeira passada = as outras duas dariam o mesmo resultado
    if(!Bloq_Mask) return;
    Bloq_Snap_Resp = Snap_Orig & (~Bloq_Mask);
    Bloq_Mask = 0;
    Computar_Bloq_Passada();
    Bloq_Snap_Resp = Snap_Orig & (~Bloq_Mask);
    Bloq_Mask = 0;
    Computar_Bloq_Passada();
    Bloq_Snap_Resp = Snap_Orig & (~Bloq_Mask);
}
function Computar_Mods_Excl_v3() {
    if(Msk_Excl & 1) Computar_Excl_Instancia_v3(1);
    if(Msk_Excl & 2) Computar_Excl_Instancia_v3(2);
    if(Msk_Excl & 4) Computar_Excl_Instancia_v3(3);
    if(Msk_Excl & 8) Computar_Excl_Instancia_v3(4);
    if(Msk_Excl & 16) Computar_Excl_Instancia_v3(5);
    if(Msk_Excl & 32) Computar_Excl_Instancia_v3(6);
    if(Msk_Excl & 64) Computar_Excl_Instancia_v3(7);
    if(Msk_Excl & 128) Computar_Excl_Instancia_v3(8);
    if(Msk_Excl & 256) Computar_Excl_Instancia_v3(9);
    if(Msk_Excl & 512) Computar_Excl_Instancia_v3(10);
    if(Msk_Excl & 1024) Computar_Excl_Instancia_v3(11);
    if(Msk_Excl & 2048) Computar_Excl_Instancia_v3(12);
    if(Msk_Excl & 4096) Computar_Excl_Instancia_v3(13);
    if(Msk_Excl & 8192) Computar_Excl_Instancia_v3(14);
    if(Msk_Excl & 16384) Computar_Excl_Instancia_v3(15);
    if(Msk_Excl & 32768) Computar_Excl_Instancia_v3(16);
    if(Msk_Excl & 65536) Computar_Excl_Instancia_v3(17);
    if(Msk_Excl & 131072) Computar_Excl_Instancia_v3(18);
    if(Msk_Excl & 262144) Computar_Excl_Instancia_v3(19);
    if(Msk_Excl & 524288) Computar_Excl_Instancia_v3(20);
    if(Msk_Excl & 1048576) Computar_Excl_Instancia_v3(21);
    Excl_RespAnt = Bloq_Snap_Resp;
}
// v7b: liga os MODs ORFAOS na BORDA do ASSOC. Orfao = sem ALFA e sem GAMA que ligue,
// mas com ZETA ASSOC — a combinacao que antes era inerte e que a v3zy passou a adotar.
// Aqui a adocao virou um EVENTO, nao um estado permanente: quando um alvo do ASSOC
// passa de parado a de pe, o orfao liga. A partir dai ele obedece ao proprio estado,
// entao um GAMA em FINALIZA consegue derruba-lo — e ele so volta quando o alvo subir
// de novo. E o comportamento que o MOD_03 do futebol pede: a corrida sobe com o
// movimento, o toque no TOUCH corta, e voltar a mover traz de volta.
// v7i: um MOD ORFAO com DELTA DIRECT ou TURBO passa a responder com a INTENSIDADE do
// alvo que o adotou, em vez de 100% fixo. Foi o Daniel quem apontou: um DIRECT orfao
// se comportava como STATIC (0 ou 100), quando o natural e seguir a metrica do MOD
// "matriz" — o ALFA e o BETA dele ja definem quanto o sinal vale.
// v7l: numa cadeia de orfaos a metrica vem do primeiro MOD com fonte, subindo a cadeia.
// Devolve -1 quando nao ha alvo com fonte de onde herdar.
function Valor_Alvo_Assoc(num) {
    // v7l: sobe a CADEIA. Se o alvo tambem e orfao, olha o alvo dele, ate 4 niveis, e usa
    // o primeiro MOD com ALFA que encontrar. Antes so o alvo direto contava, e um orfao de
    // orfao respondia a 100% (pedido do Daniel no F10). Va_Visto impede andar em circulo.
    Va_Msk = Get_F1_Assoc(num) & Mod_Apto;
    Va_Visto = 1 << (num - 1);
    Va_Nv = 0;
    while(Va_Msk && Va_Nv < 4) {
        Va_Visto = Va_Visto | Va_Msk;
        Va_Prox = 0;
        Esp_I = 1;
        while(Esp_I <= 21) {
            if((Va_Msk >> (Esp_I - 1)) & 1) {
                if(Get_Fonte_Tipo(Esp_I) != FONTE_NENHUMA) {
                    if(Zona_Ativa_Fonte(Esp_I)) return Cond_Aplicar_Fonte(Esp_I, Ler_Fonte(Esp_I));
                } else {
                    Va_Prox = Va_Prox | (Get_F1_Assoc(Esp_I) & Mod_Apto);
                }
            }
            Esp_I = Esp_I + 1;
        }
        Va_Msk = Va_Prox & (~Va_Visto);
        Va_Nv = Va_Nv + 1;
    }
    return -1;
}
function Orfao_Adotado(num) {
    if(Get_Fonte_Tipo(num) != FONTE_NENHUMA) return 0;
    if(Tem_Gatilho_Estado(num)) return 0;
    return Get_F1_Assoc(num) != 0;
}
function Adotar_Orfao(m) {
    if(Get_Fonte_Tipo(m) != FONTE_NENHUMA) return;
    if(Tem_Gatilho_Estado(m)) return;
    Work_A = Get_F1_Assoc(m);
    if(!Work_A) return;
    Work_A = Work_A & Mod_Apto;
    if(!Work_A) return;
    // subiu agora = esta de pe neste quadro e NAO estava no anterior
    if(Mask_Tem_Bit_Comum(Work_A, Bloq_Snap_Resp & (~Excl_RespAnt))) {
        Inst_Ativa = Inst_Ativa | (1 << (m - 1));
        Aplicar_RespOff_Inst(m);
    }
}
function Adotar_Orfaos() {
    if(Msk_Orfao & 1) Adotar_Orfao(1);
    if(Msk_Orfao & 2) Adotar_Orfao(2);
    if(Msk_Orfao & 4) Adotar_Orfao(3);
    if(Msk_Orfao & 8) Adotar_Orfao(4);
    if(Msk_Orfao & 16) Adotar_Orfao(5);
    if(Msk_Orfao & 32) Adotar_Orfao(6);
    if(Msk_Orfao & 64) Adotar_Orfao(7);
    if(Msk_Orfao & 128) Adotar_Orfao(8);
    if(Msk_Orfao & 256) Adotar_Orfao(9);
    if(Msk_Orfao & 512) Adotar_Orfao(10);
    if(Msk_Orfao & 1024) Adotar_Orfao(11);
    if(Msk_Orfao & 2048) Adotar_Orfao(12);
    if(Msk_Orfao & 4096) Adotar_Orfao(13);
    if(Msk_Orfao & 8192) Adotar_Orfao(14);
    if(Msk_Orfao & 16384) Adotar_Orfao(15);
    if(Msk_Orfao & 32768) Adotar_Orfao(16);
    if(Msk_Orfao & 65536) Adotar_Orfao(17);
    if(Msk_Orfao & 131072) Adotar_Orfao(18);
    if(Msk_Orfao & 262144) Adotar_Orfao(19);
    if(Msk_Orfao & 524288) Adotar_Orfao(20);
    if(Msk_Orfao & 1048576) Adotar_Orfao(21);
}
function Computar_Mods_Assoc_v3() {
    Assoc_Mask = 0;
    if(Msk_Assoc & 1) Computar_Assoc_Instancia_v3(1);
    if(Msk_Assoc & 2) Computar_Assoc_Instancia_v3(2);
    if(Msk_Assoc & 4) Computar_Assoc_Instancia_v3(3);
    if(Msk_Assoc & 8) Computar_Assoc_Instancia_v3(4);
    if(Msk_Assoc & 16) Computar_Assoc_Instancia_v3(5);
    if(Msk_Assoc & 32) Computar_Assoc_Instancia_v3(6);
    if(Msk_Assoc & 64) Computar_Assoc_Instancia_v3(7);
    if(Msk_Assoc & 128) Computar_Assoc_Instancia_v3(8);
    if(Msk_Assoc & 256) Computar_Assoc_Instancia_v3(9);
    if(Msk_Assoc & 512) Computar_Assoc_Instancia_v3(10);
    if(Msk_Assoc & 1024) Computar_Assoc_Instancia_v3(11);
    if(Msk_Assoc & 2048) Computar_Assoc_Instancia_v3(12);
    if(Msk_Assoc & 4096) Computar_Assoc_Instancia_v3(13);
    if(Msk_Assoc & 8192) Computar_Assoc_Instancia_v3(14);
    if(Msk_Assoc & 16384) Computar_Assoc_Instancia_v3(15);
    if(Msk_Assoc & 32768) Computar_Assoc_Instancia_v3(16);
    if(Msk_Assoc & 65536) Computar_Assoc_Instancia_v3(17);
    if(Msk_Assoc & 131072) Computar_Assoc_Instancia_v3(18);
    if(Msk_Assoc & 262144) Computar_Assoc_Instancia_v3(19);
    if(Msk_Assoc & 524288) Computar_Assoc_Instancia_v3(20);
    if(Msk_Assoc & 1048576) Computar_Assoc_Instancia_v3(21);
}


// Varre as 16 instâncias (chamadas explícitas — sem while, evita timeout de ciclo)
function Recalc_Um(i) {
    // contadores dedicados: Tem_Destino e os getters usam os Work_* por dentro
    Rc_A = Get_Spvar_A(i);
    Rc_B = 1 << (i - 1);
    if(CurrentMode > 0 && ((Rc_A >> CurrentMode) & 1)) {
        Msk_Perf = Msk_Perf | Rc_B;
        if(Rc_A & 1) Msk_Run = Msk_Run | Rc_B;
        if(Tem_Destino(i)) Msk_Apto_Est = Msk_Apto_Est | Rc_B;
    }
    if(Get_F1_Assoc(i)) {
        Msk_Assoc = Msk_Assoc | Rc_B;
        if(Get_Fonte_Tipo(i) == FONTE_NENHUMA && !Tem_Gatilho_Estado(i)) Msk_Orfao = Msk_Orfao | Rc_B;
    }
    if(Tem_Gatilho_Estado(i)) Msk_GatEst = Msk_GatEst | Rc_B;
    else if(Get_Fonte_Tipo(i) != FONTE_NENHUMA) Msk_Livre = Msk_Livre | Rc_B;
    if(Get_F1_Bloq(i)) Msk_Bloq = Msk_Bloq | Rc_B;
    if(Get_F1_Excl(i)) Msk_Excl = Msk_Excl | Rc_B;
}
function Recalc_Mascaras() {
    Msk_Perf = 0; Msk_Run = 0; Msk_Apto_Est = 0; Msk_Orfao = 0;
    Msk_Assoc = 0; Msk_Bloq = 0; Msk_Excl = 0; Msk_GatEst = 0; Msk_Livre = 0;
    Recalc_Um(1);
    Recalc_Um(2);
    Recalc_Um(3);
    Recalc_Um(4);
    Recalc_Um(5);
    Recalc_Um(6);
    Recalc_Um(7);
    Recalc_Um(8);
    Recalc_Um(9);
    Recalc_Um(10);
    Recalc_Um(11);
    Recalc_Um(12);
    Recalc_Um(13);
    Recalc_Um(14);
    Recalc_Um(15);
    Recalc_Um(16);
    Recalc_Um(17);
    Recalc_Um(18);
    Recalc_Um(19);
    Recalc_Um(20);
    Recalc_Um(21);
    Cfg_Sujo = FALSE;
}
function Run_Pipeline() {
    Spv_N = -1;               // v7l: cache so vale dentro do pipeline
    if(Cfg_Sujo) Recalc_Mascaras();
    Zerar_Acc();
    // v3y REORDENADO: snapshot primeiro; ASSOC antes do BLOQ. O ASSOC agora remove do
    // snapshot quem ele barra, e o BLOQ precisa ver esse snapshot ja limpo — senao uma
    // instancia suspensa pelo ASSOC ainda bloqueia terceiros (teste 17). EXCL fica por
    // ultimo porque e ele quem renova Excl_RespAnt para o proximo quadro.
    Computar_Snapshot_v3();
    Adotar_Orfaos();          // v7b: a borda do ASSOC liga os orfaos
    Computar_Mods_Assoc_v3();
    Computar_Mods_Bloq_v3();
    Computar_Mods_Excl_v3();
    if(Msk_Run & 1) Run_Instance_v3(1);
    if(Msk_Run & 2) Run_Instance_v3(2);
    if(Msk_Run & 4) Run_Instance_v3(3);
    if(Msk_Run & 8) Run_Instance_v3(4);
    if(Msk_Run & 16) Run_Instance_v3(5);
    if(Msk_Run & 32) Run_Instance_v3(6);
    if(Msk_Run & 64) Run_Instance_v3(7);
    if(Msk_Run & 128) Run_Instance_v3(8);
    if(Msk_Run & 256) Run_Instance_v3(9);
    if(Msk_Run & 512) Run_Instance_v3(10);
    if(Msk_Run & 1024) Run_Instance_v3(11);
    if(Msk_Run & 2048) Run_Instance_v3(12);
    if(Msk_Run & 4096) Run_Instance_v3(13);
    if(Msk_Run & 8192) Run_Instance_v3(14);
    if(Msk_Run & 16384) Run_Instance_v3(15);
    if(Msk_Run & 32768) Run_Instance_v3(16);
    if(Msk_Run & 65536) Run_Instance_v3(17);
    if(Msk_Run & 131072) Run_Instance_v3(18);
    if(Msk_Run & 262144) Run_Instance_v3(19);
    if(Msk_Run & 524288) Run_Instance_v3(20);
    if(Msk_Run & 1048576) Run_Instance_v3(21);
    Spv_N = -1;               // v7l: o menu edita SPVARs direto; nada de cache fora daqui
    Aplicar_Acc();
}

// =============================================================
// SEÇÃO 13 — NAVEGACAO E EDICAO DA LISTA DE MODs
// =============================================================


// v7d: helpers do pacote TURBO por MOD. O layout descrito aqui (PERM/LAT/MODO/CICLOS
// em 14 bits) e da v3zc — hoje LAT e CICLOS moram no SPVAR_C e os tempos no pack de 12
// bits repartido. Ver o mapa de bits.

// CICLOS do TURBO: 0=ATIVO (enquanto ativo), 1-10 = número de oscilações

// === TURBO do EIXO_Y (independente) ===

// Cada passo = 15 bits: btn(bits 0-4), perm(bits 5-9), lat(bits 10-14)
// Passo 1,2 em CMB_A (shift 0,15); 3,4 em CMB_B; 5 em CMB_C
// Grava o passo (1-5) da instância num com btn/perm/lat


// === RELIG da fonte por eixo ===


// Ajusta ScrollTop quando cursor desce
// v3zx: o parametro 'total_items' nunca foi lido — a funcao sempre trabalhou so com
// MenuCursor e ScrollTop. Removido para zerar o unico warning do compilador.
function Ajust_Scroll_Down() {
    if(MenuCursor >= ScrollTop + VISIBLE_ROWS) {
        ScrollTop = MenuCursor - VISIBLE_ROWS + 1;
    }
    if(MenuCursor == 0) ScrollTop = 0;
}
// Ajusta rolagem dos modificadores de condição (2 linhas visíveis)
function Ajust_Scr_Cond() {
    if(Wz_SubCursor < Wz_ScrTop) Wz_ScrTop = Wz_SubCursor;
    if(Wz_SubCursor > Wz_ScrTop + 1) Wz_ScrTop = Wz_SubCursor - 1;
    if(Wz_SubCursor == 0) Wz_ScrTop = 0;
}
// Rolagem das telas de botões (lista contínua). Janela de 2 linhas visíveis.
function Ajust_Scr_Btn() {
    if(Wz_SubCursor < Wz_ScrTop) Wz_ScrTop = Wz_SubCursor;
    if(Wz_SubCursor > Wz_ScrTop + 1) Wz_ScrTop = Wz_SubCursor - 1;
    if(Wz_SubCursor == 0) Wz_ScrTop = 0;
}
// Ajusta ScrollTop quando cursor sobe
function Ajust_Scroll_Up() {
    // Caso normal: cursor saiu pela parte de cima da janela
    if(MenuCursor < ScrollTop) ScrollTop = MenuCursor;
    // Wrap circular para o topo
    if(MenuCursor == 0) ScrollTop = 0;
    // Wrap circular para o fim: ajusta ScrollTop para mostrar ultimos itens
    if(MenuCursor > ScrollTop + VISIBLE_ROWS - 1) {
        ScrollTop = MenuCursor - VISIBLE_ROWS + 1;
        if(ScrollTop < 0) ScrollTop = 0;
    }
}
// Reset da página atual (SQ 1s)
// Salva a posição atual do cursor da tela 'md'
function Save_Cur(md) {
    if(md ==  2) Cur_2  = Wz_SubCursor;
    if(md ==  3) Cur_3  = Wz_SubCursor;
    if(md ==  4) Cur_4  = Wz_SubCursor;
    if(md ==  5) Cur_5  = Wz_SubCursor;
    if(md ==  6) Cur_6  = Wz_SubCursor;
    if(md ==  7) Cur_7  = Wz_SubCursor;
    if(md ==  8) { Cur_8  = Wz_SubCursor; Top_8  = Wz_ScrTop; }
    if(md ==  9) Cur_9  = Wz_SubCursor;
    if(md == 10) { Cur_10 = Wz_SubCursor; Top_10 = Wz_ScrTop; }
    if(md == 36) Cur_36 = Wz_SubCursor;
    if(md == 16) Cur_16 = Wz_SubCursor;
    if(md == 17) { Cur_17 = Wz_SubCursor; Top_17 = Wz_ScrTop; }
}
// Restaura a posição do cursor da tela 'md' (chamada ao entrar)
function Load_Cur(md) {
    if(md ==  2) Wz_SubCursor = Cur_2;
    if(md ==  3) Wz_SubCursor = Cur_3;
    if(md ==  4) Wz_SubCursor = Cur_4;
    if(md ==  5) Wz_SubCursor = Cur_5;
    if(md ==  6) Wz_SubCursor = Cur_6;
    if(md ==  7) Wz_SubCursor = Cur_7;
    if(md ==  8) { Wz_SubCursor = Cur_8;  Wz_ScrTop = Top_8;  }
    if(md ==  9) Wz_SubCursor = Cur_9;
    if(md == 10) { Wz_SubCursor = Cur_10; Wz_ScrTop = Top_10; }
    if(md == 36) Wz_SubCursor = Cur_36;
    if(md == 16) Wz_SubCursor = Cur_16;
    if(md == 17) { Wz_SubCursor = Cur_17; Wz_ScrTop = Top_17; }
}
// Zera todas as memórias de cursor (ao abrir/criar instância)
function Reset_Cursors() {
    Cur_2=0; Cur_3=0; Cur_4=0; Cur_5=0; Cur_6=0;
    Cur_7=0; Cur_8=0; Cur_9=0; Cur_10=0; Cur_36=0;
    Top_8=0; Top_10=0; Cur_16=0; Cur_17=0; Top_17=0;
}
// v7l: na tela de DOMINIOS o SQUARE 1s zera o MOD INTEIRO — dominios, ALFA/BETA, GAMA,
// DELTA, DELAY e ZETA (inclusive BLOK e FINALIZA) — e nao so os dominios, como antes.
// Pedido do Daniel no H15. O MOD continua existindo, na mesma posicao, e quem aponta para
// ele no ZETA continua apontando. Os valores voltam aos de um MOD recem-criado.
// Vale em RAM: o indicador R aparece ao confirmar, e so o SHARE grava na EEPROM.
function Reset_Page() {
    if(MenuDin == 36) {
        Wz_S1 = FALSE; Wz_S2 = FALSE; Wz_S3 = FALSE; Wz_S4 = FALSE;
        Set_Spvar_A(WzSlot, 1);        // so o SLOT_USED
        Set_Spvar_B(WzSlot, 0);
        Set_Spvar_C(WzSlot, 0);
        Zero_F1_Behavior(WzSlot);      // os mesmos padroes de um MOD novo
        Set_F1_Excl(WzSlot, 0); Set_F1_Assoc(WzSlot, 0); Set_F1_Bloq(WzSlot, 0);
        Set_Blok(WzSlot, 0);
        Set_Fin(WzSlot, 0);
        Set_TrbSt_X(WzSlot, 0);
        Set_Estatc_Travado(WzSlot, 0);
        Delay_Zerar(WzSlot);
        Inst_Ativa = Inst_Ativa & (~(1 << (WzSlot - 1)));
        Vib_Disparar();       // confirma no controle que o reset aconteceu
    }
}
// Cria nova instância (zera SPVAR_A com SLOT_USED=1)
function Criar_Instancia() {
    Total_Inst++;
    // SLOT_USED = 1, todos os outros bits = 0 (sem perfil, sem fonte, RELIG do 2CLK = NÃO)
    Set_Spvar_A(Total_Inst, 1);
    Set_Spvar_B(Total_Inst, 0);
    Set_Spvar_C(Total_Inst, 0);
    Zero_F1_Behavior(Total_Inst);  // garante defaults limpos (sem lixo de posição reusada)
    // v3z7: instancia nova nasce SEM indicador — nem R nem E. So aparece algo depois que
    // o usuario confirmar (R) ou salvar (E). Limpar aqui importa porque a posicao pode
    // estar sendo REUSADA depois de uma delecao.
    Cfg_Ram   = Cfg_Ram   & (~(1 << (Total_Inst - 1)));
    Cfg_Salvo = Cfg_Salvo & (~(1 << (Total_Inst - 1)));
    Cfg_Mov   = Cfg_Mov   & (~(1 << (Total_Inst - 1)));   // v3zv
    Reset_Cursors();               // cursor de cada tela recomeça do topo
    // Entra direto no wizard da nova instância
    WzSlot      = Total_Inst;
    Load_Wz(WzSlot);
    MenuCursor  = WzSlot - 1;
    MenuDin     = 36;
    Wz_SubCursor = 0;
    Wz_Entrando = TRUE;
}
// ===== v3zu: REORDENACAO DE MODs =====
// Troca com o vizinho, via L2 + UP/DOWN na lista. Repetindo, chega-se a qualquer posicao.
// A ordem nao e so cosmetica: ela decide o desempate do BLOQUEIO MUTUO e a propagacao em
// CADEIA (o pipeline avalia de 1 a 21). Ate agora isso era acidental — definido por quem
// foi criado primeiro. Com a reordenacao, passa a ser escolha.
//
// O que precisa acompanhar a troca, apurado contra o Compact_Pos da delecao:
//   os 3 SPVARs, as 3 mascaras de MOD, o tempo do AFTER, o GT_Relig,
//   os indicadores R/E, e as REFERENCIAS de todos os outros MODs.
// O estado de execucao (Inst_Ativa, TrbSt, travas) nao e movido: Inicializar_Estado o
// reconstroi no fim, exatamente como a delecao ja faz.

// Troca os bits pa e pb de uma mascara. E aqui que a reindexacao difere da delecao:
// la um bit SAI e os de cima descem; aqui dois bits trocam de lugar entre si.
function Swap_Mask_Bits(mask, pa, pb) {
    Swp_A = (mask >> pa) & 1;
    Swp_B = (mask >> pb) & 1;
    mask = mask & (~(1 << pa));
    mask = mask & (~(1 << pb));
    if(Swp_B) mask = mask | (1 << pa);
    if(Swp_A) mask = mask | (1 << pb);
    return mask;
}
// Reindexa as referencias de UM slot. Vale para todos, inclusive os dois que estao
// trocando: um MOD pode apontar para o outro, ou para si mesmo via terceiros.
function Swap_Ref_Slot(slot, pa, pb) {
    Set_F1_Excl(slot,  Swap_Mask_Bits(Get_F1_Excl(slot),  pa, pb));
    Set_F1_Assoc(slot, Swap_Mask_Bits(Get_F1_Assoc(slot), pa, pb));
    Set_F1_Bloq(slot,  Swap_Mask_Bits(Get_F1_Bloq(slot),  pa, pb));
}
function Swap_Refs(pa, pb) {
    Swap_Ref_Slot(1,  pa, pb); Swap_Ref_Slot(2,  pa, pb); Swap_Ref_Slot(3,  pa, pb);
    Swap_Ref_Slot(4,  pa, pb); Swap_Ref_Slot(5,  pa, pb); Swap_Ref_Slot(6,  pa, pb);
    Swap_Ref_Slot(7,  pa, pb); Swap_Ref_Slot(8,  pa, pb); Swap_Ref_Slot(9,  pa, pb);
    Swap_Ref_Slot(10, pa, pb); Swap_Ref_Slot(11, pa, pb); Swap_Ref_Slot(12, pa, pb);
    Swap_Ref_Slot(13, pa, pb); Swap_Ref_Slot(14, pa, pb); Swap_Ref_Slot(15, pa, pb);
    Swap_Ref_Slot(16, pa, pb); Swap_Ref_Slot(17, pa, pb); Swap_Ref_Slot(18, pa, pb);
    Swap_Ref_Slot(19, pa, pb); Swap_Ref_Slot(20, pa, pb); Swap_Ref_Slot(21, pa, pb);
}
// Troca um bit entre duas posicoes numa mascara global (indicadores R/E).
function Swap_Ind(pa, pb) {
    Cfg_Ram   = Swap_Mask_Bits(Cfg_Ram,   pa, pb);
    Cfg_Salvo = Swap_Mask_Bits(Cfg_Salvo, pa, pb);
}
// Troca o CONTEUDO de duas posicoes. a e b sao 1-based.
function Swap_Pos(a, b) {
    Swp_T = Get_Spvar_A(a); Set_Spvar_A(a, Get_Spvar_A(b)); Set_Spvar_A(b, Swp_T);
    Swp_T = Get_Spvar_B(a); Set_Spvar_B(a, Get_Spvar_B(b)); Set_Spvar_B(b, Swp_T);
    Swp_T = Get_Spvar_C(a); Set_Spvar_C(a, Get_Spvar_C(b)); Set_Spvar_C(b, Swp_T);
    Swp_T = Get_F1_Excl(a);  Set_F1_Excl(a,  Get_F1_Excl(b));  Set_F1_Excl(b,  Swp_T);
    Swp_T = Get_F1_Assoc(a); Set_F1_Assoc(a, Get_F1_Assoc(b)); Set_F1_Assoc(b, Swp_T);
    Swp_T = Get_F1_Bloq(a);  Set_F1_Bloq(a,  Get_F1_Bloq(b));  Set_F1_Bloq(b,  Swp_T);
    Swp_T = Get_GT_Relig(a); Set_GT_Relig(a, Get_GT_Relig(b)); Set_GT_Relig(b, Swp_T);
    // as referencias de TODOS os slots passam a apontar para as posicoes novas.
    // Roda DEPOIS da troca de conteudo: as mascaras ja trocaram junto com seus donos,
    // e agora os bits dentro delas sao reindexados de uma vez so.
    Swap_Refs(a - 1, b - 1);
    Swap_Ind(a - 1, b - 1);
    if(a <= MAX_INST_EEP) Save_Instance(a);
    if(b <= MAX_INST_EEP) Save_Instance(b);
    Cfg_Mov = Cfg_Mov | (1 << (a - 1));   // v3zv: gravados por reordenacao
    Cfg_Mov = Cfg_Mov | (1 << (b - 1));
    // v3zu: o Save_Instance marca as duas como SALVAS, o que seria mentira se alguma
    // estivesse so em RAM. Reordenar de fato grava — igual a delecao, e pelo mesmo
    // motivo: a EEPROM precisa refletir as posicoes novas ou o proximo boot carrega
    // tudo trocado. Entao o indicador E ali esta correto.
    Inicializar_Estado();   // reconstroi o estado de execucao nas posicoes novas
}
// =============================================================
// FUNÇÕES DE DELEÇÃO
// =============================================================
// Deleta instância num e compacta a lista
// Sequência: ajusta refs → compacta RAM → grava EEPROM → zera última posição
function Deletar_Instancia(num) {
    // PASSO 1: Ajusta referências MODs em todas as instâncias
    Ajustar_Refs(num);
    // PASSO 2: Compacta — desloca N+1 para N a partir de num
    Compactar_Lista(num);
    // PASSO 3: Zera a última posição (que agora está duplicada)
    Zerar_Posicao(Total_Inst);
    // PASSO 4: Decrementa total
    Total_Inst--;
    // PASSO 5: Reconstrói o estado lig/desl (Inst_Ativa) pelo INIC nas novas posições.
    // A compactação reorganiza os slots, mas a máscara de estado em RAM não acompanha;
    // sem isto, instâncias com INIC ativo ficam inativas até um novo Commit.
    Inicializar_Estado();
}
// Ajusta todas as referências MODs após deleção da instância num
// Regras: == num → zera | > num → decrementa | < num → mantém
// Sem while loop — chamadas explícitas para evitar timeout de ciclo GPC
function Ajustar_Refs(num) {
    Ajust_Ref_Slot(1,  num);
    Ajust_Ref_Slot(2,  num);
    Ajust_Ref_Slot(3,  num);
    Ajust_Ref_Slot(4,  num);
    Ajust_Ref_Slot(5,  num);
    Ajust_Ref_Slot(6,  num);
    Ajust_Ref_Slot(7,  num);
    Ajust_Ref_Slot(8,  num);
    Ajust_Ref_Slot(9,  num);
    Ajust_Ref_Slot(10, num);
    Ajust_Ref_Slot(11, num);
    Ajust_Ref_Slot(12, num);
    Ajust_Ref_Slot(13, num);
    Ajust_Ref_Slot(14, num);
    Ajust_Ref_Slot(15, num);
    Ajust_Ref_Slot(16, num);
    Ajust_Ref_Slot(17, num);
    Ajust_Ref_Slot(18, num);
    Ajust_Ref_Slot(19, num);
    Ajust_Ref_Slot(20, num);
    Ajust_Ref_Slot(21, num);
}
// Ajusta referências de MODs de um slot específico
// Só processa slots com instância existente e diferentes do deletado
// Remove o bit da instância deletada (p=num-1) de uma máscara e compacta os superiores.
// Retorna a máscara ajustada. Work_D/Work_E usados como temporários.
function Shift_Mask_Del(mask, p) {
    // bits abaixo de p ficam; bits acima de p descem uma posição; bit p some
    Work_D = mask & ((1 << p) - 1);          // parte baixa (preserva)
    Work_E = mask & (~((1 << (p + 1)) - 1));  // parte alta (acima de p)
    Work_E = (Work_E >> 1) & 0x1FFFFF;        // desce 1, limita a 21 bits (v3x: era 0x7FFF,
                                              // 15 bits — mesmo resquício de 16 instâncias
                                              // do Mask_Tem_Bit_Comum. Truncava referências
                                              // às instâncias 16-21 a cada deleção.)
    return Work_D | Work_E;
}
function Ajust_Ref_Slot(slot, num) {
    if(slot == num) return;
    if(slot > Total_Inst) return;  // slot além do total — ignora
    Work_C = num - 1;  // posição do bit da instância deletada
    // v3z5 ETAPA 1: so as 3 mascaras VIVAS. As mascaras de MODO (_M) saíram junto com o
    // ATV/PASS na v3-i — a logica de MOD hoje usa criterio unico de RESPOSTA e nunca le
    // esses bits. O bloco F2 saiu pelo mesmo motivo: a FONTE_2 nao existe mais na v3
    // (fonte unica desde V3-c). Eram os dois unicos pontos que mantinham esses dados vivos.
    Set_F1_Excl(slot,  Shift_Mask_Del(Get_F1_Excl(slot),  Work_C));
    Set_F1_Assoc(slot, Shift_Mask_Del(Get_F1_Assoc(slot), Work_C));
    Set_F1_Bloq(slot,  Shift_Mask_Del(Get_F1_Bloq(slot),  Work_C));
}
// Compacta lista deslocando N+1 para N a partir da posição deletada
// Sem while loop — chamadas explícitas por posição para evitar timeout GPC
function Compactar_Lista(num) {
    if(num <= 1 && Total_Inst > 1) Compact_Pos(1, 2);
    if(num <= 2 && Total_Inst > 2) Compact_Pos(2, 3);
    if(num <= 3 && Total_Inst > 3) Compact_Pos(3, 4);
    if(num <= 4 && Total_Inst > 4) Compact_Pos(4, 5);
    if(num <= 5 && Total_Inst > 5) Compact_Pos(5, 6);
    if(num <= 6 && Total_Inst > 6) Compact_Pos(6, 7);
    if(num <= 7 && Total_Inst > 7) Compact_Pos(7, 8);
    if(num <= 8 && Total_Inst > 8) Compact_Pos(8, 9);
    if(num <= 9 && Total_Inst > 9) Compact_Pos(9, 10);
    if(num <= 10 && Total_Inst > 10) Compact_Pos(10, 11);
    if(num <= 11 && Total_Inst > 11) Compact_Pos(11, 12);
    if(num <= 12 && Total_Inst > 12) Compact_Pos(12, 13);
    if(num <= 13 && Total_Inst > 13) Compact_Pos(13, 14);
    if(num <= 14 && Total_Inst > 14) Compact_Pos(14, 15);
    if(num <= 15 && Total_Inst > 15) Compact_Pos(15, 16);
    if(num <= 16 && Total_Inst > 16) Compact_Pos(16, 17);
    if(num <= 17 && Total_Inst > 17) Compact_Pos(17, 18);
    if(num <= 18 && Total_Inst > 18) Compact_Pos(18, 19);
    if(num <= 19 && Total_Inst > 19) Compact_Pos(19, 20);
    if(num <= 20 && Total_Inst > 20) Compact_Pos(20, 21);
}
function Zero_F1_Behavior(pos) {
    // LIMPEZA: removidas ~15 linhas que setavam variáveis do sistema antigo (F1X/F1Y/
    // GATILHO/MODs velhos) — nunca foram flagadas como mortas pelo compilador porque são
    // chamadas de dentro desta função (que É viva), mas escreviam em dados que NADA lê
    // mais. Essa era, coincidentemente, a causa raiz dos "defaults estranhos": esta função
    // nunca configurava as condicionais NOVAS (Cond_Mult etc, que vivem no SPVAR_B), então
    // uma instância nova ficava com SPVAR_B cru = 0, que decodifica errado (MULT=OFF,
    // THR_IN=0, DIR=NEG) em vez dos defaults sensatos abaixo.
    Set_Cond_Mult(pos, 9);    // v3za: x1.0 na escala sem OFF
    Set_Cond_ThrIn(pos, 1);   // 5
    Set_Cond_ThrOut(pos, 0);  // OFF (já era o default correto via bit cru)
    Set_Cond_Dir(pos, 1);     // ABS
    Set_GT_Relig(pos, 0); // v3: RELIG do 2CLK em RAM — default NÃO
    Set_Hold_Modo(pos, 0);  // v3z8: default APOS (comportamento classico)
}
// Copia dados da posição src para dst em RAM e grava EEPROM se necessário
function Compact_Pos(dst, src) {
    Set_Spvar_A(dst, Get_Spvar_A(src));
    Set_Spvar_B(dst, Get_Spvar_B(src));
    Set_Spvar_C(dst, Get_Spvar_C(src));
    Set_F1_Excl(dst,  Get_F1_Excl(src));
    Set_F1_Assoc(dst, Get_F1_Assoc(src));
    Set_F1_Bloq(dst,  Get_F1_Bloq(src));
    Set_GT_Relig(dst, Get_GT_Relig(src)); // v3: trava do ESTATC (bit1) — estado volatil
    // v3zb: o Hold_Relig saiu — nao ha mais nada indexado por POSICAO fora dos SPVARs,
    // entao a compactacao da delecao ficou mais simples.
    // v3z5 ETAPA 1: Copy_F1_Behavior e os F2_* saíram. Aquela funcao copiava 42 campos e
    // NENHUM deles era lido pela execucao v3 — F1X/F1Y (fonte por eixo, morta desde a fonte
    // unica), GATILHO/BTN_FN velhos (hoje no SPVAR_B/C), TAIL, TRB_* (hoje no SPVAR_C),
    // mascaras _M e todo o bloco F2. Tudo o que a v3 realmente usa ja esta nas 6 linhas
    // acima: os 3 SPVARs (que carregam fonte, condicionais, gatilhos, destino, TURBO, INIC
    // e os dois RELIG persistentes), os 3 MODs, o tempo do FA e o RELIG do HOLD.
    if(dst <= MAX_INST_EEP) Save_Instance(dst);
    Cfg_Mov = Cfg_Mov | (1 << (dst - 1));   // v3zv: gravado por compactacao da delecao
}
// Zera a última posição em RAM e EEPROM (evita duplicata após compactação)
function Zerar_Posicao(pos) {
    Set_Spvar_A(pos, 0);
    Set_Spvar_B(pos, 0);
    Set_Spvar_C(pos, 0);
    Set_F1_Excl(pos,  0); Set_F1_Assoc(pos, 0); Set_F1_Bloq(pos, 0);
    // v3z5 ETAPA 1: F2_* removidos — dados da FONTE_2, que nao existe mais na v3.
    Zero_F1_Behavior(pos);  // já cobre FA_Cfg, GT_Relig e as condicionais com os defaults certos
    if(pos <= MAX_INST_EEP) Save_Instance(pos);
}
// =============================================================
// GETTERS E SETTERS DE MODs (RAM)
// Substituem arrays — GPC não suporta int arr[25]
// =============================================================
function Get_F1_Excl(n) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) return DS_F1_EXCL_01;
                if(n == 2) return DS_F1_EXCL_02;
                if(n == 3) return DS_F1_EXCL_03;
            } else {
                if(n == 4) return DS_F1_EXCL_04;
                if(n == 5) return DS_F1_EXCL_05;
                if(n == 6) return DS_F1_EXCL_06;
            }
        } else {
            if(n <= 9) {
                if(n == 7) return DS_F1_EXCL_07;
                if(n == 8) return DS_F1_EXCL_08;
                if(n == 9) return DS_F1_EXCL_09;
            } else {
                if(n == 10) return DS_F1_EXCL_10;
                if(n == 11) return DS_F1_EXCL_11;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) return DS_F1_EXCL_12;
                if(n == 13) return DS_F1_EXCL_13;
                if(n == 14) return DS_F1_EXCL_14;
            } else {
                if(n == 15) return DS_F1_EXCL_15;
                if(n == 16) return DS_F1_EXCL_16;
            }
        } else {
            if(n <= 19) {
                if(n == 17) return DS_F1_EXCL_17;
                if(n == 18) return DS_F1_EXCL_18;
                if(n == 19) return DS_F1_EXCL_19;
            } else {
                if(n == 20) return DS_F1_EXCL_20;
                if(n == 21) return DS_F1_EXCL_21;
            }
        }
    }
    return 0;
}
function Set_F1_Excl(n, v) {
    if(n== 1) DS_F1_EXCL_01=v; if(n== 2) DS_F1_EXCL_02=v;
    if(n== 3) DS_F1_EXCL_03=v; if(n== 4) DS_F1_EXCL_04=v;
    if(n== 5) DS_F1_EXCL_05=v; if(n== 6) DS_F1_EXCL_06=v;
    if(n== 7) DS_F1_EXCL_07=v; if(n== 8) DS_F1_EXCL_08=v;
    if(n== 9) DS_F1_EXCL_09=v; if(n==10) DS_F1_EXCL_10=v;
    if(n==11) DS_F1_EXCL_11=v; if(n==12) DS_F1_EXCL_12=v;
    if(n==13) DS_F1_EXCL_13=v; if(n==14) DS_F1_EXCL_14=v;
    if(n==15) DS_F1_EXCL_15=v; if(n==16) DS_F1_EXCL_16=v;
    if(n==17) DS_F1_EXCL_17=v;
    if(n==18) DS_F1_EXCL_18=v;
    if(n==19) DS_F1_EXCL_19=v;
    if(n==20) DS_F1_EXCL_20=v;
    if(n==21) DS_F1_EXCL_21=v;
}
