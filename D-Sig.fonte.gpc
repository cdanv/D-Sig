    if(idx == 6) print(x, y, 0, 1, AFT_6[0]);
    if(idx == 7) print(x, y, 0, 1, AFT_7[0]);
}
// ===== V3-e: impressão numérica dígito-a-dígito (reaproveita TH_00="0" e CIC_1-9="1".."9") =====
function Print_Digito(x, y, d) {
    if(d == 0) print(x, y, 0, 1, TH_00[0]);
    if(d == 1) print(x, y, 0, 1, CIC_1[0]);
    if(d == 2) print(x, y, 0, 1, CIC_2[0]);
    if(d == 3) print(x, y, 0, 1, CIC_3[0]);
    if(d == 4) print(x, y, 0, 1, CIC_4[0]);
    if(d == 5) print(x, y, 0, 1, CIC_5[0]);
    if(d == 6) print(x, y, 0, 1, CIC_6[0]);
    if(d == 7) print(x, y, 0, 1, CIC_7[0]);
    if(d == 8) print(x, y, 0, 1, CIC_8[0]);
    if(d == 9) print(x, y, 0, 1, CIC_9[0]);
}
// v3zc: tabela de 63 valores (6 bits), de 50ms a 4000ms — era de 96 (7 bits).
// O corte protegeu a faixa CURTA: de 50 a 300ms o passo continua sendo de 10ms, que e
// exatamente onde o modo ATE trabalha (toques de 0,2 a 0,4s). Toda a perda de resolucao
// ficou acima de 350ms, onde se configura "segurar por um tempo" e a diferenca entre
// 1,10s e 1,15s nao muda nada na pratica.
function Hphold_Tempo_Ms(idx) {
    if(idx <= 25) return 50 + idx * 10;          // 50..300   passo 10  (26 valores)
    if(idx <= 39) return 350 + (idx - 26) * 50;  // 350..1000 passo 50  (14 valores)
    if(idx <= 55) return 1100 + (idx - 40) * 100;// 1100..2600 passo 100 (16 valores)
    return 2800 + (idx - 56) * 200;              // 2800..4000 passo 200 (7 valores)
}
// Imprime o tempo escalonado como "D.DDs" (todo valor da tabela é múltiplo de 10ms,
// então 2 casas decimais sempre bastam — validado em Python antes de implementar).
function Print_Hphold_Tempo(x, y, idx) {
    Work_N = Hphold_Tempo_Ms(idx);
    Work_D = Work_N / 1000;              // dígito inteiro (0-2)
    Work_C = Work_N - (Work_D * 1000);   // resto em ms (0-999)
    Work_C = Work_C / 10;                // 2 dígitos decimais (0-99)
    Print_Digito(x, y, Work_D);
    print(x + 6, y, 0, 1, PONTO[0]);
    Print_Digito(x + 10, y, Work_C / 10);
    Print_Digito(x + 16, y, Work_C - ((Work_C/10)*10));
    print(x + 22, y, 0, 1, SEG_L[0]);
}
// Nome da fonte pelo FONTE_TIPO (0-21) — v3, fonte única. Reaproveita strings existentes.
function Print_Fonte_Label(x, y, tipo) {
    if(tipo == FONTE_NENHUMA)  print(x, y, 0, 1, BTN_NENHUM[0]);
    if(tipo == FONTE_FINGER_X) print(x, y, 0, 1, F1_AX_F1X[0]);
    if(tipo == FONTE_FINGER_Y) print(x, y, 0, 1, F1_AX_F1Y[0]);
    if(tipo == FONTE_LX)       print(x, y, 0, 1, F1_AX_LX[0]);
    if(tipo == FONTE_LY)       print(x, y, 0, 1, F1_AX_LY[0]);
    if(tipo == FONTE_RX)       print(x, y, 0, 1, F1_AX_RX[0]);
    if(tipo == FONTE_RY)       print(x, y, 0, 1, F1_AX_RY[0]);
    if(tipo == FONTE_L2)       print(x, y, 0, 1, BTN_L2[0]);
    if(tipo == FONTE_R2)       print(x, y, 0, 1, BTN_R2[0]);
    if(tipo == FONTE_L1)       print(x, y, 0, 1, BTN_L1[0]);
    if(tipo == FONTE_L3)       print(x, y, 0, 1, BTN_L3[0]);
    if(tipo == FONTE_R1)       print(x, y, 0, 1, BTN_R1[0]);
    if(tipo == FONTE_R3)       print(x, y, 0, 1, BTN_R3[0]);
    if(tipo == FONTE_UP)       print(x, y, 0, 1, BTN_UP[0]);
    if(tipo == FONTE_DOWN)     print(x, y, 0, 1, BTN_DN[0]);
    if(tipo == FONTE_LEFT)     print(x, y, 0, 1, BTN_LT[0]);
    if(tipo == FONTE_RIGHT)    print(x, y, 0, 1, BTN_RT[0]);
    if(tipo == FONTE_TRIANGLE) print(x, y, 0, 1, BTN_TRI[0]);
    if(tipo == FONTE_CIRCLE)   print(x, y, 0, 1, BTN_CIR[0]);
    if(tipo == FONTE_CROSS)    print(x, y, 0, 1, BTN_CRS[0]);
    if(tipo == FONTE_SQUARE)   print(x, y, 0, 1, BTN_SQU[0]);
    if(tipo == FONTE_TOUCH)    print(x, y, 0, 1, BTN_TCH[0]);
    if(tipo == FONTE_SHARE)    print(x, y, 0, 1, BTN_SHR[0]);
}
