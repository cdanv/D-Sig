// --- Limites do sistema ---
define MAX_INST          = 21;   // MODs no total — 21, todos na EEPROM
define MAX_INST_EEP      = 21;   // MODs que a EEPROM comporta — 3 SPVARs cada, 63 de 64
define SPVARS_PER_INST   = 3;    // SPVARs por MOD — 96 bits, sem bit sobrando

// --- Geometria do OLED ---
// A tela tem 128x64. Estes numeros sao as unicas coordenadas repetidas em mais de uma
// tela; o resto e local ao print de cada uma.
define VISIBLE_ROWS      = 2;    // linhas de lista visiveis (fonte tamanho 1)
define ITEM_X            = 5;    // margem esquerda dos itens de lista
define ROW0_Y            = 16;   // primeira linha da lista
define ROW1_Y            = 36;   // segunda linha da lista
// v3zj: era 55. As fotos do OLED mostraram o rodape com a metade inferior CORTADA em
// todas as telas — a fonte e mais alta do que a margem de 9px ate a borda comportava.
define FOOTER_Y          = 52;   // rodape de ajuda
define PERF_ROW0_Y       = 20;   // tela de DOMINIOS: 1a linha
define PERF_ROW1_Y       = 40;   // tela de DOMINIOS: 2a linha

// --- Telas do MenuDin que tem numero proprio ---
define MENUDIN_DEL_CONF = 38;    // confirmacao de delecao

// =============================================================
// TEMPOS — tudo em ms, um nome por prazo
// =============================================================
// Regra do projeto: nenhum tempo aparece como numero solto no meio do codigo. O nome
// diz O QUE o prazo mede, e mudar um comportamento e mudar uma linha aqui. Antes da
// D-Sig, tres prazos viviam cravados dentro de combos (as esperas dos piscas e do
// toque) e um quarto, o CIRCLE que fecha o menu de status, estava escrito "200" no
// main com o define TIME_CIRCLE_CLOSE=200 logo acima, sem uso — dois numeros iguais
// que ninguem garantia que continuariam iguais.

// --- Comandos ---
define TIME_SHORT_PRESS  = 250;    // janela do segundo clique (dominios e touchpad)
define TIME_HOLD         = 500;    // quanto segurar L3/R3 para cair em D3/D4
define TIME_CIRCLE_CLOSE = 200;    // CIRCLE segurado que fecha menu (MenuDin e status)
define TIME_SQ_RESET     = 1000;   // SQUARE segurado que zera o MOD na tela de DOMINIOS
define TIME_SHARE_SAVE   = 1000;   // SHARE segurado que grava na EEPROM
define TIME_TRI_DELETE   = 1000;   // TRIANGLE segurado que abre a delecao

// --- Tela ---
define OLED_TIMEOUT      = 10000;  // quanto o OLED fica aceso depois de desenhar
define TIME_TROCA_LIMPA  = 500;    // tela apagada durante a troca de dominio

// --- Saidas com duracao (SECAO 18) ---
define TIME_TOQUE        = 200;    // quanto o toque no touchpad fica de pe
define FB_ACESO_LONGO    = 200;    // pulso do pisca de dominio LIGADO
define FB_ACESO_CURTO    = 100;    // pulso do pisca de dominio DESLIGADO
define FB_APAGADO        = 100;    // intervalo entre pulsos
define FB_RUMBLE_FORCA   = 50;     // forca da vibracao dos piscas
define FB_SALVOU         = 200;    // vibracao unica que confirma gravacao na EEPROM

// --- LED ---
define LED_FRACO         = 1;      // cor do dominio ligado, discreta
define LED_NORMAL        = 2;      // usada so nos piscas de confirmacao

// Cor do pisca — nome em vez de numero, porque quem le Fb_Disparar quer saber se
// piscou verde ou vermelho, nao qual canal do LED acendeu.
define FB_SEM_COR        = 0;      // vibra sem mexer no LED (confirmacao de gravacao)
define FB_VERDE          = 1;
define FB_VERMELHO       = 2;
// --- MAPA DE BITS DO SPVAR_A — fonte unica de verdade (v5) ---
// A auditoria externa apontou TRES descricoes conflitantes deste mesmo SPVAR espalhadas
// pelo arquivo, alem de um comentario declarando "bit 12 livre" quando ele e a metade
// alta do DST_TIPO. Ficou uma so, esta, e ela e a que vale:
//   bit  0      SLOT_USED
//   bits 1-4    DOMINIOS D1-D4
//   bits 5-9    FONTE_TIPO (23 valores)
//   bit  10     FONTE_PASSIVO
//   bits 11-12  DST_TIPO (DIRECT / STATIC / TURBO)
//   bits 13-29  DESTINOS — 4 empacotados, 19^4 = 130321
//   bits 30-31  pack de tempos do combo (bits 10-11 dele)
// Nao ha bit livre. Qualquer campo novo exige tirar de outro lugar.
//
// --- PACK DE TEMPOS DO COMBO — 12 bits, REPARTIDO EM TRES SPVARs ---
// A auditoria externa apontou, com razao, que nao havia lugar nenhum descrevendo isto
// por inteiro: quem lia o mapa de um SPVAR nao tinha como saber onde estava o resto.
//   valor = ((((t4 * 8) + t3) * 8 + t2) * 8) + t1     0..4095, 4 tempos de 8 valores
//   bits  0-6  -> SPVAR_C, bits 25-31
//   bits  7-9  -> SPVAR_B, bits 29-31
//   bits 10-11 -> SPVAR_A, bits 30-31
// Encapsulado em Get_Combo_TmpPack / Set_Combo_TmpPack — nada fora delas deve montar
// ou desmontar este valor a mao.
define BIT_SLOT_USED     = 0;
define BIT_S1            = 1;
define BIT_S2            = 2;
define BIT_S3            = 3;
define BIT_S4            = 4;
// v3zc RELAYOUT DO SPVAR_A — para caber os 4 D-pads nos destinos (14 -> 18 bits).
// O INIC saiu (ver Gatilho_Alterna) e o campo de DESTINO nao expandia no lugar, entao
// tudo desceu: FONTE_TIPO 5-9, PASSIVO 10, DST_TIPO 11-12, DST 13-30. Sobra o bit 31.
define SHIFT_F1_DST_TIPO = 11;   // 2 bits
// v3zr: o campo agora guarda 4 DESTINOS EMPACOTADOS (19^4 = 130321 -> 17 bits) para
// TODOS os tipos. Antes DIRECT/STATIC liam como mascara de 18 e o TURBO como sequencia,
// e o 18o bit era emprestado do pack de tempos — uma sobreposicao que funcionava por as
// leituras serem exclusivas, mas deixava o SPVAR_A somando 33 numa conta de 32.
// Unificando, o layout fica limpo E o ESPELHO deixa de ser necessario: nao ha mais duas
// representacoes a traduzir na troca de tipo.
define SHIFT_F1_DST      = 13;   // 17 bits — 4 destinos (0=nenhum, 1-18)
define SHIFT_FONTE_TIPO    = 5;   // v3zc
define SHIFT_FONTE_PASSIVO = 10;  // v3zc
// v3za: o RELIG DA FONTE FOI REMOVIDO. (O bit que ele ocupava nao esta mais livre —
// o campo de DESTINO cresceu sobre ele. Ver o mapa de bits, que e a fonte de verdade.)
// Motivo: existiam DOIS caminhos independentes de religar uma instancia (o RELIG da
// fonte e o RELIG do gatilho), sem coordenacao entre si — com os dois em SIM, religava
// quem chegasse primeiro, e isso nao era configuravel, era acidental. Alem disso o INIC
// era ignorado justamente na combinacao mais comum (fonte configurada e sem gatilho de
// estado), e "INIC ON + RELIG SIM" era praticamente a mesma decisao dita duas vezes.
// Agora o INIC responde a uma pergunta unica: QUEM MANDA nesta instancia?
//   INIC ON  -> a FONTE manda: ela liga e religa; o gatilho existe para interromper.
//   INIC OFF -> o GATILHO manda: ele arma; a fonte so executa enquanto armada.
//   sem fonte -> INIC volta ao papel classico (nao ha o que religar) e o gatilho e a fonte.
// O INIC mudou de TELA (saiu do GATILHO, foi para a FONTE) mas nao mudou de bit: segue
// no bit que era do INIC. Quem escrevia o RELIG da fonte agora simplesmente nao existe.
// (O define BIT_F1_INIC ja foi removido; uma auditoria externa suspeitou que ele ainda
//  ocupasse o bit 30 e conflitasse com o pack de tempos. Nao ocupa — ver o mapa de bits.)
// --- FONTE_TIPO — enum (23 opções, cabe em 5 bits) ---
// v3q: FONTE_NENHUMA(0) inserida no topo — "---" = instância sem fonte, mesma ideia do
// "---" dos gatilhos. Todo o resto deslocou +1; o offset dos botões virou -7 (era -6).
define FONTE_NENHUMA  = 0;   // "---" — sem fonte; só os gatilhos comandam a instância
define FONTE_FINGER_X = 1;   // categoria: touch
define FONTE_FINGER_Y = 2;   // categoria: touch
define FONTE_LX       = 3;   // categoria: eixo (bipolar)
define FONTE_LY       = 4;   // categoria: eixo
define FONTE_RX       = 5;   // categoria: eixo
define FONTE_RY       = 6;   // categoria: eixo
// A partir daqui, FONTE_TIPO - 7 == índice BTN_BIT_* (Ler/Set/Press_Btn_Fisico, Ptime_Btn)
define FONTE_L1       = 7;   // categoria: botão   (BTN_BIT_L1=0)
define FONTE_L2       = 8;   // categoria: gatilho (BTN_BIT_L2=1, analógico unipolar)
define FONTE_L3       = 9;   // categoria: botão   (BTN_BIT_L3=2)
define FONTE_R1       = 10;  // categoria: botão   (BTN_BIT_R1=3)
define FONTE_R2       = 11;  // categoria: gatilho (BTN_BIT_R2=4)
define FONTE_R3       = 12;  // categoria: botão   (BTN_BIT_R3=5)
define FONTE_CROSS    = 13;  // categoria: botão   (BTN_BIT_CRS=6)
define FONTE_CIRCLE   = 14;  // categoria: botão   (BTN_BIT_CIR=7)
define FONTE_SQUARE   = 15;  // categoria: botão   (BTN_BIT_SQU=8)
define FONTE_TRIANGLE = 16;  // categoria: botão   (BTN_BIT_TRI=9)
define FONTE_UP       = 17;  // categoria: botão   (BTN_BIT_UP=10)
define FONTE_DOWN     = 18;  // categoria: botão   (BTN_BIT_DN=11)
define FONTE_LEFT     = 19;  // categoria: botão   (BTN_BIT_LT=12)
define FONTE_RIGHT    = 20;  // categoria: botão   (BTN_BIT_RT=13)
define FONTE_TOUCH    = 21;  // categoria: botão   (BTN_BIT_TCH=14)
define FONTE_SHARE    = 22;  // categoria: botão   (BTN_BIT_SHR=15)
// --- Categorias de fonte (determinam quais condicionais mostrar/aplicar) ---
define CAT_TOUCH   = 0;   // só MULT
define CAT_EIXO    = 1;   // MULT+THR_IN+THR_OUT+DIR (bipolar: LX/LY/RX/RY)
define CAT_GATILHO = 2;   // MULT+THR_IN+THR_OUT, SEM DIR (unipolar: L2/R2)
define CAT_BOTAO   = 3;   // sem condicional nenhum
// --- Condicionais de fonte (v3) — bits do SPVAR_B ---
// v3z8 RELAYOUT DAS CONDICIONAIS — para abrir o unico bit livre do sistema.
// Os tres SPVARs por instancia estavam 32/32 ocupados, e as 64 SPVARs da EEPROM todas
// alocadas (63 nas instancias + 1 global). Nao havia onde por o MODO do BTN_HOLD.
// Saida: MULT(20 valores) x DIR(3) x INV(2) = 120 combinacoes, que cabem em 7 bits —
// contra os 8 que os tres ocupavam separados (5+2+1). Empacotando, sobra 1 bit exato.
// Codificacao: pack = (MULT * 3 + DIR) * 2 + INV   -> 0..119
// Decodificacao por divisao inteira nos proprios Get_Cond_* (ver Secao 9B).
// THR_IN e THR_OUT deslizaram para 7-11 e 12-16. Tudo de 18 em diante (tempo do HOLD,
// botao do BLOK, modo do TURBO) ficou INTACTO de proposito, para nao mexer no que ja
// estava salvo alem do necessario.
// v3ze: o INV SAIU. Na pratica ele so agia em destino de EIXO — os digitais sao escritos
// com abs(), que descarta o sinal; o ESTATC ja o ignorava; e no TURBO era redundante com o
// MODO (POS+INV = NEG, NEG+INV = POS, ABS+INV = mesma alternancia). Restava um caso util:
// DIRECT de eixo para eixo com sentido invertido. Sai barato — o pack cai de 114 para 57
// combinacoes (7 -> 6 bits) e ainda FICA MAIS RAPIDO: Get_Cond_Mult passa de duas divisoes
// para uma e Get_Cond_Inv deixa de existir.   pack = MULT * 3 + DIR  -> 0..56
define SHIFT_COND_PACK    = 0;    // 6 bits — MULT+DIR
// v3zb: THR_IN e THR_OUT empacotados. 20 x 20 = 400 combinacoes, que cabem em 9 bits
// contra os 10 que os dois ocupavam separados. pack = THR_IN * 20 + THR_OUT.
define SHIFT_COND_THR     = 6;    // 9 bits — THR_IN e THR_OUT juntos
define BIT_HOLD_MODO      = 15;   // 1 bit — 0=APOS (classico), 1=ATE (toque curto)
// v3zc: HPHOLD_TEMPO caiu de 7 para 6 bits (tabela de 96 -> 63 valores)
// --- GATILHO+BTN_FN v3 (Seção 4, botão único p/ tipo) — bits do SPVAR_B (restante) e SPVAR_C ---
// 5 tipos coexistentes, cada um com 1 botão só (0=nenhum, 1-16=BTN_BIT+1). BTN_HPHOLD tem
// tempo escalonado (7 bits, tabela de 80 valores). FINAL_AFTER: só o botão é persistente aqui —
// tempo e relig próprios ficam em RAM (corte cirúrgico, ver 3.9 do roteiro).
// CORRIGIDO: layout anterior tinha GATILHO_FINALAFTER_BTN (17-21) sobrepondo TURBO_PERM
// (20-23) em 2 bits — o comentário antigo assumia 10 bits livres em C quando o TURBO
// precisa de 12. Reencaixado: SPVAR_B fecha exato com HPHOLD_TEMPO+BLOQ_BTN+TURBO_MODO=14;
// SPVAR_C fecha exato com os 4 botões restantes + PERM+LAT+CICLOS=32. Zero sobreposição,
// zero bit livre desperdiçado (confirmado por checagem programática).
define SHIFT_GATILHO_HPHOLD_TEMPO = 16;  // v3ze: 6 bits — SPVAR_B (bits 16-21)
// v5: o GAMA BLOK FOI REMOVIDO e os 5 bits dele foram redistribuidos.
// Motivo (do Daniel): em uso real ele nunca teve serventia — suspender enquanto segurado
// e um gesto que compete com o proprio ato de jogar. E ele custava caro: era consultado
// em OITO pontos do caminho por quadro (Ent_Livre, Suprime_Gatilhos, Gatilho_Btn_Val,
// o Run_Instance e o criterio de engajamento). Tirar libera bits E alivia o ciclo.
// O que entrou no lugar:
//   DELAY (2 bits, 4 valores) — atrasa a subida da resposta. Nasceu do MOD_03 do FIFA:
//     correr e R2 travado subindo junto com o movimento, e sem atraso o sprint dispara
//     no primeiro toque do analogico, tirando o controle de conduzir a bola.
//   AFTER_TMP (3 bits, 8 valores) — o tempo do AFTER, que vivia em RAM e se perdia a
//     cada reinicio. Agora PERSISTE. Com isso sobra so o ZETA na lista do que nao
//     sobrevive ao desligamento.
define SHIFT_DELAY      = 22;   // 2 bits — SPVAR_B (bits 22-23)
// 'TMP' aqui e TEMPO, nao temporario: este campo E persistente. O nome ficou da
// epoca em que o tempo do AFTER vivia em RAM.
define SHIFT_AFTER_TMP  = 24;   // 3 bits — SPVAR_B (bits 24-26), tempo do AFTER
// Leia como AFTER_TEMPO. Renomear exigiria tocar em todos os usos; fica para a proxima
// revisao que mexer no layout.
// SPVAR_B: TURBO_MODO em 27-28 | bits 29-31 = parte media do pack de tempos do COMBO (3 dos 12)
define SHIFT_GATILHO_HPHOLD_BTN   = 0;   // 5 bits — SPVAR_C (bits 0-4)
// v3zb: TRIO de botoes empacotado — DUPLO, FINAL e FINALAFTER em 13 bits (SPVAR_C 5-17)
// contra os 15 que ocupavam separados. 17 x 17 x 17 = 4913 combinacoes.
// pack = (DUPLO * 17 + FINAL) * 17 + FINALAFTER
// Escolhi um TRIO e nao os CINCO de proposito: empacotar tudo renderia 4 bits, mas os
// getters de botao sao chamados ~400 vezes por quadro (Ent_Livre, Suprime_Gatilhos, os
// quatro gatilhos, Gatilho_Btn_Val) e cada leitura viraria ate 4 divisoes. Com o ciclo
// do Zen em 1ms, estourar nao degrada — trava. O trio custa no maximo 2 divisoes por
// leitura e ainda deixa BLOQ e HPHOLD com acesso direto.
define SHIFT_GATILHO_TRIO_BTN    = 5;   // 13 bits — SPVAR_C (bits 5-17)
// v7e: o mapa do SPVAR_C acima dos bits 18 e o seguinte, lido dos proprios getters:
//   bits 18-21  LAT do TURBO (4 bits, 16 valores)
//   bits 22-24  CICLOS (3 bits, ATIVO + 1 a 7)
//   bits 25-31  parte baixa do pack de tempos do COMBO (7 dos 12 bits)
// NAO ha bit livre neste SPVAR. O comentario anterior dizia "18-19 LIVRES" e citava um
// TURBO_PERM que deixou de existir na v3ze, quando cada passo do combo ganhou tempo
// proprio. TRES auditorias externas leram aquele texto como se fosse o mapa vigente e
// reportaram bits livres que nao existem — e um mapa errado e pior que nenhum, porque
// quem o seguisse alocaria em cima do LAT.
// =============================================================
// --- FONTE_1 — direção ---
define F1_DIR_NEGATIVO   = 0;
define F1_DIR_ABSOLUTO   = 1;
define F1_DIR_POSITIVO   = 2;
define TRB_MOD_ABS       = 0;   // TURBO eixo: segue o sinal ATUAL da fonte
define TRB_MOD_POS       = 1;   // TURBO eixo: polo sempre +100
define TRB_MOD_NEG       = 2;   // TURBO eixo: polo sempre -100
define TRB_MOD_ABSF      = 3;   // TURBO eixo: polo segue o sinal ATUAL da fonte (resgate do comportamento antigo)
// --- FONTE_1 — gatilho tipo ---
// --- FONTE_1 — BTN_FN tipo ---
// --- FONTE_1 — destino tipo ---
define DST_TIPO_DIRECT   = 0;
define DST_TIPO_ESTATC   = 1;
define DST_TIPO_TURBO    = 2;
// --- Bits de destino (15 bits, índices 0-14) ---
define DST_BIT_L1        = 0;
define DST_BIT_L2        = 1;
define DST_BIT_L3        = 2;
define DST_BIT_R1        = 3;
define DST_BIT_R2        = 4;
define DST_BIT_R3        = 5;
define DST_BIT_CRS       = 6;
define DST_BIT_CIR       = 7;
define DST_BIT_SQU       = 8;
define DST_BIT_TRI       = 9;
define DST_BIT_LX        = 10;
define DST_BIT_LY        = 11;
define DST_BIT_RX        = 12;
define DST_BIT_RY        = 13;
// v3zc: D-pads viraram destino. Entraram DEPOIS dos eixos de proposito — a mascara de
// eixos usada pelo TURBO (0x3C00, bits 10-13) continua valendo sem tocar em nada.
define DST_BIT_UP        = 14;
define DST_BIT_DN        = 15;
define DST_BIT_LT        = 16;
define DST_BIT_RT        = 17;
// --- Bits de botão para gatilho/BTN_FN (16 bits, índices 0-15) ---
define BTN_BIT_L1        = 0;
define BTN_BIT_L2        = 1;
define BTN_BIT_L3        = 2;
define BTN_BIT_R1        = 3;
define BTN_BIT_R2        = 4;
define BTN_BIT_R3        = 5;
define BTN_BIT_CRS       = 6;
define BTN_BIT_CIR       = 7;
define BTN_BIT_SQU       = 8;
define BTN_BIT_TRI       = 9;
define BTN_BIT_UP        = 10;
define BTN_BIT_DN        = 11;
define BTN_BIT_LT        = 12;
define BTN_BIT_RT        = 13;
define BTN_BIT_TCH       = 14;
define BTN_BIT_SHR       = 15;
// --- Tempo HPHOLD gatilho (1500-2500ms, passo 100ms = índices 0-10) ---
// --- Tempo BTN_FN (índices) ---
// --- TAIL_TIME (índices 0-25: 0=OFF, 1-25=0.5s-3.0s passo 0.1s) ---
// --- Subcursores para telas com 2 linhas ---
// =============================================================
// SEÇÃO 3 — VARIÁVEIS DE ESTADO GLOBAL
// =============================================================
// --- Modos S1–S4 ---
int Dom_Dc_D1            = 0;    // janela do duplo clique de D1 (ver Get_Dom_Dc)
int Dom_Dc_D2            = 0;    // janela do duplo clique de D2
int Dom_Tmp              = 0;    // temporaria de Dom_Duplo: le uma vez, escreve uma vez.
                                 // Dedicada de proposito — uma temporaria compartilhada
                                 // entre funcoes que se chamam e a colisao mais chata de
                                 // achar, e ja nos custou caro neste projeto
int Dom_Disparado        = 0;    // MASCARA: bit do dominio que ja disparou NESTE aperto
                                 // (anti-repeticao do "segurar"; cai quando o par solta).
                                 // Substitui Flag_Hold_S3 e Flag_Hold_S4
int CurrentMode          = 0;
int MenuLevel            = 0;
int LastMode             = -1;
int Status_Menu          = TRUE;
int SharTho_Enabled      = TRUE;
int Dc_Touch             = 0;    // janela do duplo DOWN que alterna o touchpad.
                                 // Era a unica declaracao do arquivo sem valor
                                 // inicial: no GPC nasce em zero de todo modo, mas
                                 // a excecao fazia duvidar das outras 400
// v3zh (decisao do Daniel): nasce em FALSE. Antes o touch (FINGER1/2 e os eixos X/Y)
// entrava DESLIGADO em todo perfil, o que impedia usa-lo como fonte sem antes liga-lo.
// Agora entra vivo e se comporta como qualquer outro botao/eixo na configuracao do
// MenuDin — o ATIVO/PASSIVO da FONTE ja cobre o proposito de anular quando preciso.
// O desligamento global virou funcao escondida: com o menu de status aberto, segurar L2
// e dar um duplo-clique rapido no DOWN (ver Menu_Touchpad).
// AUDITORIA: este comentario dizia R2. O codigo sempre leu L2 — o erro estava so no texto,
// aqui e no app, e no app foi corrigido na v7n. Um comando documentado errado custa mais
// que um comando sem documentacao: quem le tenta o botao errado e conclui que nao funciona.
int FingOff_Enabled      = FALSE;
int OLED_Timer           = 0;    // conta para baixo; em zero, apaga a tela
int Tela_Agenda_T        = 0;    // redesenho agendado (troca de dominio); 0 = nada

// --- Saidas com duracao (SECAO 18) — o que substituiu os cinco combos ---
// Cada uma e um contador em ms que perde o tempo da volta. O estado fica VISIVEL: da
// para perguntar "esta piscando?" em qualquer ponto do script, o que com combo nao dava.
int Tap_T                = 0;    // ms restantes do toque no touchpad
int Vib_T                = 0;    // ms restantes da vibracao que confirma a gravacao
int Fb_T                 = 0;    // ms restantes da fase atual do pisca
int Fb_Pulsos            = 0;    // quantos pulsos ainda faltam
int Fb_Aceso             = FALSE;// a fase atual e acesa ou apagada?
int Fb_Cor               = 0;    // FB_VERDE, FB_VERMELHO ou FB_SEM_COR
int Fb_Rumble            = 0;    // qual motor vibra nesta sequencia
int Fb_MsAceso           = 0;    // duracao do pulso desta sequencia
// --- MenuDin ---
int MenuDin              = 0;
int MenuCursor           = 0;   // posição do cursor na lista atual (0-based)
int ScrollTop            = 0;   // primeiro item visível (0-based)
int WzSlot               = 0;   // MOD em edicao (1-based: 1..MAX_INST)
int Wz_Entrando          = FALSE;
int Wz_SubCursor         = 0;   // subcursor dentro do passo
// --- Timers de controle ---
int Sq_Timer             = 0;   // acumula tempo do SQUARE para reset
int Circle_Timer         = 0;   // acumula tempo do CIRCLE
int Flag_Circle_Hold     = FALSE; // CIRCLE já fechou menu neste hold
int Tri_Timer            = 0;   // acumula tempo do TRIANGLE para deletar
int Flag_Share_Save      = FALSE;
int Del_Slot             = 0;   // instância sendo deletada (1-based)
// --- Total de instâncias criadas ---
int Total_Inst           = 0;   // quantos MODs existem (0..MAX_INST)
// --- Variáveis de trabalho (substituem locais — GPC não suporta vars locais) ---
int Work_A               = 0;
int Work_B               = 0;
int Work_C               = 0;   // temporário (navegação MOD, posição de bit)
int Work_D               = 0;   // temporário (máscara parte baixa)
int Work_E               = 0;   // temporário (máscara parte alta)
int Work_N               = 0;   // índice de loop genérico
// v3z9: DUAS variaveis dedicadas, criadas para quebrar colisoes de Work_ que geraram
// bugs reais na v3z8. Nao entram no rodizio Work_A..Work_N de proposito: sao usadas
// dentro de funcoes chamadas COMO ARGUMENTO de outras, que e onde o rodizio falha.
int Cond_Tmp             = 0;   // rascunho do unpack das condicionais (Secao 9B)
int Btn_Tmp              = 0;   // v3zb: rascunho do unpack do trio de botoes
int Cmb_P=0;
// v7l DESEMPENHO. O Cronus nao tem arrays: cada leitura de SPVAR por numero de MOD era uma
// cadeia de ate 21 comparacoes, e o pipeline fazia ~700 dessas leituras por volta com 21 MODs.
// O MOD que esta rodando agora fica num cache (Spv_*), e as cadeias viraram arvores (~5
// comparacoes). -1 = cache vazio (nenhum MOD tem esse numero).
// v7l: MASCARAS ESTATICAS. O que so muda quando a CONFIG muda (dominio, destino, relacoes,
// gatilhos) era recalculado MOD a MOD em todo quadro, 5 passadas x 21 MODs. Agora e calculado
// uma vez quando algo muda (menu aberto, troca de dominio, boot) e cada passada pula direto
// os MODs que nao tem o que fazer nela. So o que depende do INSTANTE continua por quadro.
int Cfg_Sujo = TRUE;   // TRUE = recalcular as mascaras antes do proximo pipeline
int Msk_Perf = 0;      // MOD marcado no dominio atual
int Msk_Run  = 0;      // usado E no dominio atual (o que Run_Instance processa)
int Msk_Orfao = 0;     // sem ALFA, sem GAMA que ligue, com ASSOC
int Msk_Apto_Est = 0;   // Msk_Perf com destino — e o Mod_Apto, que antes saia por quadro
int Msk_Assoc = 0; int Msk_Bloq = 0; int Msk_Excl = 0;
int Msk_GatEst = 0;
int Msk_Livre = 0;     // com ALFA e SEM GAMA que ligue: esta sempre ativo    // tem GAMA que liga (Tem_Gatilho_Estado)
int Rc_A = 0; int Rc_B = 0;
int Esx_T = 0;   // v7m: leitura do resto da espera
int Va_Msk = 0; int Va_Prox = 0; int Va_Visto = 0; int Va_Nv = 0;   // v7l: cadeia de orfaos
int Spv_N = -1; int Spv_A = 0; int Spv_B = 0; int Spv_C = 0;
int Esp_I=0; int Esp_N=0;   // v7i: contador e acumulador da espera do combo — dedicados
// v3zu: temporarios da REORDENACAO. Dedicados porque Swap_Pos chama getters/setters que
// usam o rodizio Work_ por dentro (Set_Combo_*, Set_Cond_*), e o valor guardado tem de
// sobreviver a essas chamadas.
int Swp_T=0; int Swp_A=0; int Swp_B=0;
int Cmb_Tmp=0; int Cmb_D1=0; int Cmb_D2=0; int Cmb_D3=0; int Cmb_D4=0; int Cmb_N=0;
// v5: timer do DELAY por instancia (ms restantes ate a resposta poder subir).
// Vive em RAM porque e estado de execucao, nao configuracao.
int Dly_01=0; int Dly_02=0; int Dly_03=0; int Dly_04=0; int Dly_05=0; int Dly_06=0; int Dly_07=0;
int Dly_08=0; int Dly_09=0; int Dly_10=0; int Dly_11=0; int Dly_12=0; int Dly_13=0; int Dly_14=0;
int Dly_15=0; int Dly_16=0; int Dly_17=0; int Dly_18=0; int Dly_19=0; int Dly_20=0; int Dly_21=0;
int Dly_Arm=0;   // bit N-1 = a contagem do MOD N ja comecou
// v6c: o GAMA BLOK VOLTOU, mas em RAM. Ele saiu na v5 por parecer sem uso; o Daniel
// descobriu depois que precisava dele. Como nao ha bit livre na EEPROM, mora aqui —
// e o script gerado pelo app o reaplica a cada boot dentro de Config_Zeta(), do mesmo
// jeito que as relacoes ZETA. Quem configura so pelo OLED perde ao desligar.
int Blk_01=0; int Blk_02=0; int Blk_03=0; int Blk_04=0; int Blk_05=0; int Blk_06=0; int Blk_07=0;
int Blk_08=0; int Blk_09=0; int Blk_10=0; int Blk_11=0; int Blk_12=0; int Blk_13=0; int Blk_14=0;
int Blk_15=0; int Blk_16=0; int Blk_17=0; int Blk_18=0; int Blk_19=0; int Blk_20=0; int Blk_21=0;
// v7: MODO DE CADA GAMA — alterna (0) ou so finaliza (1). Um bit por gatilho:
//   bit 0 = 2CLK    bit 1 = TOGGLE    bit 2 = HOLD    bit 3 = AFTER
// O BLOK fica de fora: ele suspende, nunca liga nem desliga.
// Nasceu de um vazio na regra derivada: com ALFA, o GAMA so desliga (o ALFA religa);
// SEM ALFA, ele alterna — e aí, com DOIS gatilhos, os dois abrem e fecham, sem jeito de
// ter um que apenas encerre. Este campo preenche exatamente esse caso.
// Vive em RAM, como o BLOK, e o script gerado pelo app o reaplica a cada boot.
int Fin_01=0; int Fin_02=0; int Fin_03=0; int Fin_04=0; int Fin_05=0; int Fin_06=0; int Fin_07=0;
int Fin_08=0; int Fin_09=0; int Fin_10=0; int Fin_11=0; int Fin_12=0; int Fin_13=0; int Fin_14=0;
int Fin_15=0; int Fin_16=0; int Fin_17=0; int Fin_18=0; int Fin_19=0; int Fin_20=0; int Fin_21=0;
int Est_Tmp              = 0;   // v3za: valor absoluto da fonte no destrave do ESTATC
   // retorno de Cycle_Mod (máscara seleção)
   // retorno de Cycle_Mod (máscara modo)
// === Fase 3 — pipeline ===
int Pipe_Val             = 0;   // valor processado do eixo (-100..100)
int Pipe_Raw             = 0;   // valor bruto lido do eixo físico
int Pipe_Thr            = 0;   // threshold em unidades de eixo
// v7g: acumuladores por destino (0-17). O comentario dizia 0-13 desde antes da v3zc,
// quando os quatro D-pads entraram como destinos 14-17. Guardam o valor de MAIOR
// intensidade do ciclo
int Acc_00=0; int Acc_01=0; int Acc_02=0; int Acc_03=0; int Acc_04=0; int Acc_05=0; int Acc_06=0;
int Acc_07=0; int Acc_08=0; int Acc_09=0; int Acc_10=0; int Acc_11=0; int Acc_12=0; int Acc_13=0;
// v3zc: acumuladores dos 4 D-pads (destinos 14-17). Sao DIGITAIS, como os 0-9 — entraram
// depois dos eixos justamente para nao deslocar a mascara 0x3C00 que o TURBO usa.
int Acc_14=0; int Acc_15=0; int Acc_16=0; int Acc_17=0;
int Acc_Eixo_Tocado=0;
int Bloq_Mask=0;          // MOD_BLOQ: quem esta bloqueado NESTE quadro (calculada 1x por quadro)

int Bloq_Snap_Resp=0;
int Snap_Orig=0;      // v3zm: copia do snapshot antes das passadas do BLOQ     // MOD_BLOQ: snapshot das respostas de todas as instâncias neste quadro (dedicada, mesmo motivo)
int Excl_RespAnt=0;       // MOD_EXCL: respostas de cada instância no quadro anterior (p/ detectar a borda de subida)
int Excl_Veto=0;          // MOD_EXCL: veto proprio, um bit por MOD — funciona MESMO sem gatilho/finalizador (SEMPRE_ATIVO),
                          // diferente de Inst_Ativa que é ignorado nesse caso. Limpo por Aplicar_RespOff_Inst.
int Resp_Off_F2=0;        // FONTE_2: respostas suprimidas (veto próprio, independente de Resp_Off_X/Y)

int Ent_Trava=0;          // v3z1: bit N-1 = instancia N em GATE DE ENTRADA de perfil.
                          // So volta a operar depois que fonte e gatilhos passarem por repouso.
int Mod_Apto=0;           // v3y: bit N-1 = instancia N pode PARTICIPAR de relacao de MOD
                          // (tem destino marcado E perfil ativo). Usado pelo ASSOC.
int Assoc_Mask=0;         // MOD_ASSOC: mascara por MOD (bit N-1 = MOD N) — quem está bloqueado neste quadro (nenhum vinculado de pé)

                          // Acc_Eixo_Tocado — máscara 4 bits (bit0=LX bit1=LY bit2=RX bit3=RY) — alguma instância
                         // escreveu neste destino de eixo NESTE QUADRO, mesmo que o valor seja 0.
                         // Distingue "ninguém tocou" (deixa o cru passar) de "o valor É zero de
                         // propósito" (precisa aplicar o zero, senão o cru vaza pela brecha).
// Gatilhos: estado lig/desl por instância (bit n = instância n+1 ligada) e anti-loop HPHOLD
int Inst_Ativa = 0;    // mascara por MOD (bit N-1 = MOD N) — instância ativa agora
int Hp_Travado = 0;    // mascara por MOD (bit N-1 = MOD N) — HPHOLD já alternou, espera soltar
int Hp_Press = 0;      // v3z8: bit N-1 = o botao do BTN_HOLD da instancia N estava
                       // PRESSIONADO no quadro anterior. So o modo ATE precisa disto:
                       // ele valida na SOLTURA, e sem esta memoria todo quadro com o
                       // botao solto dispararia. No modo APOS nao e usado.
// ESTATC: travamento por instância+eixo (bit n = instância n+1 com eixo travado em 100%)
// FINALIZA anti-loop (alterna 1x por pressionar, destrava ao soltar)
int Fz_Travado = 0;    // mascara por MOD (bit N-1 = MOD N)

int Resp_Off_X = 0;    // mascara por MOD (bit N-1 = MOD N) — respostas do EIXO_X individualmente suprimidas (veto por eixo)
int Resp_Off_Y = 0;    // mascara por MOD (bit N-1 = MOD N) — respostas do EIXO_Y individualmente suprimidas
// --- v3: fonte única (substitui os 3 pares antigos de rastreio por eixo/F2 -> 1 par) ---
int Src_Acima_Fonte = 0;   // mascara por MOD (bit N-1 = MOD N) — fonte estava na zona ativa no ciclo anterior
int Resp_Off_Fonte  = 0;   // mascara por MOD (bit N-1 = MOD N) — respostas da fonte individualmente suprimidas (veto)
// v5a: GT_Relig nao guarda mais RELIG nenhum — aquilo virou regra derivada na v3zb.
// Hoje carrega as TRES travas do STATIC, uma por bit:
//   bit 1 = travado   bit 2 = destravou pelo teto   bit 3 = sinal negativo do eixo
// Default 0 = nenhuma trava ativa. E o valor certo; nao "conserte" para 3.
int GT_Relig_01=0; int GT_Relig_02=0; int GT_Relig_03=0; int GT_Relig_04=0; int GT_Relig_05=0; int GT_Relig_06=0;
int GT_Relig_07=0; int GT_Relig_08=0; int GT_Relig_09=0; int GT_Relig_10=0; int GT_Relig_11=0; int GT_Relig_12=0;
int GT_Relig_13=0; int GT_Relig_14=0; int GT_Relig_15=0; int GT_Relig_16=0; int GT_Relig_17=0; int GT_Relig_18=0;
int GT_Relig_19=0; int GT_Relig_20=0; int GT_Relig_21=0;
// FINAL_AFTER: estado por instância — janela (ms) restante até desligar (0 = não contando)
int Fa_01=0; int Fa_02=0; int Fa_03=0; int Fa_04=0; int Fa_05=0; int Fa_06=0; int Fa_07=0; int Fa_08=0;
int Fa_09=0; int Fa_10=0; int Fa_11=0; int Fa_12=0; int Fa_13=0; int Fa_14=0; int Fa_15=0; int Fa_16=0;
int Fa_17=0; int Fa_18=0; int Fa_19=0; int Fa_20=0; int Fa_21=0;
// Duplo-clique: estado por instância (1-16). Empacota: bits 0-4 = botão+1 (0=nenhum); bits 5+ = janela em ms restante
int Dc_01=0; int Dc_02=0; int Dc_03=0; int Dc_04=0; int Dc_05=0; int Dc_06=0; int Dc_07=0; int Dc_08=0;
int Dc_09=0; int Dc_10=0; int Dc_11=0; int Dc_12=0; int Dc_13=0; int Dc_14=0; int Dc_15=0; int Dc_16=0;
int Dc_17=0; int Dc_18=0; int Dc_19=0; int Dc_20=0; int Dc_21=0;
// =============================================================
// SEÇÃO 4 — SPVARs EM RAM (cache das 21 instâncias persistentes) — v3
// Nomenclatura: DS_X_NN onde X=A..C (SPVAR) e NN=01..21
// Reduzido de 5 SPVARs/instância (v2) pra 3 (v3) — MODs e parte do FINAL_AFTER
// foram pra RAM (ver Seção 3.8/3.9 e Seção 4 do roteiro v3)
// =============================================================
// v3z7: estado de configuracao por instancia (bit N-1), para os indicadores da lista.
// Cfg_Ram   = tem alteracao CONFIRMADA (X no CONFIRMAR ou SHARE) ainda nao gravada.
// Cfg_Salvo = ja foi gravada na EEPROM alguma vez.
// Sao indexadas por POSICAO, como o Hold_Relig — mas nao precisam de migracao explicita
// na delecao: o Compact_Pos grava cada slot deslocado via Save_Instance, e e o proprio
// Save_Instance que acerta os dois bits (limpa o R, poe o E). O estado fica coerente de
// graca, porque apos a delecao aqueles slots ESTAO mesmo gravados.
// v3z9: snapshot tirado ao ENTRAR na instancia. O Commit_Wz compara com o estado atual
// e so marca R se algo mudou de verdade. Antes, entrar, navegar sem mexer em nada e
// confirmar com X ja acendia o R — porque as telas gravam nos SPVARs ao navegar (mesmo
// regravando valor identico) e o Commit_Wz nao tinha como distinguir. Comparar resolve:
// se os valores sao os mesmos, os SPVARs sao bit a bit iguais.
int Snap_A=0; int Snap_B=0; int Snap_C=0;
int Snap_EX=0; int Snap_AS=0; int Snap_BL=0;
int Cfg_Ram=0;
int Cfg_Salvo=0;
int Cfg_Mov=0;   // v3zv: bit N-1 = a gravacao daquele MOD veio de movimentacao
int DS_A_01=0; int DS_B_01=0; int DS_C_01=0;
int DS_A_02=0; int DS_B_02=0; int DS_C_02=0;
int DS_A_03=0; int DS_B_03=0; int DS_C_03=0;
int DS_A_04=0; int DS_B_04=0; int DS_C_04=0;
int DS_A_05=0; int DS_B_05=0; int DS_C_05=0;
int DS_A_06=0; int DS_B_06=0; int DS_C_06=0;
int DS_A_07=0; int DS_B_07=0; int DS_C_07=0;
int DS_A_08=0; int DS_B_08=0; int DS_C_08=0;
int DS_A_09=0; int DS_B_09=0; int DS_C_09=0;
int DS_A_10=0; int DS_B_10=0; int DS_C_10=0;
int DS_A_11=0; int DS_B_11=0; int DS_C_11=0;
int DS_A_12=0; int DS_B_12=0; int DS_C_12=0;
int DS_A_13=0; int DS_B_13=0; int DS_C_13=0;
int DS_A_14=0; int DS_B_14=0; int DS_C_14=0;
int DS_A_15=0; int DS_B_15=0; int DS_C_15=0;
int DS_A_16=0; int DS_B_16=0; int DS_C_16=0;
int DS_A_17=0; int DS_B_17=0; int DS_C_17=0;
int DS_A_18=0; int DS_B_18=0; int DS_C_18=0;
int DS_A_19=0; int DS_B_19=0; int DS_C_19=0;
int DS_A_20=0; int DS_B_20=0; int DS_C_20=0;
int DS_A_21=0; int DS_B_21=0; int DS_C_21=0;
// --- Variáveis de wizard (edição temporária em RAM) ---
// Carregadas da instância ao entrar, aplicadas ao confirmar
int Wz_S1 = FALSE; int Wz_S2 = FALSE;
int Wz_S3 = FALSE; int Wz_S4 = FALSE;

// =============================================================
// SEÇÃO 4B — VARIAVEIS EM RAM DO COMPORTAMENTO
