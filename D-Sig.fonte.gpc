    if(num ==  5) print(x, y, 0, 1, LBL_05[0]);
    if(num ==  6) print(x, y, 0, 1, LBL_06[0]);
    if(num ==  7) print(x, y, 0, 1, LBL_07[0]);
    if(num ==  8) print(x, y, 0, 1, LBL_08[0]);
    if(num ==  9) print(x, y, 0, 1, LBL_09[0]);
    if(num == 10) print(x, y, 0, 1, LBL_10[0]);
    if(num == 11) print(x, y, 0, 1, LBL_11[0]);
