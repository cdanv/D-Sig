}
function Set_F1_Bloq(n, v) {
    if(n== 1) DS_F1_BLOQ_01=v; if(n== 2) DS_F1_BLOQ_02=v;
    if(n== 3) DS_F1_BLOQ_03=v; if(n== 4) DS_F1_BLOQ_04=v;
    if(n== 5) DS_F1_BLOQ_05=v; if(n== 6) DS_F1_BLOQ_06=v;
    if(n== 7) DS_F1_BLOQ_07=v; if(n== 8) DS_F1_BLOQ_08=v;
    if(n== 9) DS_F1_BLOQ_09=v; if(n==10) DS_F1_BLOQ_10=v;
    if(n==11) DS_F1_BLOQ_11=v; if(n==12) DS_F1_BLOQ_12=v;
    if(n==13) DS_F1_BLOQ_13=v; if(n==14) DS_F1_BLOQ_14=v;
    if(n==15) DS_F1_BLOQ_15=v; if(n==16) DS_F1_BLOQ_16=v;
    if(n==17) DS_F1_BLOQ_17=v;
    if(n==18) DS_F1_BLOQ_18=v;
    if(n==19) DS_F1_BLOQ_19=v;
    if(n==20) DS_F1_BLOQ_20=v;
    if(n==21) DS_F1_BLOQ_21=v;
}

// Conta instâncias existentes (SLOT_USED=1) ao iniciar
function Count_Instances() {
    Total_Inst = 0;
    // v3z7: reconstroi o estado dos indicadores no boot. Criterio direto: se o SLOT_USED
    // veio ligado da EEPROM, aquela instancia FOI salva alguma vez — nao ha outro jeito
    // de o bit estar la. E nada esta sujo no boot, porque o que esta em RAM acabou de vir
    // do disco. Roda antes do Inicializar_Estado, junto com a contagem, para nao precisar
    // varrer as 21 instancias uma segunda vez.
    Cfg_Ram   = 0;
    Cfg_Salvo = 0;
    Cfg_Mov   = 0;   // v3zv: no boot nada veio de movimentacao
    // v3zo CORRIGIDO (achado do Daniel no teste de uso do Mad Max): a contagem parava na
    // instancia 12 — resquicio da v2, quando so 12 cabiam na EEPROM. Desde a v3 as 21 sao
    // persistentes, mas isto nunca foi atualizado. Os dados dos MODs 13-21 ERAM gravados
    // corretamente; o que falhava era o BOOT, que reconstruia Total_Inst ate 12 e fazia
    // os demais sumirem da lista.
    // D-Sig: UMA varredura, nao duas. A correcao da v3zo acrescentou um segundo while
    // identico ao primeiro em vez de somar dentro dele — e o comentario acima jurava que
    // havia uma so ("para nao precisar varrer as 21 uma segunda vez"). Os dois testavam
    // exatamente o mesmo bit; agora o teste e feito uma vez e alimenta os dois resultados.
    Work_N = 1;
    while(Work_N <= 21) {
        if(Get_Spvar_A(Work_N) & 1) {
            Cfg_Salvo = Cfg_Salvo | (1 << (Work_N - 1));
            Total_Inst++;
        }
        Work_N++;
    }
}
// =============================================================
// SEÇÃO 14 — WIZARD: LOAD E COMMIT
// Carrega parâmetros da instância → variáveis Wz_*
// Aplica variáveis Wz_* → instância (commit)
// =============================================================
// v3z9: alem de extrair os perfis, congela o estado inteiro da instancia para o
// Commit_Wz poder decidir se houve alteracao real. Load_Wz roda uma unica vez, na
// ENTRADA da instancia (X na lista ou criacao), que e exatamente o marco desejado.
function Load_Wz(num) {
    Snap_A  = Get_Spvar_A(num);
    Snap_B  = Get_Spvar_B(num);
    Snap_C  = Get_Spvar_C(num);
    Snap_EX = Get_F1_Excl(num);
    Snap_AS = Get_F1_Assoc(num);
    Snap_BL = Get_F1_Bloq(num);
    Work_A = Get_Spvar_A(num);
    // Extrai perfis
    Wz_S1 = (Work_A >> BIT_S1) & 1;
    Wz_S2 = (Work_A >> BIT_S2) & 1;
    Wz_S3 = (Work_A >> BIT_S3) & 1;
    Wz_S4 = (Work_A >> BIT_S4) & 1;
    // LIMPEZA: removidas ~20 linhas que carregavam dados do sistema antigo (F1_ON/F2_ON/
    // F3_USED/F1X/F1Y/F2/GATILHO/BTN_FN velhos) em variáveis Wz_ que nada mais lê — as
    // telas que exibiam esses dados saíram desde a v3-b/e. Confirmado "assigned but never
    // used" pelo compilador, e verificado que toda outra ocorrência estava só dentro de
    // funções já mortas (Load_Wz_F1X, Load_Wz_F1Y, Load_Wz_F2, etc). Fonte real é
    // carregada por Load_Wz_Fonte quando a tela 100 é aberta, não aqui.
}
// Carrega variáveis RAM da FONTE_1 → wizard
// Aplica wizard → variáveis RAM da FONTE_1
// EIXO, ON e PASSIVO ficam no SPVAR_A — tratados em Commit_Wz
// Grava eixo, ON e PASSIVO no SPVAR_A (chamado ao sair do passo 4)
// Carrega EIXO_X do SPVAR_A e RAM para wizard
// Grava seleção EIXO_X no SPVAR_A
// Grava condições EIXO_X na RAM
// Carrega EIXO_Y da RAM para wizard
// Grava seleção EIXO_Y na RAM
// Grava condições EIXO_Y na RAM
// Cicla o estado de uma instância num MOD: vazio → ATIVO → PASSIVO → vazio
// Entrada: sel/modo (máscaras atuais), p (posição do bit, 0-15)
// Saída: máscaras de seleção e modo atualizadas
// Primeira instância válida para MOD (menor índice 1..Total_Inst que não seja WzSlot)
// Próxima instância válida (desce a lista, pula WzSlot, para no fim)
// Instância válida anterior (sobe a lista, pula WzSlot, para no início)
// DESTINO: máscara de 15 bits no SPVAR_A (shift 15)
// TIPO destino: 2 bits no SPVAR_A (shift 13)
function Get_F1_Tipo(num) {
    if(num == Spv_N) { Work_A = Spv_A; return (Work_A >> SHIFT_F1_DST_TIPO) & 0x03; }   // v7l: MOD em execucao
    Work_A = Get_Spvar_A(num);
    return (Work_A >> SHIFT_F1_DST_TIPO) & 0x03;
}
function Set_F1_Tipo(num, tipo) {
    Work_A = Get_Spvar_A(num);
    Work_A = Work_A & (~(0x03 << SHIFT_F1_DST_TIPO));
    Work_A = Work_A | ((tipo & 0x03) << SHIFT_F1_DST_TIPO);
    Set_Spvar_A(num, Work_A);
}
// Estado inicial da instância (INIC): bit 30 do SPVAR_A. 1=começa ligada, 0=desligada
// RELIG do FINALIZA: bit 31 do SPVAR_A. 1=botão do FINALIZA alterna (toggle); 0=só finaliza
// destino: bits 0-13 (14 bits, máscara 0x3FFF); tipo: bits 14-15
// Carrega DESTINO + TIPO da EEPROM para o wizard
// Grava DESTINO + TIPO do wizard na EEPROM (SPVAR_A)
// Carrega tipo+destino do eixo ATUAL (X=SPVAR_A, Y=SPVAR_B) para as vars de edição.
// TURBO (TRB_*) permanece compartilhado pela instância por ora.
// Grava SÓ o tipo no eixo ATUAL (commit imediato ao mudar na tela 16)
// Grava SÓ o destino no eixo ATUAL (commit imediato ao marcar na tela 17)
// Grava tipo+destino no eixo ATUAL (X=SPVAR_A, Y=SPVAR_B)
// Carrega MODs (referências + modos) e TAIL da RAM para o wizard
// Grava MODs (referências + modos) e TAIL do wizard na RAM
// Grava parâmetros compartilhados FONTE_1 (gatilho + BTN_FN) na RAM
function Commit_Wz(num) {
    // CORRIGIDO: os bits 5-8 (LINK_F1/F1_ON/F2_ON/F3_USED no layout antigo da v2) agora
    // pertencem a FONTE_ON(5) e FONTE_TIPO(6-10) na v3 — commitados por Commit_Wz_Fonte,
    // já feito antes de chegar aqui. Esta função corrompia esses bits com lixo de
    // variáveis obsoletas do sistema antigo, agora removidas — toda vez que rodava —
    // causa raiz do "fonte muda sozinha" e "ON/OFF muda sozinho" reportados. Agora só
    // mexe em SLOT_USED e S1-S4, que continuam na mesma posição de bits da v2.
    Work_A = Get_Spvar_A(num);
    Work_A = Work_A & ~(1 << BIT_S1);
    Work_A = Work_A & ~(1 << BIT_S2);
    Work_A = Work_A & ~(1 << BIT_S3);
    Work_A = Work_A & ~(1 << BIT_S4);
    // SLOT_USED sempre 1
    Work_A = Work_A | 1;
    if(Wz_S1) Work_A = Work_A | (1 << BIT_S1);
    if(Wz_S2) Work_A = Work_A | (1 << BIT_S2);
    if(Wz_S3) Work_A = Work_A | (1 << BIT_S3);
    if(Wz_S4) Work_A = Work_A | (1 << BIT_S4);
    Set_Spvar_A(num, Work_A);
    // Reaplica o estado lig/desl desta instância conforme o INIC (recém-editado)
    // v3zc: mesma regra de nascimento do Inicializar_Estado, aplicada so a esta instancia.
    if(Get_Fonte_Tipo(num) != FONTE_NENHUMA) Inst_Ativa = Inst_Ativa | (1 << (num - 1));
    else                                     Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
    Aplicar_RespOff_Inst(num);
    Hp_Travado = Hp_Travado & (~(1 << (num - 1)));
    // v3z7: marca a instancia como ALTERADA em RAM. Commit_Wz e chamado por exatamente
    // dois caminhos — o X do CONFIRMAR e o SHARE 1s — que sao os dois atos deliberados
    // de confirmacao. Entrar no MOD, mexer e sair sem confirmar NAO passa por aqui, que
    // e a distincao pedida pelo Daniel. No caminho do SHARE o Save_Instance roda logo
    // depois e limpa este bit, entao o R nunca aparece indevidamente apos salvar.
    // v3z9: so acende o R se ALGO mudou em relacao ao snapshot da entrada. Confirmar sem
    // ter mexido em nada deixa a instancia como estava — inclusive mantendo o E de quem
    // ja estava salva, que era o outro efeito indesejado do comportamento anterior.
    if(Get_Spvar_A(num)   != Snap_A  || Get_Spvar_B(num)  != Snap_B  ||
       Get_Spvar_C(num)   != Snap_C  || Get_F1_Excl(num)   != Snap_EX ||
       Get_F1_Assoc(num)  != Snap_AS || Get_F1_Bloq(num)  != Snap_BL) {
        Cfg_Ram   = Cfg_Ram   |  (1 << (num - 1));
        Cfg_Salvo = Cfg_Salvo & (~(1 << (num - 1)));
        Cfg_Mov   = Cfg_Mov   & (~(1 << (num - 1)));   // v3zv
        // v3z9: mudou -> deixa de estar "salva e limpa". Sem isto, alterar uma instancia
        // ja gravada mantinha o E e escondia que havia mudanca pendente.
        Snap_A = Get_Spvar_A(num); Snap_B = Get_Spvar_B(num); Snap_C = Get_Spvar_C(num);
            Snap_EX = Get_F1_Excl(num); Snap_AS = Get_F1_Assoc(num); Snap_BL = Get_F1_Bloq(num);
    }
}
// =============================================================
// SEÇÃO 15 — SPVARs: ACESSO POR NUMERO DE MOD
// Get_Spvar_X(num): retorna SPVAR_X da instância num (1-based)
// Set_Spvar_X(num, val): escreve SPVAR_X da instância num
// Instâncias 1–12: usam variáveis DS_X_NN
// Instâncias 13–25: RAM only (apenas SPVAR_A disponível nesta fase)
// =============================================================
function Get_Spvar_A(num) {
    if(num == Spv_N) return Spv_A;   // v7l: MOD em execucao, sem busca
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return DS_A_01;
                if(num == 2) return DS_A_02;
                if(num == 3) return DS_A_03;
            } else {
                if(num == 4) return DS_A_04;
                if(num == 5) return DS_A_05;
                if(num == 6) return DS_A_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return DS_A_07;
                if(num == 8) return DS_A_08;
                if(num == 9) return DS_A_09;
            } else {
                if(num == 10) return DS_A_10;
                if(num == 11) return DS_A_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return DS_A_12;
                if(num == 13) return DS_A_13;
                if(num == 14) return DS_A_14;
            } else {
                if(num == 15) return DS_A_15;
                if(num == 16) return DS_A_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return DS_A_17;
                if(num == 18) return DS_A_18;
                if(num == 19) return DS_A_19;
            } else {
                if(num == 20) return DS_A_20;
                if(num == 21) return DS_A_21;
            }
        }
    }
    return 0;
}

function Set_Spvar_A(num, val) {
    if(num == Spv_N) Spv_A = val;   // v7l: mantem o cache coerente
    if(num== 1) DS_A_01 = val;
    if(num== 2) DS_A_02 = val;
    if(num== 3) DS_A_03 = val;
    if(num== 4) DS_A_04 = val;
    if(num== 5) DS_A_05 = val;
    if(num== 6) DS_A_06 = val;
    if(num== 7) DS_A_07 = val;
    if(num== 8) DS_A_08 = val;
    if(num== 9) DS_A_09 = val;
    if(num==10) DS_A_10 = val;
    if(num==11) DS_A_11 = val;
    if(num==12) DS_A_12 = val;
    if(num==13) DS_A_13 = val;
    if(num==14) DS_A_14 = val;
    if(num==15) DS_A_15 = val;
    if(num==16) DS_A_16 = val;
    if(num==17) DS_A_17 = val;
    if(num==18) DS_A_18 = val;
    if(num==19) DS_A_19 = val;
    if(num==20) DS_A_20 = val;
    if(num==21) DS_A_21 = val;
}

function Get_Spvar_B(num) {
    if(num == Spv_N) return Spv_B;   // v7l: MOD em execucao, sem busca
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return DS_B_01;
                if(num == 2) return DS_B_02;
                if(num == 3) return DS_B_03;
            } else {
                if(num == 4) return DS_B_04;
                if(num == 5) return DS_B_05;
                if(num == 6) return DS_B_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return DS_B_07;
                if(num == 8) return DS_B_08;
                if(num == 9) return DS_B_09;
            } else {
                if(num == 10) return DS_B_10;
                if(num == 11) return DS_B_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return DS_B_12;
                if(num == 13) return DS_B_13;
                if(num == 14) return DS_B_14;
            } else {
                if(num == 15) return DS_B_15;
                if(num == 16) return DS_B_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return DS_B_17;
                if(num == 18) return DS_B_18;
                if(num == 19) return DS_B_19;
            } else {
                if(num == 20) return DS_B_20;
                if(num == 21) return DS_B_21;
            }
        }
    }
    return 0;
}

function Set_Spvar_B(num, val) {
    if(num == Spv_N) Spv_B = val;   // v7l: mantem o cache coerente
    if(num== 1) DS_B_01 = val;
    if(num== 2) DS_B_02 = val;
    if(num== 3) DS_B_03 = val;
    if(num== 4) DS_B_04 = val;
    if(num== 5) DS_B_05 = val;
    if(num== 6) DS_B_06 = val;
    if(num== 7) DS_B_07 = val;
    if(num== 8) DS_B_08 = val;
    if(num== 9) DS_B_09 = val;
    if(num==10) DS_B_10 = val;
    if(num==11) DS_B_11 = val;
    if(num==12) DS_B_12 = val;
    if(num==13) DS_B_13 = val;
    if(num==14) DS_B_14 = val;
    if(num==15) DS_B_15 = val;
    if(num==16) DS_B_16 = val;
    if(num==17) DS_B_17 = val;
    if(num==18) DS_B_18 = val;
    if(num==19) DS_B_19 = val;
    if(num==20) DS_B_20 = val;
    if(num==21) DS_B_21 = val;
}

function Get_Spvar_C(num) {
    if(num == Spv_N) return Spv_C;   // v7l: MOD em execucao, sem busca
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return DS_C_01;
                if(num == 2) return DS_C_02;
                if(num == 3) return DS_C_03;
            } else {
                if(num == 4) return DS_C_04;
                if(num == 5) return DS_C_05;
                if(num == 6) return DS_C_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return DS_C_07;
                if(num == 8) return DS_C_08;
                if(num == 9) return DS_C_09;
            } else {
                if(num == 10) return DS_C_10;
                if(num == 11) return DS_C_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return DS_C_12;
                if(num == 13) return DS_C_13;
                if(num == 14) return DS_C_14;
            } else {
                if(num == 15) return DS_C_15;
                if(num == 16) return DS_C_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return DS_C_17;
                if(num == 18) return DS_C_18;
                if(num == 19) return DS_C_19;
            } else {
                if(num == 20) return DS_C_20;
                if(num == 21) return DS_C_21;
            }
        }
    }
    return 0;
}

function Set_Spvar_C(num, val) {
    if(num == Spv_N) Spv_C = val;   // v7l: mantem o cache coerente
    if(num== 1) DS_C_01 = val;
    if(num== 2) DS_C_02 = val;
