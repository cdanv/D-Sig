// =============================================================
// === FONTE_1 COMPARTILHADOS (gatilho, BTN_FN, MODs, TAIL, TURBO) ===
// MOD_ASSOC máscara de modo
// MOD_BLOQ máscara de modo
// v7d: estado da maquina do TURBO por MOD (o "por eixo" era da v2). RAM: bits0-8=timer(ms) bit9=fase bits10-13=ciclos_rest bit14=rodando
int DS_TrbSt_X_01=0; int DS_TrbSt_X_02=0; int DS_TrbSt_X_03=0; int DS_TrbSt_X_04=0; int DS_TrbSt_X_05=0; int DS_TrbSt_X_06=0; int DS_TrbSt_X_07=0; int DS_TrbSt_X_08=0; int DS_TrbSt_X_09=0; int DS_TrbSt_X_10=0; int DS_TrbSt_X_11=0; int DS_TrbSt_X_12=0; int DS_TrbSt_X_13=0; int DS_TrbSt_X_14=0; int DS_TrbSt_X_15=0; int DS_TrbSt_X_16=0;
