// Linha do GATILHO HPHOLD: idx 0 = TEMPO de hold; idx 1-16 = botões 0-15 (bit = idx-1)
// Imprime o tempo do FINAL_AFTER (índice 0-19 → 0.1-2.0s)
// Linha do BTN_FN FINAL_AFTER: idx 0 = ATRASO; idx 1-16 = botões 0-15 (bit = idx-1) em FBTN3
// Sem NATIVO (só os 16 botões físicos)
// Linha do BTN_FN FINALIZA: idx 0 = RELIG (SIM/NÃO); idx 1-16 = botões 0-15 (bit = idx-1) em FBTN2
// Setas de rolagem (^ topo / v base) quando há itens fora da janela de 2 linhas
// Imprime o nome do botão pelo índice de bit 0-15
// v3zl: desenha em fonte 0 (era 1). A fonte 1 e mais alta e estourava a linha — os nomes
// de botao apareciam cortados embaixo na tela do HOLD (tres linhas) e na linha do ATRASO
// do AFTER. Os rotulos e valores dessas mesmas telas ja usavam fonte 0, entao alem de
// resolver o corte isso deixa as linhas visualmente coerentes.
function Print_Btn_Label(x, y, idx) {
    if(idx ==  0) print(x, y, 0, 1, BTN_L1[0]);
    if(idx ==  1) print(x, y, 0, 1, BTN_L2[0]);
    if(idx ==  2) print(x, y, 0, 1, BTN_L3[0]);
    if(idx ==  3) print(x, y, 0, 1, BTN_R1[0]);
    if(idx ==  4) print(x, y, 0, 1, BTN_R2[0]);
    if(idx ==  5) print(x, y, 0, 1, BTN_R3[0]);
    if(idx ==  6) print(x, y, 0, 1, BTN_CRS[0]);
    if(idx ==  7) print(x, y, 0, 1, BTN_CIR[0]);
    if(idx ==  8) print(x, y, 0, 1, BTN_SQU[0]);
    if(idx ==  9) print(x, y, 0, 1, BTN_TRI[0]);
    if(idx == 10) print(x, y, 0, 1, BTN_UP[0]);
    if(idx == 11) print(x, y, 0, 1, BTN_DN[0]);
    if(idx == 12) print(x, y, 0, 1, BTN_LT[0]);
    if(idx == 13) print(x, y, 0, 1, BTN_RT[0]);
    if(idx == 14) print(x, y, 0, 1, BTN_TCH[0]);
    if(idx == 15) print(x, y, 0, 1, BTN_SHR[0]);
}
// v3z8: desenha UM campo da tela do BTN_HOLD na altura y.
// 0=botao  1=tempo  2=MODO (APOS/ATE)  3=RELIG
// ATENCAO Work_: Print_Hphold_Tempo suja Work_C e Work_D por dentro (rascunho dos
// digitos decimais). Por isso o campo 1 e desenhado por ULTIMO na cadeia de ifs e nada
// depende de Work_ depois dele aqui; quem chama tambem reatribui antes de reutilizar.
// ===== V3-e: impressão de botão único (0=nenhum, 1-16=BTN_BIT+1) =====
function Print_Gatilho_Btn(x, y, val) {
    if(val == 0) { print(x, y, 0, 1, BTN_NENHUM[0]); return; }
    Print_Btn_Label(x, y, val - 1);
}
// Linha da lista de GATILHO+BTN_FN (idx 0-5): nome + "*" se configurado (INIC mostra ON/OFF)
// Linha da lista HIMDs (idx 0=EXCL 1=ASSOC 2=BLOQ) — "*" se a instância atual tiver
// alguma seleção feita nesse MOD. Wz_Mod_Tipo é o próprio cursor desta tela.
function Print_Himds_Lista_Row(idx, y) {
    if(idx == Wz_Mod_Tipo) print(2, y, 0, 1, SCR_SEL[0]);
    if(idx == 0) {
        print(10, y, 0, 1, MOD_EXCL_L[0]);
        if(Get_F1_Excl(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
    if(idx == 1) {
        print(10, y, 0, 1, MOD_ASSOC_L[0]);
        if(Get_F1_Assoc(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
    if(idx == 2) {
        print(10, y, 0, 1, MOD_BLOQ_L[0]);
        if(Get_F1_Bloq(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
}
// v5: quatro itens — 0=2CLK 1=TOGGLE 2=HOLD 3=AFTER. O BLOK saiu.
function Print_Gatilho_Lista_Row(idx, y) {
    if(idx == Wz_Gatilho_Lista_Cur) print(2, y, 0, 1, SCR_SEL[0]);
    if(idx == 0) { print(10, y, 0, 1, GTL_DUPLO[0]);  if(Wz_Gatilho_Duplo_Btn)  print(115, y, 0, 1, FN_ATIVO[0]); }
    if(idx == 1) { print(10, y, 0, 1, FN_FINAL[0]);   if(Wz_Gatilho_Final_Btn)  print(115, y, 0, 1, FN_ATIVO[0]); }
    if(idx == 2) { print(10, y, 0, 1, GTL_HPHOLD[0]); if(Wz_Gatilho_Hphold_Btn) print(115, y, 0, 1, FN_ATIVO[0]); }
    if(idx == 3) { print(10, y, 0, 1, FN_FINAFT[0]);  if(Wz_Gatilho_FA_Btn)     print(115, y, 0, 1, FN_ATIVO[0]); }
    if(idx == 4) { print(10, y, 0, 1, FN_BLOQ[0]);    if(Wz_Blok)               print(115, y, 0, 1, FN_ATIVO[0]); }
}
// v5: valor do tempo do AFTER — tabela propria de 8 valores, agora persistente.
function Print_After_Val(x, y, idx) {
    if(idx == 0) print(x, y, 0, 1, AFT_0[0]);
    if(idx == 1) print(x, y, 0, 1, AFT_1[0]);
    if(idx == 2) print(x, y, 0, 1, AFT_2[0]);
    if(idx == 3) print(x, y, 0, 1, AFT_3[0]);
