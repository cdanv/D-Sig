int MenuDin_Ant=0;   // tela anterior (detecção de transição p/ memória de cursor)
int MenuDin_Prev=0;  // v3z4: MenuDin do quadro anterior — detecta a SAIDA do MenuDin
                     // para disparar o Reset_Perfil. Separada do MenuDin_Ant de proposito:
                     // aquela vive dentro do bloco CurrentMode>0 e serve a memoria de
                     // cursor; misturar as duas amarraria o reset a uma responsabilidade
                     // de interface.
// --- Wizard PERFIL_HAB (movido para antes do CONFIRMAR) ---
// Wz_S1..Wz_S4 já declarados acima — mantidos
// --- MODs em RAM — referências entre instâncias (1-based, 0=NENHUM) ---
// Implementação completa na Fase 3. Declaradas aqui para ajuste na deleção.
// F1 MODs
int DS_F1_EXCL_01=0; int DS_F1_EXCL_02=0; int DS_F1_EXCL_03=0; int DS_F1_EXCL_04=0;
int DS_F1_EXCL_05=0; int DS_F1_EXCL_06=0; int DS_F1_EXCL_07=0; int DS_F1_EXCL_08=0;
int DS_F1_EXCL_09=0; int DS_F1_EXCL_10=0; int DS_F1_EXCL_11=0; int DS_F1_EXCL_12=0;
int DS_F1_EXCL_13=0; int DS_F1_EXCL_14=0; int DS_F1_EXCL_15=0; int DS_F1_EXCL_16=0;
int DS_F1_EXCL_17=0; int DS_F1_EXCL_18=0; int DS_F1_EXCL_19=0; int DS_F1_EXCL_20=0; int DS_F1_EXCL_21=0;
int DS_F1_ASSOC_01=0; int DS_F1_ASSOC_02=0; int DS_F1_ASSOC_03=0; int DS_F1_ASSOC_04=0;
int DS_F1_ASSOC_05=0; int DS_F1_ASSOC_06=0; int DS_F1_ASSOC_07=0; int DS_F1_ASSOC_08=0;
int DS_F1_ASSOC_09=0; int DS_F1_ASSOC_10=0; int DS_F1_ASSOC_11=0; int DS_F1_ASSOC_12=0;
int DS_F1_ASSOC_13=0; int DS_F1_ASSOC_14=0; int DS_F1_ASSOC_15=0; int DS_F1_ASSOC_16=0;
int DS_F1_ASSOC_17=0; int DS_F1_ASSOC_18=0; int DS_F1_ASSOC_19=0; int DS_F1_ASSOC_20=0; int DS_F1_ASSOC_21=0;
int DS_F1_BLOQ_01=0; int DS_F1_BLOQ_02=0; int DS_F1_BLOQ_03=0; int DS_F1_BLOQ_04=0;
int DS_F1_BLOQ_05=0; int DS_F1_BLOQ_06=0; int DS_F1_BLOQ_07=0; int DS_F1_BLOQ_08=0;
int DS_F1_BLOQ_09=0; int DS_F1_BLOQ_10=0; int DS_F1_BLOQ_11=0; int DS_F1_BLOQ_12=0;
int DS_F1_BLOQ_13=0; int DS_F1_BLOQ_14=0; int DS_F1_BLOQ_15=0; int DS_F1_BLOQ_16=0;
int DS_F1_BLOQ_17=0; int DS_F1_BLOQ_18=0; int DS_F1_BLOQ_19=0; int DS_F1_BLOQ_20=0; int DS_F1_BLOQ_21=0;
// =============================================================
// SEÇÃO 5 — INICIALIZAÇÃO
// =============================================================
// =============================================================
// CONFIG INICIAL — preenchida pelo app D-Sig
// -------------------------------------------------------------
// O app gera o corpo de Config_Inicial() e o valor de Cfg_Selo. No boot, se o selo gravado na
// EEPROM for diferente do selo do codigo, a configuracao e aplicada e gravada, e o
// selo novo e registrado. Nos boots seguintes o selo bate e nada e sobrescrito —
// entao o que voce editar pelo OLED e salvar continua valendo.
// Gerar uma configuracao nova no app muda o selo, e ela volta a ser aplicada.
// Com Cfg_Selo em 0 (padrao) nada acontece: o script se comporta como sempre.
// v4a: variavel, nao define. Como define, o compilador via "CFG_SELO != 0" como condicao
// constante e avisava duas vezes. Como int o valor e o mesmo e o aviso some.
int Cfg_Selo = 0;

// --- GRAVACAO DIFERIDA DO BOOT ---
// Estas tres variaveis existem por causa de uma pane real, e vale a historia inteira.
// SINTOMA: depois de uma limpeza de slots no ZenStudio, o Cronus travava no boot
// seguinte, piscando vermelho, e so voltava com hardreset. Acontecia com o script do
// app, com o InLoco e com o avulso — ou seja, com todos.
// CAUSA: a limpeza zera a EEPROM. Com ela zerada, os DOIS caminhos de gravacao do init
// entram no mesmo boot — Migrado_V5() devolve 0 porque a SPVAR_64 foi apagada, e o selo
// gravado (0) nunca bate com o do app. Eram 64 gravacoes no avulso e 128 no script do
// app, todas seguidas, dentro do init, sem devolver o controle ao firmware. Do segundo
// boot em diante nao havia gravacao nenhuma, e era por isso que o hardreset "resolvia":
// as gravacoes que chegaram a passar deixaram o selo marcado.
// CORRECAO: o init passou a so LER e a AGENDAR. Quem grava e o Boot_Persistir, chamado
// no comeco do main: uma instancia (3 SPVARs) por volta, e o selo no fim. As 21
// instancias levam 21 voltas, cerca de 210ms — nada que se perceba, e o firmware recebe
// o controle de volta 21 vezes no caminho.
// Precisando espacar ainda mais, o passo a dividir e o Boot_Persistir: gravar um SPVAR
// por volta em vez de tres levaria 63 voltas (~630ms) e exigiria um dispatch por SPVAR.
int Boot_Inst = 0;   // 0 = nada pendente; 1-21 = proxima instancia a gravar;
                     // 22 = instancias prontas, falta so registrar o selo
int Boot_Selo = 0;   // valor do selo a registrar quando a gravacao terminar
int Boot_Mud  = 0;   // quantas instancias a migracao realmente alterou
function Config_Inicial() {
    // ---- o app escreve aqui: os 3 SPVARs de cada MOD (persistente) ----
    // A linha abaixo existe so para o corpo nao ficar vazio: sem config o ZenStudio
    // emite "Empty function detected", e o aviso confunde. O app substitui a funcao
    // inteira, entao ela desaparece no script gerado.
    Work_A = Work_A;
}
// v6b: as relacoes ZETA vivem em RAM e se perdem a cada desligamento — nao ha bits na
// EEPROM para elas. Ate agora o app as escrevia dentro de Config_Inicial(), que so roda
// quando o selo nao bate: apareciam no primeiro boot e sumiam no segundo.
// Separando-as, elas passam a ser reaplicadas em TODO boot. O efeito e o que o Daniel
// descreveu: a configuracao do app vira o DEFAULT do ZETA para aquele script.
// Consequencia assumida: alterar o ZETA pelo OLED vale ate desligar; ao ligar, volta ao
// que o app gerou. Para mudar de vez, mude no app e gere o script de novo.
function Config_Zeta() {
    // ---- o app escreve aqui: ZETA, botao do BLOK e modo FINALIZA (RAM) ----
    Work_A = Work_A;   // v7i: idem — evita o aviso de funcao vazia no template
}
// O Salvar_Tudo saiu daqui. Ele gravava as 21 instancias de uma vez, e era chamado
// exatamente nos dois pontos do init que causavam a pane do boot. Com a gravacao diferida
// quem faz esse trabalho e o Boot_Persistir, uma instancia por volta — e o Salvar_Tudo
// ficou sem nenhum chamador. O ZenStudio avisou ("Function 'Salvar_Tudo' is never used");
// o embutir.py agora faz essa mesma checagem antes de publicar, para nao depender disso.
// v5a MIGRACAO DE EEPROM (achado da auditoria externa). Os bits 22-26 do SPVAR_B eram o
// BOTAO DO BLOK; na v5 sao DELAY (22-23) e AFTER_TMP (24-26). Uma EEPROM gravada antes
// disso tem valores ali que seriam lidos como DELAY e AFTER — sem erro nem aviso, so
// comportamento errado. Um BLOK no botao 9, por exemplo, viraria DELAY=1 e AFTER=2, e o
// MOD passaria a demorar 300ms para responder sem que nada explicasse por que.
// A migracao zera esses cinco bits uma unica vez e marca a EEPROM como convertida,
// usando um selo proprio na SPVAR_64 — que ja e o lugar do selo da config do app.
// v5c CORRIGIDO apos a terceira auditoria. A migracao e o selo do app disputavam a
// mesma SPVAR_64, e isso abria um caminho de PERDA DE DADOS:
//   1) o app grava a config      -> SPVAR_64 = Cfg_Selo
//   2) o usuario ajusta DELAY e AFTER pelo OLED e salva
//   3) volta a um script sem config do app (Cfg_Selo = 0)
//   4) no boot, SPVAR_64 nao bate com o selo de migracao -> MIGRA DE NOVO
//      e a migracao zera justamente os bits do DELAY e do AFTER que ele configurou.
// Agora a SPVAR_64 e REPARTIDA e cada um tem seu espaco:
//   bit  0     migracao para o layout da v5 ja feita
//   bits 1-31  selo da configuracao do app (31 bits)
// Um nao apaga mais o outro.
// VERSAO DO LAYOUT DE BITS — nao confundir com a versao do script.
// O script esta na v6c; o LAYOUT esta na 5 porque as posicoes dos campos nos SPVARs nao
// mudaram desde a v5. A v6 mexeu em tabelas e na inicializacao, nao em bits. Uma auditoria
// externa estranhou a diferenca, com razao: os dois numeros andam separados de proposito.
// Incremente ESTE numero so quando um campo mudar de posicao ou tamanho — e, quando
// fizer isso, incremente tambem no app, para que os dois nunca divirjam em silencio,
// que e o unico jeito deste sistema falhar sem dar sinal.
define LAYOUT_VER = 5;
define BIT_MIGRADO_V5 = 1;
function Selo_Cfg_Gravado() {
    return (get_pvar(SPVAR_64, -2147483648, 2147483647, 0) >> 1) & 0x7FFFFFFF;
}
function Migrado_V5() {
    return get_pvar(SPVAR_64, -2147483648, 2147483647, 0) & BIT_MIGRADO_V5;
}
function Marcar_Selo(migrado, selo) {
    Work_A = (selo & 0x7FFFFFFF) << 1;
    if(migrado) Work_A = Work_A | BIT_MIGRADO_V5;
    Grava_Spv(SPVAR_64, Work_A);
}
// A migracao agora so mexe na RAM e AGENDA a gravacao. Duas mudancas, e as duas
// importam:
//   1. GRAVA SO SE MUDOU. Antes chamava Salvar_Tudo() sempre. Numa EEPROM zerada o laco
//      abaixo nao altera nada — nenhum MOD tem o bit SLOT_USED —, e ainda assim 63
//      gravacoes de zero sobre zero eram disparadas. Era a maior parte da pane, e a razao
//      de o InLoco, que nao tem MOD nem selo, travar igual ao script cheio.
//   2. NAO GRAVA AQUI. Quem grava e o Boot_Persistir, do main, uma instancia por volta.
// v7i: contador dedicado. Work_N funcionava por sorte — Salvar_Tudo tambem o usa como
// contador, e so nao quebrava porque rodava DEPOIS do laco.
function Migrar_V5() {
    Boot_Mud = 0;
    Esp_I = 1;
    while(Esp_I <= 21) {
        if(Get_Spvar_A(Esp_I) & 1) {   // so MODs que existem
            Work_A = Get_Spvar_B(Esp_I) & (~(0x1F << 22));
            if(Work_A != Get_Spvar_B(Esp_I)) {
                Set_Spvar_B(Esp_I, Work_A);
                Boot_Mud = Boot_Mud + 1;
            }
        }
        Esp_I++;
    }
    // O selo da migracao e registrado de todo modo: e ele que impede este laco de rodar
    // em cada boot. O que fica condicionado ao Boot_Mud e a gravacao das instancias.
    Boot_Agendar(Selo_Cfg_Gravado(), Boot_Mud > 0);
}

// Agenda o que o main vai gravar. Chamada duas vezes no mesmo boot quando a EEPROM esta
// zerada — pela migracao e pela config do app —, e a ordem resolve sozinha: quem pede
// instancias ganha de quem pede so o selo, e o selo do app, que vem depois, ganha do da
// migracao. E o mesmo resultado do codigo antigo, onde o ultimo Marcar_Selo vencia.
function Boot_Agendar(selo, com_instancias) {
    Boot_Selo = selo;
    if(com_instancias)        Boot_Inst = 1;
    else if(Boot_Inst == 0)   Boot_Inst = 22;
}

// Uma instancia por volta, e o selo no fim. Chamada no COMECO do main: o quanto antes a
// configuracao estiver na EEPROM, menor a janela em que um desligamento a perde — e
// perder essa janela nao custa nada, porque o boot seguinte refaz o mesmo trabalho.
function Boot_Persistir() {
    if(Boot_Inst == 0) return;
    if(Boot_Inst <= 21) {
        Save_Instance(Boot_Inst);
        Boot_Inst = Boot_Inst + 1;
        return;
    }
    Marcar_Selo(1, Boot_Selo);
    Boot_Inst = 0;
}
init {
    cls_oled(0);
    // v7m: o ZenStudio avisava "Cfg_Selo is never assigned" no script avulso e no InLoco,
    // onde o app nao substitui a linha da declaracao. Esta atribuicao nao muda nada e
    // tira o aviso.
    Cfg_Selo = Cfg_Selo;
    Load_All();
    // A migracao roda UMA VEZ na vida da EEPROM, independente do selo do app.
    if(!Migrado_V5()) Migrar_V5();
    // A config do app e aplicada quando o selo do codigo difere do gravado. Config_Inicial
    // so escreve no cache em RAM, que e instantaneo; a ida para a EEPROM fica agendada.
    if(Cfg_Selo != 0 && Selo_Cfg_Gravado() != (Cfg_Selo & 0x7FFFFFFF)) {
        Config_Inicial();
        Boot_Agendar(Cfg_Selo, TRUE);
    }
    // O ZETA e reaplicado SEMPRE — e RAM, entao nao ha o que preservar entre boots.
    if(Cfg_Selo != 0) Config_Zeta();
    Count_Instances();
    Inicializar_Estado();
    Update_OLED();
}
// =============================================================
// SEÇÃO 6 — MAIN
// =============================================================
// main e um INDICE: dez chamadas, nenhuma logica. Cada uma era um "BLOCO N" comentado
// dentro de um main de 700 linhas, e o comentario era a unica coisa que dizia onde um
// assunto acabava e o outro comecava. Agora o nome da funcao diz, e o compilador cobra.
//
// A ORDEM E FUNCIONAL, e esta e a razao de cada posicao:
//   1. Boot_Persistir    grava na EEPROM o que o init agendou, UMA instancia por volta.
//                        Sai na primeira linha quando nao ha nada pendente, o que e o
//                        caso de todo boot em que a configuracao ja estava gravada
//   2. Cfg_Marcar_Sujo   menu aberto = a configuracao pode mudar; as mascaras estaticas
//                        sao refeitas na saida, nunca no meio de uma edicao
//   3. Ler_Dominios      os comandos podem TROCAR o dominio nesta volta
//   4. Menu_Din          o menu de configuracao le os botoes e os suprime do jogo
//   5. Menu_Din_Saida    fechou o MenuDin? o estado de execucao recomeca do INIC
//   6. Rodar_Mods        os MODs rodam no dominio que acabou de ser decidido, e so com
//                        os dois menus fechados
//   7. Menu_Status       vem DEPOIS dos MODs porque e ele quem os congela
//   8. Tela_Manter       a tela reflete o que as cinco primeiras fizeram
//   9. Menu_Disponivel   decide se os menus podem abrir na volta SEGUINTE
//  10. Saidas_Manter     POR ULTIMO: o que as saidas com duracao escrevem nao pode ser
//                        sobrescrito por ninguem nesta volta (ver SECAO 18)
main {
    Boot_Persistir();
    Cfg_Marcar_Sujo();
    Ler_Dominios();
    Menu_Din();
    Menu_Din_Saida();
    Rodar_Mods();
    Menu_Status();
    Tela_Manter();
    Menu_Disponivel();
    Saidas_Manter();
}

// =============================================================
// SEÇÃO 7 — DOMINIOS
// =============================================================
// Quatro comandos, duas funcoes. Antes eram quatro blocos escritos a mao no main, com o
// mesmo codigo repetido duas vezes para o duplo clique e duas para o segurar — e quatro
// lugares para consertar quando o comportamento mudasse. O dominio e o par de botoes
// viram PARAMETRO, e a mesma funcao serve aos dois duplos cliques e aos dois "segurar".

// Menu aberto significa que a configuracao pode estar mudando agora: marcar sujo faz as
// mascaras estaticas serem refeitas na saida do menu, nunca no meio da edicao.
function Cfg_Marcar_Sujo() {
    if(MenuDin > 0 || MenuLevel > 0) Cfg_Sujo = TRUE;
}

function Ler_Dominios() {
    Dom_Duplo(1,    PS5_L1, PS5_L3);
    Dom_Duplo(2,    PS5_R1, PS5_R3);
    Dom_Segurar(3,  PS5_L1, PS5_L3);
    Dom_Segurar(4,  PS5_R1, PS5_R3);
}

// DUPLO CLIQUE, em duas partes:
//   a) a janela aberta pelo primeiro clique perde o tempo desta volta;
//   b) no aperto: janela aberta = segundo clique, troca o dominio;
//      janela fechada = primeiro clique, abre a janela.
// O desconto vem ANTES do teste do aperto de proposito: depois, cada clique ganharia uma
// volta de folga.
function Dom_Duplo(dom, btn_mod, btn_ana) {
    Dom_Tmp = Get_Dom_Dc(dom);
    if(Dom_Tmp > 0) Set_Dom_Dc(dom, Dom_Tmp - get_rtime());
    if(!get_ival(btn_mod)) return;
    if(!event_press(btn_ana)) return;
    if(Get_Dom_Dc(dom) > 0) Switch_Mode(dom);
    else                    Set_Dom_Dc(dom, TIME_SHORT_PRESS);
}

// SEGURAR: dispara quando o tempo de aperto do analogico passa de TIME_HOLD.
// O bit em Dom_Disparado e o anti-repeticao — sem ele o dominio ligaria e desligaria a
// cada volta enquanto o analogico continuasse pressionado. Antes eram duas variaveis
// soltas, Flag_Hold_S3 e Flag_Hold_S4, uma por comando; agora e um bit por dominio na
// mesma mascara, e e por isso que a funcao pode ser uma so. O bit e marcado ANTES da
// troca (a troca chama o reset, e o reset nao pode apaga-lo) e cai quando o par e solto.
function Dom_Segurar(dom, btn_mod, btn_ana) {
    if(!get_ival(btn_mod) || !get_ival(btn_ana)) {
        Dom_Disparado = Dom_Disparado & (~(1 << (dom - 1)));
        return;
    }
    if(get_ptime(btn_ana) < TIME_HOLD) return;
    if((Dom_Disparado >> (dom - 1)) & 1) return;
    Dom_Disparado = Dom_Disparado | (1 << (dom - 1));
    Switch_Mode(dom);
}

// O par Get_/Set_ e o array que o GPC nao tem: o numero do dominio escolhe a variavel.
// Aqui sao dois itens, entao e um if; o mesmo padrao com 21 itens (Get_Dc / Set_Dc dos
// MODs) vale a pena transformar em arvore, e foi o que a v7l fez.
// O nome leva "Dom_" porque Get_Dc / Set_Dc ja existem e sao dos MODs: a janela do 2CLK
// de cada MOD. Dois assuntos com o mesmo nome e o tipo de colisao que so aparece no dia
// em que alguem chama a funcao errada.
function Get_Dom_Dc(dom) {
    if(dom == 1) return Dom_Dc_D1;
    if(dom == 2) return Dom_Dc_D2;
    return 0;
}
function Set_Dom_Dc(dom, v) {
    if(dom == 1) Dom_Dc_D1 = v;
    if(dom == 2) Dom_Dc_D2 = v;
}

// =============================================================
// SEÇÃO 8 — MODS GERAIS E PIPELINE
// =============================================================
// Tres condicoes para os MODs rodarem, e cada uma diz uma coisa:
//   CurrentMode > 0   ha dominio ligado — sem dominio o controle fica normal
//   MenuLevel == 0    o menu de status esta fechado — ele CONGELA os MODs (o estado fica
//                     de pe e volta de onde parou), em vez de desliga-los
//   MenuDin == 0      o menu de configuracao esta fechado — enquanto se edita nada
//                     responde; ao fechar, Menu_Din_Saida recomeca do INIC
// Os dois utilitarios valem so dentro de um dominio, como os MODs.
function Rodar_Mods() {
    if(CurrentMode == 0 || MenuLevel > 0 || MenuDin > 0) return;
    Util_Touchpad();
    Util_ShareToque();
    Run_Pipeline();
}

// Com o dedo apoiado, o jogo entende toque e desvia a camera. Aqui o touchpad e anulado
// inteiro — o toque e as duas coordenadas. Nasce ligado; L2 + duplo DOWN alterna, com o
// menu de status aberto.
function Util_Touchpad() {
    if(!FingOff_Enabled) return;
    set_val(PS5_FINGER1,  0); set_val(PS5_FINGER2,  0);
    set_val(PS5_FINGER1X, 0); set_val(PS5_FINGER1Y, 0);
}

// SHARE abre a tela de captura e tira voce do jogo. Trocado por um toque curto no
// touchpad, que e o gesto que o jogo espera. O SHARE original e anulado para nao
// chegarem os dois.
function Util_ShareToque() {
    if(!SharTho_Enabled) return;
    if(!get_ival(PS5_SHARE)) return;
    set_val(PS5_SHARE, 0);
    Tap_Disparar();
}

// =============================================================
// SEÇÃO 9 — MENU DE CONFIGURACAO (MenuDin)
// =============================================================
// R1 + OPTIONS abre e fecha. Enquanto esta aberto, os botoes do jogo sao suprimidos e o
// pipeline nao roda. A guarda "sem dominio, sem menu" era o if que embrulhava este bloco
// inteiro dentro do main; virou a primeira linha da funcao.
//
// O MAPA DAS TELAS. O MenuDin guarda o numero da tela, e os numeros sao historicos — 1 e
// a lista, 36/37/38 vem da primeira versao e a familia 100+ chegou com o wizard v3. Nao
// foram renumerados de proposito: eles aparecem no Save_Cur / Load_Cur e em Reset_Page, e
// renumerar por estetica e trocar um incomodo por um risco.
//
//    1  LISTA DE MODs ........ navega, cria (X no [+]), reordena (L2+UP/DOWN),
//                              deleta (TRIANGLE 1s), entra no MOD (X)
//   36  PL_HAB ............... em quais dominios o MOD existe. SQUARE 1s zera o MOD
//  100  ALFA ................. a fonte e o MODO (ATIVO/PASSIVO), mais o DELAY
//  101  BETA ................. condicoes da fonte: MULT, THR_IN, THR_OUT, DIR
//  102  GAMA (lista) ......... os cinco gatilhos; X entra na config de um
//  103  GAMA (config) ........ botao, tempo e modo do gatilho sob o cursor
//  104  DELTA (tipo) ......... DIRECT / STATIC / TURBO
//  105  DELTA (destinos) ..... os 4 destinos, e os tempos quando e TURBO
//  106  ZETA (selecao) ....... quais MODs entram na relacao em edicao
//  107  ZETA (lista) ......... EXCL / ASSOC / BLOQ; X entra na selecao
//   37  CONFIRMAR ............ X confirma em RAM; SHARE 1s grava na EEPROM
//   38  DELETAR? ............. confirmacao da delecao (MENUDIN_DEL_CONF)
//
// Cada uma virou UMA funcao Mnu_*. Antes eram doze "else if" com o corpo dentro, e o fim
// de uma tela era o comeco da outra separados por dois comentarios e uma chave — 500
// linhas em que mover um bloco trocava a condicao dele sem avisar.
function Menu_Din() {
    if(CurrentMode == 0) return;
    Menu_Din_Abre();
    Menu_Din_Bloqueia();
    Menu_Din_Zera();
    Menu_Din_Fecha();
    Menu_Din_Cursor_Salva();
    Menu_Din_Telas();
    Menu_Din_Cursor_Troca();
}

// O DESPACHO DAS TELAS. Antes era uma cadeia de doze "else if(MenuDin == N)" com o corpo
// de cada tela dentro — 500 linhas em que o fim de uma tela e o comeco da outra eram
// dois comentarios em cima de uma chave.
// O "return" depois de cada chamada nao e enfeite: ele e o que preserva o "else" da
// cadeia antiga. Sem ele, uma tela que muda o MenuDin (e quase todas mudam) faria a tela
// NOVA rodar tambem, na mesma volta, com o estado ainda a meio caminho.
function Menu_Din_Telas() {
    if(MenuDin == 1)                     { Mnu_Lista(); return; }
    if(MenuDin == 100)                   { Mnu_Alfa(); return; }
    if(MenuDin == 101)                   { Mnu_Beta(); return; }
    if(MenuDin == 102)                   { Mnu_Gama_Lista(); return; }
    if(MenuDin == 103)                   { Mnu_Gama_Cfg(); return; }
    if(MenuDin == 104)                   { Mnu_Delta_Tipo(); return; }
    if(MenuDin == 105)                   { Mnu_Delta_Dst(); return; }
    if(MenuDin == 106)                   { Mnu_Zeta_Sel(); return; }
    if(MenuDin == 107)                   { Mnu_Zeta_Lista(); return; }
    if(MenuDin == 36)                    { Mnu_Dominios(); return; }
    if(MenuDin == MENUDIN_DEL_CONF)      { Mnu_Del_Conf(); return; }
    if(MenuDin == 37)                    { Mnu_Confirmar(); return; }
}

// Abre e fecha o MenuDin. R1 + OPTIONS nos dois sentidos: abrindo, o cursor
// comeca no topo da lista.
function Menu_Din_Abre() {
    if(!get_ival(PS5_R1))           return;
    if(!event_press(PS5_OPTIONS))   return;
    if(MenuDin > 0) {
        MenuDin = 0;
        Update_OLED();
        return;
    }
    MenuDin    = 1;
    MenuCursor = 0;
    ScrollTop  = 0;
    Update_OLED();
}

// Com o menu aberto, os botoes nao chegam ao jogo — eles sao a navegacao. O
// OPTIONS fica de fora de proposito: e ele que abre o menu de status, e o de status
// continua respondendo.
// Nao inclui o SHARE: quem o bloqueia e a tela CONFIRMAR, que o usa para gravar.
function Menu_Din_Bloqueia() {
    if(MenuDin == 0) return;
    set_val(PS5_TRIANGLE, 0); set_val(PS5_CIRCLE,  0);
    set_val(PS5_SQUARE,   0); set_val(PS5_CROSS,   0);
    set_val(PS5_L1, 0); set_val(PS5_L2, 0); set_val(PS5_L3, 0);
    set_val(PS5_R1, 0); set_val(PS5_R2, 0); set_val(PS5_R3, 0);
    set_val(PS5_UP, 0); set_val(PS5_DOWN,  0);
    set_val(PS5_LEFT, 0); set_val(PS5_RIGHT, 0);
}

// SQUARE segurado zera a PAGINA atual. Na tela de DOMINIOS (36) "a pagina" e o MOD
// inteiro — e a unica tela onde isso acontece, e esta escrito no cabecalho.
function Menu_Din_Zera() {
    if(MenuDin == 0 || !get_ival(PS5_SQUARE)) {
        Sq_Timer = 0;                       // soltou (ou fechou o menu): a contagem recomeca
        return;
    }
    Sq_Timer = Sq_Timer + get_rtime();
    if(Sq_Timer < TIME_SQ_RESET) return;
    Reset_Page();
    Sq_Timer = 0;
    Update_OLED();
}

// CIRCLE segurado fecha o MenuDin inteiro.
function Menu_Din_Fecha() {
    if(!get_ival(PS5_CIRCLE)) {
        Circle_Timer     = 0;
        // A flag cai quando o CIRCLE e SOLTO, nao quando o MenuDin zera: e isso que
        // impede o mesmo hold de fechar o menu de status logo em seguida.
        Flag_Circle_Hold = FALSE;
        return;
    }
    // So vale na Lista, antes de entrar em qualquer MOD. Dentro de uma configuracao,
    // CIRCLE — mesmo segurado — volta um nivel, e quem faz isso e o event_release de
    // cada tela. Aqui o hold tem prioridade sobre aquele "voltar um nivel".
    if(MenuDin != 1) return;
    Circle_Timer = Circle_Timer + get_rtime();
    if(Circle_Timer < TIME_CIRCLE_CLOSE) return;
    if(Flag_Circle_Hold) return;
    Flag_Circle_Hold = TRUE;
    MenuDin = 0;
    Update_OLED();
}

// MEMORIA DE CURSOR, metade 1: guarda a posicao da tela atual a cada volta, antes
// de processar. A metade 2 (Menu_Din_Cursor_Troca) restaura ao trocar de tela.
function Menu_Din_Cursor_Salva() {
    //------------------------------------------------------
    // MEMÓRIA DE CURSOR (opção 1) — salva contínuo; restaura ao trocar de tela
    // Salva a posição da tela atual a cada ciclo (antes do processamento).
    // Se a tela mudou desde o ciclo anterior, restaura o cursor da nova.
    //------------------------------------------------------
    if(MenuDin <= 1)          return;   // a lista nao tem cursor a guardar
    if(MenuDin != MenuDin_Ant) return;   // acabou de trocar: quem carrega e a outra metade
    Save_Cur(MenuDin);
}

// MEMORIA DE CURSOR, metade 2: a tela mudou nesta volta, entao carrega o cursor
// salvo da tela nova. As telas zeram Wz_SubCursor na transicao; aqui e sobrescrito.
function Menu_Din_Cursor_Troca() {
    if(MenuDin == MenuDin_Ant) return;
    // As telas zeram Wz_SubCursor na transicao; aqui ele e sobrescrito pelo que ficou
    // guardado, e e por isso que esta chamada vem DEPOIS do despacho.
    if(MenuDin > 1) Load_Cur(MenuDin);
    MenuDin_Ant = MenuDin;
    Update_OLED();
}

// --- MenuDin = 1 — LISTA DE MODs ---
function Mnu_Lista() {
    set_val(PS5_OPTIONS, 0);
    // UP/DOWN — navega lista (instâncias + botão [+])
    // Total de itens: Total_Inst + 1 (o [+])
    // Mas só mostramos [+] se Total_Inst < MAX_INST
    // v3zu: com L2 SEGURADO, UP/DOWN passam a REORDENAR em vez de navegar — o MOD
    // troca de lugar com o vizinho e o cursor vai junto, para que segurar o L2 e
    // repetir o DOWN arraste o MOD ate onde se quer. Sem L2, navegam como sempre.
    // Nao ha wrap na reordenacao de proposito: chegar ao fim da lista e parar e
    // mais previsivel do que o MOD reaparecer no topo.
    if(event_press(PS5_DOWN)) {
        if(get_ival(PS5_L2) && MenuCursor < Total_Inst - 1) {
            Swap_Pos(MenuCursor + 1, MenuCursor + 2);
            MenuCursor++;
            Ajust_Scroll_Down();
        } else if(!get_ival(PS5_L2)) {
            MenuCursor++;
            if(Total_Inst < MAX_INST) {
                if(MenuCursor > Total_Inst) MenuCursor = 0;
            } else {
                if(MenuCursor >= Total_Inst) MenuCursor = 0;
            }
            Ajust_Scroll_Down();
        }
        Update_OLED();
    }
    if(event_press(PS5_UP)) {
        if(get_ival(PS5_L2) && MenuCursor > 0 && MenuCursor < Total_Inst) {
            Swap_Pos(MenuCursor, MenuCursor + 1);
            MenuCursor--;
            Ajust_Scroll_Up();
        } else if(!get_ival(PS5_L2)) {
            MenuCursor--;
            if(MenuCursor < 0) {
                if(Total_Inst < MAX_INST) MenuCursor = Total_Inst;
                else                      MenuCursor = Total_Inst - 1;
            }
            Ajust_Scroll_Up();
        }
        Update_OLED();
    }
    // X — entra na instância ou cria nova
    if(event_press(PS5_CROSS)) {
        if(MenuCursor == Total_Inst && Total_Inst < MAX_INST) {
            // Cursor no [+] — cria nova instância
            Criar_Instancia();
            Update_OLED();
        } else {
            // Cursor numa instância existente — entra no wizard
            WzSlot      = MenuCursor + 1; // 1-based
            Load_Wz(WzSlot);
            Reset_Cursors();   // cursor de cada tela recomeça do topo
            MenuDin     = 36;
            Wz_SubCursor = 0;
            Wz_Entrando = TRUE;
            Update_OLED();
        }
    }
    // CIRCLE — fecha o MenuDin
    if(event_release(PS5_CIRCLE)) {
        MenuDin = 0;
        Update_OLED();
    }
    // TRIANGLE segurado 1s — inicia deleção da instância selecionada
    // Só ativo quando cursor aponta para instância existente (não no [+])
    if(MenuCursor < Total_Inst && get_ival(PS5_TRIANGLE)) {
        Tri_Timer = Tri_Timer + get_rtime();
        if(Tri_Timer >= TIME_TRI_DELETE) {
            Del_Slot  = MenuCursor + 1; // 1-based
            MenuDin   = MENUDIN_DEL_CONF;
            Tri_Timer = 0;
            Update_OLED();
        }
    } else {
        Tri_Timer = 0;
    }
}
    //------------------------------------------------------
    // WIZARD v3 — FONTES ÚNICA (MenuDin=100)
    // Ordem fechada: ON/OFF -> fonte (cicla 22 opções) -> PASSIVO/ATIVO -> RELIG
    //------------------------------------------------------

// --- MenuDin = 100 — ALFA — a fonte ---
function Mnu_Alfa() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; Load_Wz_Fonte(WzSlot); }
    // R1: se a fonte não tem condicional (categoria BOTAO), pula direto pro PERFIL
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Fonte(WzSlot);
        if(Get_Fonte_Categoria(Wz_Fonte_Tipo) == CAT_BOTAO) {
            MenuDin = 102;
        } else {
            Load_Wz_Cond(WzSlot);
            MenuDin = 101;
        }
        Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Fonte(WzSlot);
        MenuDin = 36;
        Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0) Wz_SubCursor = 2; Update_OLED(); }   // v5: 3 campos
    if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > 2) Wz_SubCursor = 0; Update_OLED(); }
    if(event_press(PS5_LEFT)) {
        if(Wz_SubCursor == 0) { Wz_Fonte_Tipo--; if(Wz_Fonte_Tipo < 0) Wz_Fonte_Tipo = 22; }
        if(Wz_SubCursor == 1) Wz_Fonte_Passivo = !Wz_Fonte_Passivo;
        if(Wz_SubCursor == 2) { Wz_Delay--; if(Wz_Delay < 0) Wz_Delay = 3; }
        Update_OLED();
    }
    if(event_press(PS5_RIGHT)) {
        if(Wz_SubCursor == 0) { Wz_Fonte_Tipo++; if(Wz_Fonte_Tipo > 22) Wz_Fonte_Tipo = 0; }
        if(Wz_SubCursor == 1) Wz_Fonte_Passivo = !Wz_Fonte_Passivo;
        if(Wz_SubCursor == 2) { Wz_Delay++; if(Wz_Delay > 3) Wz_Delay = 0; }
        Update_OLED();
    }
}
    //------------------------------------------------------
    // WIZARD v3 — CONDICIONAIS DA FONTE (MenuDin=101)
    // Campos variam por categoria: TOUCH=só MULT(0); GATILHO=MULT/THR_IN/THR_OUT/INV(0-3);
    // EIXO=MULT/THR_IN/THR_OUT/DIR/INV(0-4). Pendência nº2: L2/R2=GATILHO, sem DIR.
    //------------------------------------------------------

// --- MenuDin = 101 — BETA — as condicoes da fonte ---
function Mnu_Beta() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; Wz_ScrTop = 0; }
    Work_C = Get_Fonte_Categoria(Wz_Fonte_Tipo);   // categoria da fonte em edição
    // v3ze: sem o INV — TOUCH so MULT(0); GATILHO MULT/THR_IN/THR_OUT(0-2);
    // EIXO acrescenta o DIR(3).
    if(Work_C == CAT_TOUCH)        Work_D = 0;
    else if(Work_C == CAT_GATILHO) Work_D = 2;
    else                           Work_D = 3;     // CAT_EIXO
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Cond(WzSlot);
        MenuDin = 102; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Cond(WzSlot);
        MenuDin = 100; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0) Wz_SubCursor = Work_D; Ajust_Scr_Cond(); Update_OLED(); }
    if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > Work_D) Wz_SubCursor = 0; Ajust_Scr_Cond(); Update_OLED(); }
    if(event_press(PS5_LEFT)) {
        if(Wz_SubCursor == 0) { Wz_Cond_Mult--; if(Wz_Cond_Mult < 0) Wz_Cond_Mult = 0; }
        else if(Wz_SubCursor == 1) { Wz_Cond_ThrIn--; if(Wz_Cond_ThrIn < 0) Wz_Cond_ThrIn = 0; }
        else if(Wz_SubCursor == 2) { Wz_Cond_ThrOut--; if(Wz_Cond_ThrOut < 0) Wz_Cond_ThrOut = 0; }
        else if(Wz_SubCursor == 3) { Wz_Cond_Dir--; if(Wz_Cond_Dir < 0) Wz_Cond_Dir = 2; }
        Update_OLED();
    }
    if(event_press(PS5_RIGHT)) {
        if(Wz_SubCursor == 0) { Wz_Cond_Mult++; if(Wz_Cond_Mult > 18) Wz_Cond_Mult = 18; }   // v3za: escala sem OFF
        else if(Wz_SubCursor == 1) { Wz_Cond_ThrIn++; if(Wz_Cond_ThrIn > 19) Wz_Cond_ThrIn = 19; }
        else if(Wz_SubCursor == 2) { Wz_Cond_ThrOut++; if(Wz_Cond_ThrOut > 19) Wz_Cond_ThrOut = 19; }
        else if(Wz_SubCursor == 3) { Wz_Cond_Dir++; if(Wz_Cond_Dir > 2) Wz_Cond_Dir = 0; }
        Update_OLED();
    }
}
    //------------------------------------------------------
    // WIZARD v3 — GATILHO+BTN_FN: LISTA (MenuDin=102)
    // 5 tipos coexistentes + INIC. X mergulha na config do tipo sob o cursor.
    //------------------------------------------------------

// --- MenuDin = 102 — GAMA — lista dos cinco gatilhos ---
function Mnu_Gama_Lista() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; Wz_ScrTop = 0; Load_Wz_Gatilho(WzSlot); }
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Gatilho(WzSlot);
        Load_Wz_Tipo(WzSlot);
        MenuDin = 104; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Gatilho(WzSlot);
        if(Get_Fonte_Categoria(Wz_Fonte_Tipo) == CAT_BOTAO) { MenuDin = 100; }
        else                                                 { MenuDin = 101; }
        Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP)) {
        Wz_Gatilho_Lista_Cur--; if(Wz_Gatilho_Lista_Cur < 0) Wz_Gatilho_Lista_Cur = 4;   // v6c: o BLOK voltou
        if(Wz_Gatilho_Lista_Cur < Wz_ScrTop) Wz_ScrTop = Wz_Gatilho_Lista_Cur;
        if(Wz_Gatilho_Lista_Cur > Wz_ScrTop + 1) Wz_ScrTop = Wz_Gatilho_Lista_Cur - 1;
        if(Wz_Gatilho_Lista_Cur == 4) Wz_ScrTop = 3;
        Update_OLED();
    }
    if(event_press(PS5_DOWN)) {
        Wz_Gatilho_Lista_Cur++; if(Wz_Gatilho_Lista_Cur > 4) Wz_Gatilho_Lista_Cur = 0;   // v6c
        if(Wz_Gatilho_Lista_Cur < Wz_ScrTop) Wz_ScrTop = Wz_Gatilho_Lista_Cur;
        if(Wz_Gatilho_Lista_Cur > Wz_ScrTop + 1) Wz_ScrTop = Wz_Gatilho_Lista_Cur - 1;
        if(Wz_Gatilho_Lista_Cur == 0) Wz_ScrTop = 0;
        Update_OLED();
    }
    if(event_press(PS5_CROSS)) {   // v3za: os 5 itens restantes sao todos configuraveis
        MenuDin = 103; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
}
    //------------------------------------------------------
    // WIZARD v3 — GATILHO+BTN_FN: CONFIG DO TIPO (MenuDin=103)
    // Campos por tipo: BLOQ/DUPLO=só botão(0); HPHOLD=botão(0)+tempo(1);
    // FINALIZA=botão(0)+relig(1); FINAL_AFTER=botão(0)+tempo(1)+relig(2).
    // Botão: 0=nenhum, 1-16=BTN_BIT+1 (mesmo esquema da FONTE única).
    //------------------------------------------------------

// --- MenuDin = 103 — GAMA — config do gatilho sob o cursor ---
function Mnu_Gama_Cfg() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; }
    // v3zb: sem os campos de RELIG, os tipos encolheram — e o HOLD voltou a
    // caber nas 3 linhas da tela, dispensando a janela deslizante da v3z8.
    // v6c: 0=2CLK 1=TOGGLE 2=HOLD 3=AFTER 4=BLOK (o BLOK entra no FIM, nao no
    // comeco: ele e RAM e nao persiste sozinho, entao nao deve ser o primeiro
    // que a pessoa encontra ao abrir a tela.)
    // v7: todo GAMA que liga/desliga ganhou o campo ALT/FIN, entao cada tela tem
    // uma linha a mais. O BLOK (4) segue com uma so — ele nao liga nem desliga.
    Work_C = Wz_Gatilho_Lista_Cur;
    if(Work_C == 2)      Work_D = 3;   // HOLD: botao + tempo + APOS/ATE + ALT/FIN
    else if(Work_C == 3) Work_D = 2;   // AFTER: botao + tempo + ALT/FIN
    else if(Work_C == 4) Work_D = 0;   // BLOK: so botao
    else                 Work_D = 1;   // 2CLK / TOGGLE: botao + ALT/FIN
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Gatilho(WzSlot);
        MenuDin = 102; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Gatilho(WzSlot);
        MenuDin = 102; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0) Wz_SubCursor = Work_D; Update_OLED(); }
    if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > Work_D) Wz_SubCursor = 0; Update_OLED(); }
    if(event_press(PS5_LEFT)) {
        if(Wz_SubCursor == 0) {
            if(Work_C == 0)      { Wz_Gatilho_Duplo_Btn--;  if(Wz_Gatilho_Duplo_Btn < 0)  Wz_Gatilho_Duplo_Btn = 16; }
            else if(Work_C == 1) { Wz_Gatilho_Final_Btn--;  if(Wz_Gatilho_Final_Btn < 0)  Wz_Gatilho_Final_Btn = 16; }
            else if(Work_C == 2) { Wz_Gatilho_Hphold_Btn--; if(Wz_Gatilho_Hphold_Btn < 0) Wz_Gatilho_Hphold_Btn = 16; }
            else if(Work_C == 4) { Wz_Blok--; if(Wz_Blok < 0) Wz_Blok = 16; }
            else                 { Wz_Gatilho_FA_Btn--;     if(Wz_Gatilho_FA_Btn < 0)     Wz_Gatilho_FA_Btn = 16; }
        // v7h CORRIGIDO: na v7 este bloco do ALT/FIN foi inserido NO MEIO da cadeia
        // de else-if acima, e o ramo do AFTER ficou orfao dentro dele — um "else"
        // sem "if" que o ZenStudio rejeita. O contador de chaves nao pegou porque
        // as chaves continuavam balanceadas; so o compilador acusaria.
        } else if(Wz_SubCursor == Work_D && Work_C != 4) {
            // a ULTIMA linha de cada gatilho e o ALT/FIN
            Wz_Fin = Wz_Fin ^ (1 << Gatilho_Idx(Work_C));
        } else if(Wz_SubCursor == 1 && Work_C == 2) { Wz_Gatilho_Hphold_Tempo--; if(Wz_Gatilho_Hphold_Tempo < 0) Wz_Gatilho_Hphold_Tempo = 62; }
        else if(Wz_SubCursor == 2 && Work_C == 2)   { Wz_Gatilho_Hold_Modo = !Wz_Gatilho_Hold_Modo; }
        else if(Wz_SubCursor == 1 && Work_C == 3)   { Wz_Gatilho_FA_Tempo--; if(Wz_Gatilho_FA_Tempo < 0) Wz_Gatilho_FA_Tempo = 7; }
        Update_OLED();
    }
    if(event_press(PS5_RIGHT)) {
        if(Wz_SubCursor == 0) {
            if(Work_C == 0)      { Wz_Gatilho_Duplo_Btn++;  if(Wz_Gatilho_Duplo_Btn > 16)  Wz_Gatilho_Duplo_Btn = 0; }
            else if(Work_C == 1) { Wz_Gatilho_Final_Btn++;  if(Wz_Gatilho_Final_Btn > 16)  Wz_Gatilho_Final_Btn = 0; }
            else if(Work_C == 2) { Wz_Gatilho_Hphold_Btn++; if(Wz_Gatilho_Hphold_Btn > 16) Wz_Gatilho_Hphold_Btn = 0; }
            else if(Work_C == 4) { Wz_Blok++; if(Wz_Blok > 16) Wz_Blok = 0; }
            else                 { Wz_Gatilho_FA_Btn++;     if(Wz_Gatilho_FA_Btn > 16)     Wz_Gatilho_FA_Btn = 0; }
        } else if(Wz_SubCursor == Work_D && Work_C != 4) {
            Wz_Fin = Wz_Fin ^ (1 << Gatilho_Idx(Work_C));
        } else if(Wz_SubCursor == 1 && Work_C == 2) { Wz_Gatilho_Hphold_Tempo++; if(Wz_Gatilho_Hphold_Tempo > 62) Wz_Gatilho_Hphold_Tempo = 0; }
        else if(Wz_SubCursor == 2 && Work_C == 2)   { Wz_Gatilho_Hold_Modo = !Wz_Gatilho_Hold_Modo; }
        else if(Wz_SubCursor == 1 && Work_C == 3)   { Wz_Gatilho_FA_Tempo++; if(Wz_Gatilho_FA_Tempo > 7) Wz_Gatilho_FA_Tempo = 0; }
        Update_OLED();
    }
}
    //------------------------------------------------------
    // WIZARD v3 — TIPO (MenuDin=104, Seção 5) — DIRECT/ESTATC/TURBO, escolha única
    //------------------------------------------------------

// --- MenuDin = 104 — DELTA — DIRECT / STATIC / TURBO ---
function Mnu_Delta_Tipo() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; }
    if(event_press(PS5_CROSS)) {
        Commit_Wz_Tipo(WzSlot);
        MenuDin = 105; Wz_SubCursor = 0; Wz_ScrTop = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Tipo(WzSlot);
        MenuDin = 107; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Tipo(WzSlot);
        MenuDin = 102; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_LEFT))  { Wz_Tipo--; if(Wz_Tipo < 0) Wz_Tipo = 2; Update_OLED(); }
    if(event_press(PS5_RIGHT)) { Wz_Tipo++; if(Wz_Tipo > 2) Wz_Tipo = 0; Update_OLED(); }
}
    //------------------------------------------------------
    // WIZARD v3 — DESTINO (MenuDin=105, Seção 5) — mergulho a partir de 104
    //------------------------------------------------------

// --- MenuDin = 105 — DELTA — os 4 destinos ---
function Mnu_Delta_Dst() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; Wz_SubCursor = 0; Wz_ScrTop = 0; }
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Tipo(WzSlot);
        MenuDin = 104; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Tipo(WzSlot);
        MenuDin = 104; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(Wz_Tipo == DST_TIPO_TURBO) {
        // v3ze: 3 parametros gerais + 4 pares (destino, tempo) = 11 itens
        Work_B = 10;
        if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0)      Wz_SubCursor = Work_B; Ajust_Scr_Btn(); Update_OLED(); }
        if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > Work_B) Wz_SubCursor = 0;      Ajust_Scr_Btn(); Update_OLED(); }
        if(event_press(PS5_LEFT)) {
            if(Wz_SubCursor == 0)      { Wz_Turbo_Lat--;    if(Wz_Turbo_Lat < 0)    Wz_Turbo_Lat = 15; }
            else if(Wz_SubCursor == 1) { Wz_Turbo_Modo--;   if(Wz_Turbo_Modo < 0)   Wz_Turbo_Modo = 3; }
            else if(Wz_SubCursor == 2) { Wz_Turbo_Ciclos--; if(Wz_Turbo_Ciclos < 0) Wz_Turbo_Ciclos = 7; }
            else if(Wz_SubCursor == 3) { Wz_Cmb_D1--; if(Wz_Cmb_D1 < 0) Wz_Cmb_D1 = 18; }
            else if(Wz_SubCursor == 4) { Wz_Cmb_T1--; if(Wz_Cmb_T1 < 0) Wz_Cmb_T1 = 7; }
            else if(Wz_SubCursor == 5) { Wz_Cmb_D2--; if(Wz_Cmb_D2 < 0) Wz_Cmb_D2 = 18; }
            else if(Wz_SubCursor == 6) { Wz_Cmb_T2--; if(Wz_Cmb_T2 < 0) Wz_Cmb_T2 = 7; }
            else if(Wz_SubCursor == 7) { Wz_Cmb_D3--; if(Wz_Cmb_D3 < 0) Wz_Cmb_D3 = 18; }
            else if(Wz_SubCursor == 8) { Wz_Cmb_T3--; if(Wz_Cmb_T3 < 0) Wz_Cmb_T3 = 7; }
            else if(Wz_SubCursor == 9) { Wz_Cmb_D4--; if(Wz_Cmb_D4 < 0) Wz_Cmb_D4 = 18; }
            else                       { Wz_Cmb_T4--; if(Wz_Cmb_T4 < 0) Wz_Cmb_T4 = 7; }
            Update_OLED();
        }
        if(event_press(PS5_RIGHT)) {
            if(Wz_SubCursor == 0)      { Wz_Turbo_Lat++;    if(Wz_Turbo_Lat > 15)    Wz_Turbo_Lat = 0; }
            else if(Wz_SubCursor == 1) { Wz_Turbo_Modo++;   if(Wz_Turbo_Modo > 3)    Wz_Turbo_Modo = 0; }
            else if(Wz_SubCursor == 2) { Wz_Turbo_Ciclos++; if(Wz_Turbo_Ciclos > 7)  Wz_Turbo_Ciclos = 0; }
            else if(Wz_SubCursor == 3) { Wz_Cmb_D1++; if(Wz_Cmb_D1 > 18) Wz_Cmb_D1 = 0; }
            else if(Wz_SubCursor == 4) { Wz_Cmb_T1++; if(Wz_Cmb_T1 > 7)  Wz_Cmb_T1 = 0; }
            else if(Wz_SubCursor == 5) { Wz_Cmb_D2++; if(Wz_Cmb_D2 > 18) Wz_Cmb_D2 = 0; }
            else if(Wz_SubCursor == 6) { Wz_Cmb_T2++; if(Wz_Cmb_T2 > 7)  Wz_Cmb_T2 = 0; }
            else if(Wz_SubCursor == 7) { Wz_Cmb_D3++; if(Wz_Cmb_D3 > 18) Wz_Cmb_D3 = 0; }
            else if(Wz_SubCursor == 8) { Wz_Cmb_T3++; if(Wz_Cmb_T3 > 7)  Wz_Cmb_T3 = 0; }
            else if(Wz_SubCursor == 9) { Wz_Cmb_D4++; if(Wz_Cmb_D4 > 18) Wz_Cmb_D4 = 0; }
            else                       { Wz_Cmb_T4++; if(Wz_Cmb_T4 > 7)  Wz_Cmb_T4 = 0; }
            Update_OLED();
        }
    } else {
        // v3zr: DIRECT/STATIC agora tem 4 destinos, nao mais mascara de 18 —
        // cabe tudo na tela, sem rolagem.
        if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0) Wz_SubCursor = 3; Update_OLED(); }
        if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > 3) Wz_SubCursor = 0; Update_OLED(); }
        if(event_press(PS5_LEFT)) {
            if(Wz_SubCursor == 0)      { Wz_Cmb_D1--; if(Wz_Cmb_D1 < 0) Wz_Cmb_D1 = 18; }
            else if(Wz_SubCursor == 1) { Wz_Cmb_D2--; if(Wz_Cmb_D2 < 0) Wz_Cmb_D2 = 18; }
            else if(Wz_SubCursor == 2) { Wz_Cmb_D3--; if(Wz_Cmb_D3 < 0) Wz_Cmb_D3 = 18; }
            else                       { Wz_Cmb_D4--; if(Wz_Cmb_D4 < 0) Wz_Cmb_D4 = 18; }
            Update_OLED();
        }
        if(event_press(PS5_RIGHT)) {
            if(Wz_SubCursor == 0)      { Wz_Cmb_D1++; if(Wz_Cmb_D1 > 18) Wz_Cmb_D1 = 0; }
            else if(Wz_SubCursor == 1) { Wz_Cmb_D2++; if(Wz_Cmb_D2 > 18) Wz_Cmb_D2 = 0; }
            else if(Wz_SubCursor == 2) { Wz_Cmb_D3++; if(Wz_Cmb_D3 > 18) Wz_Cmb_D3 = 0; }
            else                       { Wz_Cmb_D4++; if(Wz_Cmb_D4 > 18) Wz_Cmb_D4 = 0; }
            Update_OLED();
        }
    }
}
    //------------------------------------------------------
    // WIZARD v3 — MODs (MenuDin=106, Seção 6/7/8) — tela compartilhada, avança por
    // Wz_Mod_Tipo (0=EXCL 1=ASSOC 2=BLOQ) a cada R1, sem sair da mesma tela.
    //------------------------------------------------------

// --- MenuDin = 106 — ZETA — selecao dos MODs da relacao ---
function Mnu_Zeta_Sel() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; }
    Work_B = Total_Inst - 2;   // último índice de linha válido (0-indexado)
    if(Work_B < 0) Work_B = 0;
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        Commit_Wz_Mod(Wz_Mod_Tipo);
        MenuDin = 107; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Commit_Wz_Mod(Wz_Mod_Tipo);
        MenuDin = 107; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0)      Wz_SubCursor = Work_B; Ajust_Scr_Btn(); Update_OLED(); }
    if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > Work_B) Wz_SubCursor = 0;      Ajust_Scr_Btn(); Update_OLED(); }
    if(event_press(PS5_LEFT) || event_press(PS5_RIGHT)) {
        Work_C = Mod_Row_To_Inst(Wz_SubCursor);
        if(Work_C <= Total_Inst) Wz_Mod_Sel = Wz_Mod_Sel ^ (1 << (Work_C - 1));
        Update_OLED();
    }
}
    //------------------------------------------------------
    // WIZARD v3 — HIMDs (MenuDin=107, Seção 6/7/8) — lista MOD_EXCL/ASSOC/BLOQ,
    // X mergulha em 106 (seleção de instâncias), igual padrão do GATILHO(102/103)
    //------------------------------------------------------

// --- MenuDin = 107 — ZETA — lista EXCL / ASSOC / BLOQ ---
function Mnu_Zeta_Lista() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; }
    if(event_press(PS5_CROSS)) {
        Load_Wz_Mod(Wz_Mod_Tipo);
        MenuDin = 106; Wz_SubCursor = 0; Wz_ScrTop = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        MenuDin = 37; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        Load_Wz_Tipo(WzSlot);
        MenuDin = 104; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_Mod_Tipo--; if(Wz_Mod_Tipo < 0) Wz_Mod_Tipo = 2; Update_OLED(); }
    if(event_press(PS5_DOWN)) { Wz_Mod_Tipo++; if(Wz_Mod_Tipo > 2) Wz_Mod_Tipo = 0; Update_OLED(); }
}
    //------------------------------------------------------
    // WIZARD — FONTES (MenuDin=2)
    // UP/DOWN seleciona fonte, LEFT/RIGHT toggle ON/OFF
    //------------------------------------------------------
    //------------------------------------------------------
    // WIZARD — PERFIL_HAB (MenuDin=36)
    // Seção 2 — primeira tela ao abrir a instância, antes das FONTES (Seção 3)
    //------------------------------------------------------

// --- MenuDin = 36 — PL_HAB — dominios em que o MOD existe ---
function Mnu_Dominios() {
    set_val(PS5_OPTIONS, 0);
    if(Wz_Entrando) { Wz_Entrando = FALSE; }
    if(event_press(PS5_R1) && !get_ival(PS5_OPTIONS)) {
        MenuDin = 100; Wz_SubCursor = 0; Wz_Entrando = TRUE;
        Update_OLED();
    }
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        MenuDin    = 1;
        MenuCursor = WzSlot - 1;
        Ajust_Scroll_Up();
        Update_OLED();
    }
    if(event_press(PS5_UP))   { Wz_SubCursor--; if(Wz_SubCursor < 0) Wz_SubCursor = 3; Update_OLED(); }
    if(event_press(PS5_DOWN)) { Wz_SubCursor++; if(Wz_SubCursor > 3) Wz_SubCursor = 0; Update_OLED(); }
    if(event_press(PS5_LEFT) || event_press(PS5_RIGHT)) {
        if(Wz_SubCursor == 0) Wz_S1 = !Wz_S1;
        if(Wz_SubCursor == 1) Wz_S2 = !Wz_S2;
        if(Wz_SubCursor == 2) Wz_S3 = !Wz_S3;
        if(Wz_SubCursor == 3) Wz_S4 = !Wz_S4;
        Update_OLED();
    }
}
    //------------------------------------------------------
    // CONFIRMAÇÃO DE DELEÇÃO (MenuDin=38)
    // X confirma deleção, CIRCLE cancela
    //------------------------------------------------------

// --- MenuDin = MENUDIN_DEL_CONF — confirmacao de delecao ---
function Mnu_Del_Conf() {
    set_val(PS5_OPTIONS, 0);
    set_val(PS5_TRIANGLE, 0);
    // X — confirma deleção
    if(event_press(PS5_CROSS)) {
        Deletar_Instancia(Del_Slot);
        // Ajusta cursor
        if(MenuCursor >= Total_Inst && Total_Inst > 0) {
            MenuCursor = Total_Inst - 1;
        }
        if(Total_Inst == 0) MenuCursor = 0;
        Ajust_Scroll_Up();
        MenuDin = 1;
        Update_OLED();
    }
    // CIRCLE — cancela deleção
    if(event_release(PS5_CIRCLE)) {
        Del_Slot = 0;
        MenuDin  = 1;
        Update_OLED();
    }
}
    //------------------------------------------------------
    // CONFIRMAR (MenuDin=37)
    // SHARE 1s salva na EEPROM. X confirma sem salvar.
    //------------------------------------------------------

// --- MenuDin = 37 — CONFIRMAR — X em RAM, SHARE 1s na EEPROM ---
function Mnu_Confirmar() {
    set_val(PS5_OPTIONS, 0);
    // SHARE > 1s: detectado via get_ival (não falha com set_val)
    if(get_ival(PS5_SHARE) && get_ptime(PS5_SHARE) > TIME_SHARE_SAVE) {
        Flag_Share_Save = TRUE;
    }
    if(Flag_Share_Save && !get_ival(PS5_SHARE)) {
        Flag_Share_Save = FALSE;
        Commit_Wz(WzSlot);   // aplica wizard → instância
        if(WzSlot <= MAX_INST_EEP) {
            Save_Instance(WzSlot); // grava EEPROM
            // v3zv: salvar de proposito apaga o M — a partir daqui e um E legitimo.
            Cfg_Mov = Cfg_Mov & (~(1 << (WzSlot - 1)));
            Vib_Disparar();
        }
        MenuDin    = 1;
        MenuCursor = WzSlot - 1;
        Update_OLED();
    }
    set_val(PS5_SHARE, 0); // bloqueia SHARE no jogo durante wizard
    if(Wz_Entrando) {
        Wz_Entrando = FALSE;
    } else {
        // X confirma em RAM (sem salvar EEPROM) e volta ao início da config (PERFIL)
        if(event_press(PS5_CROSS)) {
            Commit_Wz(WzSlot);
            MenuDin    = 36;
            Wz_SubCursor = 0;
            Wz_Entrando  = TRUE;
            Update_OLED();
        }
    }
    // CIRCLE/L1 — volta pra última tela antes do CONFIRMAR, que agora é o
    // HIMDs(107) — lista de MOD_EXCL/ASSOC/BLOQ, igual padrão do GATILHO.
    if(event_press(PS5_L1) || event_release(PS5_CIRCLE)) {
        MenuDin = 107;
        Wz_SubCursor = 0;
        Wz_Entrando  = TRUE;
        Update_OLED();
    }
}

// v3z4: RESET AO SAIR DO MENUDIN — mesma logica da troca de dominio.
// Enquanto o MenuDin esta aberto o Run_Pipeline nao roda, entao o estado de execucao
// CONGELA exatamente como congelava num dominio inativo: Inst_Ativa, trava do ESTATC e
// TrbSt ficam como estavam. Ao fechar, tudo retomava de onde parou — e agora, pior, com
// a configuracao possivelmente ALTERADA no meio. O reset resolve os dois de uma vez: sai
// do menu, comeca do INIC.
// Detecta a SAIDA (>0 para 0) num unico ponto, o que cobre todos os caminhos de
// fechamento: R1+OPTIONS, CIRCLE segurado na Lista, CIRCLE na tela 36, o SHARE que salva
// e volta, e o Menu_Disponivel que zera MenuDin quando o dominio cai. Cobrir cada saida
// na propria tela daria cinco pontos de manutencao e um deles ficaria esquecido.
// Nao ha reset na ENTRADA porque ali o pipeline simplesmente para de rodar.
// Reset duplicado (sair do dominio fecha o menu tambem) e inofensivo: e idempotente.
// Como o menu abre/fecha por R1+OPTIONS, o R1 esta pressionado nesse instante — o gate
// de entrada segura quem usa R1 ate soltar, igual ao L1+L3 do dominio. Coerente.
function Menu_Din_Saida() {
    if(MenuDin == 0 && MenuDin_Prev != 0) Reset_Perfil();
    MenuDin_Prev = MenuDin;
}

// =============================================================
// SEÇÃO 10 — MENU DE STATUS
// =============================================================
// O menu simples, o que CONGELA os MODs: o estado de execucao fica de pe e volta de onde
// parou, em vez de ser desligado.
// Esta funcao e um indice de duas. Os dois assuntos vinham no mesmo bloco do main, mas
// so o primeiro depende do R1 e do MenuDin — e por isso o segundo tem de ficar FORA das
// guardas, e na mesma ordem de antes: depois, nao antes.
function Menu_Status() {
    Menu_Nivel();
    Menu_Touchpad();
}

// Tres guardas, e cada uma diz uma coisa:
//   Status_Menu        ha dominio ligado (quem mantem isso e Menu_Disponivel)
//   R1 nao pressionado R1 + OPTIONS pertence ao MenuDin. Sem esta condicao os dois menus
//                      abririam no mesmo aperto
//   MenuDin fechado    com o menu de configuracao aberto, este nao atrapalha
// Sao tres "return" no inicio em vez de um if de tres condicoes com o corpo todo dentro:
// cada return responde uma pergunta e sai, e o corpo fica em um nivel so.
// AUDITORIA: o ramo do LED era "else if(MenuDin == 0) update_leds();" — a guarda de cima
// ja garante MenuDin == 0, entao aquela segunda condicao nunca podia ser falsa. Saiu.
function Menu_Nivel() {
    if(!Status_Menu)     return;
    if(get_ival(PS5_R1)) return;
    if(MenuDin > 0)      return;
    // No RELEASE, nao no press: soltar e o unico instante em que se sabe que o aperto nao
    // era parte de uma combinacao com R1.
    if(event_release(PS5_OPTIONS)) Menu_Alterna();
    if(MenuLevel == 0) {
        update_leds();
        return;
    }
    if(event_press(PS5_CROSS))  { MenuLevel++; Update_OLED(); }
    if(event_press(PS5_CIRCLE)) { MenuLevel--; Update_OLED(); }
    // CIRCLE segurado sai de qualquer nivel de uma vez; o press acima ja subiu um nivel,
    // este fecha o resto. Flag_Circle_Hold impede que o MESMO hold que acabou de fechar o
    // MenuDin feche tambem este menu.
    if(get_ival(PS5_CIRCLE) && get_ptime(PS5_CIRCLE) > TIME_CIRCLE_CLOSE && !Flag_Circle_Hold) Menu_Fecha();
    // LED apagado = MODs congelados. Fechando, a cor do dominio volta.
    colorled(0, 0, 0, 0);
}

// v7o: a janela do duplo DOWN so corria com o menu aberto, entao um primeiro clique dado
// antes de fechar o menu ficava congelado e valia como SEGUNDO clique na abertura
// seguinte, mesmo muito depois. As duas funcoes abaixo zeram a janela — nos dois
// sentidos, ao abrir e ao fechar, porque o caminho de fechamento e outro.
function Menu_Alterna() {
    if(MenuLevel == 0) MenuLevel = 1;
    else               MenuLevel = 0;
    Dc_Touch = 0;
    Update_OLED();
}
function Menu_Fecha() {
    MenuLevel = 0;
    Dc_Touch  = 0;
    Update_OLED();
}

// Liga/desliga do touchpad: duplo DOWN com L2 segurado, so com o menu de status aberto.
// Fica fora do teste do R1 porque nao usa R1, e usa a mesma janela de tempo do duplo
// clique dos dominios.
function Menu_Touchpad() {
    if(MenuLevel == 0) return;
    if(Dc_Touch > 0) Dc_Touch = Dc_Touch - get_rtime();
    if(!get_ival(PS5_L2) || !event_press(PS5_DOWN)) return;
    if(Dc_Touch > 0) FingOff_Enabled = !FingOff_Enabled;
    else             Dc_Touch = TIME_SHORT_PRESS;
}

// =============================================================
// SEÇÃO 11 — TELA E DISPONIBILIDADE DOS MENUS
// =============================================================
// Quatro motivos para desenhar, e nenhum deles desenha a cada volta: escrever no OLED e
// caro, e a volta do Zen e de 10ms.
//   troca de dominio  o redesenho agendado por Tela_Trocando venceu (SECAO 18)
//   PS pressionado    voce quer ver em que dominio esta
//   timer no fim      apaga sozinho, para nao marcar o painel
//   dominio mudou     a tela tem de acompanhar
function Tela_Manter() {
    Tela_Redesenho();
    if(get_ival(PS5_PS)) Update_OLED();
    if(OLED_Timer > 0) {
        OLED_Timer = OLED_Timer - get_rtime();
        if(OLED_Timer <= 0) cls_oled(0);
    }
    if(CurrentMode != LastMode) {
        Update_OLED();
        LastMode = CurrentMode;
    }
}

// Sem dominio ligado nenhum menu abre, e os que estavam abertos fecham. Fica no fim da
// volta de proposito: ja aconteceu tudo o que podia trocar o dominio, entao esta e a
// resposta certa para a volta seguinte.
// v7o CORRIGIDO (achado ao reescrever a base): o MenuLevel nao era zerado aqui.
// Desligar o dominio com o menu de status aberto deixava MenuLevel = 1, e ao religar o
// dominio o Run_Pipeline continuava barrado (Rodar_Mods exige MenuLevel == 0). Os MODs
// ficavam congelados sem nada na tela explicando, e a unica saida era apertar OPTIONS.
function Menu_Disponivel() {
    if(CurrentMode > 0) {
        Status_Menu = TRUE;
        return;
    }
    Status_Menu = FALSE;
    MenuDin     = 0;
    MenuLevel   = 0;
}

// =============================================================
// SEÇÃO 12 — MOTOR DOS MODs
// =============================================================
// Tudo o que roda por volta dentro de um dominio: ler a fonte, aplicar as condicoes,
// resolver os gatilhos, calcular as relacoes entre MODs e escrever os destinos.
// Sao 2.400 linhas, e ate a D-Sig elas viviam debaixo do cabecalho "SECAO 6 — MAIN",
// porque no arquivo antigo o main vinha depois delas. O leitor que procurasse o main
// pela secao caia aqui.
//
// A ORDEM DE LEITURA, de fora para dentro:
//   Run_Pipeline          o roteiro de uma volta: mascaras, snapshot, relacoes, MODs
//   Run_Instance_v3       um MOD: fonte -> condicoes -> gatilhos -> resposta
//   Acc_* / Aplicar_Acc   os destinos sao ACUMULADOS e escritos uma vez no fim, para
//                         que dois MODs no mesmo destino somem em vez de um apagar o
//                         outro
//   Recalc_Mascaras       o que so muda quando a configuracao muda (v7l)
//
// AS MASCARAS ESTATICAS sao a razao de este motor caber no orcamento de tempo do Zen.
// Antes, cada volta recalculava para os 21 MODs quem estava no dominio, quem tinha
// destino, quem tinha gatilho de estado. Agora isso e refeito so quando Cfg_Sujo esta
// marcado, e o pipeline le respostas prontas — foi o que tirou 61% do trabalho por
// volta na v7l e fez os tempos configurados baterem com o cronometro.

// ==========================================================
// FASE 3 — PIPELINE DE EXECUÇÃO (Subfase 3A: eixo X → DIRECT)
// ==========================================================
// Lê o eixo físico de origem do EIXO_X (sel: 0=F1X 1=LX 2=RX)
// Lê o eixo físico de origem do EIXO_Y (sel: 0=F1Y 1=LY 2=RY)
// Aplica as condições do EIXO_X (thr_in/thr_out/dir/mult/inv) sobre um valor cru.
// Retorna o valor condicionado (-100..100). Usado pelos DESTINOS.
// THR_IN = piso (abaixo, cessa). THR_OUT = teto (acima, cessa); 0 = sem teto.
// O EIXO_X está na ZONA ATIVA? (sim/não, independente do valor ser zero) — para o ESTATC.
// Respeita a polaridade: ABS inclui o zero; POS conta só >0; NEG conta só <0.
// Escreve o valor condicionado nos destinos marcados (14 destinos).
// Digitais (0-9): recebem |valor| proporcional. Eixos (10-13): recebem o valor.
// Acumula 'val' no destino idx, guardando o de MAIOR intensidade absoluta do ciclo
function Acc_Um(idx, val) {
    if(idx == 0)  { if(abs(val) > abs(Acc_00)) Acc_00 = val; }
    if(idx == 1)  { if(abs(val) > abs(Acc_01)) Acc_01 = val; }
    if(idx == 2)  { if(abs(val) > abs(Acc_02)) Acc_02 = val; }
    if(idx == 3)  { if(abs(val) > abs(Acc_03)) Acc_03 = val; }
    if(idx == 4)  { if(abs(val) > abs(Acc_04)) Acc_04 = val; }
    if(idx == 5)  { if(abs(val) > abs(Acc_05)) Acc_05 = val; }
    if(idx == 6)  { if(abs(val) > abs(Acc_06)) Acc_06 = val; }
    if(idx == 7)  { if(abs(val) > abs(Acc_07)) Acc_07 = val; }
    if(idx == 8)  { if(abs(val) > abs(Acc_08)) Acc_08 = val; }
    if(idx == 9)  { if(abs(val) > abs(Acc_09)) Acc_09 = val; }
    if(idx == 10) { if(abs(val) > abs(Acc_10)) Acc_10 = val; Acc_Eixo_Tocado = Acc_Eixo_Tocado | 1; }
    if(idx == 11) { if(abs(val) > abs(Acc_11)) Acc_11 = val; Acc_Eixo_Tocado = Acc_Eixo_Tocado | 2; }
    if(idx == 12) { if(abs(val) > abs(Acc_12)) Acc_12 = val; Acc_Eixo_Tocado = Acc_Eixo_Tocado | 4; }
    if(idx == 13) { if(abs(val) > abs(Acc_13)) Acc_13 = val; Acc_Eixo_Tocado = Acc_Eixo_Tocado | 8; }
    if(idx == 14) { if(abs(val) > abs(Acc_14)) Acc_14 = val; }
    if(idx == 15) { if(abs(val) > abs(Acc_15)) Acc_15 = val; }
    if(idx == 16) { if(abs(val) > abs(Acc_16)) Acc_16 = val; }
    if(idx == 17) { if(abs(val) > abs(Acc_17)) Acc_17 = val; }
}
// Acumula o valor condicionado nos destinos marcados na máscara
function Escrever_Destino(mask, val) {
    if((mask >> 0)  & 1) Acc_Um(0,  val);
    if((mask >> 1)  & 1) Acc_Um(1,  val);
    if((mask >> 2)  & 1) Acc_Um(2,  val);
    if((mask >> 3)  & 1) Acc_Um(3,  val);
    if((mask >> 4)  & 1) Acc_Um(4,  val);
    if((mask >> 5)  & 1) Acc_Um(5,  val);
    if((mask >> 6)  & 1) Acc_Um(6,  val);
    if((mask >> 7)  & 1) Acc_Um(7,  val);
    if((mask >> 8)  & 1) Acc_Um(8,  val);
    if((mask >> 9)  & 1) Acc_Um(9,  val);
    if((mask >> 10) & 1) Acc_Um(10, val);
    if((mask >> 11) & 1) Acc_Um(11, val);
    if((mask >> 12) & 1) Acc_Um(12, val);
    if((mask >> 13) & 1) Acc_Um(13, val);
    if((mask >> 14) & 1) Acc_Um(14, val);
    if((mask >> 15) & 1) Acc_Um(15, val);
    if((mask >> 16) & 1) Acc_Um(16, val);
    if((mask >> 17) & 1) Acc_Um(17, val);
}
// Zera todos os acumuladores (início do ciclo)
function Zerar_Acc() {
    Acc_00=0; Acc_01=0; Acc_02=0; Acc_03=0; Acc_04=0; Acc_05=0; Acc_06=0;
    Acc_07=0; Acc_08=0; Acc_09=0; Acc_10=0; Acc_11=0; Acc_12=0; Acc_13=0;
    Acc_14=0; Acc_15=0; Acc_16=0; Acc_17=0;
    Acc_Eixo_Tocado = 0;
}
// Escreve os acumuladores no controle (fim do ciclo).
// Digitais (0-9): |acc| proporcional. Eixos (10-13): acc com sinal.
// Só escreve digitais com valor != 0 (não force soltar o que outro processo segura).
function Aplicar_Acc() {
    if(Acc_00 != 0) set_val(PS5_L1,       abs(Acc_00));
    if(Acc_01 != 0) set_val(PS5_L2,       abs(Acc_01));
    if(Acc_02 != 0) set_val(PS5_L3,       abs(Acc_02));
    if(Acc_03 != 0) set_val(PS5_R1,       abs(Acc_03));
    if(Acc_04 != 0) set_val(PS5_R2,       abs(Acc_04));
    if(Acc_05 != 0) set_val(PS5_R3,       abs(Acc_05));
    if(Acc_06 != 0) set_val(PS5_CROSS,    abs(Acc_06));
    if(Acc_07 != 0) set_val(PS5_CIRCLE,   abs(Acc_07));
    if(Acc_08 != 0) set_val(PS5_SQUARE,   abs(Acc_08));
    if(Acc_09 != 0) set_val(PS5_TRIANGLE, abs(Acc_09));
    if(Acc_10 != 0 || ((Acc_Eixo_Tocado >> 0) & 1)) set_val(PS5_LX, Acc_10);
    if(Acc_11 != 0 || ((Acc_Eixo_Tocado >> 1) & 1)) set_val(PS5_LY, Acc_11);
    if(Acc_12 != 0 || ((Acc_Eixo_Tocado >> 2) & 1)) set_val(PS5_RX, Acc_12);
    if(Acc_13 != 0 || ((Acc_Eixo_Tocado >> 3) & 1)) set_val(PS5_RY, Acc_13);
    // v3zc: D-pads seguem a regra dos digitais — so escreve quando ha valor, para nao
    // forcar a soltura do que o jogador esta segurando de verdade.
    if(Acc_14 != 0) set_val(PS5_UP,    abs(Acc_14));
    if(Acc_15 != 0) set_val(PS5_DOWN,  abs(Acc_15));
    if(Acc_16 != 0) set_val(PS5_LEFT,  abs(Acc_16));
    if(Acc_17 != 0) set_val(PS5_RIGHT, abs(Acc_17));
}
// Zera o eixo físico de origem (usado no modo PASSIVO p/ suprimir o sinal cru)
function Set_Btn_Fisico(idx, val) {
    if(idx == 0)  set_val(PS5_L1, val);
    if(idx == 1)  set_val(PS5_L2, val);
    if(idx == 2)  set_val(PS5_L3, val);
    if(idx == 3)  set_val(PS5_R1, val);
    if(idx == 4)  set_val(PS5_R2, val);
    if(idx == 5)  set_val(PS5_R3, val);
    if(idx == 6)  set_val(PS5_CROSS, val);
    if(idx == 7)  set_val(PS5_CIRCLE, val);
    if(idx == 8)  set_val(PS5_SQUARE, val);
    if(idx == 9)  set_val(PS5_TRIANGLE, val);
    if(idx == 10) set_val(PS5_UP, val);
    if(idx == 11) set_val(PS5_DOWN, val);
    if(idx == 12) set_val(PS5_LEFT, val);
    if(idx == 13) set_val(PS5_RIGHT, val);
    if(idx == 14) set_val(PS5_TOUCH, val);
    if(idx == 15) set_val(PS5_SHARE, val);
}
// Suprime o clique cru de cada botão marcado na FONTE_2 (PASSIVO). Fase B: ainda sem a exceção
// "exceto se selecionada como destino" — isso entra na Fase D, quando a FONTE_2 ganhar destinos.
// Aplica condições do EIXO_Y (thr_in/thr_out/dir/mult/inv) sobre um valor cru.
// O EIXO_Y está na ZONA ATIVA? (sim/não) — para o ESTATC. ABS inclui zero; POS/NEG estritos.
// Lê o estado físico (pressionado?) de um botão pelo índice de bit (0=L1..15=SHARE)
function Ler_Btn_Fisico(idx) {
    if(idx <= 7) {
        if(idx <= 3) {
            if(idx <= 1) {
                if(idx == 0) return get_ival(PS5_L1);
                if(idx == 1) return get_ival(PS5_L2);
            } else {
                if(idx == 2) return get_ival(PS5_L3);
                if(idx == 3) return get_ival(PS5_R1);
            }
        } else {
            if(idx <= 5) {
                if(idx == 4) return get_ival(PS5_R2);
                if(idx == 5) return get_ival(PS5_R3);
            } else {
                if(idx == 6) return get_ival(PS5_CROSS);
                if(idx == 7) return get_ival(PS5_CIRCLE);
            }
        }
    } else {
        if(idx <= 11) {
            if(idx <= 9) {
                if(idx == 8) return get_ival(PS5_SQUARE);
                if(idx == 9) return get_ival(PS5_TRIANGLE);
            } else {
                if(idx == 10) return get_ival(PS5_UP);
                if(idx == 11) return get_ival(PS5_DOWN);
            }
        } else {
            if(idx <= 13) {
                if(idx == 12) return get_ival(PS5_LEFT);
                if(idx == 13) return get_ival(PS5_RIGHT);
            } else {
                if(idx == 14) return get_ival(PS5_TOUCH);
                if(idx == 15) return get_ival(PS5_SHARE);
            }
        }
    }
    return 0;
}
// ===== V3-c: FONTE ÚNICA — leitura, zona ativa e supressão unificadas =====
// Lê o valor bruto da fonte da instância num, despachando por FONTE_TIPO.
// Eixos/touch (tipo 0-5): valor contínuo (-100..100), via get_ival direto.
// Botões/gatilho (tipo >=6): reaproveita Ler_Btn_Fisico via índice tipo-6
// (FONTE_TIPO foi numerado de propósito pra bater com BTN_BIT_*, ver defines).
function Ler_Fonte(num) {
    Work_N = Get_Fonte_Tipo(num);
    if(Work_N == FONTE_NENHUMA)  return 0;   // sem fonte: nunca há sinal
    if(Work_N == FONTE_FINGER_X) return get_ival(PS5_FINGER1X);
    if(Work_N == FONTE_FINGER_Y) return get_ival(PS5_FINGER1Y);
    if(Work_N == FONTE_LX)       return get_ival(PS5_LX);
    if(Work_N == FONTE_LY)       return get_ival(PS5_LY);
    if(Work_N == FONTE_RX)       return get_ival(PS5_RX);
    if(Work_N == FONTE_RY)       return get_ival(PS5_RY);
    return Ler_Btn_Fisico(Work_N - 7);
}
// A fonte da instância num está na zona ativa agora? Despacha por categoria:
//   CAT_BOTAO: pressionado = ativo, sem threshold.
//   demais (touch/eixo/gatilho): threshold IN/OUT comum; DIR só filtra se CAT_EIXO
//   (gatilho L2/R2 nunca é negativo — DIR não se aplica, por isso não é checado).
// ATENÇÃO Work_: Ler_Fonte toca só Work_N internamente — Work_C (categoria) e Work_A
// (valor bruto) sobrevivem à chamada sem colisão. Confirmado pelo checador de Work_.
function Zona_Ativa_Fonte(num) {
    Work_D = Get_Fonte_Tipo(num);
    Work_C = Get_Fonte_Categoria(Work_D);
    if(Work_C == CAT_BOTAO) {
        return Ler_Fonte(num) != 0;
    }
    Work_A = Ler_Fonte(num);
    Pipe_Thr = Get_Cond_ThrIn(num) * 5;
    Pipe_Raw = Get_Cond_ThrOut(num) * 5;
    Work_N = abs(Work_A);
    if(Pipe_Raw == 0) {
        if(Work_N < Pipe_Thr) return 0;
    } else if(Pipe_Thr <= Pipe_Raw) {
        if(Work_N < Pipe_Thr || Work_N > Pipe_Raw) return 0;
    } else {
        if(Work_N > Pipe_Raw && Work_N < Pipe_Thr) return 0;
    }
    if(Work_C == CAT_EIXO) {
        if(Get_Cond_Dir(num) == F1_DIR_POSITIVO && Work_A <= 0) return 0;
        if(Get_Cond_Dir(num) == F1_DIR_NEGATIVO && Work_A >= 0) return 0;
    }
    return 1;
}
// Suprime o valor bruto da fonte (modo PASSIVO) — despacha por FONTE_TIPO,
// reaproveitando Set_Btn_Fisico via o mesmo offset tipo-6 pra botões/gatilho.
function Suprime_Fonte(num) {
    Work_N = Get_Fonte_Tipo(num);
    if(Work_N == FONTE_NENHUMA)  return;     // sem fonte: nada a suprimir
    if(Work_N == FONTE_FINGER_X) { set_val(PS5_FINGER1X, 0); return; }
    if(Work_N == FONTE_FINGER_Y) { set_val(PS5_FINGER1Y, 0); return; }
    if(Work_N == FONTE_LX)       { set_val(PS5_LX, 0); return; }
    if(Work_N == FONTE_LY)       { set_val(PS5_LY, 0); return; }
    if(Work_N == FONTE_RX)       { set_val(PS5_RX, 0); return; }
    if(Work_N == FONTE_RY)       { set_val(PS5_RY, 0); return; }
    Set_Btn_Fisico(Work_N - 7, 0);
}
// ===== V3-d: RELIG UNIFICADO =====
// Religa as respostas da instância quando a fonte sobe (por transição), independente de
// ATIVO/PASSIVO, em paralelo aos gatilhos/finalizadores. Só LIGA (nunca desliga). Substitui
// as 3 seções (EIXO_X/EIXO_Y/FONTE_2) da antiga Religa_Pela_Fonte por 1 só, já que agora há
// apenas 1 fonte por instância. Nome próprio (não "Religa_Pela_Fonte") pra não colidir com a
// função antiga, que o Run_Instance atual (v2, ainda ativo) continua chamando — troca de nome
// só quando a execução for reescrita (V3-f/g/h).
// ATENÇÃO Work_: Zona_Ativa_Fonte usa Work_C internamente (categoria) — por isso o flag aqui
// usa Work_E, não Work_C, senão o ramo "não ativo" pisaria no flag com o valor da categoria
// em vez de 0 (mesmo padrão de bug já visto em Executar_Turbo_F2/Fonte2_Ativa).
function Religa_Fonte(num) {
    Work_E = 0;
    // v3zc: havendo fonte, ela SEMPRE religa. Nao ha mais o que autorizar.
    if(Zona_Ativa_Fonte(num)) Work_E = 1;
    // religa só na subida (está na zona e não estava antes) E se as respostas estão suprimidas
    if(Work_E && !((Src_Acima_Fonte >> (num - 1)) & 1) && ((Resp_Off_Fonte >> (num - 1)) & 1)) {
        Resp_Off_Fonte = Resp_Off_Fonte & (~(1 << (num - 1)));
        Inst_Ativa = Inst_Ativa | (1 << (num - 1));
        Excl_Veto  = Excl_Veto  & (~(1 << (num - 1)));
    }
    if(Work_E) Src_Acima_Fonte = Src_Acima_Fonte | (1 << (num - 1));
    else       Src_Acima_Fonte = Src_Acima_Fonte & (~(1 << (num - 1)));
}
// ===== V3-e: GATILHO+BTN_FN unificados (dados) =====
function Get_Delay(num) {
    if(num == Spv_N) { return (Spv_B >> SHIFT_DELAY) & 0x3; }   // v7l: MOD em execucao
    return (Get_Spvar_B(num) >> SHIFT_DELAY) & 0x3;
}
function Set_Delay(num, v) {
    Work_A = Get_Spvar_B(num) & (~(0x3 << SHIFT_DELAY));
    Work_A = Work_A | ((v & 0x3) << SHIFT_DELAY);
    Set_Spvar_B(num, Work_A);
}
// v5: o tempo do AFTER agora vive no SPVAR_B — persistente. O FA_Cfg (RAM) some.
function Get_FA_Tempo(num) {
    if(num == Spv_N) { return (Spv_B >> SHIFT_AFTER_TMP) & 0x7; }   // v7l: MOD em execucao
    return (Get_Spvar_B(num) >> SHIFT_AFTER_TMP) & 0x7;
}
function Set_FA_Tempo(num, v) {
    Work_A = Get_Spvar_B(num) & (~(0x7 << SHIFT_AFTER_TMP));
    Work_A = Work_A | ((v & 0x7) << SHIFT_AFTER_TMP);
    Set_Spvar_B(num, Work_A);
}
// v5: tabelas novas. O DELAY atrasa a SUBIDA da resposta; o AFTER conta depois de soltar.
// v5a: o indice 0 e OFF — sem ele, TODO MOD nasceria com 200ms de atraso, porque zero
// e o valor de um campo nunca configurado. Foi o Daniel quem pegou isso antes do teste.
function Delay_Ms(idx) {
    if(idx == 0) return 0;
    if(idx == 1) return 300;
    if(idx == 2) return 700;
    return 1200;
}
// Concentrada na faixa CURTA, que e onde o Daniel usa: passo de 50ms ate 200ms,
// e marcos esparsos acima disso.
function After_Ms(idx) {
    if(idx == 0) return 50;
    if(idx == 1) return 100;
    if(idx == 2) return 150;
    if(idx == 3) return 200;
    if(idx == 4) return 300;
    if(idx == 5) return 500;
    if(idx == 6) return 1000;
    return 2000;
}
function Get_Gatilho_Hphold_Btn(num) {
    if(num == Spv_N) { return (Spv_C >> SHIFT_GATILHO_HPHOLD_BTN) & 0x1F; }   // v7l: MOD em execucao
    return (Get_Spvar_C(num) >> SHIFT_GATILHO_HPHOLD_BTN) & 0x1F;
}
function Set_Gatilho_Hphold_Btn(num, v) {
    Work_A = Get_Spvar_C(num) & (~(0x1F << SHIFT_GATILHO_HPHOLD_BTN));
    Work_A = Work_A | ((v & 0x1F) << SHIFT_GATILHO_HPHOLD_BTN);
    Set_Spvar_C(num, Work_A);
}
function Get_Gatilho_Hphold_Tempo(num) {
    if(num == Spv_N) { return (Spv_B >> SHIFT_GATILHO_HPHOLD_TEMPO) & 0x3F; }   // v7l: MOD em execucao
    return (Get_Spvar_B(num) >> SHIFT_GATILHO_HPHOLD_TEMPO) & 0x3F;   // v3zc: 6 bits
}
function Set_Gatilho_Hphold_Tempo(num, v) {
    Work_A = Get_Spvar_B(num) & (~(0x3F << SHIFT_GATILHO_HPHOLD_TEMPO));
    Work_A = Work_A | ((v & 0x3F) << SHIFT_GATILHO_HPHOLD_TEMPO);
    Set_Spvar_B(num, Work_A);
}
// v3zb: os tres botoes do trio. Btn_Tmp e dedicada — nao pode ser Work_, porque estes
// getters sao chamados de dentro de expressoes que ja usam o rodizio Work_.
function Get_Gatilho_Duplo_Btn(num) {
    if(num == Spv_N) { Btn_Tmp = (Spv_C >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF; return Btn_Tmp / 289; }   // v7l: MOD em execucao
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    return Btn_Tmp / 289;
}
function Set_Gatilho_Duplo_Btn(num, v) {
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    Btn_Tmp = (v & 0x1F) * 289 + (Btn_Tmp - ((Btn_Tmp / 289) * 289));
    Work_A = Get_Spvar_C(num) & (~(0x1FFF << SHIFT_GATILHO_TRIO_BTN));
    Set_Spvar_C(num, Work_A | ((Btn_Tmp & 0x1FFF) << SHIFT_GATILHO_TRIO_BTN));
}
function Get_Gatilho_Final_Btn(num) {
    if(num == Spv_N) { Btn_Tmp = (Spv_C >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF; return (Btn_Tmp / 17) - ((Btn_Tmp / 289) * 17); }   // v7l: MOD em execucao
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    return (Btn_Tmp / 17) - ((Btn_Tmp / 289) * 17);
}
function Set_Gatilho_Final_Btn(num, v) {
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    Btn_Tmp = ((Btn_Tmp / 289) * 289) + (v & 0x1F) * 17 + (Btn_Tmp - ((Btn_Tmp / 17) * 17));
    Work_A = Get_Spvar_C(num) & (~(0x1FFF << SHIFT_GATILHO_TRIO_BTN));
    Set_Spvar_C(num, Work_A | ((Btn_Tmp & 0x1FFF) << SHIFT_GATILHO_TRIO_BTN));
}
function Get_Gatilho_FinalAfter_Btn(num) {
    if(num == Spv_N) { Btn_Tmp = (Spv_C >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF; return Btn_Tmp - ((Btn_Tmp / 17) * 17); }   // v7l: MOD em execucao
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    return Btn_Tmp - ((Btn_Tmp / 17) * 17);
}
function Set_Gatilho_FinalAfter_Btn(num, v) {
    Btn_Tmp = (Get_Spvar_C(num) >> SHIFT_GATILHO_TRIO_BTN) & 0x1FFF;
    Btn_Tmp = ((Btn_Tmp / 17) * 17) + (v & 0x1F);
    Work_A = Get_Spvar_C(num) & (~(0x1FFF << SHIFT_GATILHO_TRIO_BTN));
    Set_Spvar_C(num, Work_A | ((Btn_Tmp & 0x1FFF) << SHIFT_GATILHO_TRIO_BTN));
}
function Get_GT_Relig(num) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return GT_Relig_01;
                if(num == 2) return GT_Relig_02;
                if(num == 3) return GT_Relig_03;
            } else {
                if(num == 4) return GT_Relig_04;
                if(num == 5) return GT_Relig_05;
                if(num == 6) return GT_Relig_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return GT_Relig_07;
                if(num == 8) return GT_Relig_08;
                if(num == 9) return GT_Relig_09;
            } else {
                if(num == 10) return GT_Relig_10;
                if(num == 11) return GT_Relig_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return GT_Relig_12;
                if(num == 13) return GT_Relig_13;
                if(num == 14) return GT_Relig_14;
            } else {
                if(num == 15) return GT_Relig_15;
                if(num == 16) return GT_Relig_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return GT_Relig_17;
                if(num == 18) return GT_Relig_18;
                if(num == 19) return GT_Relig_19;
            } else {
                if(num == 20) return GT_Relig_20;
                if(num == 21) return GT_Relig_21;
            }
        }
    }
    return 0;
}
function Set_GT_Relig(num, v) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) GT_Relig_01=v;
                if(num == 2) GT_Relig_02=v;
                if(num == 3) GT_Relig_03=v;
            } else {
                if(num == 4) GT_Relig_04=v;
                if(num == 5) GT_Relig_05=v;
                if(num == 6) GT_Relig_06=v;
            }
        } else {
            if(num <= 9) {
                if(num == 7) GT_Relig_07=v;
                if(num == 8) GT_Relig_08=v;
                if(num == 9) GT_Relig_09=v;
            } else {
                if(num == 10) GT_Relig_10=v;
                if(num == 11) GT_Relig_11=v;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) GT_Relig_12=v;
                if(num == 13) GT_Relig_13=v;
                if(num == 14) GT_Relig_14=v;
            } else {
                if(num == 15) GT_Relig_15=v;
                if(num == 16) GT_Relig_16=v;
            }
        } else {
            if(num <= 19) {
                if(num == 17) GT_Relig_17=v;
                if(num == 18) GT_Relig_18=v;
                if(num == 19) GT_Relig_19=v;
            } else {
                if(num == 20) GT_Relig_20=v;
                if(num == 21) GT_Relig_21=v;
            }
        }
    }
}
// [HISTORICO] v3: o RELIG do HOLD foi persistente no SPVAR_64 ate a v3zb, quando virou
// regra derivada. A SPVAR_64 hoje guarda a migracao e o selo da config do app.
// Segue o mesmo padrão dos SPVAR_A/B/C: vive em RAM (DS_HoldRelig) durante a execução,
// e só vai pra EEPROM em Save_Instance. Diferença importante: como o SPVAR_64 é GLOBAL
// (não dedicado por instância), este bit é indexado POR POSIÇÃO (bit = num-1) e por isso
// precisa ser migrado explicitamente em Compact_Pos/Zerar_Posicao, igual FA_Cfg e os MODs.
// ===== v3zb: O RELIG DOS GATILHOS DEIXOU DE SER CAMPO =====
// Os quatro RELIGs (HOLD, 2CLK, TOGGLE, FINAL_AFTER) eram, na pratica, constante
// disfarcada de opcao: tres ficavam quase sempre em SIM e o FINAL_AFTER quase sempre
// em NAO. Agora sao DERIVADOS do INIC + presenca de fonte, numa regra so.
// A derivacao obvia ("INIC ON -> a fonte religa -> o gatilho so desliga") quebra num
// caso: SEM FONTE. Ali nao existe quem religue, e um gatilho que so desligasse mataria
// a instancia no primeiro toque, para sempre. Por isso a regra tem TRES ramos:
//   sem fonte            -> o gatilho ALTERNA (e o unico caminho que existe)
//   com fonte + INIC OFF -> o gatilho ALTERNA (a fonte nao religa; ele arma)
//   com fonte + INIC ON  -> o gatilho SO DESLIGA (a fonte ja religa)
// Em uma frase: o gatilho so perde a capacidade de ligar quando existe uma fonte que
// ja faz isso. O BLOK fica de fora — e momentaneo e nao mexe em estado.
// v3zc: sem o INIC, a regra ficou binaria — COM fonte o gatilho so desliga (a fonte
// religa); SEM fonte ele alterna (e o unico caminho que existe).
// v7: a decisao passou a ser POR GATILHO. g: 0=2CLK 1=TOGGLE 2=HOLD 3=AFTER.
// Marcado como FINALIZA, o gatilho so desliga — mesmo sem ALFA, onde a regra derivada
// o faria alternar. Nao marcado, vale a regra de sempre:
//   com ALFA  -> so desliga (o ALFA religa)
//   sem ALFA  -> alterna (e o unico caminho que existe)
// Converte a posicao na lista da tela (0=2CLK 1=TOGGLE 2=HOLD 3=AFTER) no indice do bit.
// Sao iguais hoje, mas a funcao existe para que reordenar a lista nao quebre os bits.
function Gatilho_Idx(pos) {
    return pos;
}
function Gatilho_Alterna_G(num, g) {
    if((Get_Fin(num) >> g) & 1) return 0;
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) return 1;
    return 0;
}
// v3: agora persistente — reaproveita o bit 5 do SPVAR_A, liberado
// depois que FONTE_ON foi removido (redundante com S1-S4 todos OFF).
// v3z4: RELIG do FINAL_AFTER agora PERSISTENTE (SPVAR_A bit 29, ex-bit-14 do DESTINO).
// Saiu do FA_Cfg (RAM), que agora guarda so o tempo. Como vive no SPVAR_A, ele viaja de
// graca no Compact_Pos/Zerar_Posicao da delecao e vai pra EEPROM no Save_Instance —
// sem migracao explicita, diferente do Hold_Relig (que e global, indexado por POSICAO).
function Ptime_Btn(idx) {
    if(idx == 0)  return get_ptime(PS5_L1);
    if(idx == 1)  return get_ptime(PS5_L2);
    if(idx == 2)  return get_ptime(PS5_L3);
    if(idx == 3)  return get_ptime(PS5_R1);
    if(idx == 4)  return get_ptime(PS5_R2);
    if(idx == 5)  return get_ptime(PS5_R3);
    if(idx == 6)  return get_ptime(PS5_CROSS);
    if(idx == 7)  return get_ptime(PS5_CIRCLE);
    if(idx == 8)  return get_ptime(PS5_SQUARE);
    if(idx == 9)  return get_ptime(PS5_TRIANGLE);
    if(idx == 10) return get_ptime(PS5_UP);
    if(idx == 11) return get_ptime(PS5_DOWN);
    if(idx == 12) return get_ptime(PS5_LEFT);
    if(idx == 13) return get_ptime(PS5_RIGHT);
    if(idx == 14) return get_ptime(PS5_TOUCH);
    if(idx == 15) return get_ptime(PS5_SHARE);
    return 0;
}
// Detecta o "pressionar" (transição) de um botão pelo índice de bit
function Press_Btn_Fisico(idx) {
    if(idx <= 7) {
        if(idx <= 3) {
            if(idx <= 1) {
                if(idx == 0) return event_press(PS5_L1);
                if(idx == 1) return event_press(PS5_L2);
            } else {
                if(idx == 2) return event_press(PS5_L3);
                if(idx == 3) return event_press(PS5_R1);
            }
        } else {
            if(idx <= 5) {
                if(idx == 4) return event_press(PS5_R2);
                if(idx == 5) return event_press(PS5_R3);
            } else {
                if(idx == 6) return event_press(PS5_CROSS);
                if(idx == 7) return event_press(PS5_CIRCLE);
            }
        }
    } else {
        if(idx <= 11) {
            if(idx <= 9) {
                if(idx == 8) return event_press(PS5_SQUARE);
                if(idx == 9) return event_press(PS5_TRIANGLE);
            } else {
                if(idx == 10) return event_press(PS5_UP);
                if(idx == 11) return event_press(PS5_DOWN);
            }
        } else {
            if(idx <= 13) {
                if(idx == 12) return event_press(PS5_LEFT);
                if(idx == 13) return event_press(PS5_RIGHT);
            } else {
                if(idx == 14) return event_press(PS5_TOUCH);
                if(idx == 15) return event_press(PS5_SHARE);
            }
        }
    }
    return 0;
}
// Get/Set do estado de duplo-clique por instância (1-16)
function Get_Dc(num) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return Dc_01;
                if(num == 2) return Dc_02;
                if(num == 3) return Dc_03;
            } else {
                if(num == 4) return Dc_04;
                if(num == 5) return Dc_05;
                if(num == 6) return Dc_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return Dc_07;
                if(num == 8) return Dc_08;
                if(num == 9) return Dc_09;
            } else {
                if(num == 10) return Dc_10;
                if(num == 11) return Dc_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return Dc_12;
                if(num == 13) return Dc_13;
                if(num == 14) return Dc_14;
            } else {
                if(num == 15) return Dc_15;
                if(num == 16) return Dc_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return Dc_17;
                if(num == 18) return Dc_18;
                if(num == 19) return Dc_19;
            } else {
                if(num == 20) return Dc_20;
                if(num == 21) return Dc_21;
            }
        }
    }
    return 0;
}
function Set_Dc(num, v) {
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) Dc_01=v;
                if(num == 2) Dc_02=v;
                if(num == 3) Dc_03=v;
            } else {
                if(num == 4) Dc_04=v;
                if(num == 5) Dc_05=v;
                if(num == 6) Dc_06=v;
            }
        } else {
            if(num <= 9) {
                if(num == 7) Dc_07=v;
                if(num == 8) Dc_08=v;
                if(num == 9) Dc_09=v;
            } else {
                if(num == 10) Dc_10=v;
                if(num == 11) Dc_11=v;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) Dc_12=v;
                if(num == 13) Dc_13=v;
                if(num == 14) Dc_14=v;
            } else {
                if(num == 15) Dc_15=v;
                if(num == 16) Dc_16=v;
            }
        } else {
            if(num <= 19) {
                if(num == 17) Dc_17=v;
                if(num == 18) Dc_18=v;
                if(num == 19) Dc_19=v;
            } else {
                if(num == 20) Dc_20=v;
                if(num == 21) Dc_21=v;
            }
        }
    }
}
// Detecta o gatilho DUPLO_CLIK: 2 cliques no MESMO botão em < 300ms alternam a instância.
// Estado empacotado: bits 0-4 = (botão+1) do 1º clique; bits 5+ = janela (ms) restante.
// Alterna o estado lig/desl da instância (bit num-1 de Inst_Ativa)
// Sincroniza o veto por eixo ao estado da instância (ação de nível de instância afeta os dois eixos):
// instância ativa → libera ambos; instância desativada → suprime ambos.
function Aplicar_RespOff_Inst(num) {
    if(Inst_Esta_Ativa(num)) {
        Resp_Off_X = Resp_Off_X & (~(1 << (num - 1)));
        Resp_Off_Y = Resp_Off_Y & (~(1 << (num - 1)));
        Resp_Off_F2 = Resp_Off_F2 & (~(1 << (num - 1)));  // FONTE_2: mesmo tratamento de X/Y
        Resp_Off_Fonte = Resp_Off_Fonte & (~(1 << (num - 1)));  // v3: fonte única
        Excl_Veto  = Excl_Veto  & (~(1 << (num - 1)));   // MOD_EXCL: reativação pelas condições internas
    } else {
        Resp_Off_X = Resp_Off_X | (1 << (num - 1));
        Resp_Off_Y = Resp_Off_Y | (1 << (num - 1));
        Resp_Off_F2 = Resp_Off_F2 | (1 << (num - 1));
        Resp_Off_Fonte = Resp_Off_Fonte | (1 << (num - 1));  // v3: fonte única
        // Bug 6: instância desligada limpa a trava do ESTATC-como-chave. É por aqui que o
        // destino travado é liberado por FINALIZA/FINAL_AFTER/HOLD/2CLK e pelos MODs —
        // todos passam por Aplicar_RespOff_Inst ao desligar a instância.
        Set_Estatc_Travado(num, 0);
        Delay_Zerar(num);   // v5: proxima subida recomeca a contagem limpa
        // v3t: rearma a máquina do TURBO no desligamento. Com fonte "---" a zona é sempre 1
        // (não existe fonte pra sair da zona), então os CICLOS terminavam e NUNCA rearmavam
        // — o turbo rodava uma vez só e travava. Agora o próprio ciclo lig/desl do gatilho
        // faz o papel que a saída da zona fazia quando há fonte.
        Set_TrbSt_X(num, 0);
    }
}
function Toggle_Inst(num) {
    Inst_Ativa = Inst_Ativa ^ (1 << (num - 1));
    Aplicar_RespOff_Inst(num);   // gatilho/finalizador-relig agem na instância inteira
}
// Detecta o gatilho HPHOLD da instância e alterna o estado (com anti-loop).
// Regra: QUALQUER botão marcado, segurado por >= tempo configurado, alterna 1x.
// ===== V3-e: execução com botão único (substituem as versões com máscara acima quando a
// execução for reescrita em V3-f/g/h — nomes próprios, não conectadas ao Run_Instance ainda) =====
function Gatilho_HPHOLD_v3(num) {
    Work_A = Get_Gatilho_Hphold_Btn(num);      // 0=nenhum, 1-16=BTN_BIT+1
    if(Work_A == 0) return;
    Work_C = Work_A - 1;                        // índice físico do botão
    Work_B = Hphold_Tempo_Ms(Get_Gatilho_Hphold_Tempo(num));
    // v3z8: MODO ATE — o toque curto. Valida na SOLTURA, e so se o botao nao tiver
    // passado do tempo enquanto pressionado. A logica e o espelho do APOS:
    //   pressionado e passou do tempo -> marca Hp_Travado = "perdeu a janela"
    //   soltou (transicao detectada por Hp_Press) e NAO perdeu -> dispara
    // Reusar Hp_Travado com o sentido de "ja resolvido neste ciclo de aperto" mantem o
    // anti-loop de graca: o Reset_Perfil arma essa mascara toda, entao entrar num perfil
    // com o botao segurado ja chega com a janela perdida e a soltura nao vale — que e
    // exatamente o principio que fixamos para os outros tres gatilhos.
    if(Get_Hold_Modo(num)) {
        Work_D = Ler_Btn_Fisico(Work_C);
        if(Work_D) {
            Hp_Press = Hp_Press | (1 << (num - 1));
            if(Ptime_Btn(Work_C) >= Work_B) Hp_Travado = Hp_Travado | (1 << (num - 1));
            return;
        }
        if((Hp_Press >> (num - 1)) & 1) {          // acabou de soltar
            if(!((Hp_Travado >> (num - 1)) & 1)) { // dentro da janela
                if(Gatilho_Alterna_G(num, 2)) {
                    Toggle_Inst(num);
                } else {
                    Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                    Aplicar_RespOff_Inst(num);
                }
            }
        }
        Hp_Press   = Hp_Press   & (~(1 << (num - 1)));
        Hp_Travado = Hp_Travado & (~(1 << (num - 1)));
        return;
    }
    // MODO APOS — comportamento classico, inalterado.
    if(Ler_Btn_Fisico(Work_C) && Ptime_Btn(Work_C) >= Work_B) {
        if(!((Hp_Travado >> (num - 1)) & 1)) {
            if(Gatilho_Alterna_G(num, 2)) {
                Toggle_Inst(num);
            } else {
                Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                Aplicar_RespOff_Inst(num);
            }
            Hp_Travado = Hp_Travado | (1 << (num - 1));
        }
    } else if(!Ler_Btn_Fisico(Work_C)) {
        Hp_Travado = Hp_Travado & (~(1 << (num - 1)));
    }
}
function Gatilho_DUPLO_v3(num) {
    Work_A = Get_Gatilho_Duplo_Btn(num);
    if(Work_A == 0) return;
    Work_C = Work_A - 1;
    Work_E = Get_Dc(num);
    Work_D = Work_E;
    if(Work_D > 0) {
        Work_D = Work_D - get_rtime();
        if(Work_D < 0) Work_D = 0;
    }
    if(Press_Btn_Fisico(Work_C)) {
        if(Work_D > 0) {
            if(Gatilho_Alterna_G(num, 0)) {
                Toggle_Inst(num);
            } else {
                Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                Aplicar_RespOff_Inst(num);
            }
            Work_D = 0;
        } else {
            Work_D = 300;
        }
    }
    Set_Dc(num, Work_D);
}
function BTN_FN_Finaliza_v3(num) {
    Work_A = Get_Gatilho_Final_Btn(num);
    if(Work_A == 0) return;
    Work_C = Ler_Btn_Fisico(Work_A - 1);
    if(Work_C) {
        if(!((Fz_Travado >> (num - 1)) & 1)) {
            if(Gatilho_Alterna_G(num, 1)) {
                Toggle_Inst(num);
            } else {
                Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                Aplicar_RespOff_Inst(num);
            }
            Fz_Travado = Fz_Travado | (1 << (num - 1));
        }
    } else {
        Fz_Travado = Fz_Travado & (~(1 << (num - 1)));
    }
}
function BTN_FN_FinalAfter_v3(num) {
    Work_A = Get_Gatilho_FinalAfter_Btn(num);
    if(Work_A == 0) return;
    Work_C = Ler_Btn_Fisico(Work_A - 1);
    Work_E = Get_Fa(num);
    Work_B = Work_E & 1;
    Work_D = Work_E >> 1;
    if(Work_C) {
        Work_B = 1;
        Work_D = 0;
    } else {
        if(Work_B && Work_D == 0) {
            // CORRIGIDO: usava (idx+1)*100 (fórmula da escala antiga 0-19). Com a escala
            // nova (0-95, tabela do HOLD), idx 55 (default ~1,0s) virava 5.600ms — por isso
            // o tempo "excedia". Agora converte pela mesma tabela do BTN_HOLD.
            Work_D = After_Ms(Get_FA_Tempo(num));   // v5: tabela propria, persistente
            Work_B = 0;
        } else if(Work_D > 0) {
            Work_D = Work_D - get_rtime();
            if(Work_D <= 0) {
                if(Gatilho_Alterna_G(num, 3)) Toggle_Inst(num);
                else Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                if(!Gatilho_Alterna_G(num, 3)) Aplicar_RespOff_Inst(num);
                Work_D = 0;
            }
        }
    }
    Set_Fa(num, (Work_B & 1) | (Work_D << 1));
}
// ===== V3-h: DIRECT — aplica MULT+INV (Pendência nº2: botão = remap puro, sem MULT/INV;
// L2/R2 preservam o valor analógico real através do MULT/INV normalmente) =====
function Cond_Aplicar_Fonte(num, raw) {
    Work_D = Get_Fonte_Categoria(Get_Fonte_Tipo(num));
    if(Work_D == CAT_BOTAO) return raw;
    Pipe_Val = (raw * (Get_Cond_Mult(num) + 1)) / 10;   // v3za: +1 (escala sem OFF)
    if(Pipe_Val > 100) Pipe_Val = 100;
    if(Pipe_Val < -100) Pipe_Val = -100;
    return Pipe_Val;
}
// ===== V3-f: ESTATC — Estatc_Escrever_Dst já é genérica, só falta o gate de zona ativa =====
// CORRIGIDO (bug 6): com fonte em BOTÃO, o ESTATC agora é CHAVE — a fonte trava o destino
// no alto e o destino SÓ cai por gatilho de finalização/bloqueio ou MOD (que desligam a
// instância, e o desligamento limpa a trava). Antes o destino seguia a fonte: soltou o
// botão, o destino caía junto. Com fonte em eixo/touch o comportamento antigo é mantido
// (segue a zona ativa), porque ali "chave" não faz sentido — é sinal contínuo.
// O bit de trava vive no bit 1 do GT_Relig (RAM, já existente e com bits livres).
// v3za: bit 2 do GT_Relig — "ja destravou pelo TETO, aguarda repouso". Sem esta memoria
// o destrave nao funcionaria na pratica: ao SOLTAR o gatilho, a fonte atravessa a zona
// ativa de volta e retravaria na hora, desfazendo o destrave no mesmo movimento. Com o
// bit, so volta a poder travar depois que a fonte passar pelo repouso (abaixo do THR_IN).
function Estatc_Teto(num)        { return (Get_GT_Relig(num) >> 2) & 1; }
function Set_Estatc_Teto(num, v) {
    Work_A = Get_GT_Relig(num) & (~4);
    if(v) Work_A = Work_A | 4;
    Set_GT_Relig(num, Work_A);
}
// v3zw: SINAL do STATIC em destino de EIXO. Um eixo tem direcao, e o STATIC precisa
// saber qual — travar sempre no positivo cobriria so metade do curso e deixaria de fora
// justamente "andar para frente", que no LY e negativo.
// O sinal e capturado NO INSTANTE do travamento, do lado para onde a fonte foi empurrada.
// Com DIR ABS, isso faz UM MOD cobrir os dois sentidos: empurra para frente e trava para
// frente, empurra para tras e trava para tras — o mesmo ganho que o DIR ABS deu ao DIRECT
// quando fundimos os MODs 16 e 17 do Mad Max.
// Vive no bit 3 do GT_Relig (RAM), ao lado das outras duas travas do STATIC.
function Estatc_Neg(num)         { return (Get_GT_Relig(num) >> 3) & 1; }
function Set_Estatc_Neg(num, v) {
    Work_A = Get_GT_Relig(num) & (~8);
    if(v) Work_A = Work_A | 8;
    Set_GT_Relig(num, Work_A);
}
function Estatc_Travado(num)      { return (Get_GT_Relig(num) >> 1) & 1; }
function Set_Estatc_Travado(num, v) {
    Work_A = Get_GT_Relig(num) & (~2);
    if(v) Work_A = Work_A | 2;
    Set_GT_Relig(num, Work_A);
}
// v3u (sugestão do Daniel): valor de saída do ESTATC. Fontes COM condicionais (TOUCH_X/Y,
// eixos, L2/R2) passam a obedecer ao MULT — o ESTATC trava o destino na intensidade
// configurada, não sempre em 100%. Fonte de BOTÃO e "---" continuam em 100% (não têm MULT,
// são remap puro). INV fica de fora de propósito: o ESTATC trava um destino digital, e
// inverter pra -100 não teria significado ali.
function Estatc_Val(num) {
    Work_E = Get_Fonte_Tipo(num);
    if(Work_E == FONTE_NENHUMA) return 100;
    if(Get_Fonte_Categoria(Work_E) == CAT_BOTAO) return 100;
    Pipe_Val = (100 * (Get_Cond_Mult(num) + 1)) / 10;   // v3za
    if(Pipe_Val > 100) Pipe_Val = 100;
    if(Pipe_Val < 0)   Pipe_Val = 0;
    return Pipe_Val;
}
function Executar_Estatc_Fonte(num) {
    // v3t: a trava de "chave" vale pra BOTÃO e também pra GATILHO (L2/R2) — antes só
    // CAT_BOTAO travava, então L2/R2 seguiam a zona e o destino caía ao soltar. Como o
    // gate continua sendo Zona_Ativa_Fonte, o L2/R2 respeita THR_IN/THR_OUT/INV pra decidir
    // quando travar. Eixo/touch mantém o comportamento antigo (segue a zona, não trava).
    Work_D = Get_Fonte_Categoria(Get_Fonte_Tipo(num));
    if(Work_D == CAT_BOTAO || Work_D == CAT_GATILHO) {
        // v3za: THR_OUT DESTRAVA o ESTATC. Vale so para CAT_GATILHO (L2/R2), porque botao
        // nao tem THR_OUT e eixo nunca trava. Efeito pratico: o gatilho analogico vira uma
        // chave de duas posicoes POR PROFUNDIDADE — pressao leve (dentro da zona) trava o
        // destino; pressao alem do teto destrava. Um botao, dois comandos, sem tempo.
        // Este bloco roda ANTES de Zona_Ativa_Fonte de proposito: aquela funcao suja
        // Work_D por dentro, e ainda precisamos da categoria aqui.
        if(Work_D == CAT_GATILHO && Get_Cond_ThrOut(num) != 0) {
            Est_Tmp = abs(Ler_Fonte(num));
            if(Est_Tmp > Get_Cond_ThrOut(num) * 5) {
                Set_Estatc_Travado(num, 0);
                Set_Estatc_Teto(num, 1);
            } else if(Est_Tmp < Get_Cond_ThrIn(num) * 5) {
                Set_Estatc_Teto(num, 0);   // voltou ao repouso: pode travar de novo
            }
        }
        // v3zw: zera o sinal na BORDA do travamento. Botao e gatilho nunca sao negativos,
        // entao aqui o sinal e sempre positivo — o bit existe pela simetria com o ramo de
        // eixo, e para que destravar pelo teto e travar de novo nao deixe residuo.
        if(!Estatc_Teto(num)) {
            if(Zona_Ativa_Fonte(num)) {
                if(!Estatc_Travado(num)) Set_Estatc_Neg(num, 0);
                Set_Estatc_Travado(num, 1);
            }
        }
        if(Estatc_Travado(num)) {
            Work_E = Estatc_Val(num);   // Estatc_Val usa Work_E/Pipe_Val por dentro; a
                                        // atribuição aqui é NOVA, depois do retorno.
            Est_Tmp = Work_E;
            if(Estatc_Neg(num)) Est_Tmp = -Work_E;
            Estatc_Escrever_Dst_Val(Dst_Mask(num), Work_E, Est_Tmp);
        }
        return;
    }
    if(!Zona_Ativa_Fonte(num)) return;
    Work_E = Estatc_Val(num);
    // v3zw: com fonte de EIXO o STATIC segue a zona (nao trava), entao o sinal e o lado
    // ATUAL para onde a fonte esta empurrada. E isto que faz UM MOD com DIR ABS cobrir
    // os dois sentidos: para frente trava para frente, para tras trava para tras.
    Est_Tmp = Work_E;
    if(Ler_Fonte(num) < 0) Est_Tmp = -Work_E;
    Estatc_Escrever_Dst_Val(Dst_Mask(num), Work_E, Est_Tmp);
}
// ===== V3-g: TURBO — adaptado de Executar_Turbo_X, mesma máquina de oscilação, reaproveita
// Get/Set_TrbSt_X como célula de estado opaca (não precisa de variável nova).
// ATENÇÃO Work_: Zona_Ativa_Fonte toca Work_A/C/D/N por dentro — o flag fica em Work_B
// (que ela não toca) e o valor cru da fonte em Work_E (idem) — ambos sobrevivem até o fim.
// ===== v3ze: EXECUCAO DO TURBO/COMBO =====
// A maquina agora percorre ATE 4 PASSOS. Estado no TrbSt (RAM):
//   bits 0-10  timer da fase (ms)      bit 11   fase (1=ligado, 0=silencio do LAT)
//   bits 12-15 sequencias restantes    bit 16   iniciado
//   bits 17-18 passo atual (0-3)  <- v3ze
// Cada passo fica ligado pelo SEU tempo, depois vem o silencio do LAT, depois o proximo
// passo COM destino. Esgotados os passos, fecha-se uma SEQUENCIA — e e ai que o CICLOS
// e contabilizado (antes ele contava pulsos; agora conta voltas completas).
// Um passo com destino "nenhum" e simplesmente pulado, entao a sequencia tem tamanho
// variavel: configurar so o passo 1 reproduz exatamente o TURBO classico.
function Executar_Turbo_Fonte(num) {
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) Work_B = 1;
    else                                     Work_B = Zona_Ativa_Fonte(num);
    if(!Work_B) {
        Set_TrbSt_X(num, 0);   // fora da zona: rearma e silencia (sequencia recomeca do 1)
        return;
    }
    Work_E = Ler_Fonte(num);
    Work_A = Get_TrbSt_X(num);
    if(!((Work_A >> 16) & 1)) {
        // ARRANQUE: primeiro passo COM destino. Se nenhum passo tem destino, nao ha o
        // que executar — o pack fica em "terminado" e a instancia so nao produz nada.
        Cmb_P = 1;
        if(!Get_Combo_Dst(num, 1)) Cmb_P = Combo_Prox_Passo(num, 1);
        if(Cmb_P == 0) { Set_TrbSt_X(num, 1 << 16); return; }
        // v6: havendo passos VAZIOS antes do primeiro configurado, a sequencia arranca
        // em SILENCIO com a soma dos tempos deles. O passo guardado e o ANTERIOR ao
        // primeiro configurado, para que o fim do silencio caia no ramo "proximo passo
        // com destino" que ja existe — sem ramo novo na maquina.
        if(Cmb_P > 1) {
            Work_B = Trb_Prog_Espera(num, Combo_Espera(num, Cmb_P));
            if(Work_B > 0) {
                Work_A = (Work_B & 0x7FF) | ((Get_Turbo_Ciclos(num) & 0xF) << 12)
                         | (1 << 16) | ((Cmb_P - 2) << 17);
                Set_TrbSt_X(num, Work_A);
                Work_A = Get_TrbSt_X(num);
            } else {
                Work_B = Trb_Tempo_Ms(Get_Combo_Tmp(num, Cmb_P));
                Work_A = (Work_B & 0x7FF) | (1 << 11) | ((Get_Turbo_Ciclos(num) & 0xF) << 12)
                         | (1 << 16) | ((Cmb_P - 1) << 17);
                Set_TrbSt_X(num, Work_A);
            }
        } else {
            Work_B = Trb_Tempo_Ms(Get_Combo_Tmp(num, Cmb_P));
            Work_A = (Work_B & 0x7FF) | (1 << 11) | ((Get_Turbo_Ciclos(num) & 0xF) << 12)
                     | (1 << 16) | ((Cmb_P - 1) << 17);
            Set_TrbSt_X(num, Work_A);
        }
    } else {
        Work_C = (Work_A >> 12) & 0xF;              // sequencias restantes
        Cmb_P = ((Work_A >> 17) & 0x3) + 1;         // passo atual (1-4)
        if(Get_Turbo_Ciclos(num) == 0 || Work_C > 0) {
            Work_B = (Work_A & 0x7FF) - get_rtime();
            Esx_T = Get_Esx(num);
            if(Work_B <= 0 && Esx_T > 0) {
                // v7m: ainda ha resto de espera — recarrega o timer e FICA na mesma fase
                Work_B = Esx_T;
                if(Work_B > 2047) Work_B = 2047;
                Set_Esx(num, Esx_T - Work_B);
                Work_A = (Work_A & (~0x7FF)) | (Work_B & 0x7FF);
            } else if(Work_B <= 0) {
                if(((Work_A >> 11) & 1) && (Trb_Lat_Ms(Get_Turbo_Lat(num)) + Combo_Lat_Extra(num, Cmb_P)) > 0) {
                    // fim do passo LIGADO -> silencio, no mesmo passo
                    // v7j: a pausa e a latencia global MAIS os tempos dos passos vazios
                    // que vierem a seguir. Com a global em "---", so os vazios contam.
                    Work_B = Trb_Prog_Espera(num,
                        Trb_Lat_Ms(Get_Turbo_Lat(num)) + Combo_Lat_Extra(num, Cmb_P));
                    Work_A = (Work_B & 0x7FF) | (Work_C << 12) | (1 << 16) | ((Cmb_P - 1) << 17);
                } else {
                    // v6: com LAT em --- a fase de silencio nao existe — o passo termina e
                    // o proximo emenda direto. Cai neste mesmo ramo de "avancar", que ja
                    // fazia o trabalho; so o caminho de chegada mudou.
                    // fim do silencio -> proximo passo com destino
                    Cmb_N = Combo_Prox_Passo(num, Cmb_P);
                    if(Cmb_N > 0) {
                        Work_B = Trb_Tempo_Ms(Get_Combo_Tmp(num, Cmb_N));
                        Work_A = (Work_B & 0x7FF) | (1 << 11) | (Work_C << 12)
                                 | (1 << 16) | ((Cmb_N - 1) << 17);
                    } else {
                        // acabaram os passos: fecha uma SEQUENCIA
                        // v6a CORRIGIDO: a ESPERA precisa valer em TODA volta, nao so na
                        // primeira. Como o Daniel colocou, com apenas o P4 configurado a
                        // soma de P1+P2+P3 E a latencia de entrada dele — e latencia de
                        // entrada que so acontece uma vez nao e latencia, e atraso de
                        // partida. Aqui o arranque da volta reusa a mesma logica do
                        // arranque inicial: se ha passos vazios antes, entra em SILENCIO
                        // com a soma deles, guardando o passo ANTERIOR ao primeiro
                        // configurado; senao, liga o passo direto.
                        Cmb_P = 1;
                        if(!Get_Combo_Dst(num, 1)) Cmb_P = Combo_Prox_Passo(num, 1);
                        Cmb_N = 0;
                        if(Cmb_P > 1) Cmb_N = Trb_Prog_Espera(num, Combo_Espera(num, Cmb_P));
                        if(Get_Turbo_Ciclos(num) > 0) {
                            Work_C = Work_C - 1;
                            if(Work_C == 0) {
                                Work_A = (1 << 16);   // pack "terminado"
                            } else if(Cmb_N > 0) {
                                Work_A = (Cmb_N & 0x7FF) | (Work_C << 12)
                                         | (1 << 16) | ((Cmb_P - 2) << 17);
                            } else {
                                Work_B = Trb_Tempo_Ms(Get_Combo_Tmp(num, Cmb_P));
                                Work_A = (Work_B & 0x7FF) | (1 << 11) | (Work_C << 12)
                                         | (1 << 16) | ((Cmb_P - 1) << 17);
                            }
                        } else if(Cmb_N > 0) {
                            Work_A = (Cmb_N & 0x7FF) | (1 << 16) | ((Cmb_P - 2) << 17);
                        } else {
                            Work_B = Trb_Tempo_Ms(Get_Combo_Tmp(num, Cmb_P));
                            Work_A = (Work_B & 0x7FF) | (1 << 11) | (1 << 16) | ((Cmb_P - 1) << 17);
                        }
                    }
                }
            } else {
                Work_A = (Work_A & (~0x7FF)) | (Work_B & 0x7FF);
            }
            Set_TrbSt_X(num, Work_A);
        }
    }
    // ----- ESCRITA -----
    Work_B = Get_TrbSt_X(num);
    Cmb_P = ((Work_B >> 17) & 0x3) + 1;
    Cmb_N = Get_Combo_Dst(num, Cmb_P);          // 0=nenhum, 1-18 = destino+1
    if(Cmb_N) {
        Cmb_N = Cmb_N - 1;                      // indice real do destino (0-17)
        if(Cmb_N > 9 && Cmb_N < 14) {
            // destino de EIXO: usa a polaridade do MODO e escreve tambem no silencio
            // (o zero da latencia faz parte da resposta, senao o eixo cru vazaria).
            Escrever_Destino(1 << Cmb_N,
                Trb_Aplicar_Cond(num, Trb_Valor_Eixo(Get_Turbo_Modo(num), Work_B, Work_E)));
        } else if((Work_B >> 11) & 1) {
            // destino DIGITAL: so na fase ligada
            // v7i: num orfao adotado, o pulso sai com a INTENSIDADE do alvo em vez de
            // 100% fixo — mesma razao do DIRECT: quem manda e o ALFA/BETA da matriz.
            Est_Tmp = 100;
            if(Orfao_Adotado(num)) {
                Work_D = Valor_Alvo_Assoc(num);
                if(Work_D != -1) Est_Tmp = abs(Work_D);
            }
            Acc_Um(Cmb_N, Trb_Aplicar_Cond(num, Est_Tmp));
        }
    }
    // v3y/v3ze: com CICLOS definidos, esgotar as sequencias AUTOFINALIZA a instancia —
    // a resposta precisa estar viva para haver relacao de MOD, e uma instancia que
    // terminou a rajada nao pode seguir "ligada" bloqueando terceiros.
    if(Get_Turbo_Ciclos(num) > 0 && ((Work_B >> 16) & 1) &&
       (Work_B & 0x7FF) == 0 && !((Work_B >> 11) & 1)) {
        Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
        Aplicar_RespOff_Inst(num);
    }
}
// Aplica MULT e INV ao valor de saída do TURBO, saturando em ±100 (bug 5).
// Separada de Cond_Aplicar_Fonte porque aquela retorna cedo pra CAT_BOTAO (o remap de botão
// é puro), enquanto aqui o MULT/INV valem para os dois tipos de destino.
// v3t: valor físico ATUAL do botão do gatilho configurado — base da "predisposição" do
// DIRECT sem fonte. Prioridade 2CLK > HOLD > FINALIZA > FINAL_AFTER > BLOK (o primeiro
// configurado manda). Com nenhum configurado devolve 100 (a instância só está de pé pelo
// INIC, então o destino fica cheio). Work_N é seguro: Ler_Btn_Fisico/Get_Gatilho_* são puras.
// v3zk: a supressao dos botoes de gatilho agora segue o ATIVO/PASSIVO da secao ALFA,
// em vez de ser sempre ligada. Antes, todo botao usado como gatilho perdia a funcao
// nativa no jogo — caro, porque com poucos botoes alcancaveis dedicar um a um MOD que
// dorme a maior parte do tempo e desperdicio.
//   PASSIVO -> suprime a fonte E os gatilhos (comportamento anterior)
//   ATIVO   -> nao suprime nada; o botao continua servindo ao jogo
// Efeito colateral assumido: em ATIVO, o toque que LIGA o MOD tambem chega ao jogo.
// Ganho de tabela: o ATIVO/PASSIVO deixa de ser inerte quando a fonte e "---", porque
// passa a governar os gatilhos — antes nao tinha o que suprimir e o campo ficava morto.
// SEGURO quanto a destinos: esta supressão escreve direto via set_val AQUI dentro do
// Run_Instance, enquanto os destinos só acumulam em Acc_* e são escritos por Aplicar_Acc,
// que roda DEPOIS das 21 instâncias. Ou seja, destino sempre ganha da supressão — verificado
// na ordem do Run_Pipeline. Isso também resolve o antigo "exceto se citado no DESTINO".
// Roda mesmo com a instância desligada (de propósito): o gatilho precisa ficar suprimido
// sempre, senão o próprio toque que liga o MOD vazaria pro jogo. Só não roda se o PERFIL
// da instância estiver inativo — os gates de CurrentMode/S1-S4 vêm antes desta chamada.
// v3z1: a instância está em REPOUSO agora? (fonte fora da zona E nenhum botão de gatilho
// pressionado). Base do gate de entrada de perfil — ver Ent_Trava no Run_Instance_v3.
// Sem fonte ("---") só os gatilhos contam, porque não há zona a consultar.
function Get_Fin(n) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) return Fin_01;
                if(n == 2) return Fin_02;
                if(n == 3) return Fin_03;
            } else {
                if(n == 4) return Fin_04;
                if(n == 5) return Fin_05;
                if(n == 6) return Fin_06;
            }
        } else {
            if(n <= 9) {
                if(n == 7) return Fin_07;
                if(n == 8) return Fin_08;
                if(n == 9) return Fin_09;
            } else {
                if(n == 10) return Fin_10;
                if(n == 11) return Fin_11;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) return Fin_12;
                if(n == 13) return Fin_13;
                if(n == 14) return Fin_14;
            } else {
                if(n == 15) return Fin_15;
                if(n == 16) return Fin_16;
            }
        } else {
            if(n <= 19) {
                if(n == 17) return Fin_17;
                if(n == 18) return Fin_18;
                if(n == 19) return Fin_19;
            } else {
                if(n == 20) return Fin_20;
                if(n == 21) return Fin_21;
            }
        }
    }
    return 0;
}
function Set_Fin(n, v) {
    if(n== 1) Fin_01=v;   if(n== 2) Fin_02=v;   if(n== 3) Fin_03=v;
    if(n== 4) Fin_04=v;   if(n== 5) Fin_05=v;   if(n== 6) Fin_06=v;
    if(n== 7) Fin_07=v;   if(n== 8) Fin_08=v;   if(n== 9) Fin_09=v;
    if(n==10) Fin_10=v;   if(n==11) Fin_11=v;   if(n==12) Fin_12=v;
    if(n==13) Fin_13=v;   if(n==14) Fin_14=v;   if(n==15) Fin_15=v;
    if(n==16) Fin_16=v;   if(n==17) Fin_17=v;   if(n==18) Fin_18=v;
    if(n==19) Fin_19=v;   if(n==20) Fin_20=v;   if(n==21) Fin_21=v;
}
function Get_Blok(n) {
    if(n <= 11) {
        if(n <= 6) {
            if(n <= 3) {
                if(n == 1) return Blk_01;
                if(n == 2) return Blk_02;
