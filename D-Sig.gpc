    if(n==19) DS_F1_BLOQ_19=v;
    if(n==20) DS_F1_BLOQ_20=v;
    if(n==21) DS_F1_BLOQ_21=v;
}
function Count_Instances() {
    Total_Inst = 0;
    Cfg_Ram   = 0;
    Cfg_Salvo = 0;
    Cfg_Mov   = 0;
    Work_N = 1;
    while(Work_N <= 21) {
        if(Get_Spvar_A(Work_N) & 1) {
            Cfg_Salvo = Cfg_Salvo | (1 << (Work_N - 1));
            Total_Inst++;
        }
        Work_N++;
    }
}
function Load_Wz(num) {
    Snap_A  = Get_Spvar_A(num);
    Snap_B  = Get_Spvar_B(num);
    Snap_C  = Get_Spvar_C(num);
    Snap_EX = Get_F1_Excl(num);
    Snap_AS = Get_F1_Assoc(num);
    Snap_BL = Get_F1_Bloq(num);
    Work_A = Get_Spvar_A(num);
    Wz_S1 = (Work_A >> BIT_S1) & 1;
    Wz_S2 = (Work_A >> BIT_S2) & 1;
    Wz_S3 = (Work_A >> BIT_S3) & 1;
    Wz_S4 = (Work_A >> BIT_S4) & 1;
}
function Get_F1_Tipo(num) {
    if(num == Spv_N) { Work_A = Spv_A; return (Work_A >> SHIFT_F1_DST_TIPO) & 0x03; }
    Work_A = Get_Spvar_A(num);
    return (Work_A >> SHIFT_F1_DST_TIPO) & 0x03;
}
function Set_F1_Tipo(num, tipo) {
    Work_A = Get_Spvar_A(num);
    Work_A = Work_A & (~(0x03 << SHIFT_F1_DST_TIPO));
    Work_A = Work_A | ((tipo & 0x03) << SHIFT_F1_DST_TIPO);
    Set_Spvar_A(num, Work_A);
}
function Commit_Wz(num) {
    Work_A = Get_Spvar_A(num);
    Work_A = Work_A & ~(1 << BIT_S1);
    Work_A = Work_A & ~(1 << BIT_S2);
    Work_A = Work_A & ~(1 << BIT_S3);
    Work_A = Work_A & ~(1 << BIT_S4);
    Work_A = Work_A | 1;
    if(Wz_S1) Work_A = Work_A | (1 << BIT_S1);
    if(Wz_S2) Work_A = Work_A | (1 << BIT_S2);
    if(Wz_S3) Work_A = Work_A | (1 << BIT_S3);
    if(Wz_S4) Work_A = Work_A | (1 << BIT_S4);
    Set_Spvar_A(num, Work_A);
    if(Get_Fonte_Tipo(num) != FONTE_NENHUMA) Inst_Ativa = Inst_Ativa | (1 << (num - 1));
    else                                     Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
    Aplicar_RespOff_Inst(num);
    Hp_Travado = Hp_Travado & (~(1 << (num - 1)));
    if(Get_Spvar_A(num)   != Snap_A  || Get_Spvar_B(num)  != Snap_B  ||
       Get_Spvar_C(num)   != Snap_C  || Get_F1_Excl(num)   != Snap_EX ||
       Get_F1_Assoc(num)  != Snap_AS || Get_F1_Bloq(num)  != Snap_BL) {
        Cfg_Ram   = Cfg_Ram   |  (1 << (num - 1));
        Cfg_Salvo = Cfg_Salvo & (~(1 << (num - 1)));
        Cfg_Mov   = Cfg_Mov   & (~(1 << (num - 1)));
        Snap_A = Get_Spvar_A(num); Snap_B = Get_Spvar_B(num); Snap_C = Get_Spvar_C(num);
            Snap_EX = Get_F1_Excl(num); Snap_AS = Get_F1_Assoc(num); Snap_BL = Get_F1_Bloq(num);
    }
}
function Get_Spvar_A(num) {
    if(num == Spv_N) return Spv_A;
    if(num <= 11) {
        if(num <= 6) {
            if(num <= 3) {
                if(num == 1) return DS_A_01;
                if(num == 2) return DS_A_02;
                if(num == 3) return DS_A_03;
            } else {
                if(num == 4) return DS_A_04;
                if(num == 5) return DS_A_05;
                if(num == 6) return DS_A_06;
            }
        } else {
            if(num <= 9) {
                if(num == 7) return DS_A_07;
                if(num == 8) return DS_A_08;
                if(num == 9) return DS_A_09;
            } else {
                if(num == 10) return DS_A_10;
                if(num == 11) return DS_A_11;
            }
        }
    } else {
        if(num <= 16) {
            if(num <= 14) {
                if(num == 12) return DS_A_12;
                if(num == 13) return DS_A_13;
                if(num == 14) return DS_A_14;
            } else {
                if(num == 15) return DS_A_15;
                if(num == 16) return DS_A_16;
            }
        } else {
            if(num <= 19) {
                if(num == 17) return DS_A_17;
                if(num == 18) return DS_A_18;
                if(num == 19) return DS_A_19;
            } else {
                if(num == 20) return DS_A_20;
                if(num == 21) return DS_A_21;
            }
        }
    }
    return 0;
}
function Set_Spvar_A(num, val) {
    if(num == Spv_N) Spv_A = val;
    if(num== 1) DS_A_01 = val;
    if(num== 2) DS_A_02 = val;
    if(num== 3) DS_A_03 = val;
    if(num== 4) DS_A_04 = val;
    if(num== 5) DS_A_05 = val;
    if(num== 6) DS_A_06 = val;
    if(num== 7) DS_A_07 = val;
    if(num== 8) DS_A_08 = val;
    if(num== 9) DS_A_09 = val;
    if(num==10) DS_A_10 = val;
    if(num==11) DS_A_11 = val;
    if(num==12) DS_A_12 = val;
    if(num==13) DS_A_13 = val;
    if(num==14) DS_A_14 = val;
    if(num==15) DS_A_15 = val;
    if(num==16) DS_A_16 = val;
    if(num==17) DS_A_17 = val;
    if(num==18) DS_A_18 = val;
    if(num==19) DS_A_19 = val;
    if(num==20) DS_A_20 = val;
    if(num==21) DS_A_21 = val;
}
