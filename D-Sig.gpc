function Grava_Spv(qual, valor) {
    if(get_pvar(qual, -2147483648, 2147483647, 0) == valor) return;
    set_pvar(qual, valor);
}
function Save_Instance(num) {
    if(num ==  1) { Grava_Spv(SPVAR_1, DS_A_01); Grava_Spv(SPVAR_2, DS_B_01); Grava_Spv(SPVAR_3, DS_C_01); }
