function Hphold_Tempo_Ms(idx) {
    if(idx <= 25) return 50 + idx * 10;
    if(idx <= 39) return 350 + (idx - 26) * 50;
    if(idx <= 55) return 1100 + (idx - 40) * 100;
    return 2800 + (idx - 56) * 200;
}
function Print_Hphold_Tempo(x, y, idx) {
    Work_N = Hphold_Tempo_Ms(idx);
    Work_D = Work_N / 1000;
    Work_C = Work_N - (Work_D * 1000);
    Work_C = Work_C / 10;
    Print_Digito(x, y, Work_D);
    print(x + 6, y, 0, 1, PONTO[0]);
    Print_Digito(x + 10, y, Work_C / 10);
    Print_Digito(x + 16, y, Work_C - ((Work_C/10)*10));
    print(x + 22, y, 0, 1, SEG_L[0]);
}
