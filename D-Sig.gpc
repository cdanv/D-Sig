function Print_Himds_Lista_Row(idx, y) {
    if(idx == Wz_Mod_Tipo) print(2, y, 0, 1, SCR_SEL[0]);
    if(idx == 0) {
        print(10, y, 0, 1, MOD_EXCL_L[0]);
        if(Get_F1_Excl(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
    if(idx == 1) {
        print(10, y, 0, 1, MOD_ASSOC_L[0]);
        if(Get_F1_Assoc(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
    if(idx == 2) {
        print(10, y, 0, 1, MOD_BLOQ_L[0]);
        if(Get_F1_Bloq(WzSlot) != 0) print(115, y, 0, 1, FN_ATIVO[0]);
    }
}
