}
function Delay_Passou(num) {
    if(Get_Delay(num) == 0) return 1;
    if(Get_Fonte_Tipo(num) != FONTE_NENHUMA) {
        if(!Zona_Ativa_Fonte(num)) { Delay_Zerar(num); return 0; }
    }
    if(!((Dly_Arm >> (num - 1)) & 1)) {
        Set_Dly(num, Delay_Ms(Get_Delay(num)));
        Dly_Arm = Dly_Arm | (1 << (num - 1));
    }
    Work_N = Get_Dly(num);
    if(Work_N <= 0) return 1;
    Work_N = Work_N - get_rtime();
    if(Work_N < 0) Work_N = 0;
    Set_Dly(num, Work_N);
    return Work_N <= 0;
}
function Delay_Zerar(num) {
    Dly_Arm = Dly_Arm & (~(1 << (num - 1)));
    Set_Dly(num, 0);
}
function Ent_Livre(num) {
    if(Get_Blok(num) && Ler_Btn_Fisico(Get_Blok(num) - 1)) return 0;
    if(Get_Gatilho_Duplo_Btn(num)      && Ler_Btn_Fisico(Get_Gatilho_Duplo_Btn(num) - 1))      return 0;
    if(Get_Gatilho_Final_Btn(num)      && Ler_Btn_Fisico(Get_Gatilho_Final_Btn(num) - 1))      return 0;
    if(Get_Gatilho_Hphold_Btn(num)     && Ler_Btn_Fisico(Get_Gatilho_Hphold_Btn(num) - 1))     return 0;
    if(Get_Gatilho_FinalAfter_Btn(num) && Ler_Btn_Fisico(Get_Gatilho_FinalAfter_Btn(num) - 1)) return 0;
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) return 1;
    if(Zona_Ativa_Fonte(num)) return 0;
    return 1;
}
function Suprime_Gatilhos(num) {
    Work_N = Get_Blok(num);                  if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Duplo_Btn(num);      if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Final_Btn(num);      if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_Hphold_Btn(num);     if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
    Work_N = Get_Gatilho_FinalAfter_Btn(num); if(Work_N) Set_Btn_Fisico(Work_N - 1, 0);
}
function Gatilho_Btn_Val(num) {
    Work_N = Get_Gatilho_Duplo_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_Hphold_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_Final_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    Work_N = Get_Gatilho_FinalAfter_Btn(num);
    if(Work_N) return Ler_Btn_Fisico(Work_N - 1);
    return 100;
}
function Trb_Aplicar_Cond(num, v) {
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) return v;
    if(Get_Fonte_Categoria(Get_Fonte_Tipo(num)) == CAT_BOTAO) return v;
    Pipe_Val = (v * (Get_Cond_Mult(num) + 1)) / 10;
    if(Pipe_Val > 100)  Pipe_Val = 100;
    if(Pipe_Val < -100) Pipe_Val = -100;
    return Pipe_Val;
}
function Run_Instance_v3(num) {
    Spv_N = -1;
    Spv_A = Get_Spvar_A(num); Spv_B = Get_Spvar_B(num); Spv_C = Get_Spvar_C(num);
    Spv_N = num;
    Work_A = Spv_A;
    if(!(Work_A & 1)) return;
    if(CurrentMode == 0) return;
    if(!((Work_A >> CurrentMode) & 1)) return;
    if((Ent_Trava >> (num - 1)) & 1) {
        if(Get_Fonte_Passivo(num)) { Suprime_Gatilhos(num); Suprime_Fonte(num); }
        if(Ent_Livre(num)) Ent_Trava = Ent_Trava & (~(1 << (num - 1)));
        return;
    }
    Gatilho_HPHOLD_v3(num);
    Gatilho_DUPLO_v3(num);
    BTN_FN_Finaliza_v3(num);
    BTN_FN_FinalAfter_v3(num);
    if(Get_Fonte_Passivo(num)) Suprime_Gatilhos(num);
    Religa_Fonte(num);
    if(Get_Fonte_Passivo(num)) Suprime_Fonte(num);
    if(!Inst_Esta_Ativa(num)) return;
    if((Bloq_Mask  >> (num - 1)) & 1) {
        return;
    }
    if((Excl_Veto  >> (num - 1)) & 1) return;
    if((Assoc_Mask >> (num - 1)) & 1) { Delay_Zerar(num); return; }
    if(BTN_FN_Bloqueia_v3(num)) return;
    if((Resp_Off_Fonte >> (num - 1)) & 1) return;
    if(!Delay_Passou(num)) return;
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) {
        if(Get_F1_Tipo(num) == DST_TIPO_TURBO) { Executar_Turbo_Fonte(num); return; }
        if(Get_F1_Tipo(num) == DST_TIPO_DIRECT) {
            Work_D = Gatilho_Btn_Val(num);
            if(Orfao_Adotado(num)) {
                Est_Tmp = Valor_Alvo_Assoc(num);
                if(Est_Tmp != -1) Work_D = Est_Tmp;
            }
            if(Work_D) {
                Escrever_Destino(Dst_Mask(num), Work_D);
            } else {
                Inst_Ativa = Inst_Ativa & (~(1 << (num - 1)));
                Aplicar_RespOff_Inst(num);
            }
            return;
        }
        Estatc_Escrever_Dst(Dst_Mask(num));
        return;
    }
    if(Get_F1_Tipo(num) == DST_TIPO_DIRECT) {
        if(Zona_Ativa_Fonte(num)) {
            Work_D = Ler_Fonte(num);
            Escrever_Destino(Dst_Mask(num), Cond_Aplicar_Fonte(num, Work_D));
        }
    }
    if(Get_F1_Tipo(num) == DST_TIPO_ESTATC) Executar_Estatc_Fonte(num);
    if(Get_F1_Tipo(num) == DST_TIPO_TURBO)  Executar_Turbo_Fonte(num);
}
function Tem_Gatilho_Estado(num) {
    if(!Cfg_Sujo) return (Msk_GatEst >> (num - 1)) & 1;
    if(Get_Gatilho_Duplo_Btn(num)      && !((Get_Fin(num) >> 0) & 1)) return 1;
    if(Get_Gatilho_Final_Btn(num)      && !((Get_Fin(num) >> 1) & 1)) return 1;
    if(Get_Gatilho_Hphold_Btn(num)     && !((Get_Fin(num) >> 2) & 1)) return 1;
    if(Get_Gatilho_FinalAfter_Btn(num) && !((Get_Fin(num) >> 3) & 1)) return 1;
    return 0;
}
function Inst_Esta_Ativa(num) {
    if(!Cfg_Sujo) {
        if((Msk_Livre >> (num - 1)) & 1) return 1;
        return (Inst_Ativa >> (num - 1)) & 1;
    }
    if(Get_Fonte_Tipo(num) == FONTE_NENHUMA) {
        return (Inst_Ativa >> (num - 1)) & 1;
    }
    if(!Tem_Gatilho_Estado(num)) return 1;
    return (Inst_Ativa >> (num - 1)) & 1;
}
function Get_Fa(num) {
