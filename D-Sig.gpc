            } else {
                if(n == 4) return Blk_04;
                if(n == 5) return Blk_05;
                if(n == 6) return Blk_06;
            }
        } else {
            if(n <= 9) {
                if(n == 7) return Blk_07;
                if(n == 8) return Blk_08;
                if(n == 9) return Blk_09;
            } else {
                if(n == 10) return Blk_10;
                if(n == 11) return Blk_11;
            }
        }
    } else {
        if(n <= 16) {
            if(n <= 14) {
                if(n == 12) return Blk_12;
                if(n == 13) return Blk_13;
                if(n == 14) return Blk_14;
            } else {
                if(n == 15) return Blk_15;
                if(n == 16) return Blk_16;
            }
        } else {
            if(n <= 19) {
                if(n == 17) return Blk_17;
                if(n == 18) return Blk_18;
                if(n == 19) return Blk_19;
            } else {
                if(n == 20) return Blk_20;
                if(n == 21) return Blk_21;
            }
        }
    }
    return 0;
}
function Set_Blok(n, v) {
    if(n== 1) Blk_01=v;   if(n== 2) Blk_02=v;   if(n== 3) Blk_03=v;
    if(n== 4) Blk_04=v;   if(n== 5) Blk_05=v;   if(n== 6) Blk_06=v;
    if(n== 7) Blk_07=v;   if(n== 8) Blk_08=v;   if(n== 9) Blk_09=v;
    if(n==10) Blk_10=v;   if(n==11) Blk_11=v;   if(n==12) Blk_12=v;
    if(n==13) Blk_13=v;   if(n==14) Blk_14=v;   if(n==15) Blk_15=v;
    if(n==16) Blk_16=v;   if(n==17) Blk_17=v;   if(n==18) Blk_18=v;
    if(n==19) Blk_19=v;   if(n==20) Blk_20=v;   if(n==21) Blk_21=v;
}
function BTN_FN_Bloqueia_v3(num) {
    Work_N = Get_Blok(num);
    if(!Work_N) return 0;
    return Ler_Btn_Fisico(Work_N - 1);
}
